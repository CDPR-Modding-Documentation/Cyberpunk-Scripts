import enum inkEShapeVariant
{
	Fill,
	Border,
	FillAndBorder,
}

import enum inkEEndCapStyle
{
	BUTT,
	SQUARE,
	ROUND,
	JOINED,
}

import enum inkEJointStyle
{
	MITER,
	BEVEL,
	ROUND,
}

importonly abstract class inkBaseShapeWidget extends inkLeafWidget
{
}

importonly class inkRectangle extends inkBaseShapeWidget
{
}

importonly class inkCircle extends inkBaseShapeWidget
{
	import var segmentsNumber : Uint32;
}

importonly class inkShape extends inkBaseShapeWidget
{
	public import function ChangeShape( shapeName : CName );
	public import function GetShapeResource() : ResRef;
	public import function SetShapeResource( path : ResRef );

	import var shapeName : CName;
	import var shapeVariant : inkEShapeVariant;
	import var useNineSlice : Bool;
	import var nineSliceScale : inkMargin;
	import var keepInBounds : Bool;
	import var contentHAlign : inkEHorizontalAlign;
	import var contentVAlign : inkEVerticalAlign;
	import var borderColor : HDRColor;
	import var borderOpacity : Float;
	import var fillOpacity : Float;
	import var lineThickness : Float;
	import var endCapStyle : inkEEndCapStyle;
	import var jointStyle : inkEJointStyle;
	import var vertexList : array< Vector2 >;
}

