import class inkScrollController extends inkLogicController
{
	public import function Scroll( value : Float, isMouseWheel : Bool );
	public import function GetScrollPosition() : Float;
	public import function SetScrollPosition( newValue : Float );
	public import function UpdateScrollPositionFromScrollArea();
	public import function SetInputDisabled( disabled : Bool );
	public import function EnsureVisible( widget : weak< inkWidget > );
	public import function GetViewportSize() : Vector2;
	public import function SetViewportSize( newValue : Vector2 );
	public import function SetViewportWidth( newValue : Float );
	public import function SetViewportHeight( newValue : Float );
	public import function IsEnabled() : Bool;
	public import function SetEnabled( newValue : Bool );
}

import enum inkEScrollDirection
{
	Vertical,
	Horizontal,
}

