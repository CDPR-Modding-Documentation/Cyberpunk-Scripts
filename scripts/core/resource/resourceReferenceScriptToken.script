importonly final struct ResRef
{
	public import static function FromString( path : String ) : ResRef;
	public import static function FromHash( hash : Uint64 ) : ResRef;
	public import static function FromName( path : CName ) : ResRef;
	public import static function IsValid( path : ResRef ) : Bool;
	public import static function GetHash( path : ResRef ) : Uint64;
	public import static function ToString( path : ResRef ) : String;
}

import enum ECookingPlatform : Uint8
{
	PLATFORM_None,
	PLATFORM_PC,
	PLATFORM_XboxOne,
	PLATFORM_PS4,
	PLATFORM_PS5,
	PLATFORM_XSX,
	PLATFORM_WindowsServer,
	PLATFORM_LinuxServer,
	PLATFORM_GGP,
	PLATFORM_Emporium,
}

import struct CResourceWrapper
{
	import var path : ResRef;
	import var cookingPlatform : ECookingPlatform;
}

import final struct redResourceRefWrapper
{
	public import static function LoadPath( self : ref< redResourceRefWrapper >, path : ResRef );
	public import static function GetPath( self : ref< redResourceRefWrapper > ) : ResRef;
	public import static function GetHash( self : ref< redResourceRefWrapper > ) : Uint64;
	public import static function GetToken( self : ref< redResourceRefWrapper > ) : redResourceTokenWrapper;
	public import static function GetResource( self : ref< redResourceRefWrapper > ) : CResourceWrapper;
	public import static function IsEmpty( self : ref< redResourceRefWrapper > ) : Bool;
	public import static function IsLoaded( self : ref< redResourceRefWrapper > ) : Bool;
	public import static function IsFailed( self : ref< redResourceRefWrapper > ) : Bool;
	public import static function ToVariant( self : ref< redResourceRefWrapper >, type : CName ) : Variant;
	public import static function FromVariant( variant : Variant ) : redResourceRefWrapper;

	public static function FromPath( path : ResRef ) : redResourceRefWrapper
	{
		var reference : redResourceRefWrapper;
		redResourceRefWrapper.LoadPath( reference, path );
		return reference;
	}

}

import final struct redResourceAsyncRefWrapper
{
	public import static function SetPath( self : ref< redResourceAsyncRefWrapper >, path : ResRef );
	public import static function GetPath( self : ref< redResourceAsyncRefWrapper > ) : ResRef;
	public import static function GetHash( self : ref< redResourceAsyncRefWrapper > ) : Uint64;
	public import static function IsEmpty( self : ref< redResourceAsyncRefWrapper > ) : Bool;
}

import class redResourceTokenWrapper extends IScriptable
{
	public import function GetResource() : CResourceWrapper;
	public import function GetPath() : ResRef;
	public import function GetHash() : Uint64;
	public import function IsFinished() : Bool;
	public import function IsLoaded() : Bool;
	public import function IsFailed() : Bool;
	public import function RegisterCallback( target : IScriptable, funcName : CName );
}

operator==( lhs : redResourceAsyncRefWrapper, rhs : ResRef ) : Bool
{
	return redResourceAsyncRefWrapper.GetPath( lhs ) == rhs;
}

operator!=( lhs : redResourceAsyncRefWrapper, rhs : ResRef ) : Bool
{
	return redResourceAsyncRefWrapper.GetPath( lhs ) != rhs;
}

operator==( x : redResourceReferenceScriptToken, y : ResRef ) : Bool
{
	return y == ( ( ResRef )( x ) );
}

operator==( x : ResRef, y : redResourceReferenceScriptToken ) : Bool
{
	return x == ( ( ResRef )( y ) );
}

