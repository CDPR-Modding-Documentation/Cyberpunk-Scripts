class ValentinosFrenzyEffector extends Effector
{
	var m_countToRefund : Int32;
	var m_weaponToRefund : CName;

	protected override function Initialize( record : TweakDBID, game : GameInstance, parentRecord : TweakDBID )
	{
		m_countToRefund = TweakDBInterface.GetInt( record + T".countToRefund", 1 );
		m_weaponToRefund = TweakDBInterface.GetCName( record + T".weapon", 'WeaponRight' );
	}

	protected export override function ActionOn( owner : GameObject )
	{
		ProcessAction( owner );
	}

	protected export override function RepeatedAction( owner : GameObject )
	{
		ProcessAction( owner );
	}

	private function ProcessAction( owner : GameObject )
	{
		var weapon : weak< WeaponObject >;
		var refundEvent : SetAmmoCountEvent;
		if( m_weaponToRefund == 'WeaponRight' )
		{
			weapon = ScriptedPuppet.GetRightActiveWeapon( owner );
		}
		else if( m_weaponToRefund == 'WeaponLeft' )
		{
			weapon = ScriptedPuppet.GetLeftActiveWeapon( owner );
		}
		else
		{
			return;
		}
		if( ( ( weapon && WeaponObject.HasAvailableAmmoInInventory( weapon ) ) && ( WeaponObject.GetMagazineCapacity( weapon ) > WeaponObject.GetMagazineAmmoCount( weapon ) ) ) && ( m_countToRefund > 0 ) )
		{
			refundEvent = new SetAmmoCountEvent;
			refundEvent.ammoTypeID = WeaponObject.GetAmmoType( weapon );
			refundEvent.count = ( ( Uint32 )( m_countToRefund ) ) + WeaponObject.GetMagazineAmmoCount( weapon );
			weapon.QueueEvent( refundEvent );
		}
	}

}

