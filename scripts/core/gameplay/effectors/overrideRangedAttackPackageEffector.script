class OverrideRangedAttackPackageEffector extends Effector
{
	var m_attackPackage : RangedAttackPackage_Record;
	var m_weaponAttachmentSource : Item_Record;

	protected export override function Initialize( record : TweakDBID, game : GameInstance, parentRecord : TweakDBID )
	{
		var effectorRecord : OverrideRangedAttackPackageEffector_Record;
		effectorRecord = TweakDBInterface.GetOverrideRangedAttackPackageEffectorRecord( record );
		m_weaponAttachmentSource = effectorRecord.WeaponAttachmentSource();
		m_attackPackage = effectorRecord.AttackPackage();
	}

	protected override function RepeatedAction( owner : GameObject )
	{
		ActionOn( owner );
	}

	protected override function ActionOn( owner : GameObject )
	{
		var targetObjects : array< weak< GameObject > >;
		var i : Int32;
		var targetWeapon : WeaponObject;
		if( !( GetApplicationTarget( owner, 'Weapon', targetObjects ) ) )
		{
			return;
		}
		for( i = 0; i < targetObjects.Size(); i += 1 )
		{
			targetWeapon = ( ( WeaponObject )( targetObjects[ i ] ) );
			if( targetWeapon && HasRequiredAttachmentMod( targetWeapon ) )
			{
				targetWeapon.OverrideRangedAttackPackage( m_attackPackage );
			}
		}
	}

	protected override function ActionOff( owner : GameObject )
	{
		var targetObjects : array< weak< GameObject > >;
		var i : Int32;
		var targetWeapon : WeaponObject;
		if( !( GetApplicationTarget( owner, 'Weapon', targetObjects ) ) )
		{
			return;
		}
		for( i = 0; i < targetObjects.Size(); i += 1 )
		{
			targetWeapon = ( ( WeaponObject )( targetObjects[ i ] ) );
			if( targetWeapon )
			{
				targetWeapon.DefaultRangedAttackPackage();
			}
		}
	}

	private function HasRequiredAttachmentMod( weaponObject : WeaponObject ) : Bool
	{
		var weaponParts : array< InnerItemData >;
		var j : Int32;
		if( m_weaponAttachmentSource.GetID() == T"" )
		{
			return true;
		}
		weaponObject.GetItemData().GetItemParts( weaponParts );
		for( j = 0; j < weaponParts.Size(); j += 1 )
		{
			if( ItemID.GetTDBID( InnerItemData.GetItemID( weaponParts[ j ] ) ) == m_weaponAttachmentSource.GetID() )
			{
				return true;
			}
		}
		return false;
	}

}

