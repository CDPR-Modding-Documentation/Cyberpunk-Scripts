class ApplyShaderOnObjectEffector extends Effector
{
	private var m_applicationTargetName : CName;
	private var m_applicationTargets : array< weak< GameObject > >;
	private var m_effects : array< EffectInstance >;
	private var m_overrideMaterialName : CName;
	private var m_overrideMaterialTag : CName;
	private var m_overrideMaterialClearOnDetach : Bool;
	private var m_owner : weak< GameObject >;
	private var m_ownerEffect : EffectInstance;

	protected override function Initialize( record : TweakDBID, game : GameInstance, parentRecord : TweakDBID )
	{
		m_applicationTargetName = TweakDBInterface.GetCName( record + T".applicationTarget", '' );
		m_overrideMaterialName = TweakDBInterface.GetCName( record + T".overrideMaterialName", '' );
		m_overrideMaterialTag = TweakDBInterface.GetCName( record + T".overrideMaterialTag", '' );
		m_overrideMaterialClearOnDetach = TweakDBInterface.GetBool( record + T".overrideMaterialClearOnDetach", false );
	}

	protected override function ActionOn( owner : GameObject )
	{
		var effectInstance : EffectInstance;
		var i : Int32;
		m_owner = owner;
		GetApplicationTarget( m_owner, m_applicationTargetName, m_applicationTargets );
		for( i = 0; i < m_applicationTargets.Size(); i += 1 )
		{
			effectInstance = GameInstance.GetGameEffectSystem( m_owner.GetGame() ).CreateEffectStatic( m_overrideMaterialName, m_overrideMaterialTag, m_owner );
			if( ( effectInstance && IsNameValid( m_overrideMaterialName ) ) && m_applicationTargets[ i ] )
			{
				EffectData.SetBool( effectInstance.GetSharedData(), GetAllBlackboardDefs().EffectSharedData.enable, true );
				EffectData.SetBool( effectInstance.GetSharedData(), GetAllBlackboardDefs().EffectSharedData.clearMaterialOverlayOnDetach, m_overrideMaterialClearOnDetach );
				EffectData.SetEntity( effectInstance.GetSharedData(), GetAllBlackboardDefs().EffectSharedData.entity, m_applicationTargets[ i ] );
				effectInstance.Run();
			}
		}
	}

	protected override function ActionOff( owner : GameObject )
	{
		var effectInstance : EffectInstance;
		var i : Int32;
		for( i = 0; i < m_applicationTargets.Size(); i += 1 )
		{
			effectInstance = GameInstance.GetGameEffectSystem( m_owner.GetGame() ).CreateEffectStatic( m_overrideMaterialName, m_overrideMaterialTag, m_owner );
			if( ( effectInstance && IsNameValid( m_overrideMaterialName ) ) && m_applicationTargets[ i ] )
			{
				EffectData.SetBool( effectInstance.GetSharedData(), GetAllBlackboardDefs().EffectSharedData.enable, false );
				EffectData.SetEntity( effectInstance.GetSharedData(), GetAllBlackboardDefs().EffectSharedData.entity, m_applicationTargets[ i ] );
				effectInstance.Run();
			}
		}
	}

	protected override function Uninitialize( game : GameInstance )
	{
		var effectInstance : EffectInstance;
		var i : Int32;
		for( i = 0; i < m_applicationTargets.Size(); i += 1 )
		{
			effectInstance = GameInstance.GetGameEffectSystem( m_owner.GetGame() ).CreateEffectStatic( m_overrideMaterialName, m_overrideMaterialTag, m_owner );
			if( ( effectInstance && IsNameValid( m_overrideMaterialName ) ) && m_applicationTargets[ i ] )
			{
				EffectData.SetBool( effectInstance.GetSharedData(), GetAllBlackboardDefs().EffectSharedData.enable, false );
				EffectData.SetEntity( effectInstance.GetSharedData(), GetAllBlackboardDefs().EffectSharedData.entity, m_applicationTargets[ i ] );
				effectInstance.Run();
			}
		}
	}

}

