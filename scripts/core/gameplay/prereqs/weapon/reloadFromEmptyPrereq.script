class ReloadFromEmptyPrereqState extends PrereqState
{
	var m_owner : weak< GameObject >;
	var m_minAmountOfAmmoReloaded : Int32;
	var m_listenerRightWeaponInt : CallbackHandle;
	var m_listenerEquipmentRight : CallbackHandle;
	var m_listenerLeftWeaponInt : CallbackHandle;
	var m_listenerEquipmentLeft : CallbackHandle;
	private var m_reloadingInProgressRight : Bool;
	private var m_reloadingInProgressLeft : Bool;

	protected event OnWeaponStateUpdateRight( value : Int32 )
	{
		var weaponObj : WeaponObject;
		if( ( ( gamePSMRangedWeaponStates )( value ) ) == gamePSMRangedWeaponStates.Reload )
		{
			weaponObj = ScriptedPuppet.GetRightActiveWeapon( m_owner );
			if( WeaponObject.GetMagazineAmmoCount( weaponObj ) == 0 )
			{
				m_reloadingInProgressRight = true;
			}
			OnChanged( false );
		}
		else if( m_reloadingInProgressRight )
		{
			m_reloadingInProgressRight = false;
			weaponObj = ScriptedPuppet.GetRightActiveWeapon( m_owner );
			OnChanged( ( ( Int32 )( WeaponObject.GetMagazineAmmoCount( weaponObj ) ) ) >= m_minAmountOfAmmoReloaded );
		}
	}

	protected event OnWeaponStateUpdateLeft( value : Int32 )
	{
		var weaponObj : WeaponObject;
		if( ( ( gamePSMRangedWeaponStates )( value ) ) == gamePSMRangedWeaponStates.Reload )
		{
			weaponObj = ScriptedPuppet.GetLeftActiveWeapon( m_owner );
			if( WeaponObject.GetMagazineAmmoCount( weaponObj ) == 0 )
			{
				m_reloadingInProgressLeft = true;
			}
			OnChanged( false );
		}
		else if( m_reloadingInProgressLeft )
		{
			m_reloadingInProgressLeft = false;
			weaponObj = ScriptedPuppet.GetLeftActiveWeapon( m_owner );
			OnChanged( ( ( Int32 )( WeaponObject.GetMagazineAmmoCount( weaponObj ) ) ) >= m_minAmountOfAmmoReloaded );
		}
	}

	protected event OnInventoryChangeStateUpdate( value : Int32 )
	{
		m_reloadingInProgressRight = false;
		m_reloadingInProgressLeft = false;
		OnChanged( false );
	}

}

class ReloadFromEmptyPrereq extends IScriptablePrereq
{
	private var m_minAmountOfAmmoReloaded : Int32;
	private var m_listenedWeapons : array< String >;

	protected export override function Initialize( recordID : TweakDBID )
	{
		m_minAmountOfAmmoReloaded = TDB.GetInt( recordID + T".minAmountOfAmmoReloaded" );
		m_listenedWeapons = TDB.GetStringArray( recordID + T".listenedWeapons" );
	}

	protected const override function OnRegister( state : PrereqState, game : GameInstance, context : IScriptable ) : Bool
	{
		var bb : IBlackboard;
		var castedState : ReloadFromEmptyPrereqState;
		var player : PlayerPuppet;
		player = ( ( PlayerPuppet )( context ) );
		if( player )
		{
			castedState = ( ( ReloadFromEmptyPrereqState )( state ) );
			castedState.m_owner = ( ( GameObject )( context ) );
			castedState.m_minAmountOfAmmoReloaded = m_minAmountOfAmmoReloaded;
			if( m_listenedWeapons.Contains( "WeaponRight" ) )
			{
				bb = player.GetPlayerStateMachineBlackboard();
				castedState.m_listenerRightWeaponInt = bb.RegisterListenerInt( GetAllBlackboardDefs().PlayerStateMachine.RightWeapon, castedState, 'OnWeaponStateUpdateRight' );
				castedState.m_listenerEquipmentRight = bb.RegisterListenerInt( GetAllBlackboardDefs().PlayerStateMachine.EquipmentRight, castedState, 'OnInventoryChangeStateUpdate' );
			}
			if( m_listenedWeapons.Contains( "WeaponLeft" ) )
			{
				bb = player.GetPlayerStateMachineBlackboard();
				castedState.m_listenerLeftWeaponInt = bb.RegisterListenerInt( GetAllBlackboardDefs().PlayerStateMachine.LeftWeapon, castedState, 'OnWeaponStateUpdateLeft' );
				castedState.m_listenerEquipmentLeft = bb.RegisterListenerInt( GetAllBlackboardDefs().PlayerStateMachine.EquipmentLeft, castedState, 'OnInventoryChangeStateUpdate' );
			}
		}
		return false;
	}

	protected const override function OnUnregister( state : PrereqState, game : GameInstance, context : IScriptable )
	{
		var bb : IBlackboard;
		var castedState : ReloadFromEmptyPrereqState;
		var player : PlayerPuppet;
		player = ( ( PlayerPuppet )( context ) );
		if( player )
		{
			castedState = ( ( ReloadFromEmptyPrereqState )( state ) );
			bb = player.GetPlayerStateMachineBlackboard();
			if( castedState.m_listenerRightWeaponInt )
			{
				bb.UnregisterListenerInt( GetAllBlackboardDefs().PlayerStateMachine.RightWeapon, castedState.m_listenerRightWeaponInt );
			}
			if( castedState.m_listenerLeftWeaponInt )
			{
				bb.UnregisterListenerInt( GetAllBlackboardDefs().PlayerStateMachine.LeftWeapon, castedState.m_listenerLeftWeaponInt );
			}
			if( castedState.m_listenerEquipmentRight )
			{
				bb.UnregisterListenerInt( GetAllBlackboardDefs().PlayerStateMachine.EquipmentRight, castedState.m_listenerEquipmentRight );
			}
			if( castedState.m_listenerEquipmentLeft )
			{
				bb.UnregisterListenerInt( GetAllBlackboardDefs().PlayerStateMachine.EquipmentLeft, castedState.m_listenerEquipmentLeft );
			}
		}
	}

	protected const override function OnApplied( state : PrereqState, game : GameInstance, context : IScriptable )
	{
		var player : PlayerPuppet;
		var castedState : ReloadFromEmptyPrereqState;
		player = ( ( PlayerPuppet )( context ) );
		if( player )
		{
			castedState = ( ( ReloadFromEmptyPrereqState )( state ) );
			castedState.OnChanged( false );
		}
	}

}

