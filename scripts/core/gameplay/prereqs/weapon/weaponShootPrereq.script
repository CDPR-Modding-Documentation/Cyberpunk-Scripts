class WeaponShootPrereqState extends PrereqState
{
	var m_listenerRightWeaponInt : CallbackHandle;
	var m_listenerActiveRightWeaponVariant : CallbackHandle;
	var m_rightWeaponObj : weak< WeaponObject >;
	var m_listenerLeftWeaponInt : CallbackHandle;
	var m_listenerActiveLeftWeaponVariant : CallbackHandle;
	var m_leftWeaponObj : weak< WeaponObject >;
	var m_listenerOnShootVariant : CallbackHandle;
	var m_owner : weak< GameObject >;
	var m_howManyAttacks : Int32;
	var m_remainingAttacks : Int32;

	public function CheckIfPlayerWeaponChanged()
	{
		var weaponObj : WeaponObject;
		weaponObj = ScriptedPuppet.GetWeaponRight( m_owner );
		if( weaponObj != m_rightWeaponObj )
		{
			m_rightWeaponObj = weaponObj;
			m_remainingAttacks = m_howManyAttacks;
		}
		weaponObj = ScriptedPuppet.GetWeaponLeft( m_owner );
		if( weaponObj != m_leftWeaponObj )
		{
			m_leftWeaponObj = weaponObj;
			m_remainingAttacks = m_howManyAttacks;
		}
	}

	protected event OnWeaponStateUpdate( value : Int32 )
	{
		var checkPassed : Bool;
		const var prereq : WeaponShootPrereq;
		prereq = ( ( WeaponShootPrereq )( GetPrereq() ) );
		CheckIfPlayerWeaponChanged();
		if( ( ( gamePSMRangedWeaponStates )( value ) ) == gamePSMRangedWeaponStates.Reload )
		{
			m_remainingAttacks = m_howManyAttacks;
		}
		checkPassed = prereq.Evaluate( m_owner, m_remainingAttacks );
		OnChanged( checkPassed );
	}

	protected event OnInventoryChangeStateUpdate( value : Variant )
	{
		var checkPassed : Bool;
		const var prereq : WeaponShootPrereq;
		prereq = ( ( WeaponShootPrereq )( GetPrereq() ) );
		CheckIfPlayerWeaponChanged();
		checkPassed = prereq.Evaluate( m_owner, m_remainingAttacks );
		OnChanged( checkPassed );
	}

	protected event OnShoot( value : Variant )
	{
		var checkPassed : Bool;
		const var prereq : WeaponShootPrereq;
		prereq = ( ( WeaponShootPrereq )( GetPrereq() ) );
		CheckIfPlayerWeaponChanged();
		m_remainingAttacks -= 1;
		checkPassed = prereq.Evaluate( m_owner, m_remainingAttacks );
		OnChanged( checkPassed );
	}

}

class WeaponShootPrereq extends IScriptablePrereq
{
	var m_howManyAttacks : Int32;

	protected export override function Initialize( recordID : TweakDBID )
	{
		m_howManyAttacks = TweakDBInterface.GetInt( recordID + T".howManyShots", 0 );
	}

	public const function Evaluate( owner : GameObject, remainingAttacks : Int32 ) : Bool
	{
		if( remainingAttacks < 0 )
		{
			return false;
		}
		return true;
	}

	protected const override function OnRegister( state : PrereqState, game : GameInstance, context : IScriptable ) : Bool
	{
		var bb : IBlackboard;
		var castedState : WeaponShootPrereqState;
		var player : PlayerPuppet;
		castedState = ( ( WeaponShootPrereqState )( state ) );
		castedState.m_howManyAttacks = m_howManyAttacks;
		castedState.m_owner = ( ( GameObject )( context ) );
		player = ( ( PlayerPuppet )( context ) );
		if( player )
		{
			bb = player.GetPlayerStateMachineBlackboard();
			castedState.m_listenerRightWeaponInt = bb.RegisterListenerInt( GetAllBlackboardDefs().PlayerStateMachine.RightWeapon, castedState, 'OnWeaponStateUpdate' );
			castedState.m_listenerLeftWeaponInt = bb.RegisterListenerInt( GetAllBlackboardDefs().PlayerStateMachine.LeftWeapon, castedState, 'OnWeaponStateUpdate' );
			bb = GameInstance.GetBlackboardSystem( game ).Get( GetAllBlackboardDefs().UI_ActiveWeaponData );
			castedState.m_listenerActiveRightWeaponVariant = bb.RegisterListenerVariant( GetAllBlackboardDefs().UI_ActiveWeaponData.RightWeaponRecordID, castedState, 'OnInventoryChangeStateUpdate' );
			castedState.m_listenerActiveLeftWeaponVariant = bb.RegisterListenerVariant( GetAllBlackboardDefs().UI_ActiveWeaponData.LeftWeaponRecordID, castedState, 'OnInventoryChangeStateUpdate' );
			castedState.m_listenerOnShootVariant = bb.RegisterListenerVariant( GetAllBlackboardDefs().UI_ActiveWeaponData.ShootEvent, castedState, 'OnShoot' );
		}
		return false;
	}

	protected const override function OnUnregister( state : PrereqState, game : GameInstance, context : IScriptable )
	{
		var bb : IBlackboard;
		var castedState : WeaponShootPrereqState;
		var player : PlayerPuppet;
		player = ( ( PlayerPuppet )( context ) );
		if( player )
		{
			castedState = ( ( WeaponShootPrereqState )( state ) );
			bb = player.GetPlayerStateMachineBlackboard();
			if( castedState.m_listenerRightWeaponInt )
			{
				bb.UnregisterListenerInt( GetAllBlackboardDefs().PlayerStateMachine.RightWeapon, castedState.m_listenerRightWeaponInt );
			}
			if( castedState.m_listenerLeftWeaponInt )
			{
				bb.UnregisterListenerInt( GetAllBlackboardDefs().PlayerStateMachine.LeftWeapon, castedState.m_listenerLeftWeaponInt );
			}
			bb = GameInstance.GetBlackboardSystem( game ).Get( GetAllBlackboardDefs().UI_ActiveWeaponData );
			if( castedState.m_listenerActiveRightWeaponVariant )
			{
				bb.UnregisterListenerVariant( GetAllBlackboardDefs().UI_ActiveWeaponData.RightWeaponRecordID, castedState.m_listenerActiveRightWeaponVariant );
			}
			if( castedState.m_listenerActiveLeftWeaponVariant )
			{
				bb.UnregisterListenerVariant( GetAllBlackboardDefs().UI_ActiveWeaponData.LeftWeaponRecordID, castedState.m_listenerActiveLeftWeaponVariant );
			}
			if( castedState.m_listenerOnShootVariant )
			{
				bb.UnregisterListenerVariant( GetAllBlackboardDefs().UI_ActiveWeaponData.ShootEvent, castedState.m_listenerOnShootVariant );
			}
		}
	}

	protected const override function OnApplied( state : PrereqState, game : GameInstance, context : IScriptable )
	{
		var player : PlayerPuppet;
		var castedState : WeaponShootPrereqState;
		player = ( ( PlayerPuppet )( context ) );
		if( player )
		{
			castedState.OnChanged( true );
		}
	}

}

