class ORHitPrereqCondition extends BaseHitPrereqCondition
{
	var m_conditions : array< BaseHitPrereqCondition >;

	public override function SetData( recordID : TweakDBID )
	{
		var i : Int32;
		var conds : array< TweakDBID >;
		var condition : BaseHitPrereqCondition;
		m_conditions.Clear();
		conds = TweakDBInterface.GetForeignKeyArray( recordID + T".conditions" );
		for( i = 0; i < conds.Size(); i += 1 )
		{
			condition = GenericHitPrereq.CreateHitCondition( TweakDBInterface.GetHitPrereqConditionRecord( conds[ i ] ) );
			if( condition )
			{
				m_conditions.PushBack( condition );
			}
		}
	}

	public override function Evaluate( hitEvent : gameHitEvent ) : Bool
	{
		var result : Bool;
		var i : Int32;
		result = false;
		for( i = 0; i < m_conditions.Size(); i += 1 )
		{
			result = m_conditions[ i ].Evaluate( hitEvent );
			if( result )
			{
				result = CheckOnlyOncePerShot( hitEvent );
				break;
			}
		}
		return ( ( m_invert ) ? ( !( result ) ) : ( result ) );
	}

}

