class WeaponSlotHitPrereqCondition extends BaseHitPrereqCondition
{
	var m_weaponAttachmentSlotID : TweakDBID;

	public override function SetData( recordID : TweakDBID )
	{
		m_weaponAttachmentSlotID = TweakDBInterface.GetForeignKey( recordID + T".attachmentSlot", T"" );
		super.SetData( recordID );
	}

	public override function Evaluate( hitEvent : gameHitEvent ) : Bool
	{
		var slotRecordID : TweakDBID;
		slotRecordID = hitEvent.attackData.GetWeapon().GetAttachedSlotID();
		return slotRecordID == m_weaponAttachmentSlotID;
	}

}

