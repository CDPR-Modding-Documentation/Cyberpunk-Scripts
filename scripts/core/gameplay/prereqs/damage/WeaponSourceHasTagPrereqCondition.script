class WeaponSourceHasTagPrereqCondition extends BaseHitPrereqCondition
{
	var m_tagToCheck : CName;

	public override function SetData( recordID : TweakDBID )
	{
		m_tagToCheck = TweakDBInterface.GetCNameDefault( recordID + T".tagToCheck" );
		super.SetData( recordID );
	}

	public override function Evaluate( hitEvent : gameHitEvent ) : Bool
	{
		var hasTag : Bool;
		hasTag = hitEvent.attackData.GetWeapon().GetWeaponRecord().TagsContains( m_tagToCheck );
		return hasTag;
	}

}

