class weaponSourceHasModWithTagPrereqCondition extends BaseHitPrereqCondition
{
	var m_weaponRecordID : TweakDBID;
	var m_requierdModTag : CName;

	public override function SetData( recordID : TweakDBID )
	{
		m_weaponRecordID = TweakDBInterface.GetForeignKey( recordID + T".weaponRecordID", T"" );
		m_requierdModTag = TweakDBInterface.GetCName( recordID + T".requiredModTag", '' );
		super.SetData( recordID );
	}

	public override function Evaluate( hitEvent : gameHitEvent ) : Bool
	{
		return HasRequiredAttachmentMod( hitEvent.attackData.GetWeapon() );
	}

	private function HasRequiredAttachmentMod( weaponObject : WeaponObject ) : Bool
	{
		var weaponParts : array< InnerItemData >;
		var j : Int32;
		if( m_requierdModTag == '' )
		{
			return true;
		}
		weaponObject.GetItemData().GetItemParts( weaponParts );
		for( j = 0; j < weaponParts.Size(); j += 1 )
		{
			if( TweakDBInterface.GetItemRecord( ItemID.GetTDBID( InnerItemData.GetItemID( weaponParts[ j ] ) ) ).TagsContains( m_requierdModTag ) )
			{
				return true;
			}
		}
		return false;
	}

}

