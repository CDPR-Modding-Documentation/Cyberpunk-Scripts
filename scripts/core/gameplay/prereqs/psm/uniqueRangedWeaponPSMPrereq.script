class UniqueRangedWeaponPSMPrereqState extends PlayerStateMachinePrereqState
{
	var m_listenedID : BlackboardID_Int;
}

class UniqueRangedWeaponPSMPrereq extends PlayerStateMachinePrereq
{
	var m_weaponRequiredTag : CName;

	protected export const override function OnRegister( state : PrereqState, game : GameInstance, context : IScriptable ) : Bool
	{
		var bb : IBlackboard;
		var castedState : UniqueRangedWeaponPSMPrereqState;
		bb = GameInstance.GetBlackboardSystem( game ).GetLocalInstanced( ( ( ScriptedPuppet )( context ) ).GetEntityID(), GetAllBlackboardDefs().PlayerStateMachine );
		castedState = ( ( UniqueRangedWeaponPSMPrereqState )( state ) );
		castedState.m_owner = ( ( GameObject )( context ) );
		castedState.m_listenedID = GetCorrespondingWeapon( context );
		castedState.m_prevValue = bb.GetInt( castedState.m_listenedID );
		castedState.m_listenerInt = bb.RegisterListenerInt( castedState.m_listenedID, castedState, 'OnStateUpdate' );
		return false;
	}

	protected export const override function OnUnregister( state : PrereqState, game : GameInstance, context : IScriptable )
	{
		var bb : IBlackboard;
		var castedState : UniqueRangedWeaponPSMPrereqState;
		bb = GameInstance.GetBlackboardSystem( game ).GetLocalInstanced( ( ( ScriptedPuppet )( context ) ).GetEntityID(), GetAllBlackboardDefs().PlayerStateMachine );
		castedState = ( ( UniqueRangedWeaponPSMPrereqState )( state ) );
		bb.UnregisterListenerInt( castedState.m_listenedID, castedState.m_listenerInt );
	}

	public export const override function IsFulfilled( game : GameInstance, context : IScriptable ) : Bool
	{
		var bb : IBlackboard;
		var owner : weak< GameObject >;
		var checkPassed : Bool;
		var listenedID : BlackboardID_Int;
		owner = ( ( GameObject )( context ) );
		bb = GameInstance.GetBlackboardSystem( owner.GetGame() ).GetLocalInstanced( ( ( ScriptedPuppet )( context ) ).GetEntityID(), GetAllBlackboardDefs().PlayerStateMachine );
		if( !( bb ) )
		{
			return false;
		}
		listenedID = GetCorrespondingWeapon( context );
		checkPassed = Evaluate( owner, bb.GetInt( listenedID ), bb.GetInt( listenedID ) );
		return checkPassed;
	}

	protected export override function Initialize( recordID : TweakDBID )
	{
		super.Initialize( recordID );
		m_weaponRequiredTag = TweakDBInterface.GetCNameDefault( recordID + T".weaponRequiredTag" );
	}

	protected const override function GetStateMachineEnum() : String
	{
		return "gamePSMRangedWeaponStates";
	}

	private const function GetCorrespondingWeapon( context : IScriptable ) : BlackboardID_Int
	{
		var leftWeapon : WeaponObject;
		leftWeapon = GameObject.GetLeftActiveWeapon( ( ( GameObject )( context ) ) );
		if( leftWeapon )
		{
			if( leftWeapon.GetWeaponRecord().TagsContains( m_weaponRequiredTag ) )
			{
				return GetAllBlackboardDefs().PlayerStateMachine.LeftWeapon;
			}
		}
		return GetAllBlackboardDefs().PlayerStateMachine.RightWeapon;
	}

}

