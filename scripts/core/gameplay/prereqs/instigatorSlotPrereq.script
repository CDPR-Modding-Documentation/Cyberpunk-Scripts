class InstigatorSlotPrereqState extends PrereqState
{
	var m_instigator : weak< WeaponObject >;
}

class InstigatorSlotPrereq extends IScriptablePrereq
{
	var m_slot : TweakDBID;

	protected export override function Initialize( recordID : TweakDBID )
	{
		m_slot = TDB.GetForeignKey( recordID + T".slot" );
	}

	protected export const override function OnRegister( state : PrereqState, game : GameInstance, context : IScriptable, instigator : IScriptable ) : Bool
	{
		var castedState : InstigatorSlotPrereqState;
		var instigatorSlot : TweakDBID;
		castedState = ( ( InstigatorSlotPrereqState )( state ) );
		castedState.m_instigator = ( ( WeaponObject )( instigator ) );
		if( castedState.m_instigator )
		{
			instigatorSlot = castedState.m_instigator.GetAttachedSlotID();
			return instigatorSlot == m_slot;
		}
		return false;
	}

}

