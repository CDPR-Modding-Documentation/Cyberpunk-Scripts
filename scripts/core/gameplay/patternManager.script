class PatternManager
{
	private var m_player : weak< PlayerPuppet >;
	private var m_isLightRumbleOn : Bool;

	public function OnPlayerAttach( player : PlayerPuppet )
	{
		m_player = player;
	}

	public function OnPlayerDetach( player : PlayerPuppet ) {}

	public static function SetupMotionControlsSettings( gameInstance : GameInstance )
	{
		var patternMatchingGrpName : CName;
		var patternMatchingIsEnabled : ConfigVarBool;
		var patternMatchingIsEnabledVal : Bool;
		var patternMatchingPreStyle : ConfigVarListString;
		var mouserIsEnabled : ConfigVarListString;
		var gyroAimingActivationModeStyleDualGrip : ConfigVarListString;
		var patternMatchingModeStyleDualGripGyroAlwaysOn : ConfigVarListString;
		var patternMatchingModeStyleDualGripGyroRanged : ConfigVarListString;
		var patternMatchingModeStyleDualGripGyroOnAiming : ConfigVarListString;
		var patternMatchingModeStyleDualGripGyroDisabled : ConfigVarListString;
		var patternMatchingModeStyleDisabledWithDescription : ConfigVarListString;
		var userSettings : UserSettings;
		var questSystem : QuestsSystem;
		var isPlayerInGyroTutorial : Bool;
		var inputSchemesBB : IBlackboard;
		var activeStyle : CName;
		var playerPuppet : PlayerPuppet;
		patternMatchingGrpName = '/controls';
		questSystem = GameInstance.GetQuestsSystem( gameInstance );
		userSettings = GameInstance.GetSettingsSystem( gameInstance );
		if( userSettings.GetUserSettingsLoadStatus() == UserSettingsLoadStatus.NotLoaded )
		{
			return;
		}
		playerPuppet = ( ( PlayerPuppet )( GameInstance.GetPlayerSystem( gameInstance ).GetLocalPlayerControlledGameObject() ) );
		( ( ConfigVarListString )( GameInstance.GetSettingsSystem( gameInstance ).GetVar( '/gameplay/difficulty', 'GameDifficulty' ) ) ).SetEnabled( !( playerPuppet.IsInReplayTutorial() ) );
		if( GetPlatformShortName() != "emporium" )
		{
			questSystem.SetFact( 'q000_vr_tutorial_gyro_choice_enabled', 0 );
			return;
		}
		questSystem.SetFact( 'q000_vr_tutorial_gyro_choice_enabled', 1 );
		patternMatchingPreStyle = ( ( ConfigVarListString )( userSettings.GetVar( patternMatchingGrpName, 'PreSelectedStyle' ) ) );
		mouserIsEnabled = ( ( ConfigVarListString )( userSettings.GetVar( patternMatchingGrpName, 'JcmsActivationMode' ) ) );
		gyroAimingActivationModeStyleDualGrip = ( ( ConfigVarListString )( userSettings.GetVar( patternMatchingGrpName, 'GyroAimingActivationModeStyleDualGrip' ) ) );
		patternMatchingModeStyleDualGripGyroAlwaysOn = ( ( ConfigVarListString )( userSettings.GetVar( patternMatchingGrpName, 'PatternMatchingModeStyleDualGripGyroAlwaysOn' ) ) );
		patternMatchingModeStyleDualGripGyroRanged = ( ( ConfigVarListString )( userSettings.GetVar( patternMatchingGrpName, 'PatternMatchingModeStyleDualGripGyroRanged' ) ) );
		patternMatchingModeStyleDualGripGyroOnAiming = ( ( ConfigVarListString )( userSettings.GetVar( patternMatchingGrpName, 'PatternMatchingModeStyleDualGripGyroOnAiming' ) ) );
		patternMatchingModeStyleDualGripGyroDisabled = ( ( ConfigVarListString )( userSettings.GetVar( patternMatchingGrpName, 'PatternMatchingModeStyleDualGripGyroDisabled' ) ) );
		patternMatchingIsEnabled = ( ( ConfigVarBool )( userSettings.GetVar( patternMatchingGrpName, 'PatternMatchingIsEnabled' ) ) );
		if( patternMatchingIsEnabled.GetValue() )
		{
			EmporiumSettingsManager.SetPatternMatchingUnlocked( true );
		}
		patternMatchingIsEnabledVal = EmporiumSettingsManager.HasPatternMatchingUnlocked();
		patternMatchingPreStyle.SetEnabled( true );
		gyroAimingActivationModeStyleDualGrip.SetEnabled( true );
		patternMatchingModeStyleDualGripGyroAlwaysOn.SetEnabled( true );
		patternMatchingModeStyleDualGripGyroRanged.SetEnabled( true );
		patternMatchingModeStyleDualGripGyroOnAiming.SetEnabled( true );
		patternMatchingModeStyleDualGripGyroDisabled.SetEnabled( true );
		isPlayerInGyroTutorial = playerPuppet.IsInGyroTutorial();
		if( isPlayerInGyroTutorial )
		{
			patternMatchingPreStyle.SetIndex( 2 );
			mouserIsEnabled.SetIndex( 0 );
			gyroAimingActivationModeStyleDualGrip.SetIndex( 1 );
			patternMatchingModeStyleDualGripGyroAlwaysOn.SetIndex( 0 );
			patternMatchingModeStyleDualGripGyroRanged.SetIndex( 1 );
			patternMatchingModeStyleDualGripGyroOnAiming.SetIndex( 1 );
			patternMatchingModeStyleDualGripGyroDisabled.SetIndex( 1 );
			patternMatchingPreStyle.SetEnabled( false );
			gyroAimingActivationModeStyleDualGrip.SetEnabled( false );
		}
		else
		{
			inputSchemesBB = GameInstance.GetBlackboardSystem( gameInstance ).Get( GetAllBlackboardDefs().InputSchemes );
			if( inputSchemesBB )
			{
				activeStyle = inputSchemesBB.GetName( GetAllBlackboardDefs().InputSchemes.ActiveStyle );
				patternMatchingPreStyle.SetIndex( ConvertCNameIntoStyleSettingsIndex( activeStyle ) );
			}
		}
		if( !( patternMatchingIsEnabledVal ) )
		{
			patternMatchingModeStyleDisabledWithDescription = ( ( ConfigVarListString )( userSettings.GetVar( patternMatchingGrpName, 'PatternMatchingModeStyleDisabledStateWithDescription' ) ) );
			patternMatchingModeStyleDisabledWithDescription.SetEnabled( true );
			patternMatchingModeStyleDisabledWithDescription.SetIndex( ( ( isPlayerInGyroTutorial ) ? ( 1 ) : ( 2 ) ) );
			patternMatchingModeStyleDisabledWithDescription.SetEnabled( false );
			if( !( isPlayerInGyroTutorial ) )
			{
				patternMatchingModeStyleDualGripGyroAlwaysOn.SetIndex( 1 );
				patternMatchingModeStyleDualGripGyroRanged.SetIndex( 2 );
				patternMatchingModeStyleDualGripGyroOnAiming.SetIndex( 2 );
				patternMatchingModeStyleDualGripGyroDisabled.SetIndex( 2 );
			}
		}
		if( !( patternMatchingIsEnabledVal ) || isPlayerInGyroTutorial )
		{
			patternMatchingModeStyleDualGripGyroAlwaysOn.SetEnabled( false );
			patternMatchingModeStyleDualGripGyroRanged.SetEnabled( false );
			patternMatchingModeStyleDualGripGyroOnAiming.SetEnabled( false );
			patternMatchingModeStyleDualGripGyroDisabled.SetEnabled( false );
		}
	}

	public function TurnOnLightRumbleLoop()
	{
		if( m_isLightRumbleOn )
		{
			return;
		}
		GameObject.PlaySound( m_player, 'motion_loop_super_light_right_2d' );
		m_isLightRumbleOn = true;
	}

	public function TurnOffLightRumbleLoop()
	{
		if( !( m_isLightRumbleOn ) )
		{
			return;
		}
		GameObject.PlaySound( m_player, 'motion_loop_super_light_stop' );
		m_isLightRumbleOn = false;
	}

	public function HandleInputAction( action : ListenerAction, consumer : ListenerActionConsumer )
	{
		var simpleScreenMsg : SimpleScreenMessage;
		var notificationMessageType : BlackboardID_Variant;
		var currentPlayer : PlayerPuppet;
		var wasActionConsumed : Bool;
		simpleScreenMsg.isShown = true;
		simpleScreenMsg.isInstant = true;
		simpleScreenMsg.duration = 5.0;
		simpleScreenMsg.type = SimpleMessageType.Undefined;
		notificationMessageType = GetAllBlackboardDefs().UI_Notifications.OnscreenMessage;
		if( ListenerAction.IsButtonJustPressed( action ) )
		{
			if( ListenerAction.GetName( action ) == 'PatternMatchingToggleOn' )
			{
				simpleScreenMsg.message = "PATTERN MATCHING IS ON";
				GameInstance.GetBlackboardSystem( m_player.GetGame() ).Get( GetAllBlackboardDefs().UI_Notifications ).SetVariant( notificationMessageType, simpleScreenMsg, true );
			}
			else if( ListenerAction.GetName( action ) == 'PatternMatchingToggleOff' )
			{
				simpleScreenMsg.message = "PATTERN MATCHING IS OFF";
				GameInstance.GetBlackboardSystem( m_player.GetGame() ).Get( GetAllBlackboardDefs().UI_Notifications ).SetVariant( notificationMessageType, simpleScreenMsg, true );
			}
			else if( ListenerAction.GetName( action ) == 'GyroAimingToggleOn' )
			{
				simpleScreenMsg.message = "GYRO AIMING IS ON";
				GameInstance.GetBlackboardSystem( m_player.GetGame() ).Get( GetAllBlackboardDefs().UI_Notifications ).SetVariant( notificationMessageType, simpleScreenMsg, true );
			}
			else if( ListenerAction.GetName( action ) == 'GyroAimingToggleOff' )
			{
				simpleScreenMsg.message = "GYRO AIMING IS OFF";
				GameInstance.GetBlackboardSystem( m_player.GetGame() ).Get( GetAllBlackboardDefs().UI_Notifications ).SetVariant( notificationMessageType, simpleScreenMsg, true );
			}
		}
		currentPlayer = ( ( PlayerPuppet )( GameInstance.GetPlayerSystem( m_player.GetGame() ).GetLocalPlayerControlledGameObject() ) );
		if( currentPlayer.IsVRReplacer() && m_player.IsPatternMatchingOn() )
		{
			wasActionConsumed = ConsumeInputAction( currentPlayer, action, consumer );
		}
		if( ListenerAction.IsPatternJustActivated( action ) )
		{
			if( ( !( wasActionConsumed ) && GameObject.GetActiveWeapon( currentPlayer ).IsMelee() ) && ListenerAction.GetPatternTutorialName( action ) == 'MeleeAttack_Charge' )
			{
				TurnOnLightRumbleLoop();
			}
		}
		else if( ListenerAction.IsPatternJustDeactivated( action ) )
		{
			if( ( !( wasActionConsumed ) && GameObject.GetActiveWeapon( currentPlayer ).IsMelee() ) && ListenerAction.GetPatternTutorialName( action ) == 'MeleeAttack_Charge' )
			{
				TurnOffLightRumbleLoop();
			}
		}
	}

	private function ConsumeInputAction( player : PlayerPuppet, action : ListenerAction, consumer : ListenerActionConsumer ) : Bool
	{
		var consumeAction : Bool;
		var patternTutorialName : CName;
		var patternName : CName;
		var patternTutorialNameStr : String;
		var patternNameStr : String;
		var actionNameStr : String;
		var notificationEvent : UIInGameNotificationEvent;
		var questSystem : QuestsSystem;
		var allowOnlyPatternInputs : Bool;
		var blockDodgeAction : Bool;
		var equippedWeapon : WeaponObject;
		allowOnlyPatternInputs = StatusEffectSystem.ObjectHasStatusEffectWithTag( player, 'AllowOnlyMotionPatternInputs' );
		patternTutorialName = ListenerAction.GetPatternTutorialName( action );
		patternName = ListenerAction.GetPatternName( action );
		questSystem = GameInstance.GetQuestsSystem( m_player.GetGame() );
		blockDodgeAction = ( ( ( ( ( questSystem.GetFact( 'gyro_dodge_tutorial' ) == 0 ) && ( questSystem.GetFact( 'gyro_dodge_tutorial_seen' ) == 0 ) ) && ( questSystem.GetFact( 'gyro_dodge_left_tutorial' ) == 0 ) ) && ( questSystem.GetFact( 'gyro_dodge_left_tutorial_seen' ) == 0 ) ) && ( questSystem.GetFact( 'gyro_dodge_right_tutorial' ) == 0 ) ) && ( questSystem.GetFact( 'gyro_dodge_right_tutorial_seen' ) == 0 );
		if( ( patternName == 'None' && patternTutorialName == 'None' ) && allowOnlyPatternInputs )
		{
			actionNameStr = NameToString( ListenerAction.GetName( action ) );
			equippedWeapon = GameObject.GetActiveWeapon( player );
			if( ( ( ( ( equippedWeapon && equippedWeapon.IsMelee() ) && StrContains( actionNameStr, "MeleeAttack" ) ) || ( blockDodgeAction && StrContains( actionNameStr, "Dodge" ) ) ) || StrContains( actionNameStr, "Reload" ) ) || StrContains( actionNameStr, "UseConsumable" ) )
			{
				consumeAction = true;
			}
		}
		else
		{
			patternTutorialNameStr = NameToString( patternTutorialName );
			patternNameStr = NameToString( patternName );
			if( ( ( StrContains( patternTutorialNameStr, "MeleeAttack_Normal" ) || StrContains( patternNameStr, "Melee_Attack_Normal" ) ) && ( questSystem.GetFact( 'gyro_light_attack_tutorial' ) == 0 ) ) && ( questSystem.GetFact( 'gyro_light_attack_tutorial_seen' ) == 0 ) )
			{
				consumeAction = true;
			}
			else if( ( ( ( ( StrContains( patternTutorialNameStr, "MeleeAttack_Heavy" ) || StrContains( patternTutorialNameStr, "MeleeAttack_Charge" ) ) && ( questSystem.GetFact( 'gyro_strong_attack_tutorial' ) == 0 ) ) && ( questSystem.GetFact( 'gyro_strong_attack_tutorial_seen' ) == 0 ) ) && ( questSystem.GetFact( 'gyro_charged_attack_tutorial' ) == 0 ) ) && ( questSystem.GetFact( 'gyro_charged_attack_tutorial_seen' ) == 0 ) )
			{
				consumeAction = true;
			}
			else if( ( StrContains( patternTutorialNameStr, "Reload" ) && ( questSystem.GetFact( 'gyro_reload_tutorial' ) == 0 ) ) && ( questSystem.GetFact( 'gyro_reload_tutorial_seen' ) == 0 ) )
			{
				consumeAction = true;
			}
			else if( StrContains( patternTutorialNameStr, "Dodge" ) && blockDodgeAction )
			{
				consumeAction = true;
			}
			else if( ( StrContains( patternTutorialNameStr, "UseConsumable" ) && ( questSystem.GetFact( 'gyro_inhaler_tutorial' ) == 0 ) ) && ( questSystem.GetFact( 'gyro_inhaler_tutorial_seen' ) == 0 ) )
			{
				consumeAction = true;
			}
		}
		if( consumeAction )
		{
			ListenerActionConsumer.Consume( consumer );
			ListenerActionConsumer.ConsumeSingleAction( consumer );
			ListenerActionConsumer.DontSendReleaseEvent( consumer );
			notificationEvent = new UIInGameNotificationEvent;
			notificationEvent.m_notificationType = UIInGameNotificationType.ActionRestriction;
			GameInstance.GetUISystem( m_player.GetGame() ).QueueEvent( notificationEvent );
		}
		return consumeAction;
	}

}

importonly struct EmporiumSettingsManager
{
	public import static function SetPatternMatchingUnlocked( value : Bool );
	public import static function HasPatternMatchingUnlocked() : Bool;
}

