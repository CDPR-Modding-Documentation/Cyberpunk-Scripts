import enum InputDevice : Uint8
{
	KBM,
	PAD,
	TOUCH,
}

import enum InputScheme : Uint8
{
	LEGACY,
	AGILE,
	ALTERNATIVE,
	SWITCH_LEGACY,
}

function ConvertIntValueToInputScheme( valueToConvert : Uint32 ) : InputScheme
{
	var toReturn : InputScheme;
	toReturn = InputScheme.ALTERNATIVE;
	if( GetPlatformShortName() == "emporium" )
	{
		switch( valueToConvert )
		{
			case 0:
				toReturn = InputScheme.ALTERNATIVE;
			break;
			case 1:
				toReturn = InputScheme.SWITCH_LEGACY;
			break;
			default:
				break;
		}
	}
	else
	{
		switch( valueToConvert )
		{
			case 0:
				toReturn = InputScheme.LEGACY;
			break;
			case 1:
				toReturn = InputScheme.AGILE;
			break;
			case 2:
				toReturn = InputScheme.ALTERNATIVE;
			break;
			default:
				break;
		}
	}
	return toReturn;
}

function ConvertCNameIntoStyleSettingsIndex( valueToConvert : CName ) : Int32
{
	var toReturn : Int32;
	toReturn = 0;
	switch( NameToString( valueToConvert ) )
	{
		case "Handheld":
			toReturn = 0;
		break;
		case "FullKey":
			toReturn = 1;
		break;
		case "JoyDual":
			toReturn = 2;
		break;
		case "Mouser":
			toReturn = 3;
		break;
		default:
			break;
	}
	return toReturn;
}

