import enum gameModSettingType
{
	BooleanToggle,
	FloatSlider,
	IntSlider,
	KeybindsToggle,
	ComboToggle,
}

import class ModdingSystem extends IGameSystem
{
	public import function GetAllModsConfigsNames() : array< CName >;
	public import function GetAllModsConfigsTypes() : array< gameModSettingType >;
	public import function GetModsConfigValueByName( name : CName ) : Variant;
	public import function SetModsConfigValueByName( name : CName, value : Variant );
	public import function SaveCurrentConfigsValue();

	protected event OnWorldAttached()
	{
		return true;
	}

	protected event OnWorldDetached()
	{
		return true;
	}

}

