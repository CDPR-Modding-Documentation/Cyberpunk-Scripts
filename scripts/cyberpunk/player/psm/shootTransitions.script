abstract class ShootTransition extends DefaultTransition
{

	public static function GetRightWeapon( const scriptInterface : StateGameScriptInterface ) : WeaponObject
	{
		return ( ( WeaponObject )( scriptInterface.GetTransactionSystem().GetItemInSlot( scriptInterface.executionOwner, T"AttachmentSlots.WeaponRight" ) ) );
	}

	public static function GetLeftWeapon( const scriptInterface : StateGameScriptInterface ) : WeaponObject
	{
		return ( ( WeaponObject )( scriptInterface.GetTransactionSystem().GetItemInSlot( scriptInterface.executionOwner, T"AttachmentSlots.WeaponLeft" ) ) );
	}

	public static function GetRightWeaponBlackboard( const scriptInterface : StateGameScriptInterface ) : IBlackboard
	{
		return GetRightWeapon( scriptInterface ).GetSharedData();
	}

	public static function GetLeftWeaponBlackboard( const scriptInterface : StateGameScriptInterface ) : IBlackboard
	{
		return GetLeftWeapon( scriptInterface ).GetSharedData();
	}

	public static function GetRightWeaponCycleTime( const scriptInterface : StateGameScriptInterface ) : Float
	{
		return GameInstance.GetStatsSystem( scriptInterface.GetGame() ).GetStatValue( GetRightWeapon( scriptInterface ).GetEntityID(), gamedataStatType.CycleTime );
	}

	public static function GetLeftWeaponCycleTime( const scriptInterface : StateGameScriptInterface ) : Float
	{
		return GameInstance.GetStatsSystem( scriptInterface.GetGame() ).GetStatValue( GetLeftWeapon( scriptInterface ).GetEntityID(), gamedataStatType.CycleTime );
	}

	public static function IsRightWeaponReady( const stateContext : StateContext, scriptInterface : StateGameScriptInterface ) : Bool
	{
		var state : gamePSMRangedWeaponStates;
		state = GetRightWeaponState( scriptInterface );
		return ( HasRightWeaponEquipped( scriptInterface ) && !( IsRightHandChangingEquipState( stateContext ) ) ) && ( ( ( state == gamePSMRangedWeaponStates.Ready || state == gamePSMRangedWeaponStates.Shoot ) || state == gamePSMRangedWeaponStates.Charging ) || ( state == gamePSMRangedWeaponStates.Reload && !( IsReloadUninterruptible( stateContext, scriptInterface ) ) ) );
	}

	public static function IsLeftWeaponReady( const stateContext : StateContext, scriptInterface : StateGameScriptInterface ) : Bool
	{
		var state : gamePSMRangedWeaponStates;
		state = GetLeftWeaponState( scriptInterface );
		return ( HasLeftWeaponEquipped( scriptInterface ) && !( IsLeftHandChangingEquipState( stateContext ) ) ) && ( ( state == gamePSMRangedWeaponStates.Ready || state == gamePSMRangedWeaponStates.Shoot ) || state == gamePSMRangedWeaponStates.Charging );
	}

	public static function GetRightWeaponTriggerMode( scriptInterface : StateGameScriptInterface ) : gamedataTriggerMode
	{
		var triggerMode : gamedataTriggerMode;
		triggerMode = ( ( TriggerMode_Record )( GetRightWeaponBlackboard( scriptInterface ).GetVariant( GetAllBlackboardDefs().Weapon.TriggerMode ) ) ).Type();
		return triggerMode;
	}

	public static function GetLeftWeaponTriggerMode( scriptInterface : StateGameScriptInterface ) : gamedataTriggerMode
	{
		var triggerMode : gamedataTriggerMode;
		triggerMode = ( ( TriggerMode_Record )( GetLeftWeaponBlackboard( scriptInterface ).GetVariant( GetAllBlackboardDefs().Weapon.TriggerMode ) ) ).Type();
		return triggerMode;
	}

	protected static function IsReloadUninterruptible( const stateContext : StateContext, const scriptInterface : StateGameScriptInterface ) : Bool
	{
		return stateContext.GetBoolParameter( 'RightUninteruptibleReload', true );
	}

}

abstract class ExitToNextShootDecisionsBase extends ShootTransition
{
	protected var m_enteredStateVarName : CName;
	default m_enteredStateVarName = 'EnteredWithState';

	protected const function ShouldExitTo( toShootState : Int32, const stateContext : StateContext, const scriptInterface : StateGameScriptInterface ) : Bool
	{
		var enteredShootState : StateResultInt;
		enteredShootState = stateContext.GetPermanentIntParameter( m_enteredStateVarName );
		if( !( enteredShootState.valid ) )
		{
			return false;
		}
		return enteredShootState.value == toShootState;
	}

	protected const virtual function SmartExitCondition( const stateContext : StateContext, const scriptInterface : StateGameScriptInterface ) : Bool
	{
		return true;
	}

	protected export const virtual function ToLeftWeapon( const stateContext : StateContext, const scriptInterface : StateGameScriptInterface ) : Bool
	{
		var diff : Double;
		if( !( SmartExitCondition( stateContext, scriptInterface ) ) )
		{
			return false;
		}
		if( !( IsLeftWeaponReady( stateContext, scriptInterface ) ) )
		{
			return false;
		}
		diff = stateContext.GetDoubleParameter( 'LastShotTime', true ) - stateContext.GetDoubleParameter( 'LastSecondaryShotTime', true );
		if( AbsF( ( ( Float )( diff ) ) ) < 0.01 )
		{
			return ShouldExitTo( ( ( scriptInterface.IsActionJustReleased( 'RangedAttack' ) ) ? ( ( ( Int32 )( gamePSMShootStates.RightWeapon ) ) ) : ( ( ( Int32 )( gamePSMShootStates.LeftWeapon ) ) ) ), stateContext, scriptInterface );
		}
		return diff > 0.0;
	}

	protected export const virtual function ToRightWeapon( const stateContext : StateContext, const scriptInterface : StateGameScriptInterface ) : Bool
	{
		var diff : Double;
		if( !( SmartExitCondition( stateContext, scriptInterface ) ) )
		{
			return false;
		}
		if( !( IsRightWeaponReady( stateContext, scriptInterface ) ) )
		{
			return false;
		}
		diff = stateContext.GetDoubleParameter( 'LastShotTime', true ) - stateContext.GetDoubleParameter( 'LastSecondaryShotTime', true );
		if( AbsF( ( ( Float )( diff ) ) ) < 0.01 )
		{
			return ShouldExitTo( ( ( scriptInterface.IsActionJustReleased( 'RangedAttack' ) ) ? ( ( ( Int32 )( gamePSMShootStates.LeftWeapon ) ) ) : ( ( ( Int32 )( gamePSMShootStates.RightWeapon ) ) ) ), stateContext, scriptInterface );
		}
		return diff < 0.0;
	}

	protected export const virtual function ToBothWeapons( const stateContext : StateContext, const scriptInterface : StateGameScriptInterface ) : Bool
	{
		return SmartExitCondition( stateContext, scriptInterface ) && ShouldExitTo( ( ( Int32 )( gamePSMShootStates.BothWeapons ) ), stateContext, scriptInterface );
	}

	protected export const virtual function ToIdleShoot( const stateContext : StateContext, const scriptInterface : StateGameScriptInterface ) : Bool
	{
		if( !( SmartExitCondition( stateContext, scriptInterface ) ) )
		{
			return false;
		}
		if( !( HasRightWeaponEquipped( scriptInterface ) ) )
		{
			return true;
		}
		if( !( HasLeftWeaponEquipped( scriptInterface ) ) )
		{
			return true;
		}
		return ( !( ToRightWeapon( stateContext, scriptInterface ) ) && !( ToLeftWeapon( stateContext, scriptInterface ) ) ) && !( ToBothWeapons( stateContext, scriptInterface ) );
	}

}

class IdleShootDecisions extends ShootTransition
{

	protected event OnInventoryChangeStateUpdate( value : Variant )
	{
		EnableOnEnterCondition( true );
	}

	protected export const function EnterCondition( const stateContext : StateContext, const scriptInterface : StateGameScriptInterface ) : Bool
	{
		return !( IsRightWeaponReady( stateContext, scriptInterface ) ) && !( IsLeftWeaponReady( stateContext, scriptInterface ) );
	}

	protected export const function ToRightWeapon( const stateContext : StateContext, const scriptInterface : StateGameScriptInterface ) : Bool
	{
		return IsRightWeaponReady( stateContext, scriptInterface );
	}

	protected export const function ToLeftWeapon( const stateContext : StateContext, const scriptInterface : StateGameScriptInterface ) : Bool
	{
		return IsLeftWeaponReady( stateContext, scriptInterface );
	}

}

class IdleShootEvents extends ShootTransition
{

	protected export function OnEnter( stateContext : StateContext, scriptInterface : StateGameScriptInterface )
	{
		SetBlackboardIntVariable( scriptInterface, GetAllBlackboardDefs().PlayerStateMachine.ShootState, ( ( Int32 )( gamePSMShootStates.Idle ) ) );
	}

}

class RightWeaponDecisions extends ShootTransition
{

	protected export const function ToLeftWeapon( const stateContext : StateContext, const scriptInterface : StateGameScriptInterface ) : Bool
	{
		if( !( HasLeftWeaponEquipped( scriptInterface ) ) )
		{
			return false;
		}
		if( !( HasRightWeaponEquipped( scriptInterface ) ) )
		{
			return true;
		}
		if( LeftWeaponHasNoAmmoOrIsReloading( scriptInterface ) )
		{
			return false;
		}
		if( RightWeaponHasNoAmmoOrIsReloading( scriptInterface ) )
		{
			return ( scriptInterface.GetActionValue( 'RangedAttack' ) < 0.1 ) || ( scriptInterface.GetActionStateTime( 'RangedAttack' ) > ( GetLeftWeaponCycleTime( scriptInterface ) / 2.0 ) );
		}
		if( !( scriptInterface.IsActionJustReleased( 'RangedAttack' ) ) )
		{
			return false;
		}
		return true;
	}

}

class RightWeaponEvents extends ShootTransition
{

	protected export function OnEnter( stateContext : StateContext, scriptInterface : StateGameScriptInterface )
	{
		SetBlackboardIntVariable( scriptInterface, GetAllBlackboardDefs().PlayerStateMachine.ShootState, ( ( Int32 )( gamePSMShootStates.RightWeapon ) ) );
	}

}

class LeftWeaponDecisions extends ShootTransition
{

	protected export const function ToRightWeapon( const stateContext : StateContext, const scriptInterface : StateGameScriptInterface ) : Bool
	{
		if( !( HasRightWeaponEquipped( scriptInterface ) ) )
		{
			return false;
		}
		if( !( HasLeftWeaponEquipped( scriptInterface ) ) )
		{
			return true;
		}
		if( RightWeaponHasNoAmmoOrIsReloading( scriptInterface ) )
		{
			return false;
		}
		if( LeftWeaponHasNoAmmoOrIsReloading( scriptInterface ) )
		{
			return ( scriptInterface.GetActionValue( 'RangedAttack' ) < 0.1 ) || ( scriptInterface.GetActionStateTime( 'RangedAttack' ) > ( GetRightWeaponCycleTime( scriptInterface ) / 2.0 ) );
		}
		return scriptInterface.IsActionJustReleased( 'RangedAttack' );
	}

}

class LeftWeaponEvents extends ShootTransition
{

	protected export function OnEnter( stateContext : StateContext, scriptInterface : StateGameScriptInterface )
	{
		SetBlackboardIntVariable( scriptInterface, GetAllBlackboardDefs().PlayerStateMachine.ShootState, ( ( Int32 )( gamePSMShootStates.LeftWeapon ) ) );
	}

}

class BothWeaponsDecisions extends ExitToNextShootDecisionsBase
{
	default m_enteredStateVarName = 'EnteredBothWeaponsWithState';

	protected export const function EnterCondition( const stateContext : StateContext, const scriptInterface : StateGameScriptInterface ) : Bool
	{
		var lastReadyTime : StateResultFloat;
		var rightCycleTime : Float;
		var leftCycleTime : Float;
		var halfCycleTime : Float;
		var pressTime : Float;
		if( !( HasRightWeaponEquipped( scriptInterface ) ) )
		{
			return false;
		}
		if( !( HasLeftWeaponEquipped( scriptInterface ) ) )
		{
			return false;
		}
		if( !( IsRightWeaponReady( stateContext, scriptInterface ) ) )
		{
			return false;
		}
		if( !( IsLeftWeaponReady( stateContext, scriptInterface ) ) )
		{
			return false;
		}
		if( stateContext.IsStateActive( 'UpperBody', 'aimingState' ) )
		{
			return true;
		}
		if( GetRightWeaponTriggerMode( scriptInterface ) == gamedataTriggerMode.FullAuto && GetLeftWeaponTriggerMode( scriptInterface ) == gamedataTriggerMode.FullAuto )
		{
			return true;
		}
		if( GetRightWeaponTriggerMode( scriptInterface ) == gamedataTriggerMode.FullAuto || GetLeftWeaponTriggerMode( scriptInterface ) == gamedataTriggerMode.FullAuto )
		{
			return ( scriptInterface.GetActionValue( 'RangedAttack' ) > 0.1 ) && ( scriptInterface.GetActionStateTime( 'RangedAttack' ) > 0.2 );
		}
		if( scriptInterface.GetActionValue( 'RangedAttack' ) > 0.0 )
		{
			if( stateContext.IsStateActive( 'ShootState', 'IdleShoot' ) )
			{
				return false;
			}
			rightCycleTime = GetRightWeaponCycleTime( scriptInterface );
			leftCycleTime = GetLeftWeaponCycleTime( scriptInterface );
			halfCycleTime = MinF( rightCycleTime, leftCycleTime ) / 2.0;
			if( stateContext.IsStateActive( 'ShootState', 'RightWeapon' ) )
			{
				if( GetLeftWeaponTriggerMode( scriptInterface ) != gamedataTriggerMode.FullAuto )
				{
					if( GetLeftWeaponState( scriptInterface ) == gamePSMRangedWeaponStates.Ready )
					{
						lastReadyTime = stateContext.GetPermanentFloatParameter( 'LeftReadyTime' );
					}
					else if( GetLeftWeaponState( scriptInterface ) == gamePSMRangedWeaponStates.Shoot )
					{
						lastReadyTime = stateContext.GetPermanentFloatParameter( 'LastShotTime' );
					}
				}
			}
			else if( stateContext.IsStateActive( 'ShootState', 'LeftWeapon' ) )
			{
				if( GetRightWeaponTriggerMode( scriptInterface ) != gamedataTriggerMode.FullAuto )
				{
					if( GetRightWeaponState( scriptInterface ) == gamePSMRangedWeaponStates.Ready )
					{
						lastReadyTime = stateContext.GetPermanentFloatParameter( 'RightReadyTime' );
					}
					else if( GetRightWeaponState( scriptInterface ) == gamePSMRangedWeaponStates.Shoot )
					{
						lastReadyTime = stateContext.GetPermanentFloatParameter( 'LastSecondaryShotTime' );
					}
				}
			}
			pressTime = scriptInterface.GetActionStateTime( 'RangedAttack' );
			if( lastReadyTime.valid )
			{
				pressTime = MinF( pressTime, EngineTime.ToFloat( GameInstance.GetSimTime( scriptInterface.GetGame() ) ) - lastReadyTime.value );
			}
			if( pressTime > halfCycleTime )
			{
				return true;
			}
		}
		return false;
	}

	protected const override function SmartExitCondition( const stateContext : StateContext, const scriptInterface : StateGameScriptInterface ) : Bool
	{
		if( !( HasRightWeaponEquipped( scriptInterface ) ) )
		{
			return true;
		}
		if( !( HasLeftWeaponEquipped( scriptInterface ) ) )
		{
			return true;
		}
		if( GetRightWeaponTriggerMode( scriptInterface ) == gamedataTriggerMode.FullAuto && GetLeftWeaponTriggerMode( scriptInterface ) == gamedataTriggerMode.FullAuto )
		{
			return false;
		}
		if( stateContext.IsStateActive( 'UpperBody', 'aimingState' ) )
		{
			return false;
		}
		return scriptInterface.GetActionValue( 'RangedAttack' ) <= 0.0;
	}

}

class BothWeaponsEvents extends ShootTransition
{

	protected export function OnEnter( stateContext : StateContext, scriptInterface : StateGameScriptInterface )
	{
		var shootState : Int32;
		shootState = scriptInterface.localBlackboard.GetInt( GetAllBlackboardDefs().PlayerStateMachine.ShootState );
		stateContext.SetPermanentIntParameter( 'EnteredBothWeaponsWithState', shootState, true );
		SetBlackboardIntVariable( scriptInterface, GetAllBlackboardDefs().PlayerStateMachine.ShootState, ( ( Int32 )( gamePSMShootStates.BothWeapons ) ) );
	}

	protected export function OnExit( stateContext : StateContext, scriptInterface : StateGameScriptInterface )
	{
		stateContext.SetPermanentIntParameter( 'EnteredBothWeaponsWithState', 0 );
	}

}

class ValentinosFrenzyInitDecisions extends ShootTransition
{

	protected export function OnAttach( const stateContext : StateContext, const scriptInterface : StateGameScriptInterface )
	{
		scriptInterface.executionOwner.RegisterInputListener( this, 'QuickMelee' );
		EnableOnEnterCondition( false );
	}

	protected export function OnDetach( const stateContext : StateContext, const scriptInterface : StateGameScriptInterface )
	{
		scriptInterface.executionOwner.UnregisterInputListener( this );
	}

	protected event OnAction( action : ListenerAction, consumer : ListenerActionConsumer )
	{
		if( ListenerAction.IsButtonJustReleased( action ) )
		{
			EnableOnEnterCondition( true );
		}
	}

	protected export const function EnterCondition( const stateContext : StateContext, const scriptInterface : StateGameScriptInterface ) : Bool
	{
		EnableOnEnterCondition( false );
		return scriptInterface.IsActionJustTapped( 'QuickMelee' ) && CanStartValentinosFrenzy( stateContext, scriptInterface );
	}

	protected export const function ToValentinosFrenzyRightOnly( const stateContext : StateContext, const scriptInterface : StateGameScriptInterface ) : Bool
	{
		return !( CanBeInValentinosFrenzy( stateContext, scriptInterface ) ) || ( GetInStateTime() >= GetStaticFloatParameterDefault( "timeInState", 0.2 ) );
	}

}

class ValentinosFrenzyInitEvents extends ShootTransition
{

	protected export function OnEnter( stateContext : StateContext, scriptInterface : StateGameScriptInterface )
	{
		var statusEffectSystem : StatusEffectSystem;
		var tripleTequila : StatusEffect;
		var stackCount : Uint32;
		var shootState : Int32;
		statusEffectSystem = GameInstance.GetStatusEffectSystem( scriptInterface.GetGame() );
		tripleTequila = GetTripleTequilaStatusEffect( scriptInterface );
		stackCount = tripleTequila.GetStackCount();
		shootState = scriptInterface.localBlackboard.GetInt( GetAllBlackboardDefs().PlayerStateMachine.ShootState );
		stateContext.SetPermanentIntParameter( 'TripleTequilaStackCount', ( ( Int32 )( stackCount ) ), true );
		stateContext.SetPermanentIntParameter( 'LastShotInValentinosFrenzy', shootState, true );
		AnimationControllerComponent.SetInputFloat( scriptInterface.executionOwner, 'valentinos_frenzy', 1.0 );
		StatusEffectHelper.ApplyStatusEffect( scriptInterface.executionOwner, T"BaseStatusEffect.ValentinosFrenzySE" );
		statusEffectSystem.ApplyStatusEffect( scriptInterface.executionOwner.GetEntityID(), T"BaseStatusEffect.ValentinosFrenzyTripleTequilaStackSE", , , stackCount );
		if( ( tripleTequila != NULL ) && ( stackCount >= tripleTequila.GetMaxStacks() ) )
		{
			StatusEffectHelper.ApplyStatusEffect( scriptInterface.executionOwner, T"BaseStatusEffect.ValentinosFrenzyMaxStacksSE" );
		}
		StatusEffectHelper.RemoveStatusEffect( scriptInterface.executionOwner, T"BaseStatusEffect.Triple_Tequila_Stack" );
		SetBlackboardIntVariable( scriptInterface, GetAllBlackboardDefs().PlayerStateMachine.ShootState, ( ( Int32 )( gamePSMShootStates.ValentinosFrenzyInit ) ) );
	}

	private const function GetTripleTequilaStatusEffect( scriptInterface : StateGameScriptInterface ) : StatusEffect
	{
		var statusEffects : array< StatusEffect >;
		GameInstance.GetStatusEffectSystem( scriptInterface.GetGame() ).GetAppliedEffectsWithID( scriptInterface.executionOwner.GetEntityID(), T"BaseStatusEffect.Triple_Tequila_Stack", statusEffects );
		if( statusEffects.Size() )
		{
			return statusEffects[ 0 ];
		}
		return NULL;
	}

}

class ValentinosFrenzyRightOnlyDecisions extends ShootTransition
{

	protected export const function ToValentinosFrenzy( const stateContext : StateContext, const scriptInterface : StateGameScriptInterface ) : Bool
	{
		var timeRemaining : StateResultFloat;
		var cycleTimeRemaining : StateResultFloat;
		timeRemaining = stateContext.GetPermanentFloatParameter( 'ValentinosFrenzyTimeRemaining' );
		cycleTimeRemaining = stateContext.GetPermanentFloatParameter( 'ValentinosFrenzyCycleTimeRemaining' );
		if( !( CanBeInValentinosFrenzy( stateContext, scriptInterface ) ) )
		{
			return true;
		}
		if( GetRightWeaponTriggerMode( scriptInterface ) == gamedataTriggerMode.FullAuto || GetLeftWeaponTriggerMode( scriptInterface ) == gamedataTriggerMode.FullAuto )
		{
			return true;
		}
		return ( timeRemaining.value <= 0.0 ) || ( cycleTimeRemaining.valid && ( cycleTimeRemaining.value <= 0.0 ) );
	}

}

class ValentinosFrenzyRightOnlyEvents extends ShootTransition
{

	protected export function OnEnter( stateContext : StateContext, scriptInterface : StateGameScriptInterface )
	{
		var duration : Float;
		var halfCycleTime : Float;
		duration = scriptInterface.GetStatsSystem().GetStatValue( scriptInterface.executionOwner.GetEntityID(), gamedataStatType.ValentinosFrenzy_Duration );
		stateContext.SetPermanentFloatParameter( 'ValentinosFrenzyTimeRemaining', duration, true );
		halfCycleTime = GetLeftWeaponCycleTime( scriptInterface ) * 0.5;
		stateContext.SetPermanentFloatParameter( 'ValentinosFrenzyCycleTimeRemaining', halfCycleTime, true );
		SetBlackboardIntVariable( scriptInterface, GetAllBlackboardDefs().PlayerStateMachine.ShootState, ( ( Int32 )( gamePSMShootStates.ValentinosFrenzyRightOnly ) ) );
	}

	protected export function OnUpdate( timeDelta : Float, stateContext : StateContext, scriptInterface : StateGameScriptInterface )
	{
		var globalTimeDilation : Float;
		var rightCycleTime : Float;
		var leftCycleTime : Float;
		var elapsedTime : Float;
		var timeRemaining : StateResultFloat;
		var cycleTimeRemaining : StateResultFloat;
		globalTimeDilation = GameInstance.GetTimeSystem( scriptInterface.GetGame() ).GetActiveTimeDilation();
		rightCycleTime = GetRightWeaponCycleTime( scriptInterface );
		leftCycleTime = GetLeftWeaponCycleTime( scriptInterface );
		timeDelta *= globalTimeDilation;
		elapsedTime = timeDelta;
		if( ( globalTimeDilation > 0.0 ) && ( globalTimeDilation < 1.0 ) )
		{
			elapsedTime *= CalcCycleTimeDeltaFactor( MinF( rightCycleTime, leftCycleTime ), scriptInterface );
		}
		timeRemaining = stateContext.GetPermanentFloatParameter( 'ValentinosFrenzyTimeRemaining' );
		timeRemaining.value -= elapsedTime;
		stateContext.SetPermanentFloatParameter( 'ValentinosFrenzyTimeRemaining', timeRemaining.value );
		elapsedTime = timeDelta;
		if( ( globalTimeDilation > 0.0 ) && ( globalTimeDilation < 1.0 ) )
		{
			elapsedTime *= CalcCycleTimeDeltaFactor( GetLeftWeaponCycleTime( scriptInterface ), scriptInterface );
		}
		cycleTimeRemaining = stateContext.GetPermanentFloatParameter( 'ValentinosFrenzyCycleTimeRemaining' );
		cycleTimeRemaining.value -= elapsedTime;
		stateContext.SetPermanentFloatParameter( 'ValentinosFrenzyCycleTimeRemaining', cycleTimeRemaining.value );
	}

	protected export function OnExit( stateContext : StateContext, scriptInterface : StateGameScriptInterface )
	{
		stateContext.RemovePermanentFloatParameter( 'ValentinosFrenzyCycleTimeRemaining' );
	}

}

class ValentinosFrenzyDecisions extends ExitToNextShootDecisionsBase
{
	default m_enteredStateVarName = 'LastShotInValentinosFrenzy';

	protected const override function SmartExitCondition( const stateContext : StateContext, const scriptInterface : StateGameScriptInterface ) : Bool
	{
		var timeRemaining : StateResultFloat;
		timeRemaining = stateContext.GetPermanentFloatParameter( 'ValentinosFrenzyTimeRemaining' );
		if( !( CanBeInValentinosFrenzy( stateContext, scriptInterface ) ) )
		{
			return true;
		}
		return timeRemaining.value <= 0.0;
	}

}

class ValentinosFrenzyEvents extends ShootTransition
{
	var m_statMod : gameStatModifierData;

	protected export function OnEnter( stateContext : StateContext, scriptInterface : StateGameScriptInterface )
	{
		SetBlackboardIntVariable( scriptInterface, GetAllBlackboardDefs().PlayerStateMachine.ShootState, ( ( Int32 )( gamePSMShootStates.ValentinosFrenzy ) ) );
	}

	protected export function OnUpdate( timeDelta : Float, stateContext : StateContext, scriptInterface : StateGameScriptInterface )
	{
		var globalTimeDilation : Float;
		var rightCycleTime : Float;
		var leftCycleTime : Float;
		var timeRemaining : StateResultFloat;
		globalTimeDilation = GameInstance.GetTimeSystem( scriptInterface.GetGame() ).GetActiveTimeDilation();
		rightCycleTime = GetRightWeaponCycleTime( scriptInterface );
		leftCycleTime = GetLeftWeaponCycleTime( scriptInterface );
		timeDelta *= globalTimeDilation;
		if( ( globalTimeDilation > 0.0 ) && ( globalTimeDilation < 1.0 ) )
		{
			timeDelta *= CalcCycleTimeDeltaFactor( MinF( rightCycleTime, leftCycleTime ), scriptInterface );
		}
		timeRemaining = stateContext.GetPermanentFloatParameter( 'ValentinosFrenzyTimeRemaining' );
		timeRemaining.value -= timeDelta;
		stateContext.SetPermanentFloatParameter( 'ValentinosFrenzyTimeRemaining', timeRemaining.value );
	}

	protected export function OnExit( stateContext : StateContext, scriptInterface : StateGameScriptInterface )
	{
		stateContext.RemovePermanentIntParameter( 'LastShotInValentinosFrenzy' );
		AnimationControllerComponent.SetInputFloat( scriptInterface.executionOwner, 'valentinos_frenzy', 0.0 );
		StatusEffectHelper.RemoveStatusEffect( scriptInterface.executionOwner, T"BaseStatusEffect.ValentinosFrenzySE" );
		StatusEffectHelper.RemoveStatusEffect( scriptInterface.executionOwner, T"BaseStatusEffect.ValentinosFrenzyTripleTequilaStackSE" );
		StatusEffectHelper.RemoveStatusEffect( scriptInterface.executionOwner, T"BaseStatusEffect.ValentinosFrenzyMaxStacksSE" );
	}

}

