class GlamDocItemBoughtCallback extends InventoryScriptCallback
{
	private var eventTarget : weak< GlamDocGameController >;

	public function Bind( eventTargetArg : GlamDocGameController )
	{
		eventTarget = eventTargetArg;
	}

	public override function OnItemAdded( itemIDArg : ItemID, itemData : weak< gameItemData >, flaggedAsSilent : Bool )
	{
		eventTarget.OnItemBought( itemIDArg, itemData );
	}

}

enum cyberwareCustomSelectorActiveInputMode
{
	None = 0,
	Gamepad = 1,
	KBM = 2,
}

enum cyberwareCustomColorSelectorActiveMode
{
	None = 0,
	Primary = 1,
	Secondary = 2,
}

enum GlamdocScreenType
{
	Invalid = 0,
	Appearance = 1,
	ColorPicker = 2,
	Popup = 3,
}

struct cyberwareCustomColorWheelDef
{
	editable var m_parent : inkWidgetRef;
	editable var m_wheelRadius : Float;
	editable var m_selectionMargin : Float;
	editable var m_selectionFrame : inkWidgetRef;
	editable var m_hoverFrame : inkWidgetRef;
	editable var m_color1Part : inkWidgetRef;
	editable var m_color2Part : inkWidgetRef;
	editable var m_color3Part : inkWidgetRef;
	editable var m_color4Part : inkWidgetRef;
	editable var m_color5Part : inkWidgetRef;
}

struct GlamdocFactData
{
	var spendCostThreshold : Int32;
	var spendCountThreshold : Int32;
	var factName : CName;
}

struct CyberwarePreviewSettings
{
	editable var m_apperanceAnimationName : CName;
	default m_apperanceAnimationName = 'mantis';
	editable var m_apperanceCameraLocation : CName;
	default m_apperanceCameraLocation = 'UIWardrobePreview';
	editable var m_colorCustomizationAnimationName : CName;
	default m_colorCustomizationAnimationName = 'mantis';
	editable var m_colorCustomizationCameraLocation : CName;
	default m_colorCustomizationCameraLocation = 'UIWardrobePreview';
}

enum ArmsWareType
{
	Invalid = -1,
	Launcher = 0,
	MantisBlades = 1,
	NanoWires = 2,
	StrongArms = 3,
}

importonly class gameuiGlamdocGameController extends gameuiBaseMenuGameController
{
	protected import function ReloadPreviewPuppet( puppetSceneName : CName );
	protected import function PlayAnimationOnPreviewPuppet( animationName : CName, puppetSceneName : CName );
	protected import function SetCameraSlotForPreviewPuppet( slotName : CName, delayed : Bool );
	protected import function OnItemsFinishedAttach();
	protected import function HidePuppetPreview();
}

class GlamdocAttachmentSlotsScriptCallback extends AttachmentSlotsScriptCallback
{
	var m_puppet : weak< gamePuppet >;
	var m_transactionSystem : weak< TransactionSystem >;
	var m_slotToWaitFor : TweakDBID;
	var m_slotToClear : TweakDBID;
	var m_itemToWaitFor : ItemID;

	public override function OnItemEquippedVisual( slot : TweakDBID, item : ItemID )
	{
		if( m_slotToWaitFor == slot )
		{
			if( ( m_itemToWaitFor == item ) && !( m_transactionSystem.IsSlotEmpty( m_puppet, m_slotToClear ) ) )
			{
				m_transactionSystem.RemoveItemFromSlot( m_puppet, m_slotToClear );
			}
		}
	}

}

