}

class ArmsCWVisualEquipped extends Event
{
}

class VisualSlotsUpdatedEvent extends DelayEvent
{
}

class GlamdocAttachmentSlotsScriptCallback extends AttachmentSlotsScriptCallback
{
	var m_puppet : weak< gamePuppet >;
	var m_player : weak< PlayerPuppet >;
	var m_transactionSystem : weak< TransactionSystem >;
	var m_slotToWaitFor : TweakDBID;
	var m_slotToClear : TweakDBID;
	var m_itemToWaitFor : ItemID;
	var m_controller : weak< GlamDocGameController >;
	var m_visualSlots : array< TweakDBID >;
	var m_isUnequipping : Bool;
	var m_timeToWaitWhenUnequipping : Float;

	public override function OnItemEquippedVisual( slot : TweakDBID, item : ItemID )
	{
		ShowPuppetPreviewOnceItemsVisualsAreUpdated( slot, item );
	}

	public override function OnItemUnequippedComplete( slot : TweakDBID, item : ItemID )
	{
		ShowPuppetPreviewOnceItemsVisualsAreUpdated( slot, item );
	}

	private function ShowPuppetPreviewOnceItemsVisualsAreUpdated( slot : TweakDBID, item : ItemID )
	{
		var armsCWVisualEquipped : ArmsCWVisualEquipped;
		var delayEvent : VisualSlotsUpdatedEvent;
		armsCWVisualEquipped = new ArmsCWVisualEquipped;
		if( m_slotToWaitFor == slot )
		{
			if( ( m_itemToWaitFor == item ) && !( m_transactionSystem.IsSlotEmpty( m_puppet, m_slotToClear ) ) )
			{
				m_transactionSystem.RemoveItemFromSlot( m_puppet, m_slotToClear );
				GameInstance.GetUISystem( m_puppet.GetGame() ).QueueEvent( armsCWVisualEquipped );
				m_controller.UpdatePuppetBasedOnCurrentScreen();
				m_visualSlots.PushBack( m_slotToClear );
			}
		}
		m_visualSlots.Remove( slot );
		if( m_visualSlots.Size() <= 0 )
		{
			if( m_isUnequipping )
			{
				delayEvent = new VisualSlotsUpdatedEvent;
				GameInstance.GetDelaySystem( m_player.GetGame() ).DelayEvent( m_player, delayEvent, m_timeToWaitWhenUnequipping, false );
			}
			else
			{
				m_controller.ShowPreviewPuppet();
			}
		}
	}

}

