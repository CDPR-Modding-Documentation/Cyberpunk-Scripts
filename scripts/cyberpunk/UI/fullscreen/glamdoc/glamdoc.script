	protected event OnSetUserData( userData : IScriptable )
	{
		var menuData : PreviousMenuData;
		menuData = ( ( PreviousMenuData )( userData ) );
		if( menuData )
		{
			m_cameFromInventoryMenu = true;
		}
		m_vendorUserData = ( ( VendorUserData )( userData ) );
		m_buttonHintsController = ( ( ButtonHints )( SpawnFromExternal( inkWidgetRef.Get( m_buttonHintsManagerRef ), R"base\gameplay\gui\common\buttonhints.inkwidget", 'Root' ).GetController() ) );
		m_buttonHintsController.AddButtonHint( 'back', GetLocalizedText( "Common-Access-Close" ) );
	}

	protected event OnInitialize()
	{
		m_cyberwarePreviewSettingsTable[ ( ( Int32 )( ArmsWareType.Launcher ) ) ] = m_launcherPreviewSettings;
		m_cyberwarePreviewSettingsTable[ ( ( Int32 )( ArmsWareType.MantisBlades ) ) ] = m_mantisBladesPreviewSettings;
		m_cyberwarePreviewSettingsTable[ ( ( Int32 )( ArmsWareType.NanoWires ) ) ] = m_monoWirePreviewSettings;
		m_cyberwarePreviewSettingsTable[ ( ( Int32 )( ArmsWareType.StrongArms ) ) ] = m_strongArmPreviewSettings;
		InitializeVendor();
		InitializeSystems();
		InitializeUI();
		m_inventoryView = ( ( GlamdocInventoryController )( inkCompoundRef.GetController( m_inventoryViewAnchor ) ) );
		m_playerID = m_player.GetEntityID();
		m_statsSystem = GameInstance.GetStatsSystem( m_player.GetGame() );
		m_statsDataSystem = GameInstance.GetStatsDataSystem( m_player.GetGame() );
		m_statusEffectSystem = GameInstance.GetStatusEffectSystem( m_player.GetGame() );
		m_inventorySystem = GameInstance.GetInventoryManager( m_player.GetGame() );
		m_transactionSystem = GameInstance.GetTransactionSystem( m_player.GetGame() );
		RegisterInventoryListener( GetPlayerControlledObject() );
		m_dollHoverArea = gamedataEquipmentArea.Invalid;
		m_dollSelected = false;
		Init();
		m_InventoryManager = new InventoryDataManagerV2;
		m_InventoryManager.Initialize( m_player );
		m_spendCost = m_inventorySystem.GetSpendByVendorID( m_VendorDataManager.GetVendorID() );
		m_spendCount = m_spendCost % 100;
		m_spendCost = m_spendCost / 100;
		m_glamdocData = TweakDBInterface.GetGlamdocRecord( m_VendorDataManager.GetVendorID() );
		m_glamdocData.FactThresholds( m_factThresholds );
		if( MarketSystem.IsAttached( m_VendorDataManager.GetVendorInstance() ) )
		{
			OnUIVendorAttachedEvent( NULL );
		}
		UpdateCurrentCustomizationItem( GetSavedCustomizationItemID() );
		InitializeBrandData( CyberwareCustomizationPersistentData.GetBrandDataID( m_cyberwareCustomizationSystem.GetSavedData() ) );
		InitializeEquippedCyberArm();
		DisplayInventory();
		ProcessPreviousCustomizationState();
		ResetVisualHoverOnColorWheel( m_colorWheelColorA );
		ResetVisualHoverOnColorWheel( m_colorWheelColorB );
		UpdateSwapArrows();
		SpawnMinigrid();
		InitializeAxisInputDeadZone();
		ProcessFakeUpdate( true );
		PlayLibraryAnimation( m_introAnimation );
	}

	private function Init()
	{
		m_TooltipsManager = ( ( gameuiTooltipsManager )( inkWidgetRef.GetControllerByType( m_TooltipsManagerRef, 'gameuiTooltipsManager' ) ) );
		m_TooltipsManager.Setup( ETooltipsStyle.Menus );
		m_InventoryManager = new InventoryDataManagerV2;
		m_InventoryManager.Initialize( m_player );
		m_playerItemDisplayContext = ItemDisplayContextData.Make( m_player, ItemDisplayContext.VendorPlayer );
		m_vendorItemDisplayContext = ItemDisplayContextData.Make( m_player, ItemDisplayContext.Vendor );
		m_playerItemDisplayContext.AddTag( 'AllowProgramLink' );
		m_vendorItemDisplayContext.AddTag( 'AllowProgramLink' );
		m_uiScriptableSystem = UIScriptableSystem.GetInstance( m_player.GetGame() );
		m_uiInventorySystem = UIInventoryScriptableSystem.GetInstance( m_player.GetGame() );
		m_inventoryView.Configure( m_uiScriptableSystem );
		RegisterBlackboard( GetPlayerControlledObject() );
		m_ripperdocTokenManager = new RipperdocTokenManager;
		m_ripperdocTokenManager.Initialize( m_player );
		m_animationController = ( ( GlamdocScreenAnimationController )( inkWidgetRef.GetControllerByType( m_animationControllerContainer, 'GlamdocScreenAnimationController' ) ) );
		m_animationController.SetGender( m_player.GetResolvedGenderName() == 'Female' );
		PlayLibraryAnimation( 'Paperdoll_default_tab_intro' );
		DollHover( gamedataEquipmentArea.ArmsCW );
		DollSelect( true );
	}

	protected event OnPuppetPreviewShown()
	{
		m_isProcessingCustomizationChange = false;
	}

	private function ShouldGivePuppetUnHolsteredCyberware() : Bool
	{
		return GetCurrentArmsWareType() != ArmsWareType.NanoWires;
	}

	private function UpdatePuppetWithCyberware( itemToEquip : ItemID )
	{
		var equipData : EquipmentSystemPlayerData;
		var placementSlot : TweakDBID;
		var outerChestPlacementSlot : TweakDBID;
		var rightPlacementSlot : TweakDBID;
		var cyberwarePreviewItem : ItemID;
		var itemData : weak< gameItemData >;
		var mainPuppet : gamePuppet;
		var rightArm : ItemID;
		var attachmentCallback : GlamdocAttachmentSlotsScriptCallback;
		var outerChestItem : ItemID;
		mainPuppet = GetMainPlayer( m_previewPuppet.GetGame() );
		equipData = EquipmentSystem.GetData( mainPuppet );
		outerChestItem = equipData.GetItemInEquipSlot( gamedataEquipmentArea.OuterChest, 0 );
		m_currentCyberarmItem = EquipmentSystem.GetData( mainPuppet ).GetActiveMeleeWare();
		m_currentCyberarmItem = ItemID.CreateQuery( ItemID.GetTDBID( itemToEquip ) );
		rightArm = equipData.GetActiveItem( gamedataEquipmentArea.RightArm );
		rightPlacementSlot = EquipmentSystem.GetPlacementSlot( rightArm );
		placementSlot = EquipmentSystem.GetPlacementSlot( m_currentCyberarmItem );
		cyberwarePreviewItem = m_transactionSystem.CreatePreviewItemID( m_currentCyberarmItem );
		attachmentCallback = new GlamdocAttachmentSlotsScriptCallback;
		attachmentCallback.m_puppet = m_previewPuppet;
		attachmentCallback.m_slotToWaitFor = placementSlot;
		attachmentCallback.m_slotToClear = rightPlacementSlot;
		attachmentCallback.m_transactionSystem = m_transactionSystem;
		attachmentCallback.m_itemToWaitFor = cyberwarePreviewItem;
		m_attachmentSlotCallback = m_transactionSystem.RegisterAttachmentSlotListener( m_previewPuppet, attachmentCallback );
		outerChestPlacementSlot = EquipmentSystem.GetPlacementSlot( outerChestItem );
		if( !( m_transactionSystem.IsSlotEmpty( m_previewPuppet, outerChestPlacementSlot ) ) )
		{
			m_transactionSystem.RemoveItemFromSlot( m_previewPuppet, outerChestPlacementSlot );
		}
		if( !( m_transactionSystem.HasItem( m_previewPuppet, m_currentCyberarmItem ) ) )
		{
			itemData = m_transactionSystem.GetItemData( mainPuppet, m_currentCyberarmItem );
			m_transactionSystem.GiveItemByItemData( m_previewPuppet, itemData );
		}
		if( m_transactionSystem.CanPlaceItemInSlot( m_previewPuppet, placementSlot, m_currentCyberarmItem ) && ShouldGivePuppetUnHolsteredCyberware() )
		{
			m_transactionSystem.AddItemToSlot( m_previewPuppet, placementSlot, cyberwarePreviewItem, true );
		}
		else
		{
			placementSlot = EquipmentSystem.GetPlacementSlot( EquipmentSystem.GetData( mainPuppet ).GetActiveWeapon() );
			m_transactionSystem.RemoveItemFromSlot( m_previewPuppet, placementSlot );
		}
		UpdatePuppetBasedOnCurrentScreen();
	}

	protected event OnInventoryPuppetReceived( puppet : gamePuppet )
	{
		if( m_attachmentSlotCallback )
		{
			m_transactionSystem.UnregisterAttachmentSlotListener( m_previewPuppet, m_attachmentSlotCallback );
		}
		m_previewPuppet = puppet;
		m_currentCyberarmItem = EquipmentSystem.GetData( GetMainPlayer( m_previewPuppet.GetGame() ) ).GetActiveMeleeWare();
		UpdatePuppetWithCyberware( m_currentCyberarmItem );
		m_isPreviewPuppetReady = true;
	}

	private function ReloadPreviewPuppetCyberarms()
	{
		if( !( m_isPreviewPuppetReady ) )
		{
			return;
		}
		PlayAnimationOnPreviewPuppet( 'mantis', 'inventory' );
	}

	private function DisplayInventory()
	{
		var i, limit : Int32;
		var playerItems : array< weak< UIInventoryItem > >;
		var vendorItems : array< weak< WrappedUIInventoryItem > >;
		var filteredPlayerItems, filteredVendorItems : array< GlamdocWrappedUIInventoryItem >;
		var glamdocItem : GlamdocWrappedUIInventoryItem;
		var playerCurrencyAmount : Int32;
		var requirementsManager : weak< UIInventoryItemRequirementsManager >;
		m_filterMode = RipperdocModes.Item;
		vendorItems = GetVendorItems( m_filterArea );
		playerItems = m_cachedPlayerItems;
		for( i = 0, limit = playerItems.Size(); i < limit; i += 1 )
		{
			if( FilterItem( playerItems[ i ] ) )
			{
				filteredPlayerItems.PushBack( GlamdocWrappedUIInventoryItem.Make( playerItems[ i ], m_playerItemDisplayContext ) );
				requirementsManager = playerItems[ i ].GetRequirementsManager( m_player );
				requirementsManager.SetIsEquippableRaw( CheckIfCanApply( playerItems[ i ].GetItemData() ) );
			}
		}
		playerCurrencyAmount = m_VendorDataManager.GetLocalPlayerCurrencyAmount();
		for( i = 0, limit = vendorItems.Size(); i < limit; i += 1 )
		{
			if( FilterItem( vendorItems[ i ].Item ) )
			{
				glamdocItem = GlamdocWrappedUIInventoryItem.Make( vendorItems[ i ].Item, m_vendorItemDisplayContext, vendorItems[ i ].AdditionalData );
				glamdocItem.IsEnoughMoney = playerCurrencyAmount >= ( ( Int32 )( vendorItems[ i ].Item.GetBuyPrice() ) );
				if( MarketSystem.IsNewItem( m_VendorDataManager.GetVendorInstance(), vendorItems[ i ].Item.GetTweakDBID() ) )
				{
					glamdocItem.IsNew = true;
				}
				glamdocItem.IsEnoughMoney = playerCurrencyAmount >= ( ( Int32 )( vendorItems[ i ].Item.GetBuyPrice() ) );
				requirementsManager = vendorItems[ i ].Item.GetRequirementsManager( m_player );
				requirementsManager.SetIsEquippableRaw( CheckIfCanApply( vendorItems[ i ].Item.GetItemData() ) );
				filteredVendorItems.PushBack( glamdocItem );
			}
		}
		m_inventoryView.ShowArea( filteredPlayerItems, filteredVendorItems, m_filterArea );
	}

	private function CheckIfCanApply( itemData : weak< gameItemData > ) : Bool
	{
		var playerItems : array< weak< UIInventoryItem > >;
		playerItems = m_uiInventorySystem.GetPlayerAreaItems( gamedataEquipmentArea.ArmsCW );
		return ItemTagMatch( itemData, ( ( ArmsWareType )( ( ( Int32 )( playerItems[ 0 ].GetItemType() ) ) - ( ( Int32 )( gamedataItemType.Cyb_Launcher ) ) ) ) );
	}

	private function FilterItem( item : weak< UIInventoryItem > ) : Bool
	{
		if( item.IsEquipped() )
		{
			return false;
		}
		if( item.IsRecipe() )
		{
			return false;
		}
		if( EquipmentSystem.GetInstance( m_player ).GetPlayerData( m_player ).IsSideUpgradeEquipped( item.GetID() ) )
		{
			return false;
		}
		return ItemTagMatch( item.GetItemData(), m_filterArea );
	}

	private function ItemTagMatch( item : weak< gameItemData >, filterArea : ArmsWareType ) : Bool
	{
		return ( ( Int32 )( filterArea ) ) == ItemTagToIndex( item );
	}

	private function GetVendorItems( area : ArmsWareType ) : array< weak< WrappedUIInventoryItem > >
	{
		var i, j, limit : Int32;
		var data : array< weak< WrappedUIInventoryItem > >;
		var vendorItems : array< weak< IScriptable > >;
		var playerItem : weak< UIInventoryItem >;
		if( area == ArmsWareType.Invalid )
		{
			m_vendorWrappedItems.GetValues( vendorItems );
			for( i = 0, limit = vendorItems.Size(); i < limit; i += 1 )
			{
				data.PushBack( ( ( weak< weak< WrappedUIInventoryItem > > )( vendorItems[ i ] ) ) );
			}
		}
		else
		{
			data = m_cachedVendorItems[ ( ( Int32 )( m_filterArea ) ) ];
		}
		for( i = data.Size() - 1; i >= limit; i -= 1 )
		{
			for( j = 0; j < m_cachedPlayerItems.Size(); j += 1 )
			{
				if( playerItem.GetTweakDBID() == data[ i ].Item.GetTweakDBID() )
				{
					data.Remove( data[ i ] );
				}
			}
		}
		return data;
	}

	protected function RegisterBlackboard( player : GameObject )
	{
		m_equipmentBlackboard = GameInstance.GetBlackboardSystem( player.GetGame() ).Get( GetAllBlackboardDefs().UI_Equipment );
		if( m_equipmentBlackboard )
		{
			m_equipmentBlackboardCallback = m_equipmentBlackboard.RegisterDelayedListenerVariant( GetAllBlackboardDefs().UI_Equipment.itemEquipped, this, 'OnItemEquipped' );
		}
		m_VendorBlackboard = GetBlackboardSystem().Get( GetAllBlackboardDefs().UI_Vendor );
	}

	protected function UnregisterBlackboard()
	{
		if( m_equipmentBlackboard )
		{
			m_equipmentBlackboard.UnregisterListenerVariant( GetAllBlackboardDefs().UI_Equipment.itemEquipped, m_equipmentBlackboardCallback );
		}
		m_VendorBlackboard = NULL;
	}

	protected event OnUIVendorAttachedEvent( evt : UIVendorAttachedEvent )
	{
		PreparePlayerItems();
		PrepareVendorItems();
	}

	private function PreparePlayerItems()
	{
		var i, limit : Int32;
		var playerItems : inkHashMap;
		var values : array< weak< IScriptable > >;
		var uiInventoryItem : weak< UIInventoryItem >;
		var tags : array< CName >;
		playerItems = m_uiInventorySystem.GetPlayerItemsMap();
		playerItems.GetValues( values );
		m_uiInventorySystem.GetInventoryItemsManager().FlushEquippedItems();
		m_cachedPlayerItems.Clear();
		for( i = 0, limit = values.Size(); i < limit; i += 1 )
		{
			uiInventoryItem = ( ( UIInventoryItem )( values[ i ] ) );
			tags = TweakDBInterface.GetItemRecord( ItemID.GetTDBID( uiInventoryItem.GetID() ) ).Tags();
			if( !( tags.Contains( 'Glamdoc' ) ) )
			{
				continue;
			}
			m_cachedPlayerItems.PushBack( uiInventoryItem );
		}
	}

	private function EquipmentAreaToIndex( equipArea : gamedataItemType ) : Int32
	{
		switch( equipArea )
		{
			case gamedataItemType.Cyb_Launcher:
				return 0;
			case gamedataItemType.Cyb_MantisBlades:
				return 1;
			case gamedataItemType.Cyb_NanoWires:
				return 2;
			case gamedataItemType.Cyb_StrongArms:
				return 3;
		}
		return -1;
	}

	private function GetCurrentArmsWareType() : ArmsWareType
	{
		var equippedItems : array< weak< UIInventoryItem > >;
		equippedItems = m_uiInventorySystem.GetPlayerAreaItems( gamedataEquipmentArea.ArmsCW );
		if( equippedItems.Size() > 0 )
		{
			return ( ( ArmsWareType )( ( ( Int32 )( equippedItems[ 0 ].GetItemType() ) ) - ( ( Int32 )( gamedataItemType.Cyb_Launcher ) ) ) );
		}
		return ArmsWareType.Launcher;
	}

	private function PrepareVendorItems()
	{
		var i, j, limit, targetIndex : Int32;
		var vendorObject : weak< GameObject >;
		var vendorItems : array< VendorGameItemData >;
		var uiInventoryItem : UIInventoryItem;
		var wrappedItem : WrappedUIInventoryItem;
		var isOwned : Bool;
		for( i = 0, limit = m_cachedVendorItems.Size(); i < limit; i += 1 )
		{
			m_cachedVendorItems[ i ].Clear();
		}
		vendorObject = m_VendorDataManager.GetVendorInstance();
		vendorItems = m_VendorDataManager.GetGlamDocItems();
		m_vendorItems = new inkHashMap;
		m_vendorWrappedItems = new inkHashMap;
		m_filterArea = GetCurrentArmsWareType();
		m_selector.Show( ( ( Int32 )( m_filterArea ) ) );
		for( i = 0, limit = vendorItems.Size(); i < limit; i += 1 )
		{
			isOwned = false;
			uiInventoryItem = UIInventoryItem.Make( vendorObject, vendorItems[ i ].itemData, m_uiInventorySystem.GetInventoryItemsManager() );
			wrappedItem = WrappedUIInventoryItem.Make( uiInventoryItem, VendorItemAdditionalData.Make( vendorItems[ i ].itemStack ) );
			m_vendorItems.Insert( uiInventoryItem.Hash, uiInventoryItem );
			m_vendorWrappedItems.Insert( uiInventoryItem.Hash, wrappedItem );
			targetIndex = ItemTagToIndex( uiInventoryItem );
			if( targetIndex < 0 )
			{
				continue;
			}
			for( j = 0; j < m_cachedPlayerItems.Size(); j += 1 )
			{
				if( m_cachedPlayerItems[ j ].GetTweakDBID() == uiInventoryItem.GetTweakDBID() )
				{
					isOwned = true;
					break;
				}
			}
			if( isOwned )
			{
				continue;
			}
			if( !( IsEP1() ) && uiInventoryItem.GetItemData().HasTag( 'EP1' ) )
			{
				continue;
			}
			m_cachedVendorItems[ targetIndex ].PushBack( wrappedItem );
		}
	}

	private function ItemTagToIndex( item : UIInventoryItem ) : Int32
	{
		return ItemTagToIndex( item.GetItemData() );
	}

	private function ItemTagToIndex( itemData : weak< gameItemData > ) : Int32
	{
		if( itemData.HasTag( 'ProjectileLauncher' ) )
		{
			return 0;
		}
		else if( itemData.HasTag( 'MantisBlades' ) )
		{
			return 1;
		}
		else if( itemData.HasTag( 'NanoWires' ) )
		{
			return 2;
		}
		else if( itemData.HasTag( 'StrongArms' ) )
		{
			return 3;
		}
		return -1;
	}

	private function InitializeVendor()
	{
		var vendorPanelData : VendorPanelData;
		var vendorData : VendorData;
		if( m_vendorUserData )
		{
			vendorPanelData = m_vendorUserData.vendorData;
			vendorData = vendorPanelData.data;
			m_VendorDataManager = new VendorDataManager;
			m_VendorDataManager.Initialize( GetPlayerControlledObject(), vendorData.entityID );
		}
	}

	private function InitializeSystems()
	{
		m_player = ( ( PlayerPuppet )( GetPlayerControlledObject() ) );
		m_questSystem = GameInstance.GetQuestsSystem( m_player.GetGame() );
		m_cyberwareCustomizationSystem = ( ( CyberwareCustomizationSystem )( GameInstance.GetScriptableSystemsContainer( m_player.GetGame() ).Get( 'CyberwareCustomizationSystem' ) ) );
	}

	private function InitializeUI()
	{
		var names : array< String >;
		var i : Int32;
		var savedData : CyberwareCustomizationPersistentData;
		m_player.RegisterInputListener( this, '__DEVICE_CHANGED__' );
		RegisterToGlobalInputCallback( 'OnPostOnPress', this, 'OnButtonPress' );
		RegisterToGlobalInputCallback( 'OnPostOnRelative', this, 'OnMouseInput' );
		RegisterToGlobalInputCallback( 'OnPostOnRelease', this, 'OnGlobalInputReleased' );
		RegisterToGlobalInputCallback( 'OnPostOnAxis', this, 'OnGlobalAxisInput' );
		m_tabRoot = ( ( TabRadioGroup )( inkWidgetRef.GetController( m_headerTabContainer ) ) );
		RegisterTabButtons();
		UpdateControlsState();
		m_allFilters.PushBack( ArmsWareType.Launcher );
		m_allFilters.PushBack( ArmsWareType.MantisBlades );
		m_allFilters.PushBack( ArmsWareType.NanoWires );
		m_allFilters.PushBack( ArmsWareType.StrongArms );
		for( i = 0; i < m_allFilters.Size(); i += 1 )
		{
			names.PushBack( GetAreaHeader( m_allFilters[ i ] ) );
		}
		m_uiSystem = GameInstance.GetUISystem( m_player.GetGame() );
		m_filterMode = RipperdocModes.Default;
		m_filterArea = ArmsWareType.Invalid;
		m_selector = ( ( GlamdocSelectorController )( inkCompoundRef.GetController( m_selectorAnchor ) ) );
		m_selector.Configure( names );
		m_appearanceWidgets.PushBack( m_armsAnchor );
		m_appearanceWidgets.PushBack( m_appearanceWrapper );
		m_appearanceWidgets.PushBack( m_selectorAnchor );
		m_appearanceWidgets.PushBack( m_selectorLeftButtonAnchor );
		m_appearanceWidgets.PushBack( m_selectorRightButtonAnchor );
		m_colorPickerWidgets.PushBack( m_colorPickerWrapper );
		HideWidgetsWhenUsingKBM();
		UpdateSwapArrows();
		SwitchSelectionTab( GlamdocScreenType.Appearance );
		PlayHoverWidgetAnimation();
		savedData = m_cyberwareCustomizationSystem.GetSavedData();
		if( !( savedData.enabled ) )
		{
			ResetDefinedColors();
		}
	}

	protected function RegisterTabButtons()
	{
		var labels : array< String >;
		m_tabRoot.RegisterToCallback( 'OnValueChanged', this, 'OnValueChanged' );
		labels.PushBack( GetLocalizedText( "LocKey#97490" ) );
		labels.PushBack( GetLocalizedText( "LocKey#97491" ) );
		m_tabRoot.SetData( labels.Size(), NULL, labels );
	}

	protected event OnValueChanged( controller : weak< inkRadioGroupController >, selectedIndex : Int32 )
	{
		SelectTab( selectedIndex );
	}

	private function SelectTab( selectedIndex : Int32 )
	{
		switch( selectedIndex )
		{
			case 0:
				SwitchSelectionTab( GlamdocScreenType.Appearance );
			break;
			case 1:
				SwitchSelectionTab( GlamdocScreenType.ColorPicker );
			break;
		}
		PlaySound( 'TabButton', 'OnPress' );
	}

	private function InitializeAxisInputDeadZone()
	{
		var deadzoneConfig : ConfigVarFloat;
		var controlsGroupVehicle : CName;
		var controlsGroupBase : CName;
		var deadzoneSettingName : CName;
		controlsGroupVehicle = '/controls/vehicle';
		controlsGroupBase = '/controls';
		deadzoneSettingName = 'Axis_DeadzoneInner';
		if( GameInstance.GetSettingsSystem( m_player.GetGame() ).HasVar( controlsGroupVehicle, deadzoneSettingName ) )
		{
			deadzoneConfig = ( ( ConfigVarFloat )( GameInstance.GetSettingsSystem( m_player.GetGame() ).GetVar( controlsGroupVehicle, deadzoneSettingName ) ) );
		}
		else if( GameInstance.GetSettingsSystem( m_player.GetGame() ).HasVar( controlsGroupBase, deadzoneSettingName ) )
		{
			deadzoneConfig = ( ( ConfigVarFloat )( GameInstance.GetSettingsSystem( m_player.GetGame() ).GetVar( controlsGroupBase, deadzoneSettingName ) ) );
		}
		if( deadzoneConfig )
		{
			m_axisInputThreshold = deadzoneConfig.GetValue();
		}
		else
		{
			m_axisInputThreshold = 0.34999999;
		}
	}

	private function ProcessFakeUpdate( on : Bool )
	{
		var anim : inkAnimDef;
		var alphaInterpolator : inkAnimTransparency;
		var animOptions : inkAnimOptions;
		if( on )
		{
			anim = new inkAnimDef;
			alphaInterpolator = new inkAnimTransparency;
			alphaInterpolator.SetDuration( 0.0001 );
			alphaInterpolator.SetStartTransparency( 1.0 );
			alphaInterpolator.SetEndTransparency( 1.0 );
			alphaInterpolator.SetType( inkanimInterpolationType.Linear );
			alphaInterpolator.SetMode( inkanimInterpolationMode.EasyIn );
			anim.AddInterpolator( alphaInterpolator );
			animOptions.playReversed = false;
			animOptions.executionDelay = 0.0;
			animOptions.loopType = inkanimLoopType.Cycle;
			animOptions.loopInfinite = true;
			m_fakeUpdateProxy = inkWidgetRef.PlayAnimationWithOptions( m_CursorRootContainerRef, anim, animOptions );
			m_fakeUpdateProxy.RegisterToCallback( inkanimEventType.OnEndLoop, this, 'OnFakeUpdate' );
		}
		else
		{
			if( m_fakeUpdateProxy.IsPlaying() )
			{
				m_fakeUpdateProxy.Stop();
				m_fakeUpdateProxy.UnregisterFromCallback( inkanimEventType.OnEndLoop, this, 'OnFakeUpdate' );
			}
		}
	}

	private function GetAreaHeader( area : ArmsWareType ) : String
	{
		var label : String;
		switch( area )
		{
			case ArmsWareType.Launcher:
				label = GetLocalizedText( "LocKey#3722" );
			break;
			case ArmsWareType.MantisBlades:
				label = GetLocalizedText( "LocKey#3717" );
			break;
			case ArmsWareType.NanoWires:
				label = GetLocalizedText( "LocKey#3720" );
			break;
			case ArmsWareType.StrongArms:
				label = GetLocalizedText( "LocKey#3718" );
			break;
		}
		return label;
	}

	private function ProcessPreviousCustomizationState()
	{
		var savedData : CyberwareCustomizationPersistentData;
		savedData = m_cyberwareCustomizationSystem.GetSavedData();
		if( savedData.enabled )
		{
			m_customizationItemData = GameInstance.GetTransactionSystem( m_player.GetGame() ).GetItemData( m_player, savedData.customizationItemID );
			m_colorADefined = true;
			m_selectedIndexColorA = savedData.primaryColorIndex;
			UpdateControlsState();
			UpdateAndApplyColor( m_selectedIndexColorA, cyberwareCustomColorSelectorActiveMode.Primary );
			m_colorBDefined = true;
			m_selectedIndexColorB = savedData.secondaryColorIndex;
			UpdateControlsState();
			UpdateAndApplyColor( m_selectedIndexColorB, cyberwareCustomColorSelectorActiveMode.Secondary );
			SwitchActiveMode( cyberwareCustomColorSelectorActiveMode.Primary );
		}
		else
		{
			m_selectedIndexColorA = 0;
			m_selectedIndexColorB = 0;
		}
	}

	private function FindInventoryItem( itemData : gameItemData ) : weak< UIInventoryItem >
	{
		var i : Int32;
		for( i = 0; i < m_cachedPlayerItems.Size(); i += 1 )
		{
			if( m_cachedPlayerItems[ i ].ID == itemData.GetID() )
			{
				return m_cachedPlayerItems[ i ];
			}
		}
		return NULL;
	}

	private function InitializeBrandData( brandData : UIGlamdocBrandData_Record )
	{
		var i : Int32;
		if( !( TDBID.IsValid( brandData.GetRecordID() ) ) || !( m_equippedStyle ) )
		{
			HideColorTab();
			return;
		}
		for( i = 0; i < m_colorPickerWidgets.Size(); i += 1 )
		{
			inkWidgetRef.SetVisible( m_colorPickerWidgets[ i ], true );
		}
		ShowVisualSelectionOnColorWheels();
		SetColorWheelTintFromBrandData( m_colorWheelColorA, brandData );
		SetColorWheelTintFromBrandData( m_colorWheelColorB, brandData );
		inkImageRef.SetAtlasResource( m_brandIcon, brandData.BrandIconHandle().AtlasResourcePath() );
		inkImageRef.SetTexturePart( m_brandIcon, brandData.BrandIconHandle().AtlasPartName() );
	}

	private function InitializeEquippedCyberArm()
	{
		var items : array< weak< UIInventoryItem > >;
		items = m_uiInventorySystem.GetPlayerAreaItems( gamedataEquipmentArea.ArmsCW );
		if( items.Size() > 0 )
		{
			m_equippedArmItem = items[ 0 ];
		}
	}

	private function HideColorTab()
	{
		var i : Int32;
		for( i = 0; i < m_colorPickerWidgets.Size(); i += 1 )
		{
			inkWidgetRef.SetVisible( m_colorPickerWidgets[ i ], false );
		}
		ResetHighlightOnColorWheel();
	}

	private function SetColorTabInputHintsVisibility( isVisible : Bool )
	{
		if( isVisible )
		{
			m_buttonHintsController.AddButtonHint( 'unequip_item', "LocKey#97495" );
			m_buttonHintsController.AddButtonHint( 'select', "LocKey#97494" );
		}
		else
		{
			m_buttonHintsController.RemoveButtonHint( 'unequip_item' );
			m_buttonHintsController.RemoveButtonHint( 'select' );
		}
	}

	private function SetColorWheelTintFromBrandData( colorWheel : cyberwareCustomColorWheelDef, brandData : UIGlamdocBrandData_Record )
	{
		inkWidgetRef.SetTintColor( colorWheel.m_color1Part, CyberwareCustomizationHelper.GetColorFromBrandData( brandData, 0 ) );
		inkWidgetRef.SetTintColor( colorWheel.m_color2Part, CyberwareCustomizationHelper.GetColorFromBrandData( brandData, 1 ) );
		inkWidgetRef.SetTintColor( colorWheel.m_color3Part, CyberwareCustomizationHelper.GetColorFromBrandData( brandData, 2 ) );
		inkWidgetRef.SetTintColor( colorWheel.m_color4Part, CyberwareCustomizationHelper.GetColorFromBrandData( brandData, 3 ) );
		inkWidgetRef.SetTintColor( colorWheel.m_color5Part, CyberwareCustomizationHelper.GetColorFromBrandData( brandData, 4 ) );
	}

	protected event OnSetMenuEventDispatcher( menuEventDispatcher : weak< inkMenuEventDispatcher > )
	{
		m_menuEventDispatcher = menuEventDispatcher;
		m_menuEventDispatcher.RegisterToEvent( 'OnBack', this, 'OnBack' );
		m_menuEventDispatcher.RegisterToEvent( 'OnBeforeLeaveScenario', this, 'OnBeforeLeaveScenario' );
		m_menuEventDispatcher.RegisterToEvent( 'OnCloseMenu', this, 'OnCloseMenu' );
	}

	protected event OnBeforeLeaveScenario( userData : IScriptable )
	{
		var i : Int32;
		if( m_anyChangesMade )
		{
			m_inventorySystem.SaveSpendByVendorID( m_VendorDataManager.GetVendorID(), m_spendCost, m_spendCount );
			for( i = 0; i < m_factThresholds.Size(); i += 1 )
			{
				if( ( m_spendCost > m_factThresholds[ i ].SpendCost() ) && ( m_spendCount > m_factThresholds[ i ].SpendCount() ) )
				{
					if( m_questSystem.GetFact( m_factThresholds[ i ].FactKey() ) <= i )
					{
						m_questSystem.SetFact( m_factThresholds[ i ].FactKey(), i + 1 );
					}
				}
			}
			if( m_colorChanged && !( m_appearanceChanged ) )
			{
				m_questSystem.SetFact( 'glamdoc_color', 1 );
			}
			MenuUIUtils.RequestAutoSave( m_player, 1.0 );
		}
	}

	protected event OnCloseMenu( userData : IScriptable )
	{
		if( m_inventoryView )
		{
			m_inventoryView.ReleaseVirtualGrid();
		}
	}

	protected event OnUninitialize()
	{
		if( m_attachmentSlotCallback )
		{
			m_transactionSystem.UnregisterAttachmentSlotListener( m_previewPuppet, m_attachmentSlotCallback );
		}
		SendLatestToCyberwareCustomization();
		m_player.UnregisterInputListener( this, '__DEVICE_CHANGED__' );
		UnregisterFromGlobalInputCallback( 'OnPostOnPress', this, 'OnButtonPress' );
		UnregisterFromGlobalInputCallback( 'OnPostOnRelative', this, 'OnMouseInput' );
		UnregisterFromGlobalInputCallback( 'OnPostOnRelease', this, 'OnGlobalInputReleased' );
		UnregisterFromGlobalInputCallback( 'OnPostOnAxis', this, 'OnGlobalAxisInput' );
		m_menuEventDispatcher.UnregisterFromEvent( 'OnBack', this, 'OnBack' );
		m_menuEventDispatcher.UnregisterFromEvent( 'OnBeforeLeaveScenario', this, 'OnBeforeLeaveScenario' );
		inkWidgetRef.UnregisterFromCallback( m_mouseHitColor1Ref, 'OnHoverOut', this, 'OnHoverOutColorWheel' );
		inkWidgetRef.UnregisterFromCallback( m_mouseHitColor2Ref, 'OnHoverOut', this, 'OnHoverOutColorWheel' );
		UnregisterBlackboard();
		ProcessFakeUpdate( false );
	}

	private function QuitVendor()
	{
		m_menuEventDispatcher.SpawnEvent( 'OnVendorClose' );
	}

	private function UpdateAndApplyColor( colorIndex : Uint8, selectedMode : cyberwareCustomColorSelectorActiveMode )
	{
		SelectColorIndexForMode( colorIndex, selectedMode );
		switch( selectedMode )
		{
			case cyberwareCustomColorSelectorActiveMode.Primary:
			{
				m_cachedNewColorA = GetColorFromIndexForCurrentBrand( colorIndex );
				SetVisualSelectionOnColorWheel( m_colorWheelColorA, true );
			}
			break;
			case cyberwareCustomColorSelectorActiveMode.Secondary:
			{
				m_cachedNewColorB = GetColorFromIndexForCurrentBrand( colorIndex );
				SetVisualSelectionOnColorWheel( m_colorWheelColorB, true );
			}
			break;
		}
		UpdateSwapArrows();
		SendCustomizationColorToSystem();
	}

	private function GetColorFromIndexForCurrentBrand( index : Uint8 ) : Color
	{
		return CyberwareCustomizationHelper.GetColorFromBrandData( CyberwareCustomizationHelper.GetBrandDataFromCustomizationItem( m_customizationItemData ), index );
	}

	private function SendCustomizationColorToSystem()
	{
		var request : SaveAndApplyCyberWareCustomColorRequest;
		var savedData : CyberwareCustomizationPersistentData;
		request = new SaveAndApplyCyberWareCustomColorRequest;
		request.enabled = true;
		request.primaryColorIndex = ( ( m_colorADefined ) ? ( m_selectedIndexColorA ) : ( ( ( Uint8 )( CyberwareCustomizationHelper.GetDefaultPrimaryColorIndexFromCustomizationItem( m_equippedStyle.GetItemData() ) ) ) ) );
		request.secondaryColorIndex = ( ( m_colorBDefined ) ? ( m_selectedIndexColorB ) : ( ( ( Uint8 )( CyberwareCustomizationHelper.GetDefaultSecondaryColorIndexFromCustomizationItem( m_equippedStyle.GetItemData() ) ) ) ) );
		savedData = m_cyberwareCustomizationSystem.GetSavedData();
		m_colorChanged = ( request.primaryColorIndex != savedData.primaryColorIndex ) || ( request.secondaryColorIndex != savedData.secondaryColorIndex );
		if( m_colorChanged )
		{
			m_anyChangesMade = true;
			SpawnOnEquipEvent();
		}
		m_cyberwareCustomizationSystem.QueueRequest( request );
	}

	private function UpdatePuppetBasedOnCurrentScreen()
	{
		var currentArmWareType : ArmsWareType;
		currentArmWareType = GetCurrentArmsWareType();
		if( m_screenType == GlamdocScreenType.Appearance )
		{
			PlayAnimationOnPreviewPuppet( m_cyberwarePreviewSettingsTable[ ( ( Int32 )( currentArmWareType ) ) ].m_apperanceAnimationName, 'inventory' );
			SetCameraSlotForPreviewPuppet( m_cyberwarePreviewSettingsTable[ ( ( Int32 )( currentArmWareType ) ) ].m_apperanceCameraLocation, false );
		}
		else
		{
			PlayAnimationOnPreviewPuppet( m_cyberwarePreviewSettingsTable[ ( ( Int32 )( currentArmWareType ) ) ].m_colorCustomizationAnimationName, 'inventory' );
			SetCameraSlotForPreviewPuppet( m_cyberwarePreviewSettingsTable[ ( ( Int32 )( currentArmWareType ) ) ].m_colorCustomizationCameraLocation, false );
		}
	}

	protected event OnGlobalAxisInput( e : inkPointerEvent )
	{
		var value : Float;
		value = e.GetAxisData();
		if( e.IsAction( 'popup_axisX' ) )
		{
			m_axisInputCache.X = value;
		}
		else if( e.IsAction( 'popup_axisY' ) )
		{
			m_axisInputCache.Y = value;
		}
	}

	protected event OnButtonPress( e : inkPointerEvent )
	{
		if( !( e.IsHandled() ) )
		{
			if( e.IsAction( 'back' ) )
			{
				QuitVendor();
			}
			e.Handle();
		}
	}

	protected event OnGlobalInputReleased( e : inkPointerEvent )
	{
		var nextMode : cyberwareCustomColorSelectorActiveMode;
		if( e.IsHandled() )
		{
			return false;
		}
		if( e.IsAction( 'UI_vehicle_customization_select' ) && m_screenType == GlamdocScreenType.ColorPicker )
		{
			e.Handle();
			ProcessPointerClick( e );
			GameInstance.GetAudioSystem( m_player.GetGame() ).Play( 'ui_menu_onpress' );
			PlayRumble( RumbleStrength.SuperLight, RumbleType.Pulse, RumblePosition.Both );
		}
		else if( e.IsAction( 'UI_vehicle_customization_swap' ) && m_screenType == GlamdocScreenType.ColorPicker )
		{
			if( SwapColors() )
			{
				e.Consume();
				GameInstance.GetAudioSystem( m_player.GetGame() ).Play( 'ui_menu_onpress' );
			}
		}
		else if( e.IsAction( 'unequip_item' ) && m_screenType == GlamdocScreenType.ColorPicker )
		{
			if( ResetColorsToDefault() )
			{
				e.Consume();
				GameInstance.GetAudioSystem( m_player.GetGame() ).Play( 'ui_menu_onpress' );
			}
		}
		else if( ( e.IsAction( 'next_menu' ) || e.IsAction( 'prior_menu' ) ) && !( m_isInEquipPopup ) )
		{
			m_tabRoot.Toggle( ( ( m_screenType == GlamdocScreenType.Appearance ) ? ( 1 ) : ( 0 ) ) );
			e.Consume();
		}
		else if( ( e.IsAction( 'next_sub_menu' ) || e.IsAction( 'prior_sub_menu' ) ) && m_screenType == GlamdocScreenType.ColorPicker )
		{
			nextMode = ( ( m_activeMode == cyberwareCustomColorSelectorActiveMode.Primary ) ? ( cyberwareCustomColorSelectorActiveMode.Secondary ) : ( cyberwareCustomColorSelectorActiveMode.Primary ) );
			SwitchActiveMode( nextMode );
		}
	}

	private function SwitchSelectionTab( screenType : GlamdocScreenType )
	{
		var i : Int32;
		var targetWidgets : array< inkWidgetRef >;
		var previousWidgets : array< inkWidgetRef >;
		var savedData : CyberwareCustomizationPersistentData;
		savedData = m_cyberwareCustomizationSystem.GetSavedData();
		if( screenType == GlamdocScreenType.ColorPicker && !( ItemID.IsValid( savedData.customizationItemID ) ) )
		{
			return;
		}
		m_screenType = screenType;
		m_selector.SetIsDisabled( m_screenType != GlamdocScreenType.Appearance );
		if( m_screenType == GlamdocScreenType.Appearance )
		{
			targetWidgets = m_appearanceWidgets;
			previousWidgets = m_colorPickerWidgets;
			SetColorTabInputHintsVisibility( false );
			ResetVisualHoverOnColorWheel( m_colorWheelColorA );
			ResetVisualHoverOnColorWheel( m_colorWheelColorB );
		}
		else
		{
			targetWidgets = m_colorPickerWidgets;
			previousWidgets = m_appearanceWidgets;
			SetColorTabInputHintsVisibility( true );
			if( m_activeMode == cyberwareCustomColorSelectorActiveMode.None )
			{
				SwitchActiveMode( cyberwareCustomColorSelectorActiveMode.Primary );
			}
		}
		UpdateCursorVisibility();
		UpdatePuppetBasedOnCurrentScreen();
		for( i = 0; i < targetWidgets.Size(); i += 1 )
		{
			inkWidgetRef.SetOpacity( targetWidgets[ i ], 1.0 );
			inkWidgetRef.SetInteractive( targetWidgets[ i ], true );
		}
		for( i = 0; i < previousWidgets.Size(); i += 1 )
		{
			inkWidgetRef.SetOpacity( previousWidgets[ i ], 0.30000001 );
			inkWidgetRef.SetInteractive( previousWidgets[ i ], false );
		}
	}

	protected event OnMouseInput( e : inkPointerEvent )
	{
		if( e.IsAction( 'mouse_x' ) || e.IsAction( 'mouse_y' ) )
		{
			ProcessMouseInput( e.GetScreenSpacePosition() );
		}
	}

	private function ProcessMouseInput( mousePos : Vector2 )
	{
		var mouseLocationRelativeToColorPicker : Vector2;
		var angle : Float;
		if( m_screenType != GlamdocScreenType.ColorPicker )
		{
			return;
		}
		if( !( ShouldProcessMouseInputForActiveColorWheel( mousePos ) ) )
		{
			return;
		}
		mouseLocationRelativeToColorPicker = GetMouseLocationRelativeToActiveColorPicker( mousePos );
		angle = AtanF( mouseLocationRelativeToColorPicker.Y, mouseLocationRelativeToColorPicker.X );
		ProcessPointerMovement( GetColorIndexFromAngle( angle ), GetActiveColorWheelData() );
	}

	private function GetColorIndexFromAngle( angle : Float ) : Uint8
	{
		var sectionAngle : Int32;
		var offset : Float;
		sectionAngle = 72;
		offset = -( ( Pi() / 5.0 ) ) - ( Pi() / 2.0 );
		angle = WrapAngle( angle - offset );
		return ( ( Uint8 )( ( ( Int32 )( Rad2Deg( angle ) ) ) / sectionAngle ) );
	}

	private function ProcessPointerMovement( index : Uint8, wheelData : cyberwareCustomColorWheelDef )
	{
		m_hoveredIndex = index;
		if( m_hoveredIndex != m_lastSelectedIndex )
		{
			m_lastSelectedIndex = index;
			PlayRumble( RumbleStrength.SuperLight, RumbleType.Pulse, RumblePosition.Left );
		}
		UpdateHoveredPartForWheel( index, wheelData );
	}

	protected event OnFakeUpdate( proxy : inkAnimProxy )
	{
		if( m_screenType == GlamdocScreenType.ColorPicker && !( m_player.PlayerLastUsedKBM() ) )
		{
			ProcessGamePadInput();
		}
	}

	private function ProcessGamePadInput()
	{
		var angle : Float;
		if( ( AbsF( m_axisInputCache.Y ) > m_axisInputThreshold ) || ( AbsF( m_axisInputCache.X ) > m_axisInputThreshold ) )
		{
			angle = AtanF( m_axisInputCache.X, m_axisInputCache.Y ) - ( Pi() / 2.0 );
			ProcessPointerMovement( GetColorIndexFromAngle( angle ), GetActiveColorWheelData() );
			m_axisInputCache.X = 0.0;
			m_axisInputCache.Y = 0.0;
		}
	}

	private function UpdateCursorVisibility()
	{
		var evt : inkMenuLayer_SetCursorVisibility;
		var visible : Bool;
		visible = m_player.PlayerLastUsedKBM() || m_screenType == GlamdocScreenType.Appearance;
		evt = new inkMenuLayer_SetCursorVisibility;
		evt.Init( visible );
		QueueEvent( evt );
	}

	private function UpdateHoveredPartForWheel( index : Uint8, wheelData : cyberwareCustomColorWheelDef )
	{
		ResetVisualHoverOnColorWheel( wheelData );
		inkWidgetRef.SetVisible( wheelData.m_hoverFrame, true );
		inkWidgetRef.SetRotation( wheelData.m_hoverFrame, GetSelectorAngleFromColorIndex( index ) );
	}

	private function ResetVisualHoverOnColorWheel( wheelData : cyberwareCustomColorWheelDef )
	{
		inkWidgetRef.SetVisible( wheelData.m_hoverFrame, false );
	}

	private function SetVisualSelectionOnColorWheel( wheelData : cyberwareCustomColorWheelDef, isVisible : Bool )
	{
		inkWidgetRef.SetVisible( wheelData.m_selectionFrame, isVisible );
	}

	private function ShowVisualSelectionOnColorWheels()
	{
		SetVisualSelectionOnColorWheel( m_colorWheelColorA, m_colorADefined );
		SetVisualSelectionOnColorWheel( m_colorWheelColorB, m_colorBDefined );
	}

	private function ResetHighlightOnColorWheel()
	{
		ResetVisualHoverOnColorWheel( m_colorWheelColorA );
		SetVisualSelectionOnColorWheel( m_colorWheelColorA, false );
		ResetVisualHoverOnColorWheel( m_colorWheelColorB );
		SetVisualSelectionOnColorWheel( m_colorWheelColorB, false );
	}

	private function ProcessPointerClick( e : inkPointerEvent )
	{
		if( m_player.PlayerLastUsedKBM() )
		{
			switch( e.GetTarget() )
			{
				case inkWidgetRef.Get( m_mouseHitColor1Ref ):
				{
					SwitchActiveMode( cyberwareCustomColorSelectorActiveMode.Primary );
					ProcessMouseInput( e.GetScreenSpacePosition() );
				}
				break;
				case inkWidgetRef.Get( m_mouseHitColor2Ref ):
				{
					SwitchActiveMode( cyberwareCustomColorSelectorActiveMode.Secondary );
					ProcessMouseInput( e.GetScreenSpacePosition() );
				}
				break;
			}
			if( !( ShouldProcessMouseInputForActiveColorWheel( e.GetScreenSpacePosition() ) ) )
			{
				return;
			}
		}
		switch( m_activeMode )
		{
			case cyberwareCustomColorSelectorActiveMode.Primary:
			{
				m_colorADefined = true;
				m_selectedIndexColorA = m_hoveredIndex;
				UpdateAndApplyColor( m_selectedIndexColorA, cyberwareCustomColorSelectorActiveMode.Primary );
				UpdateHoveredPartForWheel( m_selectedIndexColorA, m_colorWheelColorA );
			}
			break;
			case cyberwareCustomColorSelectorActiveMode.Secondary:
			{
				m_colorBDefined = true;
				m_selectedIndexColorB = m_hoveredIndex;
				UpdateAndApplyColor( m_selectedIndexColorB, cyberwareCustomColorSelectorActiveMode.Secondary );
				UpdateHoveredPartForWheel( m_selectedIndexColorB, m_colorWheelColorB );
			}
			break;
		}
	}

	private function SelectColorIndexForMode( index : Uint8, mode : cyberwareCustomColorSelectorActiveMode )
	{
		switch( mode )
		{
			case cyberwareCustomColorSelectorActiveMode.Primary:
			{
				m_selectedIndexColorA = index;
				inkWidgetRef.SetRotation( m_colorWheelColorA.m_selectionFrame, GetSelectorAngleFromColorIndex( index ) );
			}
			break;
			case cyberwareCustomColorSelectorActiveMode.Secondary:
			{
				m_selectedIndexColorB = index;
				inkWidgetRef.SetRotation( m_colorWheelColorB.m_selectionFrame, GetSelectorAngleFromColorIndex( index ) );
			}
			break;
		}
	}

	private function GetSelectorAngleFromColorIndex( colorIndex : Uint8 ) : Float
	{
		var sectionAngle : Float;
		sectionAngle = ( 2.0 * Pi() ) / 5.0;
		return Rad2Deg( WrapAngle( sectionAngle * colorIndex ) );
	}

	private function ShouldProcessMouseInputForActiveColorWheel( mousePos : Vector2 ) : Bool
	{
		var mouseLocationRelativeToColorPicker : Vector2;
		var activeColorWheelData : cyberwareCustomColorWheelDef;
		mouseLocationRelativeToColorPicker = GetMouseLocationRelativeToActiveColorPicker( mousePos );
		activeColorWheelData = GetActiveColorWheelData();
		return ( ( mouseLocationRelativeToColorPicker.X * mouseLocationRelativeToColorPicker.X ) + ( mouseLocationRelativeToColorPicker.Y * mouseLocationRelativeToColorPicker.Y ) ) <= ( ( activeColorWheelData.m_wheelRadius + activeColorWheelData.m_selectionMargin ) * ( activeColorWheelData.m_wheelRadius + activeColorWheelData.m_selectionMargin ) );
	}

	private function GetMouseLocationRelativeToActiveColorPicker( mousePos : Vector2 ) : Vector2
	{
		var rootSize : Vector2;
		var localPos : Vector2;
		var offsetMargins : inkMargin;
		var offsetX, offsetY : Float;
		offsetMargins = inkWidgetRef.GetMargin( m_CursorRootOffsetPoint );
		localPos = WidgetUtils.GlobalToLocal( inkWidgetRef.Get( m_CursorRootContainerRef ), mousePos );
		offsetX = ( offsetMargins.left - ( rootSize.X / 2.0 ) ) * -1.0;
		offsetY = ( offsetMargins.top - ( rootSize.Y / 2.0 ) ) * -1.0;
		rootSize = GetRootWidget().GetSize();
		return Vector2( ( localPos.X + offsetX ) - ( rootSize.X / 2.0 ), ( localPos.Y + offsetY ) - ( rootSize.Y / 2.0 ) );
	}

	private function WrapAngle( angle : Float ) : Float
	{
		var value : Float;
		value = ( angle + ( 2.0 * Pi() ) ) % ( 2.0 * Pi() );
		return value;
	}

	private function SwitchActiveMode( optional switchTo : cyberwareCustomColorSelectorActiveMode )
	{
		var colorWheelText : String;
		switch( switchTo )
		{
			case cyberwareCustomColorSelectorActiveMode.Primary:
			{
				m_activeMode = cyberwareCustomColorSelectorActiveMode.Primary;
				colorWheelText = ( GetLocalizedText( "LocKey#95816" ) + " " ) + IntToString( ( ( Int32 )( m_activeMode ) ) );
				inkTextRef.SetText( m_colorWheelSubMenuTitle, colorWheelText );
			}
			break;
			case cyberwareCustomColorSelectorActiveMode.Secondary:
			{
				m_activeMode = cyberwareCustomColorSelectorActiveMode.Secondary;
				colorWheelText = ( GetLocalizedText( "LocKey#95816" ) + " " ) + IntToString( ( ( Int32 )( m_activeMode ) ) );
				inkTextRef.SetText( m_colorWheelSubMenuTitle, colorWheelText );
			}
			break;
		}
		if( !( m_player.PlayerLastUsedKBM() ) )
		{
			switch( m_activeMode )
			{
				case cyberwareCustomColorSelectorActiveMode.Primary:
				{
					m_hoveredIndex = m_selectedIndexColorA;
				}
				break;
				case cyberwareCustomColorSelectorActiveMode.Secondary:
				{
					m_hoveredIndex = m_selectedIndexColorB;
				}
				break;
			}
		}
		inkWidgetRef.SetVisible( m_colorPaletteRef, true );
		UpdateWidgetsForNewMode( m_activeMode );
	}

	private function UpdateWidgetsForNewMode( currentMode : cyberwareCustomColorSelectorActiveMode )
	{
		switch( currentMode )
		{
			case cyberwareCustomColorSelectorActiveMode.Primary:
			{
				inkWidgetRef.SetOpacity( m_colorWheelColorA.m_parent, 0.80000001 );
				inkWidgetRef.SetOpacity( m_colorWheelColorB.m_parent, 0.1 );
				UpdateHoveredPartForWheel( m_selectedIndexColorA, m_colorWheelColorA );
				SelectColorIndexForMode( m_selectedIndexColorA, cyberwareCustomColorSelectorActiveMode.Primary );
				ResetVisualHoverOnColorWheel( m_colorWheelColorB );
			}
			break;
			case cyberwareCustomColorSelectorActiveMode.Secondary:
			{
				inkWidgetRef.SetOpacity( m_colorWheelColorA.m_parent, 0.1 );
				inkWidgetRef.SetOpacity( m_colorWheelColorB.m_parent, 0.80000001 );
				UpdateHoveredPartForWheel( m_selectedIndexColorB, m_colorWheelColorB );
				SelectColorIndexForMode( m_selectedIndexColorB, cyberwareCustomColorSelectorActiveMode.Secondary );
				ResetVisualHoverOnColorWheel( m_colorWheelColorA );
			}
			break;
		}
	}

	private function SwapColors() : Bool
	{
		var swapIndex : Uint8;
		var swapCachedColor : Color;
		if( !( m_colorADefined ) )
		{
			SelectColorIndexForMode( ( ( Uint8 )( CyberwareCustomizationHelper.GetDefaultPrimaryColorIndexFromCustomizationItem( m_equippedStyle.GetItemData() ) ) ), cyberwareCustomColorSelectorActiveMode.Primary );
		}
		if( !( m_colorBDefined ) )
		{
			SelectColorIndexForMode( ( ( Uint8 )( CyberwareCustomizationHelper.GetDefaultSecondaryColorIndexFromCustomizationItem( m_equippedStyle.GetItemData() ) ) ), cyberwareCustomColorSelectorActiveMode.Secondary );
		}
		swapIndex = m_selectedIndexColorA;
		swapCachedColor = m_cachedNewColorA;
		m_selectedIndexColorA = m_selectedIndexColorB;
		m_cachedNewColorA = m_cachedNewColorB;
		m_selectedIndexColorB = swapIndex;
		m_cachedNewColorB = swapCachedColor;
		UpdateControlsState();
		UpdateSwapArrows();
		SendCustomizationColorToSystem();
		return true;
	}

	private function UpdateSwapArrows()
	{
		if( !( m_colorADefined ) || !( m_colorBDefined ) )
		{
			inkWidgetRef.SetVisible( m_swapContainer, false );
			return;
		}
		inkWidgetRef.SetVisible( m_swapContainer, true );
		inkImageRef.SetTintColor( m_swapArrowPrimaryColor, m_cachedNewColorA );
		inkImageRef.SetTintColor( m_swapArrowSecondaryColor, m_cachedNewColorB );
	}

	private function ResetColorsToDefault() : Bool
	{
		var request : SaveAndApplyCyberWareCustomColorRequest;
		var savedData : CyberwareCustomizationPersistentData;
		request = new SaveAndApplyCyberWareCustomColorRequest;
		if( !( m_colorADefined ) && !( m_colorBDefined ) )
		{
			return false;
		}
		ResetDefinedColors();
		request.enabled = true;
		request.primaryColorIndex = m_selectedIndexColorA;
		request.secondaryColorIndex = m_selectedIndexColorB;
		savedData = m_cyberwareCustomizationSystem.GetSavedData();
		m_colorChanged = ( request.primaryColorIndex != savedData.primaryColorIndex ) || ( request.secondaryColorIndex != savedData.secondaryColorIndex );
		if( m_colorChanged )
		{
			m_anyChangesMade = true;
		}
		m_cyberwareCustomizationSystem.QueueRequest( request );
		UpdateSwapArrows();
		return true;
	}

	private function ResetDefinedColors()
	{
		var defaultColorA : Uint8;
		var defaultColorB : Uint8;
		defaultColorA = ( ( Uint8 )( CyberwareCustomizationHelper.GetDefaultPrimaryColorIndexFromCustomizationItem( m_equippedStyle.GetItemData() ) ) );
		defaultColorB = ( ( Uint8 )( CyberwareCustomizationHelper.GetDefaultSecondaryColorIndexFromCustomizationItem( m_equippedStyle.GetItemData() ) ) );
		m_colorADefined = true;
		SelectColorIndexForMode( defaultColorA, cyberwareCustomColorSelectorActiveMode.Primary );
		m_cachedNewColorA = GetColorFromIndexForCurrentBrand( defaultColorA );
		m_colorBDefined = true;
		SelectColorIndexForMode( defaultColorB, cyberwareCustomColorSelectorActiveMode.Secondary );
		m_cachedNewColorB = GetColorFromIndexForCurrentBrand( defaultColorB );
	}

	private function UpdateControlsState()
	{
		if( m_colorADefined )
		{
			SelectColorIndexForMode( m_selectedIndexColorA, cyberwareCustomColorSelectorActiveMode.Primary );
		}
		if( m_colorBDefined )
		{
			SelectColorIndexForMode( m_selectedIndexColorB, cyberwareCustomColorSelectorActiveMode.Secondary );
		}
	}

	protected event OnAction( action : ListenerAction, consumer : ListenerActionConsumer )
	{
		if( ListenerAction.IsAction( action, '__DEVICE_CHANGED__' ) )
		{
			if( GetActiveInputMode() == m_activeInputMode )
			{
				return false;
			}
			m_activeInputMode = GetActiveInputMode();
			HideWidgetsWhenUsingKBM();
			UpdateCursorVisibility();
		}
	}

	private function HideWidgetsWhenUsingKBM()
	{
		var index : Int32;
		for( index = 0; index < m_hideWhenUsingKBM.Size(); index += 1 )
		{
			inkWidgetRef.SetVisible( m_hideWhenUsingKBM[ index ], !( m_player.PlayerLastUsedKBM() ) );
		}
	}

	private function GetActiveInputMode() : cyberwareCustomSelectorActiveInputMode
	{
		if( !( m_player ) )
		{
			return cyberwareCustomSelectorActiveInputMode.None;
		}
		else if( m_player.PlayerLastUsedKBM() )
		{
			return cyberwareCustomSelectorActiveInputMode.KBM;
		}
		else
		{
			return cyberwareCustomSelectorActiveInputMode.Gamepad;
		}
	}

	private function GetActiveColorWheelData() : cyberwareCustomColorWheelDef
	{
		switch( m_activeMode )
		{
			case cyberwareCustomColorSelectorActiveMode.Primary:
			{
				return m_colorWheelColorA;
			}
			break;
			case cyberwareCustomColorSelectorActiveMode.Secondary:
			{
				return m_colorWheelColorB;
			}
			break;
		}
		return m_colorWheelColorA;
	}

	protected function PlayHoverWidgetAnimation()
	{
		var playbackOptions : inkAnimOptions;
		playbackOptions.loopType = inkanimLoopType.Cycle;
		playbackOptions.loopInfinite = true;
		PlayLibraryAnimation( 'Reworked_PrimaryColor_Hover', playbackOptions );
		PlayLibraryAnimation( 'Reworked_SecondaryColor_Hover', playbackOptions );
	}

	protected event OnSlotClick( evt : ItemDisplayClickEvent )
	{
		var item : weak< UIInventoryItem >;
		var uiMenuNotification : UIMenuNotificationEvent;
		var type : VendorConfirmationPopupType;
		var isEquipped, isRequirementMet : Bool;
		item = evt.uiInventoryItem;
		isEquipped = item.IsEquipped();
		if( ( item == NULL ) || m_screenType != GlamdocScreenType.Appearance )
		{
			return false;
		}
		if( evt.actionName.IsAction( 'click' ) )
		{
			m_audioSystem.Play( 'ui_menu_onpress' );
			if( evt.displayContextData.IsVendorItem() )
			{
				isRequirementMet = ItemTagMatch( item.GetItemData(), ( ( ArmsWareType )( ( ( Int32 )( m_equippedArmItem.GetItemType() ) ) - ( ( Int32 )( gamedataItemType.Cyb_Launcher ) ) ) ) );
				if( !( isRequirementMet ) )
				{
					m_selector.SetIsDisabled( true );
					OpenConfirmationPopup( item, m_VendorDataManager.GetBuyingPrice( item.GetID() ), VendorConfirmationPopupType.BuyNotEquipableCyberware, 'OnBuyConfirmationPopupClosed' );
				}
				else if( m_VendorDataManager.GetBuyingPrice( item.GetID() ) > m_VendorDataManager.GetLocalPlayerCurrencyAmount() )
				{
					uiMenuNotification = new UIMenuNotificationEvent;
					uiMenuNotification.m_notificationType = UIMenuNotificationType.VNotEnoughMoney;
					m_uiSystem.QueueEvent( uiMenuNotification );
				}
				else
				{
					type = ( ( EquipmentSystem.GetInstance( m_player ).GetPlayerData( m_player ).IsEquippable( item.GetItemData() ) ) ? ( VendorConfirmationPopupType.BuyAndEquipCyberware ) : ( VendorConfirmationPopupType.BuyNotEquipableCyberware ) );
					OpenConfirmationPopup( item, m_VendorDataManager.GetBuyingPrice( item.GetID() ), type, 'OnBuyConfirmationPopupClosed' );
				}
				m_selector.SetIsDisabled( true );
				m_isInEquipPopup = true;
			}
			else if( !( isEquipped ) )
			{
				if( !( m_isProcessingCustomizationChange ) )
				{
					ApplyCyberwareCosmetic( item.GetItemData() );
					m_anyChangesMade = true;
				}
			}
		}
		else if( ( ( evt.actionName.IsAction( 'unequip_item' ) && ( m_equippedStyle != NULL ) ) && ItemID.IsValid( m_equippedStyle.GetID() ) ) && ( item.GetID() == m_equippedStyle.GetID() ) )
		{
			UpdateCurrentCustomizationItem( ItemID.None() );
			UnequipCyberwareCustomization();
			ReloadPreviewPuppetCyberarms();
			HideColorTab();
		}
	}

	protected event OnSelectorChange( evt : GlamdocSelectorChangeEvent )
	{
		if( m_screenType != GlamdocScreenType.Appearance || m_isInEquipPopup )
		{
			return false;
		}
		PlayRumble( RumbleStrength.SuperLight, RumbleType.Pulse, ( ( evt.SlidingRight ) ? ( RumblePosition.Right ) : ( RumblePosition.Left ) ) );
		m_audioSystem.Play( 'ui_gui_tab_change' );
		m_filterArea = m_allFilters[ evt.Index ];
		DisplayInventory();
		m_selector.Show( evt.Index );
		DollHover( gamedataEquipmentArea.ArmsCW );
		DollSelect( true );
	}

	private function DollHover( area : gamedataEquipmentArea )
	{
		if( m_dollHoverArea == area )
		{
			return;
		}
		if( m_dollSelected )
		{
			DollSelect( false );
		}
		if( m_dollHoverArea != gamedataEquipmentArea.Invalid )
		{
			m_animationController.StopHover();
		}
		if( area != gamedataEquipmentArea.Invalid )
		{
			m_animationController.StartHover();
		}
		m_dollHoverArea = area;
	}

	private function DollSelect( select : Bool )
	{
		if( m_dollHoverArea == gamedataEquipmentArea.Invalid || m_dollSelected == select )
		{
			return;
		}
		if( select )
		{
			m_animationController.StartSelect();
		}
		else
		{
			m_animationController.StopSelect();
		}
		m_dollSelected = select;
	}

	private function OpenConfirmationPopup( item : weak< UIInventoryItem >, price : Int32, type : VendorConfirmationPopupType, listener : CName )
	{
		var data : VendorConfirmationPopupData;
		m_audioSystem.Play( 'ui_hacking_access_granted' );
		data = new VendorConfirmationPopupData;
		data.notificationName = 'base\gameplay\gui\widgets\notifications\vendor_confirmation.inkwidget';
		data.isBlocking = true;
		data.useCursor = true;
		data.queueName = 'modal_popup';
		data.inventoryItem = item;
		data.quantity = item.GetQuantity();
		data.type = type;
		data.price = price;
		if( type == VendorConfirmationPopupType.BuyAndEquipCyberware || type == VendorConfirmationPopupType.BuyNotEquipableCyberware )
		{
			m_isPurchasing = true;
		}
		m_tokenPopup = ShowGameNotification( data );
		m_tokenPopup.RegisterListener( this, listener );
		m_buttonHintsController.Hide();
	}

	protected event OnBuyConfirmationPopupClosed( data : inkGameNotificationData )
	{
		var resultData : VendorConfirmationPopupCloseData;
		m_tokenPopup = NULL;
		resultData = ( ( VendorConfirmationPopupCloseData )( data ) );
		m_isInEquipPopup = false;
		m_selector.SetIsDisabled( false );
		if( resultData.confirm )
		{
			m_VendorDataManager.BuyItemFromVendor( resultData.inventoryItem.GetItemData(), resultData.inventoryItem.GetQuantity() );
		}
		else
		{
			m_isPurchasing = false;
		}
		m_buttonHintsController.Show();
		m_audioSystem.Play( 'ui_menu_onpress' );
	}

	public function OnItemBought( itemID : ItemID, itemData : weak< gameItemData > )
	{
		if( !( m_isPurchasing ) )
		{
			return;
		}
		m_isPurchased = true;
		m_isPurchasing = false;
		RemoveCachedVendorItem( itemID );
		m_InventoryManager.MarkToRebuild();
		if( !( ApplyCyberwareCosmetic( itemData ) ) )
		{
			m_isPurchased = false;
		}
		DisplayInventory();
		m_spendCost += m_VendorDataManager.GetBuyingPrice( itemID );
		m_spendCount += 1;
		if( m_spendCost > 111 )
		{
			m_questSystem.SetFact( '', 1 );
		}
		m_anyChangesMade = true;
	}

	private function RemoveCachedVendorItem( itemID : ItemID )
	{
		var i, limit : Int32;
		var item : weak< WrappedUIInventoryItem >;
		var hash : Uint64;
		hash = ItemID.GetCombinedHash( itemID );
		item = ( ( weak< weak< WrappedUIInventoryItem > > )( m_vendorWrappedItems.Get( hash ) ) );
		if( item != NULL )
		{
			for( i = 0, limit = m_cachedVendorItems.Size(); i < limit; i += 1 )
			{
				m_cachedVendorItems[ i ].Remove( item );
			}
			m_vendorItems.Remove( hash );
			m_vendorWrappedItems.Remove( hash );
		}
	}

	protected event OnUIVendorItemBoughtEvent( evt : UIVendorItemsBoughtEvent )
	{
		var i, limit : Int32;
		for( i = 0, limit = evt.itemsID.Size(); i < limit; i += 1 )
		{
			RemoveCachedVendorItem( evt.itemsID[ i ] );
		}
	}

	protected event OnSlotHover( evt : ItemDisplayHoverOverEvent )
	{
		var item : weak< UIInventoryItem >;
		var isVendorItem : Bool;
		m_TooltipsManager.HideTooltips();
		if( m_screenType == GlamdocScreenType.Appearance )
		{
			item = evt.uiInventoryItem;
			isVendorItem = evt.displayContextData.GetDisplayContext() == ItemDisplayContext.Vendor;
			SetButtonHintsHover( item, isVendorItem );
			if( ItemID.IsValid( item.GetID() ) )
			{
				ShowCWTooltip( item, evt.widget, isVendorItem );
			}
			if( isVendorItem )
			{
				MarketSystem.ItemInspected( m_VendorDataManager.GetVendorInstance(), ItemID.GetTDBID( item.ID ) );
			}
			if( item.GetID() == m_equippedStyle.GetID() )
			{
				m_minigridController.HighlightSlot( 0, true );
			}
		}
	}

	protected event OnSlotUnhover( evt : ItemDisplayHoverOutEvent )
	{
		m_TooltipsManager.HideTooltips();
		SetButtonHintsHoverOut();
		m_minigridController.UnhighlightSlot( 0 );
	}

	private function ShowCWTooltip( item : weak< UIInventoryItem >, widget : weak< inkWidget >, isVendorItem : Bool, optional iconErrorInfo : DEBUG_IconErrorInfo )
	{
		var anchor : weak< inkWidget >;
		var placement : gameuiETooltipPlacement;
		var tooltipData : UIInventoryItemTooltipWrapper;
		anchor = widget;
		placement = gameuiETooltipPlacement.RightTop;
		tooltipData = UIInventoryItemTooltipWrapper.Make( item, ( ( isVendorItem ) ? ( m_vendorItemDisplayContext ) : ( m_playerItemDisplayContext ) ) );
		m_TooltipsManager.ShowTooltipAtWidget( 'itemTooltip', anchor, tooltipData, placement, false, inkMargin( m_defaultTooltipGap, 0.0, 0.0, 0.0 ) );
	}

	private function SetButtonHintsHover( item : weak< UIInventoryItem >, isVendorItem : Bool )
	{
		var isEquipped, isEmpty : Bool;
		isEmpty = item == NULL;
		isEquipped = item.IsEquipped();
		if( m_screenType == GlamdocScreenType.Appearance )
		{
			if( isEquipped && item.GetEquipmentArea() != gamedataEquipmentArea.EyesCW )
			{
				m_buttonHintsController.AddButtonHint( 'unequip_item', GetLocalizedText( "UI-UserActions-Unequip" ) );
			}
			if( isEmpty || isEquipped )
			{
				m_buttonHintsController.AddButtonHint( 'select', "LocKey#34928" );
			}
			else if( isVendorItem )
			{
				m_buttonHintsController.AddButtonHint( 'select', "LocKey#17847" );
			}
			else
			{
				m_buttonHintsController.AddButtonHint( 'select', "LocKey#246" );
			}
			SetCursorContext( 'Hover' );
		}
	}

	private function SetButtonHintsHoverOut()
	{
		m_buttonHintsController.RemoveButtonHint( 'unequip_item' );
		m_buttonHintsController.RemoveButtonHint( 'select' );
	}

	public function SendLatestToCyberwareCustomization()
	{
		var request : SaveAndApplyCyberwareCustomizationDataRequest;
		var savedData : CyberwareCustomizationPersistentData;
		savedData = m_cyberwareCustomizationSystem.GetSavedData();
		HidePuppetPreview();
		m_isProcessingCustomizationChange = true;
		request = new SaveAndApplyCyberwareCustomizationDataRequest;
		request.enabled = true;
		request.customizationItem = m_equippedStyle.GetItemData();
		request.switcherName = ( ( m_equippedStyle ) ? ( CyberwareCustomizationHelper.GetCyberarmTypeFromCustomizationItem( m_equippedStyle.GetItemData() ) ) : ( savedData.switcherName ) );
		request.switcherIndex = ( ( Uint32 )( CyberwareCustomizationHelper.GetCustomizationIndexFromCustomizationItem( m_equippedStyle.GetItemData() ) ) );
		request.primaryColorIndex = ( ( m_colorADefined ) ? ( m_selectedIndexColorA ) : ( ( ( Uint8 )( CyberwareCustomizationHelper.GetDefaultPrimaryColorIndexFromCustomizationItem( m_equippedStyle.GetItemData() ) ) ) ) );
		request.secondaryColorIndex = ( ( m_colorBDefined ) ? ( m_selectedIndexColorB ) : ( ( ( Uint8 )( CyberwareCustomizationHelper.GetDefaultSecondaryColorIndexFromCustomizationItem( m_equippedStyle.GetItemData() ) ) ) ) );
		m_cyberwareCustomizationSystem.QueueRequest( request );
	}

	public function UnequipCyberwareCustomization()
	{
		var custoRequest : SaveAndApplyCyberwareCustomizationDataRequest;
		var unequipRequest : UnequipRequest;
		var savedData : CyberwareCustomizationPersistentData;
		savedData = m_cyberwareCustomizationSystem.GetSavedData();
		HidePuppetPreview();
		m_isProcessingCustomizationChange = true;
		custoRequest = new SaveAndApplyCyberwareCustomizationDataRequest;
		custoRequest.enabled = false;
		custoRequest.switcherName = savedData.switcherName;
		custoRequest.switcherIndex = 0;
		m_cyberwareCustomizationSystem.QueueRequest( custoRequest );
		unequipRequest = new UnequipRequest;
		unequipRequest.areaType = gamedataEquipmentArea.ArmsCWStyle;
		unequipRequest.owner = m_player;
		unequipRequest.slotIndex = 0;
		unequipRequest.force = false;
		GameInstance.GetScriptableSystemsContainer( m_player.GetGame() ).Get( 'EquipmentSystem' ).QueueRequest( unequipRequest );
		m_anyChangesMade = true;
		SpawnOnEquipEvent();
	}

	private function ApplyCyberwareCosmetic( itemData : weak< gameItemData > ) : Bool
	{
		var notification : UIMenuNotificationEvent;
		var additionalInfo : VendorRequirementsNotMetNotificationData;
		var equipRequest : EquipRequest;
		if( !( CheckIfCanApply( itemData ) ) )
		{
			notification = new UIMenuNotificationEvent;
			notification.m_notificationType = UIMenuNotificationType.VendorRequirementsNotMet;
			additionalInfo = new VendorRequirementsNotMetNotificationData;
			additionalInfo.m_data = RPGManager.GetFirstUnmetEquipRequirement( m_player, RPGManager.GetEquipRequirements( m_player, itemData ) );
			notification.m_additionalInfo = additionalInfo;
			m_uiSystem.QueueEvent( notification );
			m_audioSystem.Play( 'ui_menu_attributes_fail' );
			return false;
		}
		UpdateCurrentCustomizationItem( itemData.GetID() );
		m_customizationItemData = m_equippedStyle.GetItemData();
		InitializeBrandData( CyberwareCustomizationHelper.GetBrandDataFromCustomizationItem( m_customizationItemData ) );
		ResetColorsToDefault();
		SendLatestToCyberwareCustomization();
		ReloadPreviewPuppetCyberarms();
		equipRequest = new EquipRequest;
		equipRequest.owner = m_player;
		equipRequest.itemID = itemData.GetID();
		equipRequest.slotIndex = 0;
		GameInstance.GetScriptableSystemsContainer( m_player.GetGame() ).Get( 'EquipmentSystem' ).QueueRequest( equipRequest );
		if( m_isPurchased )
		{
			m_isPurchased = false;
			m_audioSystem.Play( 'ui_gui_cyberware_capacity_guage_up_lp_01' );
		}
		if( m_minigridController )
		{
			m_minigridController.UpdateData( gamedataEquipmentArea.ArmsCWStyle, m_uiInventorySystem.GetPlayerAreaItems( gamedataEquipmentArea.ArmsCWStyle ) );
		}
		SpawnOnEquipEvent();
		return true;
	}

	protected event OnItemEquipped( value : Variant )
	{
		m_uiInventorySystem.GetInventoryItemsManager().FlushEquippedItems();
		ResetColorsToDefault();
		QueueEvent( new DelayedItemEquipped );
		QueueEvent( new RipperdocRefreshInventoryEvent );
	}

	protected event OnDelayedItemEquipped( evt : DelayedItemEquipped )
	{
		UpdateMinigrid();
	}

	protected event OnRefreshInventoryEvent( evt : RipperdocRefreshInventoryEvent )
	{
		DisplayInventory();
	}

	protected event OnUIInventoryItemAdded( evt : UIInventoryItemAdded )
	{
		PreparePlayerItems();
		QueueEvent( new RipperdocRefreshInventoryEvent );
	}

	private function RegisterInventoryListener( player : GameObject )
	{
		var itemBoughtCallback : GlamDocItemBoughtCallback;
		itemBoughtCallback = new GlamDocItemBoughtCallback;
		itemBoughtCallback.itemID = ItemID.None();
		itemBoughtCallback.Bind( this );
		m_inventoryListener = GameInstance.GetTransactionSystem( player.GetGame() ).RegisterInventoryListener( player, itemBoughtCallback );
	}

	private function SpawnMinigrid()
	{
		var gridUserData : GridUserData;
		var category : RipperdocCategory;
		category = RipperdocCategory( gamedataEquipmentArea.ArmsCWStyle, inkEHorizontalAlign.Left, m_armsAnchor );
		inkCompoundRef.RemoveAllChildren( category.parent );
		gridUserData = new GridUserData;
		gridUserData.equipArea = category.equipArea;
		gridUserData.align = category.align;
		gridUserData.parent = category.parent;
		AsyncSpawnFromLocal( inkCompoundRef.Get( category.parent ), 'ArmsInventoryMiniGridLeft', this, 'OnMinigridSpawned', gridUserData );
	}

	protected event OnMinigridSpawned( widget : inkWidget, userData : IScriptable )
	{
		var i, limit : Int32;
		var gridUserData : GridUserData;
		var items : array< weak< UIInventoryItem > >;
		var margin : inkMargin;
		margin.left = -300.0;
		margin.top = -130.0;
		m_minigridTargetAnchorMargin = margin;
		gridUserData = ( ( GridUserData )( userData ) );
		widget.SetHAlign( gridUserData.align );
		m_minigridController = ( ( CyberwareInventoryMiniGrid )( widget.GetController() ) );
		items.PushBack( m_equippedStyle );
		for( i = 0, limit = items.Size(); i < limit; i += 1 )
		{
			items[ i ].GetRequirementsManager( m_player ).SetIsEquippableRaw( false );
		}
		m_minigridController.SetTargetMargin( m_minigridTargetAnchorMargin, gridUserData.parent );
		m_minigridController.SetupData( gridUserData.equipArea, items, this, '', CyberwareScreenType.Glamdoc, false, m_playerItemDisplayContext, m_InventoryManager, m_player, true, false );
		m_minigridController.SetPositionImmediate( m_minigridTargetAnchorMargin );
		m_minigridController.SetLabelImmediate( false );
		m_minigridController.RefreshisNewPreview( false );
		m_minigridController.OpacityShow();
		inkTextRef.SetLocalizedTextScript( m_minigridTitleAnchor, "LocKey#97489" );
		inkTextRef.SetText( m_minigridTextAnchor, items[ 0 ].GetName() );
	}

	private function UpdateMinigrid()
	{
		m_minigridController.UpdateData( gamedataEquipmentArea.ArmsCWStyle, m_uiInventorySystem.GetPlayerAreaItems( gamedataEquipmentArea.ArmsCWStyle ) );
		inkTextRef.SetText( m_minigridTextAnchor, ( ( m_equippedStyle ) ? ( m_equippedStyle.GetName() ) : ( "" ) ) );
	}

	private function GetSavedCustomizationItemID() : ItemID
	{
		var savedData : CyberwareCustomizationPersistentData;
		savedData = m_cyberwareCustomizationSystem.GetSavedData();
		return savedData.customizationItemID;
	}

	private function UpdateCurrentCustomizationItem( itemID : ItemID )
	{
		var itemData : weak< gameItemData >;
		itemData = GameInstance.GetTransactionSystem( m_player.GetGame() ).GetItemData( m_player, itemID );
		m_equippedStyleItem = ( ( itemData == NULL ) ? ( ( ( UIInventoryItem )( NULL ) ) ) : ( UIInventoryItem.Make( m_player, itemData, m_uiInventorySystem.GetInventoryItemsManager() ) ) );
		m_equippedStyle = ( ( weak< weak< UIInventoryItem > > )( m_equippedStyleItem ) );
	}

	private function SpawnOnEquipEvent()
	{
		var equipAnimationUpdateData : EquipAnimationUpdateData;
		equipAnimationUpdateData = new EquipAnimationUpdateData;
		equipAnimationUpdateData.equipArea = gamedataEquipmentArea.ArmsCW;
		equipAnimationUpdateData.isEquip = true;
		m_menuEventDispatcher.SpawnEvent( 'OnEquipAnimationDataUpdate', equipAnimationUpdateData );
	}

}

