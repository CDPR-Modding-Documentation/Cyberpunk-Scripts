class GalleryFullPreview extends inkGameController
{
	protected editable var m_buttonHintsManagerRef : inkWidgetRef;
	protected editable var m_screenshotContainer : inkWidgetRef;
	protected editable var m_screenshotMask : inkWidgetRef;
	protected editable var m_screenshotPreview : inkImageRef;
	protected editable var m_container : inkWidgetRef;
	protected editable var m_windowWrapper : inkWidgetRef;
	protected var m_preloader : weak< inkCompoundWidget >;
	protected var m_systemHandler : weak< inkISystemRequestsHandler >;
	protected var m_data : GalleryPreviewData;
	protected var m_buttonHintsController : weak< ButtonHints >;
	protected var m_deleteConfirmationToken : inkGameNotificationToken;

	protected event OnInitialize()
	{
		m_systemHandler = GetSystemRequestsHandler();
		m_data = ( ( GalleryPreviewData )( GetRootWidget().GetUserData( 'GalleryPreviewData' ) ) );
		m_buttonHintsController = ( ( ButtonHints )( SpawnFromExternal( inkWidgetRef.Get( m_buttonHintsManagerRef ), R"base\gameplay\gui\common\buttonhints.inkwidget", 'Root' ).GetController() ) );
		m_buttonHintsController.AddButtonHint( 'back', GetLocalizedText( "Common-Access-Close" ) );
		RegisterToGlobalInputCallback( 'OnPostOnRelease', this, 'OnGlobalRelease' );
		m_preloader = ( ( inkCompoundWidget )( SpawnFromExternal( inkWidgetRef.Get( m_container ), R"base\gameplay\gui\common\preloader\preloader.inkwidget", 'Root' ) ) );
		m_preloader.SetAnchor( inkEAnchor.Fill );
		m_preloader.SetAnchorPoint( Vector2( 0.5, 0.5 ) );
		m_preloader.GetWidgetByPathName( 'border' ).SetVisible( false );
		m_preloader.SetVisible( true );
		inkWidgetRef.SetVisible( m_screenshotContainer, false );
	}

	protected event OnUninitialize()
	{
		UnregisterFromGlobalInputCallback( 'OnPostOnRelease', this, 'OnGlobalRelease' );
	}

	protected event OnGlobalRelease( evt : inkPointerEvent )
	{
		if( evt.IsAction( 'cancel' ) || evt.IsAction( 'click' ) )
		{
			PlaySound( 'Button', 'OnPress' );
			m_data.token.TriggerCallback( NULL );
		}
	}

	public function GetPreviewImageWidget() : weak< inkImage >
	{
		return ( ( inkImage )( inkImageRef.Get( m_screenshotPreview ) ) );
	}

}

class GalleryScreenshotFullPreview extends GalleryFullPreview
{
	protected editable var m_favoriteIcon : inkWidgetRef;

	protected event OnInitialize()
	{
		var screenshotData : weak< GalleryScreenshotPreviewData >;
		m_systemHandler = GetSystemRequestsHandler();
		m_data = ( ( GalleryScreenshotPreviewData )( GetRootWidget().GetUserData( 'GalleryScreenshotPreviewData' ) ) );
		screenshotData = ( ( GalleryScreenshotPreviewData )( m_data ) );
		m_buttonHintsController = ( ( ButtonHints )( SpawnFromExternal( inkWidgetRef.Get( m_buttonHintsManagerRef ), R"base\gameplay\gui\common\buttonhints.inkwidget", 'Root' ).GetController() ) );
		m_buttonHintsController.AddButtonHint( 'back', GetLocalizedText( "Common-Access-Close" ) );
		m_buttonHintsController.AddButtonHint( 'delete_screenshot', GetLocalizedText( "UI-Gallery-DeletePicture" ) );
		RefreshFavoriteButtonHint();
		RegisterToGlobalInputCallback( 'OnPostOnRelease', this, 'OnGlobalRelease' );
		m_preloader = ( ( inkCompoundWidget )( SpawnFromExternal( inkWidgetRef.Get( m_container ), R"base\gameplay\gui\common\preloader\preloader.inkwidget", 'Root' ) ) );
		m_preloader.SetAnchor( inkEAnchor.Fill );
		m_preloader.SetAnchorPoint( Vector2( 0.5, 0.5 ) );
		m_preloader.GetWidgetByPathName( 'border' ).SetVisible( false );
		m_preloader.SetVisible( true );
		inkWidgetRef.SetVisible( m_screenshotContainer, false );
		LoadScreenshot();
		screenshotData.galleryController.m_canInteract = false;
	}

	protected event OnGlobalRelease( evt : inkPointerEvent )
	{
		var isFavorite : Bool;
		var screenshotItem : weak< GalleryScreenshotItem >;
		var screenshotData : weak< GalleryScreenshotPreviewData >;
		if( evt.IsAction( 'cancel' ) || evt.IsAction( 'click' ) )
		{
			PlaySound( 'Button', 'OnPress' );
			screenshotData = ( ( GalleryScreenshotPreviewData )( m_data ) );
			m_data.token.TriggerCallback( NULL );
			screenshotData.galleryController.m_canInteract = true;
		}
		if( evt.IsAction( 'secondaryAction' ) )
		{
			PlaySound( 'Button', 'OnPress' );
			screenshotData = ( ( GalleryScreenshotPreviewData )( m_data ) );
			isFavorite = screenshotData.favoriteManager.IsFavorite( screenshotData.Hash );
			screenshotData.favoriteManager.SetFavorite( screenshotData.Hash, !( isFavorite ) );
			inkWidgetRef.SetVisible( m_favoriteIcon, !( isFavorite ) );
			screenshotData.isFavorite = !( isFavorite );
			screenshotItem = ( ( GalleryScreenshotItem )( screenshotData.screenshotItem ) );
			screenshotItem.SetFavoriteDisplay( !( isFavorite ) );
			RefreshFavoriteButtonHint();
			evt.Handle();
		}
		if( evt.IsAction( 'delete_screenshot' ) )
		{
			PlaySound( 'Button', 'OnPress' );
			screenshotData = ( ( GalleryScreenshotPreviewData )( m_data ) );
			screenshotData.token.TriggerCallback( NULL );
			screenshotData.galleryController.DeleteScreenshot( screenshotData.screenshotIndex, screenshotData.canBeDeleted );
			evt.Handle();
		}
	}

	protected function LoadScreenshot()
	{
		var screenshotData : weak< GalleryScreenshotPreviewData >;
		screenshotData = ( ( GalleryScreenshotPreviewData )( m_data ) );
		m_systemHandler.RequestGameScreenshot( screenshotData.screenshotIndex, GetPreviewImageWidget(), this, 'OnScreenshotLoaded' );
	}

	protected function RefreshFavoriteButtonHint()
	{
		var screenshotData : weak< GalleryScreenshotPreviewData >;
		screenshotData = ( ( GalleryScreenshotPreviewData )( m_data ) );
		m_buttonHintsController.RemoveButtonHint( 'secondaryAction' );
		m_buttonHintsController.AddButtonHint( 'secondaryAction', ( ( screenshotData.isFavorite ) ? ( GetLocalizedText( "UI-Gallery-RemoveFromFavorites" ) ) : ( GetLocalizedText( "UI-Gallery-AddToFavorites" ) ) ) );
	}

	public function OnScreenshotLoaded( screenshotSize : Vector2, errorCode : Int32 )
	{
		var previewSize : Vector2;
		var screenshotData : weak< GalleryScreenshotPreviewData >;
		screenshotData = ( ( GalleryScreenshotPreviewData )( m_data ) );
		previewSize = GalleryUtils.FillScreenshotInPreview( screenshotSize, inkImageRef.GetSize( m_screenshotPreview ) );
		inkImageRef.SetSize( m_screenshotPreview, previewSize );
		inkWidgetRef.SetSize( m_screenshotContainer, previewSize );
		inkImageRef.SetTintColor( m_screenshotPreview, HDRColor( 0.73000002, 0.73000002, 0.73000002, 1.0 ) );
		m_preloader.SetVisible( false );
		inkWidgetRef.SetVisible( m_favoriteIcon, screenshotData.isFavorite );
		PlayLibraryAnimation( 'intro' );
	}

}

