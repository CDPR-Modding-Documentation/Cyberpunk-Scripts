class MenuScenario_CreditsPickerPause extends MenuScenario_BaseMenu
{

	protected event OnEnterScenario( prevScenario : CName, userData : IScriptable )
	{
		var menuState : weak< inkMenusState >;
		menuState = GetMenusState();
		m_currMenuName = 'credits_picker';
		menuState.OpenMenu( m_currMenuName );
	}

	protected event OnLeaveScenario( nextScenario : CName )
	{
		var menuState : weak< inkMenusState >;
		super.OnLeaveScenario( nextScenario );
		menuState = GetMenusState();
		menuState.CloseMenu( 'credits_picker' );
	}

	protected event OnSwitchToCredits()
	{
		m_prevMenuName = m_currMenuName;
		SwitchMenu( 'finalboards_credits' );
	}

	protected event OnSwitchToCreditsEp1()
	{
		m_prevMenuName = m_currMenuName;
		SwitchMenu( 'finalboards_credits_ep1' );
	}

	protected event OnBack()
	{
		if( m_currMenuName != 'credits_picker' )
		{
			SwitchMenu( 'credits_picker' );
		}
		else
		{
			SwitchToScenario( 'MenuScenario_PauseMenu' );
		}
	}

}

class MenuScenario_PauseMenu extends MenuScenario_BaseMenu
{

	protected event OnEnterScenario( prevScenario : CName, userData : IScriptable )
	{
		GetMenusState().OpenMenu( 'pause_menu_background' );
		SwitchMenu( 'pause_menu' );
	}

	protected event OnSwitchToPauseMenu()
	{
		SwitchMenu( 'pause_menu' );
	}

	protected event OnSwitchToSaveGame()
	{
		SwitchMenu( 'save_game' );
	}

	protected event OnSwitchToLoadGame()
	{
		SwitchMenu( 'load_game' );
	}

	protected event OnCreditsPicker()
	{
		m_prevMenuName = m_currMenuName;
		SwitchToScenario( 'MenuScenario_CreditsPickerPause' );
	}

	protected event OnSwitchToSettings()
	{
		SwitchMenu( 'settings_main' );
	}

	protected event OnSwitchToModioMenu()
	{
		var platformName : String;
		if( !( GetSystemRequestsHandler().GetIsSignedIn() ) )
		{
			GetSystemRequestsHandler().RequestSystemNotificationGenericYesNo( 'UI-Modio-ErrorMessages-PopupTitle', 'UI-Modio-Tooltips-RequestLoginCDPR', this, 'OnRequestCDPRAccountPopupCallBack' );
			return true;
		}
		if( !( GetSystemRequestsHandler().IsOnline() ) )
		{
			GetSystemRequestsHandler().RequestSystemNotificationGeneric( 'UI-Modio-ErrorMessages-PopupTitle', 'UI-Modio-ErrorMessages-ModioOutage' );
			return true;
		}
		platformName = GetPlatformShortName();
		if( ( ( ( ( platformName == "ps5" || platformName == "ps5pro" ) || platformName == "xseriesx" ) || platformName == "xseriess" ) || platformName == "emporium" ) || platformName == "windowsGDK" )
		{
			Modio.RequestRestrictionStatus( this, 'OnRequestRestrictionStatusCallBack' );
			return true;
		}
		if( !( CheckModioMenuCanOpen() ) )
		{
			return true;
		}
		m_prevMenuName = m_currMenuName;
		SwitchToScenario( 'MenuScenario_Mods_Pause' );
	}

	protected event OnPitchScreenDisplay()
	{
		CloseSubMenu();
		SwitchToScenario( 'MenuScenario_Pitch_Pause' );
	}

	protected event OnRequestCDPRAccountPopupCallBack( value : Bool )
	{
		if( !( value ) )
		{
			return true;
		}
		if( !( IsGogDisPlaying() ) )
		{
			DisplayGog();
		}
	}

	protected function IsGogDisPlaying() : Bool
	{
		var menuWidget : inkWidget;
		var gogContainer : weak< inkCompoundWidget >;
		if( !( GetMenusState().IsMenuOpened( 'load_game' ) ) )
		{
			menuWidget = GetMenusState().OpenMenu( 'pause_menu' );
			gogContainer = ( ( inkCompoundWidget )( menuWidget.GetController().GetWidget( 'GogPanel/GogContainer' ) ) );
			if( gogContainer )
			{
				if( gogContainer.GetNumChildren() )
				{
					return true;
				}
			}
		}
		return false;
	}

	protected function DisplayGog()
	{
		OnGOGProfile();
	}

	protected event OnGOGProfile()
	{
		var menuWidget : inkWidget;
		var gogContainer : weak< inkCompoundWidget >;
		if( !( GetMenusState().IsMenuOpened( 'load_game' ) ) )
		{
			menuWidget = GetMenusState().OpenMenu( 'pause_menu' );
			gogContainer = ( ( inkCompoundWidget )( menuWidget.GetController().GetWidget( 'GogPanel/GogContainer' ) ) );
			if( gogContainer )
			{
				if( gogContainer.GetNumChildren() )
				{
					gogContainer.RemoveAllChildren();
				}
				else
				{
					SpawnGogPopupWidget( menuWidget, gogContainer );
				}
			}
		}
	}

	private function SpawnGogPopupWidget( menuWidget : inkWidget, gogContainer : weak< inkCompoundWidget > )
	{
		var gogPopupController : weak< GOGProfileLogicController >;
		var gogPopupWidget : inkWidget;
		gogPopupWidget = menuWidget.GetController().SpawnFromExternal( gogContainer, R"base\gameplay\gui\fullscreen\main_menu\gog_popup.inkwidget", 'Root' );
		if( gogPopupWidget != NULL )
		{
			gogPopupController = ( ( GOGProfileLogicController )( gogPopupWidget.GetController() ) );
			if( gogPopupController != NULL )
			{
				gogPopupController.SetMenuState( EGOGMenuState.MainMenu );
				gogPopupController.SetGogContainer( gogContainer );
			}
		}
	}

	protected event OnRequestOpenModioBrowser()
	{
		OnSwitchToModioMenu();
	}

	protected event OnRequestRestrictionStatusCallBack( status : Int32 )
	{
		if( !( GetSystemRequestsHandler().IsOnline() ) )
		{
			GetSystemRequestsHandler().RequestSystemNotificationGeneric( 'UI-Modio-ErrorMessages-PopupTitle', 'UI-Modio-ErrorMessages-ModioOutage' );
			return true;
		}
		if( status == 0 )
		{
			OpenModioMenu();
		}
		else if( GetPlatformShortName() != "emporium" )
		{
			Modio.ShowMsgDialog( 1, GetLocalizedText( "Gameplay-Scanning-Devices-GameplayActions-Error" ), GetLocalizedText( "UI-Modio-ErrorMessages-NotAllowedToInteractWithUGC" ), GetLocalizedText( "Gameplay-Devices-Interactions-Ok" ) );
		}
	}

	public function OpenModioMenu()
	{
		if( !( CheckModioMenuCanOpen() ) )
		{
			return;
		}
		if( m_currMenuName == 'pause_menu' || GetMenusState().IsMenuOpened( 'load_game' ) )
		{
			m_prevMenuName = m_currMenuName;
			SwitchToScenario( 'MenuScenario_Mods_Pause' );
		}
	}

	protected event OnModioInitResult( isSuccess : Bool )
	{
		if( isSuccess )
		{
			OnSwitchToModioMenu();
		}
		else
		{
			GetSystemRequestsHandler().RequestSystemNotificationGeneric( 'UI-Modio-ErrorMessages-PopupTitle', 'UI-Modio-Tooltips-RequestLoginModio' );
		}
	}

	public function CheckModioMenuCanOpen() : Bool
	{
		if( !( GetSystemRequestsHandler().IsOnline() ) )
		{
			GetSystemRequestsHandler().RequestSystemNotificationGeneric( 'UI-Modio-ErrorMessages-PopupTitle', 'UI-Modio-ErrorMessages-ModioOutage' );
			return false;
		}
		if( !( Modio.IsAuthorized() ) && GetSystemRequestsHandler().GetIsSignedIn() )
		{
			Modio.RequestLoginModio( this, 'OnModioLoginResult' );
			return false;
		}
		if( !( Modio.IsInitialized() ) )
		{
			Modio.RequestInitModio( this, 'OnModioInitResult' );
		}
		return true;
	}

	protected event OnSwitchToDlc()
	{
		SwitchMenu( 'dlc_menu' );
	}

	protected event OnSwitchToBrightnessSettings()
	{
		m_prevMenuName = m_currMenuName;
		SwitchMenu( 'brightness_settings' );
	}

	protected event OnSwitchToHDRSettings()
	{
		m_prevMenuName = m_currMenuName;
		SwitchMenu( 'hdr_settings' );
	}

	protected event OnSwitchToControllerPanel()
	{
		var menuState : weak< inkMenusState >;
		menuState = GetMenusState();
		m_prevMenuName = m_currMenuName;
		SwitchMenu( menuState.GetControllerMenuName() );
	}

	protected event OnOpenDebugHubMenu()
	{
		CloseSubMenu();
		SwitchToScenario( 'DebugMenuScenario_HubMenu' );
	}

	protected event OnRequestPauseMenu()
	{
		GotoIdleState();
	}

	protected event OnClosePauseMenu()
	{
		GotoIdleState();
	}

	protected event OnCloseHubMenuRequest() {}

	protected event OnCloseSettingsScreen()
	{
		GoBack( true );
	}

	protected event OnBack()
	{
		GoBack( false );
	}

	protected event OnBuyGame()
	{
		TrialHelper.ShowUpgradeTrialVersionCommerceDialog();
	}

	private function GoBack( forceCloseSettings : Bool )
	{
		var menuState : weak< inkMenusState >;
		menuState = GetMenusState();
		if( m_prevMenuName != '' )
		{
			SwitchMenu( m_prevMenuName );
			m_prevMenuName = '';
		}
		else if( m_currMenuName == 'settings_main' && !( forceCloseSettings ) )
		{
			menuState.DispatchEvent( m_currMenuName, 'OnBack' );
		}
		else if( m_currMenuName != 'pause_menu' )
		{
			SwitchMenu( 'pause_menu' );
		}
		else
		{
			GotoIdleState();
		}
	}

	protected event OnModioLoginResult( status : Int32 )
	{
		if( status == 0 )
		{
			OnSwitchToModioMenu();
		}
		else
		{
			GetSystemRequestsHandler().RequestSystemNotificationGeneric( 'UI-Modio-ErrorMessages-PopupTitle', 'UI-Modio-Tooltips-RequestLoginModio' );
		}
	}

}

class MenuScenario_Mods_Pause extends MenuScenario_BaseMenu
{

	protected event OnEnterScenario( prevScenario : CName, userData : IScriptable )
	{
		m_prevMenuName = prevScenario;
		GetMenusState().OpenMenu( 'modio_browser_menu' );
	}

	protected event OnLeaveScenario( nextScenario : CName )
	{
		super.OnLeaveScenario( nextScenario );
		GetMenusState().CloseMenu( 'modio_browser_menu' );
	}

	protected event OnMainMenuBack()
	{
		SwitchToScenario( 'MenuScenario_PauseMenu' );
	}

}

class MenuScenario_Pitch_Pause extends MenuScenario_BaseMenu
{

	protected event OnEnterScenario( prevScenario : CName, userData : IScriptable )
	{
		var menuState : weak< inkMenusState >;
		menuState = GetMenusState();
		menuState.OpenMenu( 'pitch_menu' );
	}

	protected event OnLeaveScenario( nextScenario : CName )
	{
		super.OnLeaveScenario( nextScenario );
		GetMenusState().CloseMenu( 'pitch_menu' );
	}

	protected event OnMainMenuBack()
	{
		CloseSubMenu();
		SwitchToScenario( 'MenuScenario_PauseMenu' );
	}

	protected event OnMainMenu()
	{
		SwitchToScenario( 'MenuScenario_PauseMenu' );
	}

}

