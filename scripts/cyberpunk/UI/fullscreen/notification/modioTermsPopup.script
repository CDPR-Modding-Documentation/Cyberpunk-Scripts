import enum inkModioReportType : Uint8
{
	Generic,
	DMCA,
	NotWorking,
	RudeContent,
	IllegalContent,
	StolenContent,
	FalseInformation,
	Other,
}

importonly struct Modio
{
	public import static function IsInitialized() : Bool;
	public import static function IsAuthorized() : Bool;
	public import static function OpenUrl( urlType : Int32 );
	public import static function RequestLoginModio( optional callbackListener : weak< IScriptable >, optional functionName : CName, optional acceptTerms : Bool );
	public import static function RequestInitModio( optional callbackListener : weak< IScriptable >, optional functionName : CName );
	public import static function RequestReport( modID : Int64, reportType : inkModioReportType, detail : String, contact : String, optional callbackListener : weak< IScriptable >, optional functionName : CName );
	public import static function RequestRestrictionStatus( optional callbackListener : weak< IScriptable >, optional functionName : CName, optional bOverrideShowMessageForNS2 : Bool );
	public import static function OpenIMEDialog( oldStr : String, optional callbackListener : weak< IScriptable >, optional functionName : CName, optional maxChar : Int32 );
	public import static function ShowMsgDialog( dialogType : Int32, title : String, msg : String, btnText : String, optional callbackListener : weak< IScriptable >, optional functionName : CName );
	public import static function OpenSigninDialog( optional callbackListener : weak< IScriptable >, optional functionName : CName );
	public import static function IsModReloadingProgress() : Bool;
	public import static function ClearModCaches();
	public import static function SubStrByChar( str : String, start : Int32, length : Int32 ) : String;
}

class ModioTermsPopupEvent extends Event
{
}

class ModioTermsPopupData extends inkGameNotificationData
{
}

class ModioTermsPopupCloseEvent extends Event
{
	var m_isAccepted : Bool;
}

class RefreshOnlineData extends IScriptable
{
	var isOnline : Bool;
}

class ModioToolTipInMenu extends inkLogicController
{
	private editable var m_mainContainer : inkWidgetRef;
	editable var m_content : inkTextRef;
	private editable var m_TopMargin : inkCanvasRef;

	protected event OnInitialize()
	{
		inkWidgetRef.SetVisible( m_mainContainer, false );
	}

	public function SetText( str : String )
	{
		inkTextRef.SetText( m_content, str );
		inkWidgetRef.SetVisible( m_mainContainer, StrLen( str ) > 0 );
	}

	public function SetMarginTop( top : Float )
	{
		var size : Vector2;
		size = inkCanvasRef.Get( m_TopMargin ).GetSize();
		size.Y = top;
		inkCanvasRef.Get( m_TopMargin ).SetSize( size );
	}

}

class ModioTermsPopupController extends inkGameController
{
	private editable var m_hyperlinkButtonRef1 : inkWidgetRef;
	private editable var m_hyperlinkButtonRef2 : inkWidgetRef;
	private editable var m_hyperlinkButtonRef3 : inkWidgetRef;
	private editable var m_agreeBtnRef : inkWidgetRef;
	private editable var m_NoThanksBtnRef : inkWidgetRef;
	private editable var m_toggleSelectBtnRef : inkWidgetRef;
	private editable var m_agreeTxtRef : inkTextRef;
	private editable var m_questionOne_ContainerRef : inkWidgetRef;
	private editable var m_questionTwo_ContainerRef : inkWidgetRef;
	private editable var m_questionOne_ToggleFillRef : inkWidgetRef;
	private editable var m_questionTwo_ToggleFillRef : inkWidgetRef;
	private editable var m_consoleWarning : inkTextRef;
	private editable var m_ps5Warning : inkRichTextBoxRef;
	private var m_data : ModioTermsPopupData;
	private var m_requestHandler : weak< inkISystemRequestsHandler >;
	private var m_acceptButtonController : weak< inkButtonController >;
	private var m_questionOne_State : Bool;
	default m_questionOne_State = false;
	private var m_questionTwo_State : Bool;
	default m_questionTwo_State = false;
	private var m_colorNames : ModsMenuColorsNames;

	protected event OnInitialize()
	{
		m_data = ( ( ModioTermsPopupData )( GetRootWidget().GetUserData( 'ModioTermsPopupData' ) ) );
		RegisterToGlobalInputCallback( 'OnPostOnRelease', this, 'OnRelease' );
		m_requestHandler = GetSystemRequestsHandler();
		inkWidgetRef.RegisterToCallback( m_hyperlinkButtonRef1, 'OnPress', this, 'OnTermsPress' );
		inkWidgetRef.RegisterToCallback( m_hyperlinkButtonRef1, 'OnHoverOver', this, 'OnTermsHoverOver' );
		inkWidgetRef.RegisterToCallback( m_hyperlinkButtonRef1, 'OnHoverOut', this, 'OnTermsHoverOut' );
		inkWidgetRef.RegisterToCallback( m_hyperlinkButtonRef2, 'OnPress', this, 'OnPrivacyPress' );
		inkWidgetRef.RegisterToCallback( m_hyperlinkButtonRef2, 'OnHoverOver', this, 'OnPrivacyHoverOver' );
		inkWidgetRef.RegisterToCallback( m_hyperlinkButtonRef2, 'OnHoverOut', this, 'OnPrivacyHoverOut' );
		inkWidgetRef.RegisterToCallback( m_hyperlinkButtonRef3, 'OnPress', this, 'OnCDPRPrivacyPress' );
		inkWidgetRef.RegisterToCallback( m_hyperlinkButtonRef3, 'OnHoverOver', this, 'OnCDPRPrivacyHoverOver' );
		inkWidgetRef.RegisterToCallback( m_hyperlinkButtonRef3, 'OnHoverOut', this, 'OnCDPRPrivacyHoverOut' );
		inkTextRef.SetVisible( m_consoleWarning, true );
		if( ( GetPlatformShortName() == "xseriess" || GetPlatformShortName() == "xseriesx" ) || GetPlatformShortName() == "windowsGDK" )
		{
			inkTextRef.SetText( m_consoleWarning, GetLocalizedText( "UI-Modio-ErrorMessages-WarningNoAchievements" ) );
		}
		else if( GetPlatformShortName() == "ps5" || GetPlatformShortName() == "ps5pro" )
		{
			inkTextRef.SetText( m_consoleWarning, GetLocalizedText( "UI-Modio-ErrorMessages-WarningNoTrophies" ) );
		}
		else if( GetPlatformShortName() == "emporium" )
		{
			inkTextRef.SetVisible( m_consoleWarning, false );
		}
		else
		{
			inkTextRef.SetText( m_consoleWarning, GetLocalizedText( "UI-Modio-ErrorMessages-WarningNoAchieveTrophies" ) );
		}
		inkRichTextBoxRef.SetVisible( m_ps5Warning, false );
		inkWidgetRef.RegisterToCallback( m_agreeBtnRef, 'OnButtonClick', this, 'OnAgreePress' );
		inkWidgetRef.RegisterToCallback( m_NoThanksBtnRef, 'OnButtonClick', this, 'OnCancelPress' );
		inkWidgetRef.RegisterToCallback( m_toggleSelectBtnRef, 'OnButtonClick', this, 'OnToggleSelectPress' );
		inkWidgetRef.RegisterToCallback( m_questionOne_ContainerRef, 'OnPress', this, 'OnPressQuestionOne' );
		inkWidgetRef.RegisterToCallback( m_questionTwo_ContainerRef, 'OnPress', this, 'OnPressQuestionTwo' );
		inkWidgetRef.RegisterToCallback( m_questionOne_ContainerRef, 'OnHoverOut', this, 'OnHoverOutQuestionOne' );
		inkWidgetRef.RegisterToCallback( m_questionTwo_ContainerRef, 'OnHoverOut', this, 'OnHoverOutQuestionTwo' );
		m_acceptButtonController = ( ( inkButtonController )( inkWidgetRef.GetControllerByType( m_agreeBtnRef, 'inkButtonController' ) ) );
		UpdateToggleOne();
		UpdateToggleTwo();
		inkWidgetRef.SetVisible( m_hyperlinkButtonRef3, false );
		inkWidgetRef.RegisterToCallback( m_agreeBtnRef, 'OnRelease', this, 'OnAgreeTouch' );
		inkWidgetRef.RegisterToCallback( m_NoThanksBtnRef, 'OnRelease', this, 'OnCancelTouch' );
	}

	protected event OnUninitialize()
	{
		UnregisterFromGlobalInputCallback( 'OnPostOnRelease', this, 'OnRelease' );
		inkWidgetRef.UnregisterFromCallback( m_hyperlinkButtonRef1, 'OnPress', this, 'OnTermsPress' );
		inkWidgetRef.UnregisterFromCallback( m_hyperlinkButtonRef1, 'OnHoverOver', this, 'OnTermsHoverOver' );
		inkWidgetRef.UnregisterFromCallback( m_hyperlinkButtonRef1, 'OnHoverOut', this, 'OnTermsHoverOut' );
		inkWidgetRef.UnregisterFromCallback( m_hyperlinkButtonRef2, 'OnPress', this, 'OnPrivacyPress' );
		inkWidgetRef.UnregisterFromCallback( m_hyperlinkButtonRef2, 'OnHoverOver', this, 'OnPrivacyHoverOver' );
		inkWidgetRef.UnregisterFromCallback( m_hyperlinkButtonRef2, 'OnHoverOut', this, 'OnPrivacyHoverOut' );
		inkWidgetRef.UnregisterFromCallback( m_hyperlinkButtonRef3, 'OnPress', this, 'OnCDPRPrivacyPress' );
		inkWidgetRef.UnregisterFromCallback( m_hyperlinkButtonRef3, 'OnHoverOver', this, 'OnCDPRPrivacyHoverOver' );
		inkWidgetRef.UnregisterFromCallback( m_hyperlinkButtonRef3, 'OnHoverOut', this, 'OnCDPRPrivacyHoverOut' );
		inkWidgetRef.UnregisterFromCallback( m_agreeBtnRef, 'OnButtonClick', this, 'OnAgreePress' );
		inkWidgetRef.UnregisterFromCallback( m_NoThanksBtnRef, 'OnButtonClick', this, 'OnCancelPress' );
		inkWidgetRef.UnregisterFromCallback( m_toggleSelectBtnRef, 'OnButtonClick', this, 'OnToggleSelectPress' );
		inkWidgetRef.UnregisterFromCallback( m_questionOne_ContainerRef, 'OnPress', this, 'OnPressQuestionOne' );
		inkWidgetRef.UnregisterFromCallback( m_questionTwo_ContainerRef, 'OnPress', this, 'OnPressQuestionTwo' );
		inkWidgetRef.UnregisterFromCallback( m_questionOne_ContainerRef, 'OnHoverOut', this, 'OnHoverOutQuestionOne' );
		inkWidgetRef.UnregisterFromCallback( m_questionTwo_ContainerRef, 'OnHoverOut', this, 'OnHoverOutQuestionTwo' );
		inkWidgetRef.UnregisterFromCallback( m_agreeBtnRef, 'OnRelease', this, 'OnAgreeTouch' );
		inkWidgetRef.UnregisterFromCallback( m_NoThanksBtnRef, 'OnRelease', this, 'OnCancelTouch' );
	}

	protected event OnTermsPress( evt : inkPointerEvent )
	{
		if( evt.IsAction( 'click' ) || evt.IsAction( 'tap' ) )
		{
			Modio.OpenUrl( 0 );
		}
	}

	protected event OnTermsHoverOver( evt : inkPointerEvent )
	{
		inkWidgetRef.Get( m_hyperlinkButtonRef1 ).BindProperty( 'tintColor', m_colorNames.activeBlueName );
	}

	protected event OnTermsHoverOut( evt : inkPointerEvent )
	{
		inkWidgetRef.Get( m_hyperlinkButtonRef1 ).BindProperty( 'tintColor', m_colorNames.redName );
	}

	protected event OnPrivacyPress( evt : inkPointerEvent )
	{
		if( evt.IsAction( 'click' ) || evt.IsAction( 'tap' ) )
		{
			Modio.OpenUrl( 1 );
		}
	}

	protected event OnPrivacyHoverOver( evt : inkPointerEvent )
	{
		inkWidgetRef.Get( m_hyperlinkButtonRef2 ).BindProperty( 'tintColor', m_colorNames.activeBlueName );
	}

	protected event OnPrivacyHoverOut( evt : inkPointerEvent )
	{
		inkWidgetRef.Get( m_hyperlinkButtonRef2 ).BindProperty( 'tintColor', m_colorNames.redName );
	}

	protected event OnCDPRPrivacyPress( evt : inkPointerEvent )
	{
		if( evt.IsAction( 'click' ) || evt.IsAction( 'tap' ) )
		{
			m_requestHandler.OpenPrivacyPolicyUrl();
		}
	}

	protected event OnCDPRPrivacyHoverOver( evt : inkPointerEvent )
	{
		inkWidgetRef.Get( m_hyperlinkButtonRef3 ).BindProperty( 'tintColor', m_colorNames.activeBlueName );
	}

	protected event OnCDPRPrivacyHoverOut( evt : inkPointerEvent )
	{
		inkWidgetRef.Get( m_hyperlinkButtonRef3 ).BindProperty( 'tintColor', m_colorNames.redName );
	}

	protected event OnAgreePress( controller : weak< inkButtonController > )
	{
		Agree();
	}

	protected event OnCancelPress( controller : weak< inkButtonController > )
	{
		Close();
	}

	protected event OnAgreeTouch( e : inkPointerEvent )
	{
		if( e.IsAction( 'tap' ) && m_acceptButtonController.GetEnabled() )
		{
			Agree();
		}
	}

	protected event OnCancelTouch( e : inkPointerEvent )
	{
		if( e.IsAction( 'tap' ) )
		{
			Close();
		}
	}

	protected event OnToggleSelectPress( controller : weak< inkButtonController > )
	{
		if( !( m_questionOne_State && m_questionTwo_State ) )
		{
			m_questionOne_State = m_questionTwo_State = true;
		}
		else
		{
			m_questionOne_State = m_questionTwo_State = false;
		}
		UpdateToggleOne();
		UpdateToggleTwo();
	}

	private function Agree()
	{
		var closeEvent : ModioTermsPopupCloseEvent;
		closeEvent = new ModioTermsPopupCloseEvent;
		closeEvent.m_isAccepted = true;
		GameInstance.GetUISystem( GetPlayerControlledObject().GetGame() ).QueueEvent( closeEvent );
		Close();
	}

	private function Close()
	{
		m_data.token.TriggerCallback( m_data );
	}

	protected event OnRelease( evt : inkPointerEvent )
	{
		if( evt.IsAction( 'close_popup' ) )
		{
			Close();
		}
		else if( ( evt.IsAction( 'mod_notification_confirm' ) && m_questionOne_State ) && m_questionTwo_State )
		{
			Agree();
		}
	}

	protected event OnPressQuestionOne( evt : inkPointerEvent )
	{
		if( evt.IsAction( 'click' ) || evt.IsAction( 'tap' ) )
		{
			m_questionOne_State = !( m_questionOne_State );
			UpdateToggleOne();
		}
	}

	protected event OnPressQuestionTwo( evt : inkPointerEvent )
	{
		if( evt.IsAction( 'click' ) || evt.IsAction( 'tap' ) )
		{
			m_questionTwo_State = !( m_questionTwo_State );
			UpdateToggleTwo();
		}
	}

	private function UpdateToggleOne()
	{
		inkWidgetRef.SetState( m_questionOne_ContainerRef, ( ( m_questionOne_State ) ? ( 'Selected' ) : ( 'Default' ) ) );
		inkWidgetRef.SetVisible( m_questionOne_ToggleFillRef, m_questionOne_State );
		UpdateAcceptButton();
	}

	private function UpdateToggleTwo()
	{
		inkWidgetRef.SetState( m_questionTwo_ContainerRef, ( ( m_questionTwo_State ) ? ( 'Selected' ) : ( 'Default' ) ) );
		inkWidgetRef.SetVisible( m_questionTwo_ToggleFillRef, m_questionTwo_State );
		UpdateAcceptButton();
	}

	private function UpdateAcceptButton()
	{
		m_acceptButtonController.SetSelectable( m_questionOne_State && m_questionTwo_State );
		m_acceptButtonController.SetEnabled( m_questionOne_State && m_questionTwo_State );
		if( m_questionOne_State && m_questionTwo_State )
		{
			inkTextRef.Get( m_agreeTxtRef ).BindProperty( 'tintColor', 'PopupButton.textColor' );
		}
		else
		{
			inkTextRef.Get( m_agreeTxtRef ).BindProperty( 'tintColor', 'MainColors.Grey' );
		}
	}

	protected event OnHoverOutQuestionOne( e : inkPointerEvent )
	{
		inkWidgetRef.SetState( m_questionOne_ContainerRef, ( ( m_questionOne_State ) ? ( 'Selected' ) : ( 'Default' ) ) );
	}

	protected event OnHoverOutQuestionTwo( e : inkPointerEvent )
	{
		inkWidgetRef.SetState( m_questionTwo_ContainerRef, ( ( m_questionTwo_State ) ? ( 'Selected' ) : ( 'Default' ) ) );
	}

}

