class ModReloadingPopupEvent extends Event
{
}

class ModReloadingPopupData extends inkGameNotificationData
{
}

class ModReloadingPopupController extends inkGameController
{
	private editable var m_progressBarRef : inkWidgetRef;
	private editable var m_noTurnOffTextWidget : inkTextRef;
	private var m_progressBarController : weak< LoadingScreenProgressBarController >;
	private var m_data : ModReloadingPopupData;
	private var m_requestHandler : weak< inkISystemRequestsHandler >;

	protected event OnInitialize()
	{
		var platformName : String;
		m_data = ( ( ModReloadingPopupData )( GetRootWidget().GetUserData( 'ModReloadingPopupData' ) ) );
		m_requestHandler = GetSystemRequestsHandler();
		RegisterToGlobalInputCallback( 'OnPostOnRelease', this, 'OnRelease' );
		m_requestHandler.RegisterToCallback( 'OnAdditionalContentDataReloadProgressCallback', this, 'OnModReloadProgress' );
		m_progressBarController = ( ( LoadingScreenProgressBarController )( inkWidgetRef.GetController( m_progressBarRef ) ) );
		platformName = GetPlatformShortName();
		if( ( ( ( platformName == "ps5" || platformName == "ps5pro" ) || platformName == "xseriesx" ) || platformName == "xseriess" ) || platformName == "emporium" )
		{
			inkTextRef.SetText( m_noTurnOffTextWidget, GetLocalizedText( "UI-Modio-ModalContent-NoTurnOffConsole" ) );
		}
		else
		{
			inkTextRef.SetText( m_noTurnOffTextWidget, GetLocalizedText( "UI-Modio-ModalContent-NoTurnOffSystem" ) );
		}
	}

	protected event OnUninitialize()
	{
		UnregisterFromGlobalInputCallback( 'OnPostOnRelease', this, 'OnRelease' );
		m_requestHandler.UnregisterFromCallback( 'OnAdditionalContentDataReloadProgressCallback', this, 'OnModReloadProgress' );
	}

	protected event OnModReloadProgress( progress : Float )
	{
		if( m_progressBarController )
		{
			m_progressBarController.SetProgress( progress );
		}
		if( progress >= 1.0 )
		{
			Close();
		}
	}

	private function Close()
	{
		m_data.token.TriggerCallback( m_data );
	}

	protected event OnRelease( evt : inkPointerEvent )
	{
		if( evt.IsAction( 'close_popup' ) )
		{
			Close();
		}
	}

}

