class ModioReportController extends inkLogicController
{
	private editable var m_reportTypeBtnRef1 : inkWidgetRef;
	private editable var m_reportTypeBtnRef2 : inkWidgetRef;
	private editable var m_reportTypeBtnRef3 : inkWidgetRef;
	private editable var m_reportTypeBtnRef4 : inkWidgetRef;
	private editable var m_reportTypeBtnRef5 : inkWidgetRef;
	private editable var m_reportTypeBtnRef6 : inkWidgetRef;
	private editable var m_reportTypeBtnRef7 : inkWidgetRef;
	private editable var m_reportPanel1 : inkWidgetRef;
	private editable var m_reportPanel2 : inkWidgetRef;
	private editable var m_reportTypeBtnInStep2Ref : inkWidgetRef;
	private editable var m_reportTypeLabelInStep2Ref : inkTextRef;
	private editable var m_titleMsgRef : inkTextRef;
	private editable var m_hyperlinkButtonRef1 : inkWidgetRef;
	private editable var m_hyperlinkButtonRef2 : inkWidgetRef;
	private editable var m_agreeBtnRef : inkWidgetRef;
	private editable var m_NoThanksBtnRef : inkWidgetRef;
	private editable var m_detailText : inkTextInputRef;
	private editable var m_detailArea : inkWidgetRef;
	private editable var m_SelectModLabelRef : inkTextRef;
	private editable var m_SelectModImg : inkImageRef;
	private var m_fadeAnim : inkAnimProxy;
	private var m_currentModID : Int64;
	private var m_currentReportType : Int8;
	private var m_systemHandler : weak< inkISystemRequestsHandler >;
	private var m_modMenuController : weak< inkIGameController >;
	private var m_acceptButtonController : weak< inkButtonController >;
	private var m_OpenIMGDialog : Bool;

	protected event OnInitialize()
	{
		var platformName : String;
		inkWidgetRef.RegisterToCallback( m_hyperlinkButtonRef1, 'OnPress', this, 'OnTermsPress' );
		inkWidgetRef.RegisterToCallback( m_hyperlinkButtonRef2, 'OnPress', this, 'OnPrivacyPress' );
		inkWidgetRef.RegisterToCallback( m_agreeBtnRef, 'OnButtonClick', this, 'OnAgreePress' );
		inkWidgetRef.RegisterToCallback( m_NoThanksBtnRef, 'OnButtonClick', this, 'OnCancelPress' );
		inkWidgetRef.RegisterToCallback( m_detailArea, 'OnPress', this, 'OnDetailPress' );
		RegisterToGlobalInputCallback( 'OnPostOnRelease', this, 'OnButtonPress' );
		inkWidgetRef.RegisterToCallback( m_reportTypeBtnRef1, 'OnPress', this, 'OnReportTypeBtnPress1' );
		inkWidgetRef.RegisterToCallback( m_reportTypeBtnRef2, 'OnPress', this, 'OnReportTypeBtnPress2' );
		inkWidgetRef.RegisterToCallback( m_reportTypeBtnRef3, 'OnPress', this, 'OnReportTypeBtnPress3' );
		inkWidgetRef.RegisterToCallback( m_reportTypeBtnRef4, 'OnPress', this, 'OnReportTypeBtnPress4' );
		inkWidgetRef.RegisterToCallback( m_reportTypeBtnRef5, 'OnPress', this, 'OnReportTypeBtnPress5' );
		inkWidgetRef.RegisterToCallback( m_reportTypeBtnRef6, 'OnPress', this, 'OnReportTypeBtnPress6' );
		inkWidgetRef.RegisterToCallback( m_reportTypeBtnRef7, 'OnPress', this, 'OnReportTypeBtnPress7' );
		inkWidgetRef.RegisterToCallback( m_reportTypeBtnInStep2Ref, 'OnPress', this, 'OnReportTypeBtnInStep2Press' );
		m_acceptButtonController = ( ( inkButtonController )( inkWidgetRef.GetControllerByType( m_agreeBtnRef, 'inkButtonController' ) ) );
		m_acceptButtonController.SetSelectable( true );
		m_acceptButtonController.SetEnabled( true );
		m_currentReportType = -1;
		inkWidgetRef.SetVisible( m_reportPanel1, true );
		inkWidgetRef.SetVisible( m_reportPanel2, false );
		( ( inkText )( inkTextInputRef.Get( m_detailText ) ) ).SetWrappingAtPosition( 1450.0 );
		platformName = GetPlatformShortName();
		if( ( ( platformName == "ps5" || platformName == "ps5pro" ) || platformName == "xseriesx" ) || platformName == "xseriess" )
		{
			inkTextInputRef.SetInteractive( m_detailText, false );
		}
	}

	protected event OnUninitialize()
	{
		inkWidgetRef.UnregisterFromCallback( m_hyperlinkButtonRef1, 'OnPress', this, 'OnTermsPress' );
		inkWidgetRef.UnregisterFromCallback( m_hyperlinkButtonRef2, 'OnPress', this, 'OnPrivacyPress' );
		inkWidgetRef.UnregisterFromCallback( m_agreeBtnRef, 'OnButtonClick', this, 'OnAgreePress' );
		inkWidgetRef.UnregisterFromCallback( m_NoThanksBtnRef, 'OnButtonClick', this, 'OnCancelPress' );
		inkWidgetRef.UnregisterFromCallback( m_detailArea, 'OnPress', this, 'OnDetailPress' );
		inkWidgetRef.UnregisterFromCallback( m_reportTypeBtnRef1, 'OnPress', this, 'OnReportTypeBtnPress1' );
		inkWidgetRef.UnregisterFromCallback( m_reportTypeBtnRef2, 'OnPress', this, 'OnReportTypeBtnPress2' );
		inkWidgetRef.UnregisterFromCallback( m_reportTypeBtnRef3, 'OnPress', this, 'OnReportTypeBtnPress3' );
		inkWidgetRef.UnregisterFromCallback( m_reportTypeBtnRef4, 'OnPress', this, 'OnReportTypeBtnPress4' );
		inkWidgetRef.UnregisterFromCallback( m_reportTypeBtnRef5, 'OnPress', this, 'OnReportTypeBtnPress5' );
		inkWidgetRef.UnregisterFromCallback( m_reportTypeBtnRef6, 'OnPress', this, 'OnReportTypeBtnPress6' );
		inkWidgetRef.UnregisterFromCallback( m_reportTypeBtnRef7, 'OnPress', this, 'OnReportTypeBtnPress7' );
		inkWidgetRef.UnregisterFromCallback( m_reportTypeBtnInStep2Ref, 'OnPress', this, 'OnReportTypeBtnInStep2Press' );
		UnregisterFromGlobalInputCallback( 'OnPostOnRelease', this, 'OnButtonPress' );
		m_modMenuController.RequestSetFocus( NULL );
	}

	protected event OnReportTypeBtnPress1( evt : inkPointerEvent )
	{
		OnReportTypeClick( evt, 1 );
	}

	protected event OnReportTypeBtnPress2( evt : inkPointerEvent )
	{
		OnReportTypeClick( evt, 2 );
	}

	protected event OnReportTypeBtnPress3( evt : inkPointerEvent )
	{
		OnReportTypeClick( evt, 3 );
	}

	protected event OnReportTypeBtnPress4( evt : inkPointerEvent )
	{
		OnReportTypeClick( evt, 4 );
	}

	protected event OnReportTypeBtnPress5( evt : inkPointerEvent )
	{
		OnReportTypeClick( evt, 5 );
	}

	protected event OnReportTypeBtnPress6( evt : inkPointerEvent )
	{
		OnReportTypeClick( evt, 6 );
	}

	protected event OnReportTypeBtnPress7( evt : inkPointerEvent )
	{
		OnReportTypeClick( evt, 7 );
	}

	protected event OnReportTypeClick( evt : inkPointerEvent, index : Int8 )
	{
		var selectTypeStr : String;
		if( evt.IsAction( 'click' ) )
		{
			m_currentReportType = index;
			inkWidgetRef.SetVisible( m_reportPanel1, false );
			inkWidgetRef.SetVisible( m_reportPanel2, true );
			switch( index )
			{
				case 1:
					selectTypeStr = GetLocalizedText( "LocKey#97545" );
				break;
				case 2:
					selectTypeStr = GetLocalizedText( "LocKey#97539" );
				break;
				case 3:
					selectTypeStr = GetLocalizedText( "LocKey#97540" );
				break;
				case 4:
					selectTypeStr = GetLocalizedText( "LocKey#97541" );
				break;
				case 5:
					selectTypeStr = GetLocalizedText( "LocKey#97542" );
				break;
				case 6:
					selectTypeStr = GetLocalizedText( "LocKey#97543" );
				break;
				case 7:
					selectTypeStr = GetLocalizedText( "LocKey#97546" );
				break;
			}
			inkTextRef.SetText( m_reportTypeLabelInStep2Ref, selectTypeStr );
		}
	}

	protected event OnReportTypeBtnInStep2Press( evt : inkPointerEvent )
	{
		if( evt.IsAction( 'click' ) )
		{
			inkWidgetRef.SetVisible( m_reportPanel1, true );
			inkWidgetRef.SetVisible( m_reportPanel2, false );
			m_modMenuController.RequestSetFocus( NULL );
		}
	}

	protected event OnButtonPress( evt : inkPointerEvent )
	{
		if( !( GetRootWidget().IsVisible() ) )
		{
			return false;
		}
		if( evt.IsAction( 'back' ) )
		{
			Close();
		}
		else if( evt.IsAction( 'close_popup' ) )
		{
			Close();
		}
	}

	protected event OnDetailPress( evt : inkPointerEvent )
	{
		var platformName : String;
		if( evt.IsAction( 'click' ) )
		{
			( ( inkTextInput )( inkTextInputRef.Get( m_detailText ) ) ).RequestFocus();
			platformName = GetPlatformShortName();
			if( ( ( platformName == "ps5" || platformName == "ps5pro" ) || platformName == "xseriesx" ) || platformName == "xseriess" )
			{
				if( !( m_OpenIMGDialog ) )
				{
					Modio.OpenIMEDialog( ( ( inkText )( inkTextInputRef.Get( m_detailText ) ) ).GetText(), this, 'OnOpenIMEDialogResult' );
					m_OpenIMGDialog = true;
				}
				else
				{
					m_OpenIMGDialog = false;
				}
			}
		}
	}

	protected event OnOpenIMEDialogResult( str : String, hasResult : Bool )
	{
		if( hasResult )
		{
			( ( inkText )( inkTextInputRef.Get( m_detailText ) ) ).SetText( str );
		}
	}

	protected event OnAgreePress( controller : weak< inkButtonController > )
	{
		var detail : String;
		detail = ( ( inkText )( inkTextInputRef.Get( m_detailText ) ) ).GetText();
		if( m_currentModID <= 0 )
		{
			return true;
		}
		if( m_currentReportType < 0 )
		{
			m_systemHandler.RequestSystemNotificationGeneric( 'UI-Modio-ModalContent-ReportTitle', 'UI-Modio-ModalContent-ReportInstructA' );
			return true;
		}
		if( detail == "" || ( StrLen( detail ) < 3 ) )
		{
			m_systemHandler.RequestSystemNotificationGeneric( 'UI-Modio-ModalContent-ReportTitle', 'UI-Modio-ModalContent-ReportInstructB' );
			return true;
		}
		Modio.RequestReport( m_currentModID, ( ( inkModioReportType )( m_currentReportType ) ), detail, "", this, 'OnReportResult' );
		m_acceptButtonController.SetSelectable( false );
		m_acceptButtonController.SetEnabled( false );
	}

	protected event OnCancelPress( controller : weak< inkButtonController > )
	{
		Close();
	}

	protected event OnTermsPress( evt : inkPointerEvent )
	{
		if( evt.IsAction( 'click' ) )
		{
			Modio.OpenUrl( 0 );
		}
	}

	protected event OnPrivacyPress( evt : inkPointerEvent )
	{
		if( evt.IsAction( 'click' ) )
		{
			Modio.OpenUrl( 1 );
		}
	}

	public function OnReportTypeItemClick( index : Int8 )
	{
		m_currentReportType = index;
	}

	public function Close()
	{
		m_modMenuController.RequestSetFocus( NULL );
		( ( BrowserModsMenuGameController )( m_modMenuController ) ).ActivateNavigation();
		PlayFadeAnimation( 0.5 );
	}

	public function OnOpen()
	{
		GetRootWidget().SetVisible( true );
		PlayFadeAnimation( 1.0 );
		m_currentReportType = -1;
		inkWidgetRef.SetVisible( m_reportPanel1, true );
		inkWidgetRef.SetVisible( m_reportPanel2, false );
		m_acceptButtonController.SetSelectable( true );
		m_acceptButtonController.SetEnabled( true );
	}

	private function PlayFadeAnimation( opacity : Float )
	{
		var widget : weak< inkWidget >;
		var animDef : inkAnimDef;
		var animInterp : inkAnimTransparency;
		widget = GetRootWidget();
		if( ( widget.GetOpacity() == opacity ) || ( m_fadeAnim != NULL ) )
		{
			return;
		}
		animDef = new inkAnimDef;
		animInterp = new inkAnimTransparency;
		animInterp.SetEndTransparency( opacity );
		animInterp.SetDuration( 0.1 );
		animInterp.SetDirection( inkanimInterpolationDirection.To );
		animInterp.SetUseRelativeDuration( true );
		animDef.AddInterpolator( animInterp );
		m_fadeAnim = widget.PlayAnimation( animDef );
		m_fadeAnim.RegisterToCallback( inkanimEventType.OnFinish, this, 'OnFadeAnimFinished' );
	}

	protected event OnFadeAnimFinished( anim : inkAnimProxy )
	{
		if( m_fadeAnim != NULL )
		{
			m_fadeAnim.UnregisterFromCallback( inkanimEventType.OnFinish, this, 'OnFadeAnimFinished' );
			m_fadeAnim = NULL;
		}
		if( GetRootWidget().GetOpacity() < 0.89999998 )
		{
			GetRootWidget().SetVisible( false );
		}
	}

	public function IsClosed() : Bool
	{
		if( GetRootWidget().IsVisible() )
		{
			return false;
		}
		if( ( m_fadeAnim != NULL ) && m_fadeAnim.IsPlaying() )
		{
			return false;
		}
		return true;
	}

	public function SetModID( modID : Int64 )
	{
		var modLogoPath : String;
		if( m_currentModID != modID )
		{
			( ( inkText )( inkTextInputRef.Get( m_detailText ) ) ).SetText( "" );
		}
		m_currentModID = modID;
		if( m_modMenuController && inkImageRef.IsValid( m_SelectModImg ) )
		{
			modLogoPath = ( ( ModioBrowserMenuGameController )( m_modMenuController ) ).GetModLogoPathByModID( modID );
			if( modLogoPath != "" && m_systemHandler )
			{
				m_systemHandler.RequestGameScreenshotByPath( modLogoPath, ( ( inkImage )( inkImageRef.Get( m_SelectModImg ) ) ) );
			}
		}
	}

	public function SetModName( modName : String )
	{
		inkTextRef.SetText( m_SelectModLabelRef, modName );
	}

	public function SetSystemHandler( systemHandler : weak< inkISystemRequestsHandler > )
	{
		m_systemHandler = systemHandler;
	}

	public function SetModMenuController( controller : weak< inkIGameController > )
	{
		m_modMenuController = controller;
	}

	protected event OnReportResult( err : Int32 )
	{
		var msg : String;
		m_acceptButtonController.SetSelectable( true );
		m_acceptButtonController.SetEnabled( true );
		if( err == 0 )
		{
			m_systemHandler.RequestSystemNotificationGeneric( 'UI-Modio-ModalContent-ReportTitle', 'Gameplay-Scanning-Devices-Success' );
			Close();
		}
		else
		{
			msg = "Modio Report failed, error code " + IntToString( err );
			m_systemHandler.RequestSystemNotificationGeneric( 'UI-Modio-ModalContent-ReportTitle', StringToName( msg ) );
		}
	}

}

class ModioReportReasonButtonController extends inkLogicController
{
	private editable var m_buttonCore : inkWidgetRef;
	private editable var m_buttonBorder : inkWidgetRef;
	private editable var m_leftButtonSideBorder : inkWidgetRef;
	private var m_colorNames : ModsMenuColorsNames;

	protected event OnInitialize()
	{
		RegisterToCallback( 'OnRelease', this, 'OnRelease' );
		RegisterToCallback( 'OnHoverOver', this, 'OnHoverOver' );
		RegisterToCallback( 'OnHoverOut', this, 'OnHoverOut' );
	}

	protected event OnUninitialize()
	{
		UnregisterFromCallback( 'OnRelease', this, 'OnRelease' );
		UnregisterFromCallback( 'OnHoverOver', this, 'OnHoverOver' );
		UnregisterFromCallback( 'OnHoverOut', this, 'OnHoverOut' );
	}

	protected event OnHoverOver( e : inkPointerEvent )
	{
		inkWidgetRef.Get( m_buttonCore ).BindProperty( 'tintColor', m_colorNames.faintRedName );
		inkWidgetRef.Get( m_buttonBorder ).BindProperty( 'tintColor', m_colorNames.activeRedName );
		inkWidgetRef.Get( m_leftButtonSideBorder ).BindProperty( 'tintColor', m_colorNames.activeRedName );
	}

	protected event OnHoverOut( e : inkPointerEvent )
	{
		inkWidgetRef.Get( m_buttonCore ).BindProperty( 'tintColor', m_colorNames.mediumRedName );
		inkWidgetRef.Get( m_buttonBorder ).BindProperty( 'tintColor', m_colorNames.mildRedName );
		inkWidgetRef.Get( m_leftButtonSideBorder ).BindProperty( 'tintColor', m_colorNames.mildRedName );
	}

}

