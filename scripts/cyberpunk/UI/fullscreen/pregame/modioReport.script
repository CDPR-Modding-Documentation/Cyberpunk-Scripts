	private var m_colorNames : ModsMenuColorsNames;

	protected event OnInitialize()
	{
		var platformName : String;
		var navControllerForStep2Btn : inkDiscreteNavigationController;
		var navControllerForStep2TextArea : inkDiscreteNavigationController;
		inkWidgetRef.RegisterToCallback( m_hyperlinkButtonRef1, 'OnPress', this, 'OnTermsPress' );
		inkWidgetRef.RegisterToCallback( m_hyperlinkButtonRef1, 'OnHoverOver', this, 'OnTermsHoverOver' );
		inkWidgetRef.RegisterToCallback( m_hyperlinkButtonRef1, 'OnHoverOut', this, 'OnTermsHoverOut' );
		inkWidgetRef.RegisterToCallback( m_hyperlinkButtonRef2, 'OnPress', this, 'OnPrivacyPress' );
		inkWidgetRef.RegisterToCallback( m_hyperlinkButtonRef2, 'OnHoverOver', this, 'OnPrivacyHoverOver' );
		inkWidgetRef.RegisterToCallback( m_hyperlinkButtonRef2, 'OnHoverOut', this, 'OnPrivacyHoverOut' );
		inkWidgetRef.RegisterToCallback( m_agreeBtnRef, 'OnButtonClick', this, 'OnAgreePress' );
		inkWidgetRef.RegisterToCallback( m_NoThanksBtnRef, 'OnButtonClick', this, 'OnCancelPress' );
		inkWidgetRef.RegisterToCallback( m_agreeBtnRef, 'OnRelease', this, 'OnAgreeTouch' );
		inkWidgetRef.RegisterToCallback( m_NoThanksBtnRef, 'OnRelease', this, 'OnCancelTouch' );
		inkWidgetRef.RegisterToCallback( m_agreeBtnRef, 'OnHoverOver', this, 'OnAgreeHoveredOver' );
		inkWidgetRef.RegisterToCallback( m_NoThanksBtnRef, 'OnHoverOver', this, 'OnCancelHoveredOver' );
		inkWidgetRef.RegisterToCallback( m_detailArea, 'OnRelease', this, 'OnDetailPress' );
		inkWidgetRef.RegisterToCallback( m_detailArea, 'OnHoverOver', this, 'OnDetailHoveredOver' );
		if( inkWidgetRef.IsValid( m_detailTextArea ) )
		{
			( ( inkCanvas )( inkWidgetRef.Get( m_detailTextArea ) ) ).GetWidget( 0 ).RegisterToCallback( 'OnRelease', this, 'OnDetailTextPress' );
			( ( inkCanvas )( inkWidgetRef.Get( m_detailTextArea ) ) ).GetWidget( 0 ).SetInteractive( true );
		}
		RegisterToGlobalInputCallback( 'OnPostOnRelease', this, 'OnButtonPress' );
		inkWidgetRef.RegisterToCallback( m_reportTypeBtnRef1, 'OnRelease', this, 'OnReportTypeBtnPress1' );
		inkWidgetRef.RegisterToCallback( m_reportTypeBtnRef2, 'OnRelease', this, 'OnReportTypeBtnPress2' );
		inkWidgetRef.RegisterToCallback( m_reportTypeBtnRef3, 'OnRelease', this, 'OnReportTypeBtnPress3' );
		inkWidgetRef.RegisterToCallback( m_reportTypeBtnRef4, 'OnRelease', this, 'OnReportTypeBtnPress4' );
		inkWidgetRef.RegisterToCallback( m_reportTypeBtnRef5, 'OnRelease', this, 'OnReportTypeBtnPress5' );
		inkWidgetRef.RegisterToCallback( m_reportTypeBtnRef6, 'OnRelease', this, 'OnReportTypeBtnPress6' );
		inkWidgetRef.RegisterToCallback( m_reportTypeBtnRef7, 'OnRelease', this, 'OnReportTypeBtnPress7' );
		inkWidgetRef.RegisterToCallback( m_reportTypeBtnInStep2Ref, 'OnRelease', this, 'OnReportTypeBtnInStep2Press' );
		navControllerForStep2Btn = ( ( inkDiscreteNavigationController )( inkWidgetRef.GetController( m_reportTypeBtnInStep2Ref ) ) );
		navControllerForStep2Btn.OverrideNavigation( inkDiscreteNavigationDirection.Down, inkWidgetRef.Get( m_detailArea ) );
		navControllerForStep2TextArea = ( ( inkDiscreteNavigationController )( inkWidgetRef.GetController( m_detailArea ) ) );
		navControllerForStep2TextArea.OverrideNavigation( inkDiscreteNavigationDirection.Down, inkWidgetRef.Get( m_hyperlinkButtonRef1 ) );
		m_acceptButtonController = ( ( inkButtonController )( inkWidgetRef.GetControllerByType( m_agreeBtnRef, 'inkButtonController' ) ) );
		m_acceptButtonController.SetSelectable( true );
		m_acceptButtonController.SetEnabled( true );
		m_currentReportType = -1;
		inkWidgetRef.SetVisible( m_reportPanel1, true );
		inkWidgetRef.SetVisible( m_reportPanel2, false );
		( ( inkText )( inkTextInputRef.Get( m_detailText ) ) ).SetWrapping( true, 1450.0, textWrappingPolicy.PerCharacter );
		( ( inkTextInput )( inkTextInputRef.Get( m_detailText ) ) ).SetMaxChars( 1000 );
		platformName = GetPlatformShortName();
		if( ( ( ( platformName == "ps5" || platformName == "ps5pro" ) || platformName == "xseriesx" ) || platformName == "xseriess" ) || platformName == "emporium" )
		{
			inkTextInputRef.SetInteractive( m_detailText, false );
		}
	}

	protected event OnUninitialize()
	{
		inkWidgetRef.UnregisterFromCallback( m_hyperlinkButtonRef1, 'OnPress', this, 'OnTermsPress' );
		inkWidgetRef.UnregisterFromCallback( m_hyperlinkButtonRef1, 'OnHoverOver', this, 'OnTermsHoverOver' );
		inkWidgetRef.UnregisterFromCallback( m_hyperlinkButtonRef1, 'OnHoverOut', this, 'OnTermsHoverOut' );
		inkWidgetRef.UnregisterFromCallback( m_hyperlinkButtonRef2, 'OnPress', this, 'OnPrivacyPress' );
		inkWidgetRef.UnregisterFromCallback( m_hyperlinkButtonRef2, 'OnHoverOver', this, 'OnPrivacyHoverOver' );
		inkWidgetRef.UnregisterFromCallback( m_hyperlinkButtonRef2, 'OnHoverOut', this, 'OnPrivacyHoverOut' );
		inkWidgetRef.UnregisterFromCallback( m_agreeBtnRef, 'OnButtonClick', this, 'OnAgreePress' );
		inkWidgetRef.UnregisterFromCallback( m_NoThanksBtnRef, 'OnButtonClick', this, 'OnCancelPress' );
		inkWidgetRef.UnregisterFromCallback( m_agreeBtnRef, 'OnRelease', this, 'OnAgreeTouch' );
		inkWidgetRef.UnregisterFromCallback( m_NoThanksBtnRef, 'OnRelease', this, 'OnCancelTouch' );
		inkWidgetRef.UnregisterFromCallback( m_agreeBtnRef, 'OnHoverOver', this, 'OnAgreeHoveredOver' );
		inkWidgetRef.UnregisterFromCallback( m_NoThanksBtnRef, 'OnHoverOver', this, 'OnCancelHoveredOver' );
		inkWidgetRef.UnregisterFromCallback( m_detailArea, 'OnRelease', this, 'OnDetailPress' );
		inkWidgetRef.UnregisterFromCallback( m_detailArea, 'OnHoverOver', this, 'OnDetailHoveredOver' );
		inkWidgetRef.UnregisterFromCallback( m_reportTypeBtnRef1, 'OnRelease', this, 'OnReportTypeBtnPress1' );
		inkWidgetRef.UnregisterFromCallback( m_reportTypeBtnRef2, 'OnRelease', this, 'OnReportTypeBtnPress2' );
		inkWidgetRef.UnregisterFromCallback( m_reportTypeBtnRef3, 'OnRelease', this, 'OnReportTypeBtnPress3' );
		inkWidgetRef.UnregisterFromCallback( m_reportTypeBtnRef4, 'OnRelease', this, 'OnReportTypeBtnPress4' );
		inkWidgetRef.UnregisterFromCallback( m_reportTypeBtnRef5, 'OnRelease', this, 'OnReportTypeBtnPress5' );
		inkWidgetRef.UnregisterFromCallback( m_reportTypeBtnRef6, 'OnRelease', this, 'OnReportTypeBtnPress6' );
		inkWidgetRef.UnregisterFromCallback( m_reportTypeBtnRef7, 'OnRelease', this, 'OnReportTypeBtnPress7' );
		inkWidgetRef.UnregisterFromCallback( m_reportTypeBtnInStep2Ref, 'OnRelease', this, 'OnReportTypeBtnInStep2Press' );
		UnregisterFromGlobalInputCallback( 'OnPostOnRelease', this, 'OnButtonPress' );
		m_modMenuController.RequestSetFocus( NULL );
		if( inkWidgetRef.IsValid( m_detailTextArea ) )
		{
			( ( inkCanvas )( inkWidgetRef.Get( m_detailTextArea ) ) ).GetWidget( 0 ).UnregisterFromCallback( 'OnRelease', this, 'OnDetailTextPress' );
		}
	}

	protected event OnReportTypeBtnPress1( evt : inkPointerEvent )
	{
		OnReportTypeClick( evt, 1 );
	}

	protected event OnReportTypeBtnPress2( evt : inkPointerEvent )
	{
		OnReportTypeClick( evt, 2 );
	}

	protected event OnReportTypeBtnPress3( evt : inkPointerEvent )
	{
		OnReportTypeClick( evt, 3 );
	}

	protected event OnReportTypeBtnPress4( evt : inkPointerEvent )
	{
		OnReportTypeClick( evt, 4 );
	}

	protected event OnReportTypeBtnPress5( evt : inkPointerEvent )
	{
		OnReportTypeClick( evt, 5 );
	}

	protected event OnReportTypeBtnPress6( evt : inkPointerEvent )
	{
		OnReportTypeClick( evt, 6 );
	}

	protected event OnReportTypeBtnPress7( evt : inkPointerEvent )
	{
		OnReportTypeClick( evt, 7 );
	}

	protected event OnReportTypeClick( evt : inkPointerEvent, index : Int8 )
	{
		var selectTypeStr : String;
		var navControllerForLink1 : inkDiscreteNavigationController;
		var navControllerForLink2 : inkDiscreteNavigationController;
		if( evt.IsAction( 'click' ) || evt.IsAction( 'tap' ) )
		{
			m_currentReportType = index;
			inkWidgetRef.SetVisible( m_reportPanel1, false );
			inkWidgetRef.SetVisible( m_reportPanel2, true );
			switch( index )
			{
				case 1:
					selectTypeStr = GetLocalizedText( "LocKey#97545" );
				break;
				case 2:
					selectTypeStr = GetLocalizedText( "LocKey#97539" );
				break;
				case 3:
					selectTypeStr = GetLocalizedText( "LocKey#97540" );
				break;
				case 4:
					selectTypeStr = GetLocalizedText( "LocKey#97541" );
				break;
				case 5:
					selectTypeStr = GetLocalizedText( "LocKey#97542" );
				break;
				case 6:
					selectTypeStr = GetLocalizedText( "LocKey#97543" );
				break;
				case 7:
					selectTypeStr = GetLocalizedText( "LocKey#97546" );
				break;
			}
			inkTextRef.SetText( m_reportTypeLabelInStep2Ref, selectTypeStr );
			if( ( ( BrowserModsMenuGameController )( m_modMenuController ) ).IsUsingDPad() )
			{
				( ( inkGameController )( m_modMenuController ) ).SetCursorOverWidget( inkWidgetRef.Get( m_detailArea ), 0.0, true );
			}
			navControllerForLink1 = ( ( inkDiscreteNavigationController )( inkWidgetRef.GetController( m_hyperlinkButtonRef1 ) ) );
			navControllerForLink2 = ( ( inkDiscreteNavigationController )( inkWidgetRef.GetController( m_hyperlinkButtonRef2 ) ) );
			navControllerForLink1.OverrideNavigation( inkDiscreteNavigationDirection.Up, inkWidgetRef.Get( m_detailArea ) );
			navControllerForLink2.OverrideNavigation( inkDiscreteNavigationDirection.Up, inkWidgetRef.Get( m_detailArea ) );
			evt.Handle();
			PlaySound( 'Button', 'OnPress' );
		}
	}

	protected event OnReportTypeBtnInStep2Press( evt : inkPointerEvent )
	{
		var navControllerForLink1 : inkDiscreteNavigationController;
		var navControllerForLink2 : inkDiscreteNavigationController;
		if( evt.IsAction( 'click' ) || evt.IsAction( 'tap' ) )
		{
			inkWidgetRef.SetVisible( m_reportPanel1, true );
			inkWidgetRef.SetVisible( m_reportPanel2, false );
			m_modMenuController.RequestSetFocus( NULL );
			navControllerForLink1 = ( ( inkDiscreteNavigationController )( inkWidgetRef.GetController( m_hyperlinkButtonRef1 ) ) );
			navControllerForLink2 = ( ( inkDiscreteNavigationController )( inkWidgetRef.GetController( m_hyperlinkButtonRef2 ) ) );
			navControllerForLink1.OverrideNavigation( inkDiscreteNavigationDirection.Up, inkWidgetRef.Get( m_reportTypeBtnRef7 ) );
			navControllerForLink2.OverrideNavigation( inkDiscreteNavigationDirection.Up, inkWidgetRef.Get( m_reportTypeBtnRef7 ) );
			if( ( ( BrowserModsMenuGameController )( m_modMenuController ) ).IsUsingDPad() )
			{
				( ( inkGameController )( m_modMenuController ) ).SetCursorOverWidget( inkWidgetRef.Get( m_reportTypeBtnRef1 ), 0.0, true );
			}
			PlaySound( 'Button', 'OnPress' );
		}
	}

	protected event OnButtonPress( evt : inkPointerEvent )
	{
		if( !( GetRootWidget().IsVisible() ) )
		{
			return false;
		}
		if( evt.IsAction( 'back' ) || evt.IsAction( 'close_popup' ) )
		{
			TryClose();
		}
		else if( evt.IsAction( 'mod_confirm_report' ) )
		{
			OnAgreePress( NULL );
		}
	}

	protected event OnDetailHoveredOver( evt : inkPointerEvent )
	{
		PlaySound( 'Button', 'OnHover' );
	}

	protected event OnDetailPress( evt : inkPointerEvent )
	{
		var platformName : String;
		var voName : CName;
		var voVar : ConfigVarListName;
		if( evt.IsHandled() )
		{
			return false;
		}
		if( evt.IsAction( 'click' ) || evt.IsAction( 'tap' ) )
		{
			( ( inkTextInput )( inkTextInputRef.Get( m_detailText ) ) ).RequestFocus();
			PlaySound( 'Button', 'OnPress' );
			platformName = GetPlatformShortName();
			if( ( ( ( platformName == "ps5" || platformName == "ps5pro" ) || platformName == "xseriesx" ) || platformName == "xseriess" ) || platformName == "emporium" )
			{
				if( !( m_bIsOpenIMGDialog ) )
				{
					Modio.OpenIMEDialog( ( ( inkText )( inkTextInputRef.Get( m_detailText ) ) ).GetText(), this, 'OnOpenIMEDialogResult' );
					m_bIsOpenIMGDialog = true;
				}
				else
				{
					m_bIsOpenIMGDialog = false;
				}
			}
			else if( platformName == "windows" || platformName == "windowsGDK" )
			{
				voVar = ( ( ConfigVarListName )( m_systemHandler.GetUserSettings().GetVar( '/language', 'OnScreen' ) ) );
				if( voVar )
				{
					voName = voVar.GetValue();
					if( ( ( voName == 'ja' || voName == 'ko' ) || voName == 'zh-cn' ) || voName == 'zh-tw' )
					{
						Modio.OpenIMEDialog( ( ( inkText )( inkTextInputRef.Get( m_detailText ) ) ).GetText(), this, 'OnOpenIMEDialogResult', 1000 );
					}
				}
			}
		}
	}

	protected event OnDetailTextPress( evt : inkPointerEvent )
	{
		var platformName : String;
		var voName : CName;
		var voVar : ConfigVarListName;
		if( evt.IsHandled() )
		{
			return false;
		}
		if( evt.IsAction( 'click' ) || evt.IsAction( 'tap' ) )
		{
			( ( inkTextInput )( inkTextInputRef.Get( m_detailText ) ) ).RequestFocus();
			PlaySound( 'Button', 'OnPress' );
			platformName = GetPlatformShortName();
			if( platformName == "mac" )
			{
				voVar = ( ( ConfigVarListName )( m_systemHandler.GetUserSettings().GetVar( '/language', 'OnScreen' ) ) );
				if( voVar )
				{
					voName = voVar.GetValue();
					if( ( ( voName == 'ja' || voName == 'ko' ) || voName == 'zh-cn' ) || voName == 'zh-tw' )
					{
						Modio.OpenIMEDialog( ( ( inkText )( inkTextInputRef.Get( m_detailText ) ) ).GetText(), this, 'OnOpenIMEDialogResult', 1000 );
					}
				}
			}
		}
	}

	protected event OnOpenIMEDialogResult( str : String, hasResult : Bool )
	{
		var maxChars : Uint32;
		if( hasResult )
		{
			maxChars = ( ( inkTextInput )( inkTextInputRef.Get( m_detailText ) ) ).GetMaxChars();
			if( ( maxChars > 0 ) && ( StrLen( str ) > ( ( Int32 )( maxChars ) ) ) )
			{
				( ( inkText )( inkTextInputRef.Get( m_detailText ) ) ).SetText( Modio.SubStrByChar( str, 0, ( ( Int32 )( maxChars ) ) ) );
			}
			else
			{
				( ( inkText )( inkTextInputRef.Get( m_detailText ) ) ).SetText( str );
			}
		}
		m_bIsOpenIMGDialog = false;
	}

	protected event OnAgreePress( controller : weak< inkButtonController > )
	{
		SendAgree();
	}

	public function SendAgree()
	{
		var detail : String;
		detail = ( ( inkText )( inkTextInputRef.Get( m_detailText ) ) ).GetText();
		PlaySound( 'Button', 'OnPress' );
		if( m_currentModID <= 0 )
		{
			return;
		}
		if( m_currentReportType < 0 )
		{
			m_systemHandler.RequestSystemNotificationGeneric( 'UI-Modio-ModalContent-ReportTitle', 'UI-Modio-ModalContent-ReportInstructA' );
			return;
		}
		if( detail == "" || ( StrLen( detail ) < 3 ) )
		{
			m_systemHandler.RequestSystemNotificationGeneric( 'UI-Modio-ModalContent-ReportTitle', 'UI-Modio-ModalContent-ReportInstructB' );
			return;
		}
		Modio.RequestReport( m_currentModID, ( ( inkModioReportType )( m_currentReportType ) ), detail, "", this, 'OnReportResult' );
		m_acceptButtonController.SetSelectable( false );
		m_acceptButtonController.SetEnabled( false );
	}

	protected event OnAgreeTouch( evt : inkPointerEvent )
	{
		if( evt.IsAction( 'tap' ) )
		{
			SendAgree();
		}
	}

	protected event OnAgreeHoveredOver( evt : inkPointerEvent )
	{
		PlaySound( 'Button', 'OnHover' );
	}

	protected event OnCancelTouch( evt : inkPointerEvent )
	{
		if( evt.IsAction( 'tap' ) )
		{
			TryClose();
		}
	}

	protected event OnCancelHoveredOver( evt : inkPointerEvent )
	{
		PlaySound( 'Button', 'OnHover' );
	}

	protected event OnCancelPress( controller : weak< inkButtonController > )
	{
		TryClose();
	}

	protected event OnTermsPress( evt : inkPointerEvent )
	{
		if( evt.IsAction( 'click' ) || evt.IsAction( 'tap' ) )
		{
			Modio.OpenUrl( 0 );
			PlaySound( 'Button', 'OnPress' );
		}
	}

	protected event OnTermsHoverOver( evt : inkPointerEvent )
	{
		inkWidgetRef.Get( m_hyperlinkButtonRef1 ).BindProperty( 'tintColor', m_colorNames.activeBlueName );
		PlaySound( 'Button', 'OnHover' );
	}

	protected event OnTermsHoverOut( evt : inkPointerEvent )
	{
		inkWidgetRef.Get( m_hyperlinkButtonRef1 ).BindProperty( 'tintColor', m_colorNames.redName );
	}

	protected event OnPrivacyPress( evt : inkPointerEvent )
	{
		if( evt.IsAction( 'click' ) || evt.IsAction( 'tap' ) )
		{
			Modio.OpenUrl( 1 );
			PlaySound( 'Button', 'OnPress' );
		}
	}

	protected event OnPrivacyHoverOver( evt : inkPointerEvent )
	{
		inkWidgetRef.Get( m_hyperlinkButtonRef2 ).BindProperty( 'tintColor', m_colorNames.activeBlueName );
		PlaySound( 'Button', 'OnHover' );
	}

	protected event OnPrivacyHoverOut( evt : inkPointerEvent )
	{
		inkWidgetRef.Get( m_hyperlinkButtonRef2 ).BindProperty( 'tintColor', m_colorNames.redName );
	}

	public function OnReportTypeItemClick( index : Int8 )
	{
		m_currentReportType = index;
	}

	public function TryClose()
	{
		PlaySound( 'Button', 'OnPress' );
		if( ( ( inkText )( inkTextInputRef.Get( m_detailText ) ) ).GetText() != "" )
		{
			AskIfReallyWantToClose();
		}
		else
		{
			Close();
		}
	}

	public function AskIfReallyWantToClose()
	{
		m_systemHandler.RequestSystemNotificationGenericYesNo( 'UI-Modio-ErrorMessages-WarningReportTitle', 'UI-Modio-ErrorMessages-WarningReportDesc', this, 'OnCloseWarningPopupClosed' );
	}

	protected event OnCloseWarningPopupClosed( value : Bool )
	{
		if( value )
		{
			Close();
		}
	}

	public function Close()
	{
		( ( inkText )( inkTextInputRef.Get( m_detailText ) ) ).SetText( "" );
		m_modMenuController.RequestSetFocus( NULL );
		( ( BrowserModsMenuGameController )( m_modMenuController ) ).ActivateNavigation();
		PlayFadeAnimation( 0.5 );
	}

	public function OnOpen()
	{
		var navControllerForLink1 : inkDiscreteNavigationController;
		var navControllerForLink2 : inkDiscreteNavigationController;
		GetRootWidget().SetVisible( true );
		PlayFadeAnimation( 1.0 );
		m_currentReportType = -1;
		inkWidgetRef.SetVisible( m_reportPanel1, true );
		inkWidgetRef.SetVisible( m_reportPanel2, false );
		m_acceptButtonController.SetSelectable( true );
		m_acceptButtonController.SetEnabled( true );
		navControllerForLink1 = ( ( inkDiscreteNavigationController )( inkWidgetRef.GetController( m_hyperlinkButtonRef1 ) ) );
		navControllerForLink2 = ( ( inkDiscreteNavigationController )( inkWidgetRef.GetController( m_hyperlinkButtonRef2 ) ) );
		navControllerForLink1.OverrideNavigation( inkDiscreteNavigationDirection.Up, inkWidgetRef.Get( m_reportTypeBtnRef7 ) );
		navControllerForLink2.OverrideNavigation( inkDiscreteNavigationDirection.Up, inkWidgetRef.Get( m_reportTypeBtnRef7 ) );
	}

	private function PlayFadeAnimation( opacity : Float )
	{
		var widget : weak< inkWidget >;
		var animDef : inkAnimDef;
		var animInterp : inkAnimTransparency;
		widget = GetRootWidget();
		if( ( widget.GetOpacity() == opacity ) || ( m_fadeAnim != NULL ) )
		{
			return;
		}
		animDef = new inkAnimDef;
		animInterp = new inkAnimTransparency;
		animInterp.SetEndTransparency( opacity );
		animInterp.SetDuration( 0.1 );
		animInterp.SetDirection( inkanimInterpolationDirection.To );
		animInterp.SetUseRelativeDuration( true );
		animDef.AddInterpolator( animInterp );
		m_fadeAnim = widget.PlayAnimation( animDef );
		m_fadeAnim.RegisterToCallback( inkanimEventType.OnFinish, this, 'OnFadeAnimFinished' );
	}

	protected event OnFadeAnimFinished( anim : inkAnimProxy )
	{
		var modMenuController : weak< BrowserModsMenuGameController >;
		if( m_fadeAnim != NULL )
		{
			m_fadeAnim.UnregisterFromCallback( inkanimEventType.OnFinish, this, 'OnFadeAnimFinished' );
			m_fadeAnim = NULL;
		}
		if( GetRootWidget().GetOpacity() < 0.89999998 )
		{
			GetRootWidget().SetVisible( false );
			modMenuController = ( ( BrowserModsMenuGameController )( m_modMenuController ) );
			if( modMenuController.IsUsingDPad() )
			{
				modMenuController.FocusMoreOptionButton();
			}
			else
			{
				modMenuController.ResetCursor();
			}
		}
	}

	public function IsClosed() : Bool
	{
		if( GetRootWidget().IsVisible() )
		{
			return false;
		}
		if( ( m_fadeAnim != NULL ) && m_fadeAnim.IsPlaying() )
		{
			return false;
		}
		return true;
	}

	public function SetModID( modID : Int64 )
	{
		var modLogoPath : String;
		if( m_currentModID != modID )
		{
			( ( inkText )( inkTextInputRef.Get( m_detailText ) ) ).SetText( "" );
		}
		m_currentModID = modID;
		if( m_modMenuController && inkImageRef.IsValid( m_SelectModImg ) )
		{
			modLogoPath = ( ( ModioBrowserMenuGameController )( m_modMenuController ) ).GetModLogoPathByModID( modID );
			if( modLogoPath != "" && m_systemHandler )
			{
				m_systemHandler.RequestGameScreenshotByPath( modLogoPath, ( ( inkImage )( inkImageRef.Get( m_SelectModImg ) ) ) );
			}
		}
	}

	public function SetModName( modName : String )
	{
		inkTextRef.SetText( m_SelectModLabelRef, modName );
	}

	public function SetSystemHandler( systemHandler : weak< inkISystemRequestsHandler > )
	{
		m_systemHandler = systemHandler;
	}

	public function SetModMenuController( controller : weak< inkIGameController > )
	{
		m_modMenuController = controller;
	}

	protected event OnReportResult( err : Int32 )
	{
		m_acceptButtonController.SetSelectable( true );
		m_acceptButtonController.SetEnabled( true );
		if( err == 0 )
		{
			m_systemHandler.RequestSystemNotificationGeneric( 'UI-Modio-ModalContent-ReportTitle', 'UI-Modio-ModalContent-ReportInstructD' );
			Close();
		}
		else
		{
			if( !( m_systemHandler.IsOnline() ) )
			{
				m_systemHandler.RequestSystemNotificationGeneric( 'UI-Modio-ModalContent-ReportTitle', 'UI-Modio-ErrorMessages-Network' );
			}
			else
			{
				m_systemHandler.RequestSystemNotificationGeneric( 'UI-Modio-ModalContent-ReportTitle', 'UI-Modio-ErrorMessages-GenericError' );
			}
		}
	}

}

class ModioReportReasonButtonController extends inkLogicController
{
	private editable var m_buttonCore : inkWidgetRef;
	private editable var m_buttonBorder : inkWidgetRef;
	private editable var m_leftButtonSideBorder : inkWidgetRef;
	private var m_colorNames : ModsMenuColorsNames;

	protected event OnInitialize()
	{
		RegisterToCallback( 'OnRelease', this, 'OnRelease' );
		RegisterToCallback( 'OnHoverOver', this, 'OnHoverOver' );
		RegisterToCallback( 'OnHoverOut', this, 'OnHoverOut' );
	}

	protected event OnUninitialize()
	{
		UnregisterFromCallback( 'OnRelease', this, 'OnRelease' );
		UnregisterFromCallback( 'OnHoverOver', this, 'OnHoverOver' );
		UnregisterFromCallback( 'OnHoverOut', this, 'OnHoverOut' );
	}

	protected event OnHoverOver( e : inkPointerEvent )
	{
		inkWidgetRef.Get( m_buttonCore ).BindProperty( 'tintColor', m_colorNames.faintRedName );
		inkWidgetRef.Get( m_buttonBorder ).BindProperty( 'tintColor', m_colorNames.activeRedName );
		inkWidgetRef.Get( m_leftButtonSideBorder ).BindProperty( 'tintColor', m_colorNames.activeRedName );
		PlaySound( 'Button', 'OnHover' );
	}

	protected event OnHoverOut( e : inkPointerEvent )
	{
		inkWidgetRef.Get( m_buttonCore ).BindProperty( 'tintColor', m_colorNames.mediumRedName );
		inkWidgetRef.Get( m_buttonBorder ).BindProperty( 'tintColor', m_colorNames.mildRedName );
		inkWidgetRef.Get( m_leftButtonSideBorder ).BindProperty( 'tintColor', m_colorNames.mildRedName );
	}

}

