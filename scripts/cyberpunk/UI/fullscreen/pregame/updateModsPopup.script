import struct ModToUpdateInfo
{
	import var modTitle : String;
	import var modLogoPath : String;
	import var id : Int64;
}

class UpdateModsPopupEvent extends Event
{
	var modInfoList : array< ModToUpdateInfo >;
	var bHaveModsBeenDeleted : Bool;
	var bShouldShowThumbnail : Bool;
	var bShouldShowModNames : Bool;
	var bShouldShowConfirmButton : Bool;
}

import class UpdateModsPopupData extends inkGameNotificationData
{
	public import function DisableModsFromOutdatedModsPopupPanelIDs( panelsIDs : array< Uint32 > );
	public import function OnConfirm();
}

class UpdateModsPopupData2 extends UpdateModsPopupData
{
	var modInfoList : array< ModToUpdateInfo >;
	var bHaveModsBeenDeleted : Bool;
	var bShouldShowThumbnail : Bool;
	var bShouldShowModNames : Bool;
	var bShouldShowConfirmButton : Bool;
}

class ModioUpdateModsPopupController extends inkGameController
{
	private editable var m_outdatedModText : inkTextRef;
	private editable var m_removedModText : inkTextRef;
	private editable var m_popupTitleText : inkTextRef;
	private editable var m_verificationOutdatedModText : inkTextRef;
	private editable var m_disableButtonRef : inkWidgetRef;
	private editable var m_confirmButtonRef : inkWidgetRef;
	private editable var m_closeButtonRef : inkWidgetRef;
	private editable var m_updateModSpawnerMoreThanThreeWidget : inkWidgetRef;
	private editable var m_SpawnerMoreThanThreeCanvas : inkWidgetRef;
	private editable var m_updateModSpawnerLessThanThreeWidget : inkWidgetRef;
	private editable var m_introAnimationName : CName;
	default m_introAnimationName = 'popup_fade_in';
	private editable var m_outroAnimationName : CName;
	default m_outroAnimationName = 'popup_fade_out';
	private var m_uiSystem : UISystem;
	private var m_systemHandler : weak< inkISystemRequestsHandler >;
	private var m_data : UpdateModsPopupData2;
	private var m_outdatedModsPanelList : array< weak< inkWidget > >;
	private var m_listOfDisplayedPanels : array< weak< OutdatedModPanel > >;
	private var m_outroAnimProxy : inkAnimProxy;
	private var m_clickedConfirm : Bool;

	protected event OnInitialize()
	{
		var i : Int32;
		var panel : OutdatedModPanel;
		var outdatedModPanelSpawner : inkWidgetRef;
		m_data = ( ( UpdateModsPopupData2 )( GetRootWidget().GetUserData( 'UpdateModsPopupData2' ) ) );
		m_systemHandler = GetSystemRequestsHandler();
		m_clickedConfirm = false;
		PlaySound( 'GameMenu', 'OnOpen' );
		RegisterToGlobalInputCallback( 'OnPreOnRelease', this, 'OnGlobalRelease' );
		inkWidgetRef.RegisterToCallback( m_disableButtonRef, 'OnPress', this, 'OnPressDisable' );
		inkWidgetRef.RegisterToCallback( m_confirmButtonRef, 'OnPress', this, 'OnPressConfirm' );
		inkWidgetRef.RegisterToCallback( m_closeButtonRef, 'OnPress', this, 'OnPressClose' );
		m_uiSystem = GameInstance.GetUISystem( GetPlayerControlledObject().GetGame() );
		inkWidgetRef.SetVisible( m_confirmButtonRef, m_data.bShouldShowConfirmButton );
		if( m_data.modInfoList.Size() > 3 )
		{
			outdatedModPanelSpawner = m_updateModSpawnerMoreThanThreeWidget;
		}
		else
		{
			inkWidgetRef.SetVisible( m_SpawnerMoreThanThreeCanvas, false );
			outdatedModPanelSpawner = m_updateModSpawnerLessThanThreeWidget;
		}
		if( m_data.bHaveModsBeenDeleted )
		{
			inkTextRef.SetText( m_removedModText, "UI-Modio-ModalContent-VerificationTextA4" );
			inkTextRef.SetVisible( m_removedModText, true );
		}
		if( m_data.modInfoList.Size() == 0 )
		{
			inkTextRef.SetVisible( m_outdatedModText, false );
			inkTextRef.SetVisible( m_verificationOutdatedModText, false );
			inkWidgetRef.SetVisible( m_disableButtonRef, false );
		}
		for( i = 0; i < m_data.modInfoList.Size(); i += 1 )
		{
			panel = ( ( OutdatedModPanel )( SpawnFromLocal( inkWidgetRef.Get( outdatedModPanelSpawner ), 'OutdatedModPanel' ).GetController() ) );
			panel.SetupPanel( m_data.modInfoList[ i ].modTitle, m_data.modInfoList[ i ].modLogoPath, m_data.modInfoList[ i ].id, m_data.bShouldShowThumbnail, m_data.bShouldShowModNames, m_systemHandler );
			m_listOfDisplayedPanels.PushBack( panel );
		}
		PlayLibraryAnimation( m_introAnimationName );
	}

	protected event OnUnitialize()
	{
		UnregisterFromGlobalInputCallback( 'OnPreOnRelease', this, 'OnGlobalRelease' );
		m_clickedConfirm = false;
		inkWidgetRef.UnregisterFromCallback( m_confirmButtonRef, 'OnPress', this, 'OnPressConfirm' );
		inkWidgetRef.UnregisterFromCallback( m_closeButtonRef, 'OnPress', this, 'OnPressClose' );
		inkWidgetRef.UnregisterFromCallback( m_disableButtonRef, 'OnPress', this, 'OnPressDisable' );
	}

	protected event OnPressConfirm( evt : inkPointerEvent )
	{
		m_clickedConfirm = true;
		if( evt.IsAction( 'click' ) || evt.IsAction( 'tap' ) )
		{
			PlayCloseAnimation();
		}
	}

	protected event OnPressClose( evt : inkPointerEvent )
	{
		if( evt.IsAction( 'click' ) || evt.IsAction( 'tap' ) )
		{
			PlayCloseAnimation();
		}
	}

	protected event OnPressDisable( evt : inkPointerEvent )
	{
		var listOfPanelIdsFromModsToDisable : array< Uint32 >;
		var i : Uint32;
		if( evt.IsAction( 'click' ) || evt.IsAction( 'tap' ) )
		{
			for( i = 0; i < ( ( Uint32 )( m_listOfDisplayedPanels.Size() ) ); i += 1 )
			{
				if( m_listOfDisplayedPanels[ ( ( Int32 )( i ) ) ].GetIsPanelChecked() )
				{
					listOfPanelIdsFromModsToDisable.PushBack( i );
				}
			}
			m_data.DisableModsFromOutdatedModsPopupPanelIDs( listOfPanelIdsFromModsToDisable );
			PlayCloseAnimation();
		}
	}

	protected event OnGlobalRelease( evt : inkPointerEvent )
	{
		if( evt.IsAction( 'close_popup' ) )
		{
			PlayCloseAnimation();
		}
	}

	private function PlayCloseAnimation()
	{
		PlaySound( 'Button', 'OnPress' );
		m_outroAnimProxy = PlayLibraryAnimation( m_outroAnimationName );
		m_outroAnimProxy.RegisterToCallback( inkanimEventType.OnFinish, this, 'OnOutroAnimationFinished' );
	}

	protected event OnOutroAnimationFinished( proxy : inkAnimProxy )
	{
		Close();
		m_outroAnimProxy.UnregisterFromCallback( inkanimEventType.OnFinish, this, 'OnOutroAnimationFinished' );
		if( m_clickedConfirm )
		{
			m_data.OnConfirm();
			m_clickedConfirm = false;
		}
	}

	private function Close()
	{
		PlaySound( 'GameMenu', 'OnClose' );
		m_uiSystem.QueueMenuEvent( 'OnRequestCloseUpdateMods' );
		m_data.token.TriggerCallback( m_data );
	}

}

class OutdatedModPanel extends inkLogicController
{
	private editable var m_logoWidget : inkImageRef;
	private editable var m_modTitleText : inkTextRef;
	private editable var m_checkbox : inkImageRef;
	private editable var m_thumbnailCanvas : inkWidgetRef;
	private var m_systemHandler : weak< inkISystemRequestsHandler >;
	private var m_modName : String;
	private var m_modID : Int64;
	private var m_bIsChecked : Bool;

	protected event OnInitialize()
	{
		RegisterToCallback( 'OnRelease', this, 'OnRelease' );
	}

	protected event OnUnitialize()
	{
		UnregisterFromCallback( 'OnRelease', this, 'OnRelease' );
	}

	protected event OnRelease( e : inkPointerEvent )
	{
		if( e.IsAction( 'click' ) )
		{
			SetIsCheckedPanel( !( m_bIsChecked ) );
		}
	}

	public function SetupPanel( modTitle : String, modLogoPath : String, modID : Int64, bShouldDisplayThumbnail : Bool, bShouldDisplayModName : Bool, systemHandler : weak< inkISystemRequestsHandler > )
	{
		m_modID = modID;
		m_modName = modTitle;
		SetIsCheckedPanel( true );
		if( !( bShouldDisplayThumbnail ) || ( StrLen( modLogoPath ) == 0 ) )
		{
			inkWidgetRef.SetVisible( m_thumbnailCanvas, false );
		}
		else
		{
			systemHandler.RequestGameScreenshotByPath( modLogoPath, ( ( inkImage )( inkImageRef.Get( m_logoWidget ) ) ), this, 'OnScreenshotLoadedByPath' );
		}
		if( bShouldDisplayModName && ( StrLen( modTitle ) != 0 ) )
		{
			inkTextRef.SetText( m_modTitleText, modTitle );
		}
		else
		{
			inkTextRef.SetText( m_modTitleText, IntToString( ( ( Int32 )( modID ) ) ) );
		}
	}

	public function SetIsCheckedPanel( bChecked : Bool )
	{
		m_bIsChecked = bChecked;
		inkImageRef.SetVisible( m_checkbox, m_bIsChecked );
	}

	public function GetIsPanelChecked() : Bool
	{
		return m_bIsChecked;
	}

	public function GetModID() : Int64
	{
		return m_modID;
	}

	protected event OnScreenshotLoadedByPath( screenshotSize : Vector2, errorCode : Int32 )
	{
		if( errorCode != 0 )
		{
			inkWidgetRef.SetVisible( m_thumbnailCanvas, false );
		}
	}

}

