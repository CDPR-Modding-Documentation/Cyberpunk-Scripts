import struct ModToUpdateInfo
{
	import var modTitle : String;
	import var authorName : String;
	import var modLogoPath : String;
	import var id : Int64;
	import var actionsNeeded : Bool[ 4 ];
}

import class UpdateModsPopupController extends inkGameController
{
	public import function ReceiveListOfMods( modList : array< ModToUpdateInfo > );
	public import function OnGoToModMenu( modsTickedByUser : array< Int32 > );
}

class UpdateModsPopupEvent extends Event
{
	var modInfoList : array< ModToUpdateInfo >;
	var bHaveModsBeenDeleted : Bool;
	var bShouldShowThumbnail : Bool;
	var bShouldShowModNames : Bool;
	var bShouldShowConfirmButton : Bool;
	var bDefaultModsSelected : Bool;
	var deprecatedModsCount : Int32;
	var bDoesNumberExceedModLimit : Bool;
	var bIsForLoadingASave : Bool;
	default bIsForLoadingASave = true;
}

import class UpdateModsPopupData extends inkGameNotificationData
{
	public import function DisableModsFromOutdatedModsPopupPanelIDs( panelsIDs : array< Uint32 > );
	public import function OnConfirm();
	public import function OnClose();
}

class UpdateModsPopupData2 extends UpdateModsPopupData
{
	var modInfoList : array< ModToUpdateInfo >;
	var bHaveModsBeenDeleted : Bool;
	var bShouldShowThumbnail : Bool;
	var bShouldShowModNames : Bool;
	var bShouldShowConfirmButton : Bool;
	var bDefaultModsSelected : Bool;
	var deprecatedModsCount : Int32;
	var bDoesNumberExceedModLimit : Bool;
	var bIsForLoadingASave : Bool;
}

class ModioUpdateModsPopupController extends UpdateModsPopupController
{
	private editable var m_missingModsText : inkTextRef;
	private editable var m_actionsPossibleText : inkTextRef;
	private editable var m_removedModText : inkTextRef;
	private editable var m_tooManyModsInSaveText : inkTextRef;
	private editable var m_popupTitleText : inkTextRef;
	private editable var m_proceedWarningText : inkTextRef;
	private editable var m_disableButtonRef : inkWidgetRef;
	private editable var m_disableButtonTextRef : inkTextRef;
	private editable var m_openModioBrowserRef : inkWidgetRef;
	private editable var m_confirmButtonRef : inkWidgetRef;
	private editable var m_closeButtonRef : inkWidgetRef;
	private editable var m_updateModSpawnerMoreThanThreeWidget : inkWidgetRef;
	private editable var m_SpawnerMoreThanThreeCanvas : inkWidgetRef;
	private editable var m_updateModSpawnerLessThanThreeWidget : inkWidgetRef;
	private editable var m_introAnimationName : CName;
	default m_introAnimationName = 'popup_fade_in';
	private editable var m_outroAnimationName : CName;
	default m_outroAnimationName = 'popup_fade_out';
	private editable var m_ModMenuButtonText : inkTextRef;
	private var m_uiSystem : UISystem;
	private var m_systemHandler : weak< inkISystemRequestsHandler >;
	private var m_data : UpdateModsPopupData2;
	private var m_outdatedModsPanelList : array< weak< inkWidget > >;
	private var m_listOfDisplayedPanels : array< weak< OutdatedModPanel > >;
	private var m_outroAnimProxy : inkAnimProxy;
	private var m_clickedConfirm : Bool;
	private var m_disableButtonController : weak< inkButtonController >;
	private var m_closeButtonController : weak< inkButtonController >;
	private var m_confirmButtonController : weak< inkButtonController >;
	private var m_openModioBrowserController : weak< inkButtonController >;
	private var m_currentlyHoveredWidget : weak< inkWidget >;

	protected event OnInitialize()
	{
		var i : Int32;
		var panel : OutdatedModPanel;
		var panelWidget : weak< inkWidget >;
		var outdatedModPanelSpawner : inkWidgetRef;
		m_currentlyHoveredWidget = NULL;
		m_data = ( ( UpdateModsPopupData2 )( GetRootWidget().GetUserData( 'UpdateModsPopupData2' ) ) );
		m_systemHandler = GetSystemRequestsHandler();
		m_disableButtonController = ( ( inkButtonController )( inkWidgetRef.GetController( m_disableButtonRef ) ) );
		m_closeButtonController = ( ( inkButtonController )( inkWidgetRef.GetController( m_closeButtonRef ) ) );
		m_confirmButtonController = ( ( inkButtonController )( inkWidgetRef.GetController( m_confirmButtonRef ) ) );
		m_openModioBrowserController = ( ( inkButtonController )( inkWidgetRef.GetController( m_openModioBrowserRef ) ) );
		if( !( GetSystemRequestsHandler().IsPreGame() ) )
		{
			inkWidgetRef.SetVisible( m_openModioBrowserRef, false );
		}
		m_clickedConfirm = false;
		inkTextRef.SetText( m_missingModsText, GetLocalizedText( "UI-Modio-ModalContent-VerificationTextA6" ) );
		inkTextRef.SetText( m_ModMenuButtonText, GetLocalizedText( "UI-Modio-InputHints-ModMenu" ) );
		PlaySound( 'GameMenu', 'OnOpen' );
		RegisterToGlobalInputCallback( 'OnPreOnRelease', this, 'OnGlobalRelease' );
		if( m_data.bIsForLoadingASave )
		{
			inkWidgetRef.RegisterToCallback( m_disableButtonRef, 'OnPress', this, 'OnPressDisable' );
			inkWidgetRef.RegisterToCallback( m_disableButtonRef, 'OnHoverOver', this, 'OnHoverOverDisable' );
			inkWidgetRef.RegisterToCallback( m_disableButtonRef, 'OnHoverOut', this, 'OnHoverOutDisable' );
			inkTextRef.SetText( m_disableButtonTextRef, GetLocalizedText( "UI-Modio-InputHints-VerifLoad" ) );
		}
		else
		{
			inkWidgetRef.SetVisible( m_disableButtonRef, false );
		}
		inkWidgetRef.RegisterToCallback( m_openModioBrowserRef, 'OnPress', this, 'OnPressOpenModioBrowser' );
		inkWidgetRef.RegisterToCallback( m_openModioBrowserRef, 'OnHoverOver', this, 'OnHoverOverOpenModioBrowser' );
		inkWidgetRef.RegisterToCallback( m_openModioBrowserRef, 'OnHoverOut', this, 'OnHoverOutOpenModioBrowser' );
		inkWidgetRef.RegisterToCallback( m_confirmButtonRef, 'OnPress', this, 'OnPressConfirm' );
		inkWidgetRef.RegisterToCallback( m_confirmButtonRef, 'OnHoverOver', this, 'OnHoverOverConfirm' );
		inkWidgetRef.RegisterToCallback( m_confirmButtonRef, 'OnHoverOut', this, 'OnHoverOutConfirm' );
		inkWidgetRef.RegisterToCallback( m_closeButtonRef, 'OnPress', this, 'OnPressClose' );
		inkWidgetRef.RegisterToCallback( m_closeButtonRef, 'OnHoverOver', this, 'OnHoverOverClose' );
		inkWidgetRef.RegisterToCallback( m_closeButtonRef, 'OnHoverOut', this, 'OnHoverOutClose' );
		RegisterToCallback( 'OnReceivedModLogo', this, 'OnReceivedModLogo' );
		m_uiSystem = GameInstance.GetUISystem( GetPlayerControlledObject().GetGame() );
		inkWidgetRef.SetVisible( m_confirmButtonRef, m_data.bShouldShowConfirmButton );
		if( m_data.modInfoList.Size() > 3 )
		{
			outdatedModPanelSpawner = m_updateModSpawnerMoreThanThreeWidget;
		}
		else
		{
			inkWidgetRef.SetVisible( m_SpawnerMoreThanThreeCanvas, false );
			outdatedModPanelSpawner = m_updateModSpawnerLessThanThreeWidget;
		}
		if( m_data.bHaveModsBeenDeleted )
		{
			inkTextRef.SetText( m_removedModText, "UI-Modio-ModalContent-VerificationTextA4" );
			inkTextRef.SetVisible( m_removedModText, true );
		}
		if( m_data.modInfoList.Size() == 0 )
		{
			inkTextRef.SetVisible( m_missingModsText, false );
			inkTextRef.SetVisible( m_proceedWarningText, false );
			inkWidgetRef.SetVisible( m_disableButtonRef, false );
		}
		if( m_data.bIsForLoadingASave )
		{
			if( !( GetSystemRequestsHandler().IsPreGame() ) )
			{
				inkTextRef.SetText( m_actionsPossibleText, GetLocalizedText( "UI-Modio-ModalContent-VerificationTextA7" ) );
			}
			inkTextRef.SetText( m_proceedWarningText, GetLocalizedText( "UI-Modio-ModalContent-VerificationTextB3" ) );
		}
		if( m_data.bDoesNumberExceedModLimit )
		{
			inkTextRef.SetVisible( m_tooManyModsInSaveText, true );
			inkTextRef.SetText( m_tooManyModsInSaveText, GetLocalizedText( "UI-Modio-ModalContent-VerificationTextLimit" ) );
		}
		for( i = 0; i < m_data.modInfoList.Size(); i += 1 )
		{
			panelWidget = SpawnFromLocal( inkWidgetRef.Get( outdatedModPanelSpawner ), 'OutdatedModPanel' );
			panelWidget.SetHAlign( inkEHorizontalAlign.Left );
			panel = ( ( OutdatedModPanel )( panelWidget.GetController() ) );
			panel.SetupPanel( this, m_data.modInfoList[ i ], m_data.bShouldShowThumbnail, m_data.bShouldShowModNames, m_data.bDefaultModsSelected, m_systemHandler );
			m_listOfDisplayedPanels.PushBack( panel );
		}
		if( m_listOfDisplayedPanels.Size() > 0 )
		{
			m_disableButtonController.OverrideNavigation( inkDiscreteNavigationDirection.Down, m_listOfDisplayedPanels[ 0 ].GetRootWidget() );
			m_closeButtonController.OverrideNavigation( inkDiscreteNavigationDirection.Down, m_listOfDisplayedPanels[ 0 ].GetRootWidget() );
			m_confirmButtonController.OverrideNavigation( inkDiscreteNavigationDirection.Down, m_listOfDisplayedPanels[ 0 ].GetRootWidget() );
			m_openModioBrowserController.OverrideNavigation( inkDiscreteNavigationDirection.Down, m_listOfDisplayedPanels[ 0 ].GetRootWidget() );
			m_disableButtonController.OverrideNavigation( inkDiscreteNavigationDirection.Up, m_listOfDisplayedPanels[ m_listOfDisplayedPanels.Size() - 1 ].GetRootWidget() );
			m_closeButtonController.OverrideNavigation( inkDiscreteNavigationDirection.Up, m_listOfDisplayedPanels[ m_listOfDisplayedPanels.Size() - 1 ].GetRootWidget() );
			m_confirmButtonController.OverrideNavigation( inkDiscreteNavigationDirection.Up, m_listOfDisplayedPanels[ m_listOfDisplayedPanels.Size() - 1 ].GetRootWidget() );
			m_openModioBrowserController.OverrideNavigation( inkDiscreteNavigationDirection.Up, m_listOfDisplayedPanels[ m_listOfDisplayedPanels.Size() - 1 ].GetRootWidget() );
			m_listOfDisplayedPanels[ 0 ].OverrideNavigation( inkDiscreteNavigationDirection.Up, inkWidgetRef.Get( m_closeButtonRef ) );
			m_disableButtonController.OverrideNavigation( inkDiscreteNavigationDirection.Left, m_closeButtonController.GetRootWidget() );
			m_closeButtonController.OverrideNavigation( inkDiscreteNavigationDirection.Right, m_disableButtonController.GetRootWidget() );
		}
		PlayLibraryAnimation( m_introAnimationName );
		ReceiveListOfMods( m_data.modInfoList );
	}

	public function OnWidgetHoveredOut( inWidget : inkWidget )
	{
		if( m_currentlyHoveredWidget == inWidget )
		{
			m_currentlyHoveredWidget = NULL;
		}
	}

	public function OnWidgetHoveredHover( inHoveredWidget : inkWidget )
	{
		m_currentlyHoveredWidget = inHoveredWidget;
	}

	protected event OnUnitialize()
	{
		UnregisterFromGlobalInputCallback( 'OnPreOnRelease', this, 'OnGlobalRelease' );
		m_clickedConfirm = false;
		inkWidgetRef.UnregisterFromCallback( m_confirmButtonRef, 'OnPress', this, 'OnPressConfirm' );
		inkWidgetRef.UnregisterFromCallback( m_confirmButtonRef, 'OnHoverOver', this, 'OnHoverOverConfirm' );
		inkWidgetRef.UnregisterFromCallback( m_confirmButtonRef, 'OnHoverOut', this, 'OnHoverOutConfirm' );
		inkWidgetRef.UnregisterFromCallback( m_closeButtonRef, 'OnPress', this, 'OnPressClose' );
		inkWidgetRef.UnregisterFromCallback( m_closeButtonRef, 'OnHoverOver', this, 'OnHoverOverClose' );
		inkWidgetRef.UnregisterFromCallback( m_closeButtonRef, 'OnHoverOut', this, 'OnHoverOutClose' );
		inkWidgetRef.UnregisterFromCallback( m_disableButtonRef, 'OnPress', this, 'OnPressDisable' );
		inkWidgetRef.UnregisterFromCallback( m_disableButtonRef, 'OnHoverOver', this, 'OnHoverOverDisable' );
		inkWidgetRef.UnregisterFromCallback( m_disableButtonRef, 'OnHoverOut', this, 'OnHoverOutDisable' );
		inkWidgetRef.UnregisterFromCallback( m_openModioBrowserRef, 'OnPress', this, 'OnPressOpenModioBrowser' );
		inkWidgetRef.UnregisterFromCallback( m_openModioBrowserRef, 'OnHoverOver', this, 'OnHoverOverOpenModioBrowser' );
		inkWidgetRef.UnregisterFromCallback( m_openModioBrowserRef, 'OnHoverOut', this, 'OnHoverOutOpenModioBrowser' );
		UnregisterFromCallback( 'OnReceivedModLogo', this, 'OnReceivedModLogo' );
	}

	protected event OnReceivedModLogo( modID : Int64, modLogoPath : String )
	{
		var i : Int32;
		var currentPanel : OutdatedModPanel;
		for( i = 0; i < m_listOfDisplayedPanels.Size(); i += 1 )
		{
			currentPanel = ( ( OutdatedModPanel )( m_listOfDisplayedPanels[ i ].GetController() ) );
			if( currentPanel.MatchesID( modID ) )
			{
				currentPanel.LoadImage( modLogoPath );
				return true;
			}
		}
		return false;
	}

	protected event OnPressConfirm( evt : inkPointerEvent )
	{
		m_clickedConfirm = true;
		if( ( evt.IsAction( 'click' ) || evt.IsAction( 'tap' ) ) || evt.IsAction( 'system_notification_confirm' ) )
		{
			PlayCloseAnimation();
		}
	}

	protected event OnHoverOverConfirm( evt : inkPointerEvent )
	{
		OnWidgetHoveredHover( inkWidgetRef.Get( m_confirmButtonRef ) );
	}

	protected event OnHoverOutConfirm( evt : inkPointerEvent )
	{
		OnWidgetHoveredOut( inkWidgetRef.Get( m_confirmButtonRef ) );
	}

	protected event OnPressClose( evt : inkPointerEvent )
	{
		if( ( evt.IsAction( 'click' ) || evt.IsAction( 'tap' ) ) || evt.IsAction( 'close_popup' ) )
		{
			m_data.OnClose();
			PlayCloseAnimation();
		}
	}

	protected event OnHoverOverClose( evt : inkPointerEvent )
	{
		OnWidgetHoveredHover( inkWidgetRef.Get( m_closeButtonRef ) );
	}

	protected event OnHoverOutClose( evt : inkPointerEvent )
	{
		OnWidgetHoveredOut( inkWidgetRef.Get( m_closeButtonRef ) );
	}

	protected event OnPressDisable( evt : inkPointerEvent )
	{
		var listOfPanelIdsFromModsToDisable : array< Uint32 >;
		var i : Uint32;
		if( ( evt.IsAction( 'click' ) || evt.IsAction( 'tap' ) ) || evt.IsAction( 'one_click_confirm' ) )
		{
			for( i = 0; i < ( ( Uint32 )( m_listOfDisplayedPanels.Size() ) ); i += 1 )
			{
				if( m_listOfDisplayedPanels[ ( ( Int32 )( i ) ) ].GetIsPanelChecked() )
				{
					listOfPanelIdsFromModsToDisable.PushBack( i );
				}
			}
			m_data.DisableModsFromOutdatedModsPopupPanelIDs( listOfPanelIdsFromModsToDisable );
			PlayCloseAnimation();
		}
	}

	protected event OnHoverOverDisable( evt : inkPointerEvent )
	{
		OnWidgetHoveredHover( inkWidgetRef.Get( m_disableButtonRef ) );
	}

	protected event OnHoverOutDisable( evt : inkPointerEvent )
	{
		OnWidgetHoveredOut( inkWidgetRef.Get( m_disableButtonRef ) );
	}

	protected event OnPressOpenModioBrowser( evt : inkPointerEvent )
	{
		var modsSelected : array< Int32 >;
		var i : Int32;
		if( !( GetSystemRequestsHandler().IsPreGame() ) )
		{
			return NULL;
		}
		if( ( evt.IsAction( 'click' ) || evt.IsAction( 'tap' ) ) || evt.IsAction( 'go_to_mod_menu' ) )
		{
			for( i = 0; i < m_listOfDisplayedPanels.Size(); i += 1 )
			{
				if( m_listOfDisplayedPanels[ i ].GetIsPanelChecked() )
				{
					modsSelected.PushBack( i );
				}
			}
			OnGoToModMenu( modsSelected );
			m_uiSystem.QueueMenuEvent( 'OnRequestOpenModioBrowser' );
			PlayCloseAnimation();
		}
	}

	protected event OnHoverOverOpenModioBrowser( evt : inkPointerEvent )
	{
		OnWidgetHoveredHover( inkWidgetRef.Get( m_openModioBrowserRef ) );
	}

	protected event OnHoverOutOpenModioBrowser( evt : inkPointerEvent )
	{
		OnWidgetHoveredOut( inkWidgetRef.Get( m_openModioBrowserRef ) );
	}

	protected event OnGlobalRelease( evt : inkPointerEvent )
	{
		if( evt.IsAction( 'close_popup' ) )
		{
			OnPressClose( evt );
		}
		if( evt.IsAction( 'one_click_confirm' ) && m_data.bIsForLoadingASave )
		{
			OnPressDisable( evt );
		}
		else if( evt.IsAction( 'go_to_mod_menu' ) )
		{
			OnPressOpenModioBrowser( evt );
		}
		else if( ( evt.IsAction( 'popup_navigate_up' ) || evt.IsAction( 'popup_navigate_right' ) ) && ( m_currentlyHoveredWidget == NULL ) )
		{
			SetCursorOverWidget( inkWidgetRef.Get( m_closeButtonRef ), 0.1, true );
		}
		else if( ( evt.IsAction( 'popup_navigate_down' ) || evt.IsAction( 'popup_navigate_left' ) ) && ( m_currentlyHoveredWidget == NULL ) )
		{
			if( m_listOfDisplayedPanels.Size() > 0 )
			{
				SetCursorOverWidget( m_listOfDisplayedPanels[ 0 ].GetRootWidget(), 0.1, true );
			}
			else
			{
				SetCursorOverWidget( inkWidgetRef.Get( m_closeButtonRef ), 0.1, true );
			}
		}
	}

	private function PlayCloseAnimation()
	{
		PlaySound( 'Button', 'OnPress' );
		m_outroAnimProxy = PlayLibraryAnimation( m_outroAnimationName );
		m_outroAnimProxy.RegisterToCallback( inkanimEventType.OnFinish, this, 'OnOutroAnimationFinished' );
	}

	protected event OnOutroAnimationFinished( proxy : inkAnimProxy )
	{
		Close();
		m_outroAnimProxy.UnregisterFromCallback( inkanimEventType.OnFinish, this, 'OnOutroAnimationFinished' );
		if( m_clickedConfirm )
		{
			m_data.OnConfirm();
			m_clickedConfirm = false;
		}
	}

	private function Close()
	{
		PlaySound( 'GameMenu', 'OnClose' );
		m_uiSystem.QueueMenuEvent( 'OnRequestCloseUpdateMods' );
		m_data.token.TriggerCallback( m_data );
	}

}

class OutdatedModPanel extends inkDiscreteNavigationController
{
	private editable var m_logoWidget : inkImageRef;
	private editable var m_modTitleText : inkTextRef;
	private editable var m_checkboxCanvas : inkWidgetRef;
	private editable var m_checkbox : inkImageRef;
	private editable var m_thumbnailCanvas : inkWidgetRef;
	private editable var m_reasonInfoSpawner : inkWidgetRef;
	private editable var m_modCreatorText : inkTextRef;
	private editable var m_modCreatorCanvas : inkWidgetRef;
	private editable var m_imageBackgroundRef : inkImageRef;
	private editable var m_outlineImageRef : inkImageRef;
	private var m_colorNames : ModsMenuColorsNames;
	private var m_systemHandler : weak< inkISystemRequestsHandler >;
	private var m_modName : String;
	private var m_modID : Int64;
	private var m_bIsChecked : Bool;
	private var m_actionRequiredType1 : weak< ModActionRequiredTypeInfoController >;
	private var m_actionRequiredType2 : weak< ModActionRequiredTypeInfoController >;
	private var m_popupController : weak< ModioUpdateModsPopupController >;
	private var m_bEditableCheckboxState : Bool;
	default m_bEditableCheckboxState = true;

	protected event OnInitialize()
	{
		RegisterToCallback( 'OnRelease', this, 'OnRelease' );
		RegisterToCallback( 'OnHoverOver', this, 'OnHoverOver' );
		RegisterToCallback( 'OnHoverOut', this, 'OnHoverOut' );
	}

	protected event OnUnitialize()
	{
		UnregisterFromCallback( 'OnRelease', this, 'OnRelease' );
		UnregisterFromCallback( 'OnHoverOver', this, 'OnHoverOver' );
		UnregisterFromCallback( 'OnHoverOut', this, 'OnHoverOut' );
	}

	protected event OnHoverOver( e : inkPointerEvent )
	{
		inkImageRef.Get( m_imageBackgroundRef ).BindProperty( 'tintColor', m_colorNames.darkerBlueName );
		inkImageRef.Get( m_outlineImageRef ).BindProperty( 'tintColor', m_colorNames.activeBlueName );
		inkImageRef.Get( m_checkbox ).BindProperty( 'tintColor', m_colorNames.activeBlueName );
		m_popupController.OnWidgetHoveredHover( GetRootWidget() );
	}

	protected event OnHoverOut( e : inkPointerEvent )
	{
		inkImageRef.Get( m_imageBackgroundRef ).BindProperty( 'tintColor', m_colorNames.fullscreenRedDarkBackgroundName );
		inkImageRef.Get( m_outlineImageRef ).BindProperty( 'tintColor', m_colorNames.mildRedName );
		inkImageRef.Get( m_checkbox ).BindProperty( 'tintColor', m_colorNames.redName );
		m_popupController.OnWidgetHoveredOut( GetRootWidget() );
	}

	protected event OnRelease( e : inkPointerEvent )
	{
		if( ( e.IsAction( 'click' ) || e.IsAction( 'tap' ) ) && m_bEditableCheckboxState )
		{
			SetIsCheckedPanel( !( m_bIsChecked ) );
			PlaySound( 'Button', 'OnPress' );
		}
	}

	public function MatchesID( inModID : Int64 ) : Bool
	{
		return m_modID == inModID;
	}

	public function LoadImage( imagePath : String )
	{
		m_systemHandler.RequestGameScreenshotByPath( imagePath, ( ( inkImage )( inkImageRef.Get( m_logoWidget ) ) ), this, 'OnScreenshotLoadedByPath' );
	}

	private function IsReasonMultiple( modInfo : ModToUpdateInfo ) : Bool
	{
		return modInfo.actionsNeeded[ ( ( Int32 )( inkModActionReason.NeedEnable ) ) ] && modInfo.actionsNeeded[ ( ( Int32 )( inkModActionReason.NeedUpdate ) ) ];
	}

	private function GetMainReasonForActionRequired( modInfo : ModToUpdateInfo ) : inkModActionReason
	{
		if( modInfo.actionsNeeded[ ( ( Int32 )( inkModActionReason.NeedInstall ) ) ] )
		{
			return inkModActionReason.NeedInstall;
		}
		if( modInfo.actionsNeeded[ ( ( Int32 )( inkModActionReason.NeedSubscribe ) ) ] )
		{
			return inkModActionReason.NeedSubscribe;
		}
		if( modInfo.actionsNeeded[ ( ( Int32 )( inkModActionReason.NeedEnable ) ) ] )
		{
			return inkModActionReason.NeedEnable;
		}
		return inkModActionReason.NeedUpdate;
	}

	public function SetupPanel( popupController : weak< ModioUpdateModsPopupController >, modInfo : ModToUpdateInfo, bShouldDisplayThumbnail : Bool, bShouldDisplayModName : Bool, bSelected : Bool, systemHandler : weak< inkISystemRequestsHandler > )
	{
		m_systemHandler = systemHandler;
		m_popupController = popupController;
		m_modID = modInfo.id;
		m_modName = modInfo.modTitle;
		if( modInfo.authorName != "" )
		{
			inkTextRef.SetText( m_modCreatorText, modInfo.authorName );
		}
		else
		{
			inkWidgetRef.SetVisible( m_modCreatorCanvas, false );
		}
		SetIsCheckedPanel( bSelected );
		if( !( bShouldDisplayThumbnail ) || ( StrLen( modInfo.modLogoPath ) == 0 ) )
		{
			inkWidgetRef.SetVisible( m_thumbnailCanvas, false );
		}
		else
		{
			systemHandler.RequestGameScreenshotByPath( modInfo.modLogoPath, ( ( inkImage )( inkImageRef.Get( m_logoWidget ) ) ), this, 'OnScreenshotLoadedByPath' );
		}
		if( bShouldDisplayModName && ( StrLen( m_modName ) != 0 ) )
		{
			inkTextRef.SetText( m_modTitleText, m_modName );
		}
		else
		{
			inkTextRef.SetText( m_modTitleText, IntToString( ( ( Int32 )( m_modID ) ) ) );
		}
		m_actionRequiredType1 = ( ( ModActionRequiredTypeInfoController )( SpawnFromLocal( inkWidgetRef.Get( m_reasonInfoSpawner ), 'modActionReason' ).GetController() ) );
		m_actionRequiredType1.Setup( GetMainReasonForActionRequired( modInfo ) );
		if( IsReasonMultiple( modInfo ) )
		{
			m_actionRequiredType2 = ( ( ModActionRequiredTypeInfoController )( SpawnFromLocal( inkWidgetRef.Get( m_reasonInfoSpawner ), 'modActionReason' ).GetController() ) );
			m_actionRequiredType2.Setup( inkModActionReason.NeedUpdate );
		}
		if( ( !( IsReasonMultiple( modInfo ) ) && GetMainReasonForActionRequired( modInfo ) == inkModActionReason.NeedUpdate ) || GetMainReasonForActionRequired( modInfo ) == inkModActionReason.NeedInstall )
		{
			SetIsCheckedPanel( true );
			inkWidgetRef.SetVisible( m_checkboxCanvas, false );
			m_bEditableCheckboxState = false;
		}
	}

	public function SetIsCheckedPanel( bChecked : Bool )
	{
		m_bIsChecked = bChecked;
		inkImageRef.SetVisible( m_checkbox, m_bIsChecked );
	}

	public function GetIsPanelChecked() : Bool
	{
		return m_bIsChecked;
	}

	public function GetModID() : Int64
	{
		return m_modID;
	}

	protected event OnScreenshotLoadedByPath( screenshotSize : Vector2, errorCode : Int32 )
	{
		inkWidgetRef.SetVisible( m_thumbnailCanvas, errorCode == 0 );
	}

}

import enum inkModActionReason : Uint8
{
	NeedInstall,
	NeedSubscribe,
	NeedUpdate,
	NeedEnable,
}

class ModActionRequiredTypeInfoController extends inkLogicController
{
	private editable var m_reasonText : inkTextRef;
	private editable var m_reasonIcon : inkImageRef;

	public function Setup( inReason : inkModActionReason )
	{
		var text : inkText;
		var img : inkImage;
		text = ( ( inkText )( inkTextRef.Get( m_reasonText ) ) );
		img = ( ( inkImage )( inkImageRef.Get( m_reasonIcon ) ) );
		switch( inReason )
		{
			case inkModActionReason.NeedSubscribe:
				text.SetText( GetLocalizedText( "UI-Modio-ModalContent-VerifModSub" ) );
			img.SetTexturePart( 'checkmark' );
			break;
			case inkModActionReason.NeedEnable:
				text.SetText( GetLocalizedText( "UI-Modio-ModalContent-VerifModEnable" ) );
			img.SetTexturePart( 'visible' );
			break;
			case inkModActionReason.NeedUpdate:
				text.SetText( GetLocalizedText( "UI-Modio-ModalContent-VerifModUpdate" ) );
			img.SetTexturePart( 'update_small' );
			break;
			case inkModActionReason.NeedInstall:
				text.SetText( GetLocalizedText( "UI-Modio-ModalContent-VerifModInstall" ) );
			img.SetTexturePart( 'Download' );
			break;
		}
	}

}

