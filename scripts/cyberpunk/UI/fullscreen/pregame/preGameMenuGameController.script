import class gameuiPreGameMenuGameController extends gameuiBaseMenuGameController
{
	private var m_saveMessageToken : inkGameNotificationToken;

	protected event OnInitialize()
	{
		RegisterToGlobalInputCallback( 'OnPostOnRelease', this, 'OnBackAction' );
	}

	protected event OnUninitialize()
	{
		UnregisterFromGlobalInputCallback( 'OnPostOnRelease', this, 'OnBackAction' );
	}

	protected event OnPuppetReady( sceneName : CName, puppet : gamePuppet )
	{
		var transactionSystem : TransactionSystem;
		var gender : CName;
		var item : ItemID;
		transactionSystem = GameInstance.GetTransactionSystem( puppet.GetGame() );
		gender = puppet.GetResolvedGenderName();
		if( gender == 'Male' )
		{
			item = ItemID.FromTDBID( T"Items.CharacterCustomizationMaHead" );
		}
		else if( gender == 'Female' )
		{
			item = ItemID.FromTDBID( T"Items.CharacterCustomizationWaHead" );
		}
		transactionSystem.GiveItem( puppet, item, 1 );
		transactionSystem.AddItemToSlot( puppet, EquipmentSystem.GetPlacementSlot( item ), item );
		item = ItemID.FromTDBID( T"Items.CharacterCustomizationArms" );
		transactionSystem.GiveItem( puppet, item, 1 );
		transactionSystem.AddItemToSlot( puppet, EquipmentSystem.GetPlacementSlot( item ), item );
		UpdateCensorshipItems( puppet, transactionSystem, gender );
	}

	protected event OnCensorFlagsChanged( sceneName : CName, puppet : gamePuppet )
	{
		var transactionSystem : TransactionSystem;
		var gender : CName;
		transactionSystem = GameInstance.GetTransactionSystem( puppet.GetGame() );
		gender = puppet.GetResolvedGenderName();
		UpdateCensorshipItems( puppet, transactionSystem, gender );
	}

	public function UpdateCensorshipItems( puppet : gamePuppet, transactionSystem : TransactionSystem, gender : CName )
	{
		var characterCustomizationSystem : gameuiICharacterCustomizationSystem;
		var item1, item2 : ItemID;
		item1 = ItemID.FromTDBID( T"Items.Underwear_Basic_01_Bottom" );
		item2 = ItemID.FromTDBID( T"Items.Underwear_Basic_01_Top" );
		transactionSystem.RemoveItemFromSlot( puppet, EquipmentSystem.GetPlacementSlot( item1 ) );
		transactionSystem.RemoveItemByTDBID( puppet, ItemID.GetTDBID( item1 ), 1 );
		if( gender == 'Female' )
		{
			transactionSystem.RemoveItemFromSlot( puppet, EquipmentSystem.GetPlacementSlot( item2 ) );
			transactionSystem.RemoveItemByTDBID( puppet, ItemID.GetTDBID( item2 ), 1 );
		}
		characterCustomizationSystem = GameInstance.GetCharacterCustomizationSystem( puppet.GetGame() );
		if( !( characterCustomizationSystem.IsNudityAllowed() ) )
		{
			transactionSystem.GiveItem( puppet, item1, 1 );
			transactionSystem.AddItemToSlot( puppet, EquipmentSystem.GetPlacementSlot( item1 ), item1 );
			if( gender == 'Female' )
			{
				transactionSystem.GiveItem( puppet, item2, 1 );
				transactionSystem.AddItemToSlot( puppet, EquipmentSystem.GetPlacementSlot( item2 ), item2 );
			}
		}
	}

	protected event OnBackAction( evt : inkPointerEvent )
	{
		var settings : UserSettings;
		var inputSettingGroupName : CName;
		var inputSettingGroup : ConfigGroup;
		var inputSettingVarName : CName;
		var inputSettingVar : ConfigVarListString;
		var displayInputSettingVarName : CName;
		var displayInputSettingVar : ConfigVarListString;
		var initScheme : Int32;
		var currentInputScheme : Int32;
		if( evt.IsAction( 'back' ) )
		{
			if( GetPlatformShortName() == "emporium" )
			{
				inputSettingGroupName = '/controls/controller';
				inputSettingVarName = 'InputSchemesModeNintendo';
				displayInputSettingVarName = 'DisplayInputSchemesModeNintendo';
				settings = GetSystemRequestsHandler().GetUserSettings();
				if( settings.HasGroup( inputSettingGroupName ) )
				{
					inputSettingGroup = settings.GetGroup( inputSettingGroupName );
					if( inputSettingGroup.HasVar( inputSettingVarName ) )
					{
						inputSettingVar = ( ( ConfigVarListString )( inputSettingGroup.GetVar( inputSettingVarName ) ) );
						initScheme = inputSettingVar.GetIndex();
					}
					if( inputSettingGroup.HasVar( displayInputSettingVarName ) )
					{
						displayInputSettingVar = ( ( ConfigVarListString )( inputSettingGroup.GetVar( displayInputSettingVarName ) ) );
						currentInputScheme = displayInputSettingVar.GetIndex();
					}
				}
				if( currentInputScheme != initScheme )
				{
					m_saveMessageToken = GenericMessageNotification.Show( this, GetLocalizedTextByKey( 'UI-Settings-Interface-InputSchemeSaveChangedMessage' ), GenericMessageNotificationType.YesNo );
					m_saveMessageToken.RegisterListener( this, 'OnSaveMessageInputScheme' );
				}
				else
				{
					SpawnMenuInstanceEvent( 'OnSettingsBack' );
				}
			}
			else
			{
				SpawnMenuInstanceEvent( 'OnSettingsBack' );
			}
		}
	}

	protected event OnSaveMessageInputScheme( data : inkGameNotificationData )
	{
		var resultData : GenericMessageNotificationCloseData;
		var result : GenericMessageNotificationResult;
		var settings : UserSettings;
		var inputSettingGroupName : CName;
		var inputSettingGroup : ConfigGroup;
		var inputSettingVarName : CName;
		var inputSettingVar : ConfigVarListString;
		var displayInputSettingVarName : CName;
		var displayInputSettingVar : ConfigVarListString;
		resultData = ( ( GenericMessageNotificationCloseData )( data ) );
		result = resultData.result;
		inputSettingGroupName = '/controls/controller';
		inputSettingVarName = 'InputSchemesModeNintendo';
		displayInputSettingVarName = 'DisplayInputSchemesModeNintendo';
		settings = GetSystemRequestsHandler().GetUserSettings();
		if( settings.HasGroup( inputSettingGroupName ) )
		{
			inputSettingGroup = settings.GetGroup( inputSettingGroupName );
			if( inputSettingGroup.HasVar( inputSettingVarName ) )
			{
				inputSettingVar = ( ( ConfigVarListString )( inputSettingGroup.GetVar( inputSettingVarName ) ) );
			}
			if( inputSettingGroup.HasVar( displayInputSettingVarName ) )
			{
				displayInputSettingVar = ( ( ConfigVarListString )( inputSettingGroup.GetVar( displayInputSettingVarName ) ) );
			}
		}
		if( result == GenericMessageNotificationResult.Yes )
		{
			inputSettingVar.SetIndex( displayInputSettingVar.GetIndex() );
		}
		else
		{
			displayInputSettingVar.SetIndex( inputSettingVar.GetIndex() );
		}
		m_saveMessageToken = NULL;
		if( result == GenericMessageNotificationResult.Yes )
		{
			SpawnMenuInstanceEvent( 'OnSettingsBack' );
		}
	}

}

