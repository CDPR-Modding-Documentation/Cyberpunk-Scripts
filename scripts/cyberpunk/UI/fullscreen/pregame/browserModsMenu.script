	public import function EnableOrDisableAllMods();
	public import function GetModLogoPathByModID( modID : Int64 ) : String;
	public import function GetRemainingSpaceOnUserDiskText() : String;
	public import function GetRemainingSpaceOnUserDisk() : Uint64;
