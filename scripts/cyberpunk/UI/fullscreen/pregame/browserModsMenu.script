	public function UpdateFiltersFromDrawer( drawerOutputList : array< ModFilterDrawerOutput > )
	{
		var nonLanguageFilterTags : array< String >;
		var languageFilterTags : array< String >;
		var i : Int32;
		var currentOutput : ModFilterDrawerOutput;
		m_selectedFilterSpawnerController.MarkAllFiltersAsDelete();
		for( i = 0; i < drawerOutputList.Size(); i += 1 )
		{
			currentOutput = drawerOutputList[ i ];
			if( currentOutput.m_bIsExceptionFilter )
			{
			}
			else if( currentOutput.m_bIsLanguageFilter )
			{
				languageFilterTags.PushBack( currentOutput.m_activeFilterName );
			}
			else
			{
				nonLanguageFilterTags.PushBack( currentOutput.m_activeFilterName );
			}
			m_selectedFilterSpawnerController.AddFilter( currentOutput.m_activeFilterName, currentOutput.m_localizedFilterName, currentOutput.m_bIsExceptionFilter );
		}
		RequestDelayedSpawnForSelectedFilters();
		UpdateFiltersFromDrawer( nonLanguageFilterTags, languageFilterTags );
	}

	protected event OnDelayedSliderAdjustForDrawer()
	{
		m_filterDrawer.AdjustScrollbarAfterFolderManipulation();
	}

	protected event OnDelayedSpawnForFilters()
	{
		var listOfFilters : array< weak< SelectedFilterItem > >;
		var currentFilter : SelectedFilterItem;
		var cumulatedWidth : Float;
		var spawnerWidgetChildMargin : inkMargin;
		var spawnerWidgetChildRightMargin : Float;
		var i : Int32;
		var hiddenFiltersNb : Int32;
		cumulatedWidth = 0.0;
		hiddenFiltersNb = 0;
		m_moreFilterTooltipString = "";
		spawnerWidgetChildMargin = ( ( inkCompoundWidget )( inkWidgetRef.Get( m_selectedFilterSpawner ) ) ).GetChildMargin();
		spawnerWidgetChildRightMargin = spawnerWidgetChildMargin.right;
		m_selectedFilterSpawnerController.DeleteMarkedFilters();
		listOfFilters = m_selectedFilterSpawnerController.GetListOfFilters();
		for( i = 0; i < listOfFilters.Size(); i += 1 )
		{
			currentFilter = listOfFilters[ i ];
			cumulatedWidth += ( currentFilter.GetDesiredWidth() + spawnerWidgetChildRightMargin );
			if( cumulatedWidth < 1500.0 )
			{
				currentFilter.GetRootWidget().SetVisible( true );
			}
			else
			{
				hiddenFiltersNb += 1;
				currentFilter.GetRootWidget().SetAffectsLayoutWhenHidden( false );
				if( hiddenFiltersNb > 1 )
				{
					m_moreFilterTooltipString += " / ";
				}
				m_moreFilterTooltipString += currentFilter.GetLocalizedFilterName();
			}
		}
		if( hiddenFiltersNb > 0 )
		{
			currentFilter = m_selectedFilterSpawnerController.AddExceptionMoreFilter( hiddenFiltersNb );
			currentFilter.UnregisterFromCallback( 'OnHoverOver', this, 'OnPlusFilterHoveredOver' );
			currentFilter.UnregisterFromCallback( 'OnHoverOut', this, 'OnPlusFilterHoveredOut' );
			currentFilter.RegisterToCallback( 'OnHoverOver', this, 'OnPlusFilterHoveredOver' );
			currentFilter.RegisterToCallback( 'OnHoverOut', this, 'OnPlusFilterHoveredOut' );
		}
	}

	protected event OnPlusFilterHoveredOver( e : inkPointerEvent )
	{
		var tooltipData : MessageTooltipData;
		if( ShouldIgnoreInput() )
		{
			return true;
		}
		tooltipData = new MessageTooltipData;
		tooltipData.Title = GetLocalizedText( m_moreFilterTooltipString );
		m_tooltipManager.ShowTooltipAtWidget( 0, e.GetTarget(), tooltipData, gameuiETooltipPlacement.RightTop, true );
	}

	protected event OnPlusFilterHoveredOut( e : inkPointerEvent )
	{
		m_tooltipManager.HideTooltips();
	}

