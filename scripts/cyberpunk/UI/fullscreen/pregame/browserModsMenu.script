	public import function UpdateCurrentlySelectedSortingOptions( selectedSortingOption : inkModioModSortingOptions );
	public import function UpdateCurrentlySelectedLanguageTags( selectedLanguage : inkModioLanguageTagsOptions );
	public import function UpdateAllowMatureContentState( bMatureContentState : Bool );
