	public import function LikeButtonClicked( bIsForLike : Bool );
	public import function AuthorButtonClicked( bIsForShowFromSameAuthor : Bool );
	public import function HideModButtonClicked();
	public import function MuteAuthorButtonClicked();
	public import function GetFilterTagNameFromEnum( inFilterTag : inkModioFilterTags ) : String;
	public import function SwitchBetweenBrowserAndCollectionMenu();
	public import function SetMaxEnteredChars( enteredText : weak< inkTextInput > );
	public import function ParseTextInSearchBar( textEntered : String );
