		tooltipData.Title = GetLocalizedText( tooltipLockey );
		tooltipMargin.left = -40.0;
		m_tooltipManager.ShowTooltipAtWidget( 0, inWidgetToAttachTooltipTo, tooltipData, gameuiETooltipPlacement.LeftTop, true, tooltipMargin );
