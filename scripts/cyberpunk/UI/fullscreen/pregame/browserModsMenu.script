abstract class ContentCheckbox extends AnimatedListItemController
{
	protected editable var m_checkboxCanvas : inkWidgetRef;
	protected editable var m_checkboxImage : inkImageRef;
	protected editable var m_checkboxText : inkTextRef;
	protected var m_bState : Bool;
	protected var m_ownerMenu : weak< BrowserModsMenuGameController >;
	protected var m_colorNames : ModsMenuColorsNames;

	protected event OnInitialize()
	{
		RegisterToCallback( 'OnHoverOver', this, 'OnHoverOver' );
		RegisterToCallback( 'OnHoverOut', this, 'OnHoverOut' );
		RegisterToCallback( 'OnRelease', this, 'OnRelease' );
		SetNavigable( true );
	}

	protected event OnHoverOver( e : inkPointerEvent )
	{
		if( m_ownerMenu.ShouldIgnoreInput() )
		{
			return false;
		}
		inkImageRef.Get( m_checkboxImage ).BindProperty( 'tintColor', m_colorNames.activeBlueName );
		inkImageRef.SetVisible( m_checkboxImage, true );
	}

	protected event OnHoverOut( e : inkPointerEvent )
	{
		inkImageRef.Get( m_checkboxImage ).BindProperty( 'tintColor', m_colorNames.mildRedName );
		inkImageRef.SetVisible( m_checkboxImage, m_bState );
	}

	protected event OnRelease( e : inkPointerEvent )
	{
		if( e.IsAction( 'click' ) || e.IsAction( 'tap' ) )
		{
			OnClickContentCheckbox();
			PlaySound( 'Button', 'OnPress' );
		}
	}

	protected virtual function OnClickContentCheckbox()
	{
		m_bState = !( m_bState );
		inkImageRef.SetVisible( m_checkboxImage, m_bState );
	}

}

class MatureContentCheckbox extends ContentCheckbox
{
	protected var m_bIsBrowserMenu : Bool;

	protected event OnInitialize()
	{
		m_bIsBrowserMenu = true;
		super.OnInitialize();
	}

	public function InitializeCheckbox( inOwnerMenu : weak< BrowserModsMenuGameController > )
	{
		m_ownerMenu = inOwnerMenu;
		m_bState = m_ownerMenu.GetCurrentAllowMatureContentState();
		m_ownerMenu.AddToListOfNavigables( this );
	}

	public function UpdateCheckbox()
	{
		m_bState = m_ownerMenu.GetCurrentAllowMatureContentState();
		inkImageRef.SetVisible( m_checkboxImage, m_bState );
	}

	protected override function OnClickContentCheckbox()
	{
		m_bState = !( m_bState );
		inkImageRef.SetVisible( m_checkboxImage, m_bState );
		m_ownerMenu.UpdateAllowMatureContentState( m_bState );
	}

}

class LikedFilterCheckbox extends ContentCheckbox
{

	protected event OnInitialize()
	{
		super.OnInitialize();
	}

	public function InitializeCheckbox( inOwnerMenu : weak< BrowserModsMenuGameController > )
	{
