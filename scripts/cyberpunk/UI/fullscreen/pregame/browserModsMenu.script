	protected event OnDropdownItemClickedEvent( evt : DropdownItemClickedEvent )
	{
		var identifierTypeName : CName;
		var sortingIdentifier : inkModioModSortingOptions;
		var sortingButtonController : ModSortingDropdownButtonController;
		var sortingData : DropdownItemData;
		var languageIdentifier : inkModioLanguageTagsOptions;
		var languageButtonController : LanguageDropdownButtonController;
		var languageData : DropdownItemData;
		PlaySound( 'Button', 'OnPress' );
		identifierTypeName = evt.identifier.GetTypeName();
		if( identifierTypeName == ( ( CName )( 'inkModioModSortingOptions' ) ) )
		{
			sortingIdentifier = ( ( inkModioModSortingOptions )evt.identifier );
			sortingData = ModSortingDropdownData.GetSortingDropdownOption( m_sortingDropdownListController.GetData(), sortingIdentifier );
			if( sortingData )
			{
				sortingButtonController = ( ( ModSortingDropdownButtonController )( m_sortingDropdownButtonController.GetController() ) );
				sortingButtonController.SetData( sortingData );
				UpdateCurrentlySelectedSortingOptions( sortingIdentifier );
				if( IsUsingDPad() )
				{
					SetCursorOverWidget( m_sortingDropdownListController.GetRootWidget(), 0.0, true );
				}
				else
				{
					ResetCursor();
				}
			}
		}
		else if( identifierTypeName == ( ( CName )( 'inkModioLanguageTagsOptions' ) ) )
		{
			languageIdentifier = ( ( inkModioLanguageTagsOptions )evt.identifier );
			languageData = ModLanguageDropdownData.GetLanguageDropdownOption( m_languageDropdownListController.GetData(), languageIdentifier );
			if( languageData )
			{
				languageButtonController = ( ( LanguageDropdownButtonController )( m_languageDropdownButtonController.GetController() ) );
				languageButtonController.SetData( languageData );
				UpdateCurrentlySelectedLanguageTags( languageIdentifier );
			}
		}
	}

