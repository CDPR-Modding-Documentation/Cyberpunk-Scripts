	protected override function SetupData( const data : ref< array< DropdownItemData > > )
	{
		var i : Int32;
		var item : LanguageDropdownCheckboxElementController;
		var languageCheckbox : LanguageCheckbox;
		m_data = data;
		inkCompoundRef.RemoveAllChildren( m_listContainer );
		for( i = 0; i < data.Size(); i += 1 )
		{
			item = ( ( LanguageDropdownCheckboxElementController )( SpawnFromLocal( inkCompoundRef.Get( m_listContainer ), 'LanguagesDropdownCheckboxElement' ).GetController() ) );
			item.m_ownerMenu = ( ( BrowserModsMenuGameController )( m_ownerController ) );
			item.Setup( data[ i ] );
			languageCheckbox = item.m_languageCheckboxController;
			languageCheckbox.InitializeCheckbox( ( ( ModioBrowserMenuGameController )( m_ownerController ) ), ( ( inkModioLanguageTagsOptions )data[ i ].identifier ) );
			m_languageItems.PushBack( item );
			if( i == 0 )
			{
				item.SetActive( true );
				m_activeElement = item;
			}
		}
	}

}

