	protected event OnHoldInput( e : inkPointerEvent )
	{
		HandleHoldInput( e );
	}

	private function HandleHoldInput( e : inkPointerEvent )
	{
		var holdProgress : Float;
		if( ShouldIgnoreInput() )
		{
			return;
		}
		if( e.IsAction( 'enable_or_disable_all_mods' ) && !( m_IsInBrowserMenu ) )
		{
			holdProgress = e.GetHoldProgress();
			if( holdProgress > 0.25 )
			{
				m_IgnoreNextEnableAction = true;
			}
			if( holdProgress < 1.0 )
			{
				return;
			}
			PlaySound( 'Button', 'OnPress' );
			EnableOrDisableAllMods();
		}
	}

	protected event OnSetMenuEventDispatcher( menuEventDispatcher : weak< inkMenuEventDispatcher > )
	{
		m_eventDispatcher = menuEventDispatcher;
	}

	protected event OnButtonRelease( evt : inkPointerEvent )
	{
		var widget : inkWidget;
		if( IsFilterDrawerOpen() )
		{
			if( evt.IsAction( 'back' ) || evt.IsAction( 'display_filter_drawer' ) )
			{
				HideFilterDrawer();
			}
			else if( evt.IsAction( 'focus_search_bar' ) )
			{
				m_filterDrawer.ResetAll();
			}
			else if( evt.IsAction( 'navigate_up' ) )
			{
				m_filterDrawer.NavigateUp();
			}
			else if( evt.IsAction( 'navigate_down' ) )
			{
				m_filterDrawer.NavigateDown();
			}
			return true;
		}
		if( ShouldIgnoreInput() )
		{
			return true;
		}
		if( evt.IsAction( 'back' ) )
		{
			if( IsSearchBarFocused() )
			{
				m_modsearchBarController.LoseFocus();
				evt.Handle();
			}
			else if( m_sortingDropdownListController.IsOpened() )
			{
				m_sortingDropdownListController.Close();
				evt.Handle();
			}
			else
			{
				m_eventDispatcher.SpawnEvent( 'OnMainMenuBack' );
				evt.Handle();
			}
		}
		else if( evt.IsAction( 'mod_prior_menu' ) || evt.IsAction( 'mod_next_menu' ) )
		{
			PlaySound( 'Button', 'OnPress' );
			if( !( IsSearchBarFocused() ) )
			{
				SwitchBetweenBrowserAndCollectionMenu();
				evt.Handle();
			}
		}
		else if( evt.IsAction( 'enable_or_disable_mod' ) )
		{
			if( !( IsSearchBarFocused() ) && !( m_waitingForNewModListState ) )
			{
				if( !( m_IgnoreNextEnableAction ) && GetIsSelectedModInstalled() )
				{
					PlaySound( 'Button', 'OnPress' );
					EnableOrDisableCurrentlyFocusedMod();
				}
				m_IgnoreNextEnableAction = false;
				evt.Handle();
			}
		}
		else if( evt.IsAction( 'mod_prior_page' ) )
		{
			if( ( !( IsSearchBarFocused() ) && !( m_bIsInGallery ) ) && !( m_waitingForNewModListState ) )
			{
				PlaySound( 'Button', 'OnPress' );
				GoToPreviousPage();
				evt.Handle();
			}
		}
		else if( evt.IsAction( 'mod_next_page' ) )
		{
			if( ( !( IsSearchBarFocused() ) && !( m_bIsInGallery ) ) && !( m_waitingForNewModListState ) )
			{
				PlaySound( 'Button', 'OnPress' );
				GoToNextPage();
				evt.Handle();
			}
		}
		else if( evt.IsAction( 'click' ) || ( evt.IsAction( 'tap' ) && !( evt.IsHandled() ) ) )
		{
			widget = evt.GetCurrentTarget();
			if( IsSearchBarFocused() && ( evt.GetCurrentTarget() != inkTextInputRef.Get( m_searchBarTextInput ) ) )
			{
				m_modsearchBarController.LoseFocus();
				widget.SetVisible( true );
			}
		}
		else if( evt.IsAction( 'subscribe_to_mod' ) )
		{
			if( !( IsSearchBarFocused() ) && !( m_waitingForNewModListState ) )
			{
				PlaySound( 'Button', 'OnPress' );
				if( IsPregame() )
				{
					if( GetIsSelectedModInstalled() && CanDisplayUninstallConfirmationPopup() )
					{
						AskIfUserReallyWantToUnsubscribe();
					}
					else
					{
						SubscribeToModShortcutPressed();
					}
				}
				else
				{
					WarnAboutImpossibleActionInPauseMenu();
				}
			}
		}
		else if( evt.IsAction( 'focus_search_bar' ) && IsGameOnConsole() )
		{
			m_modsearchBarController.TryFocus( false );
		}
		else if( evt.IsAction( 'display_filter_drawer' ) )
		{
			if( !( IsSearchBarFocused() ) )
			{
				ShowFilterDrawer();
			}
		}
		else if( evt.IsAction( 'display_hidden_mods' ) )
		{
			if( !( IsSearchBarFocused() ) )
			{
				DisplayHiddenModsPopup();
			}
		}
	}

	public function DisplayHiddenModsPopup()
	{
		var hiddenManagerEvent : HiddenModManagerPopupEvent;
		PlaySound( 'Button', 'OnPress' );
		hiddenManagerEvent = new HiddenModManagerPopupEvent;
		hiddenManagerEvent.m_data = new HiddenModManagerPopupData;
		hiddenManagerEvent.m_data.queueName = 'modio_hiddenMods';
		hiddenManagerEvent.m_data.notificationName = 'base\gameplay\gui\fullscreen\main_menu\modio\modio_mutedmods.inkwidget';
		hiddenManagerEvent.m_data.isBlocking = true;
		hiddenManagerEvent.m_data.useCursor = true;
		hiddenManagerEvent.m_data.m_ownerMenu = this;
		hiddenManagerEvent.m_data.m_listOfHiddenMods = m_hiddenModsInfoList;
		hiddenManagerEvent.m_data.m_listOfModLogoPath = GetHiddenModsLogoPath();
		hiddenManagerEvent.m_data.m_listOfHiddenAuthors = GetHiddenAuthors();
		QueueBroadcastEvent( hiddenManagerEvent );
	}

