	protected event OnNewModSelected( inModInfo : ModioModInfos, inModInfoProgress : ModioModProgressInfo, inSelectedPanelID : Int32, fromAuthor : Int64, bIsModCurrentlyBeingProcesssed : Bool, bIsPendingActivationOrDeactivation : Bool )
	{
		var subscribeController : SubscribeToModButtonController;
		var likeController : LikeButtonController;
		var authorController : FromAuthorButtonController;
		var bIsFilteringByAuthor : Bool;
		var downloadProgressBarController : ModPanelDownloadProgressBarController;
		if( m_currentSelectedModID != inModInfo.id )
		{
			m_modDetailItem.InitializeModDetails( inModInfo, m_systemHandler, GetRemainingSpaceOnUserDisk(), GetRemainingSpaceOnUserDiskText() );
		}
		else
		{
			m_modDetailItem.PlayEnableDisableToggleTransitionAnimationIfNeeded( inModInfo.bIsUserSubscribedToMod, inModInfo.bIsModEnabledForUser );
			m_modDetailItem.RemoveLoadingDataState();
		}
		m_modDetailItem.AdjustCosmeticsForLikesAndDownloads( inModInfo );
		m_modDetailItem.EditPendingActivationOrDeactivationText( bIsPendingActivationOrDeactivation, inModInfo.bIsModEnabledForUser );
		if( inModInfo.id == 0 )
		{
			m_modDetailItem.SetEmptyDataState();
		}
		m_modDetailItem.ApplyCorrectColor( inModInfo.bIsUserSubscribedToMod, !( inModInfo.bIsModEnabledForUser ) );
		m_bCurrentlySelectedModIsEnabled = inModInfo.bIsModEnabledForUser;
		m_currentlySelectedModEntry.ApplyUnselectedColor();
		m_currentlySelectedModEntry = ( ( ModEntryItem )( m_modPickerController.m_modEntryItemList[ inSelectedPanelID ].GetController() ) );
		if( inModInfo.id != 0 )
		{
			m_currentlySelectedModEntry.ApplySelectedColor();
		}
		else
		{
			m_currentlySelectedModEntry.ApplyUnselectedColor();
		}
		if( !( inModInfo.bIsModNewForUser ) )
		{
			m_currentlySelectedModEntry.RemoveNewModIcon();
		}
		subscribeController = ( ( SubscribeToModButtonController )( inkWidgetRef.GetController( m_modDetailItem.m_subscriptionButton ) ) );
		if( m_modDetailItem.ShouldPreventSubscribing( inModInfo.bIsUserSubscribedToMod ) )
		{
			subscribeController.SetIsDisabledForOutOfSpaceReason( true );
		}
		else
		{
			subscribeController.SetIsDisabled( bIsModCurrentlyBeingProcesssed );
		}
		subscribeController.SetButtonInfo( inModInfo.bIsUserSubscribedToMod );
		likeController = ( ( LikeButtonController )( inkWidgetRef.GetController( m_modDetailItem.m_likeButton ) ) );
		likeController.SetIsDisabled( bIsModCurrentlyBeingProcesssed );
		likeController.SetButtonInfo( inModInfo.bIsUserLikingMod );
		authorController = ( ( FromAuthorButtonController )( inkWidgetRef.GetController( m_modDetailItem.m_authorButton ) ) );
		bIsFilteringByAuthor = ( ( fromAuthor == 0 ) ? ( false ) : ( fromAuthor == inModInfo.authorID ) );
		authorController.SetButtonInfo( bIsFilteringByAuthor );
		m_moreOptionsController.SetIsDisabled( bIsModCurrentlyBeingProcesssed );
		downloadProgressBarController = ( ( ModPanelDownloadProgressBarController )( inkCompoundRef.GetController( m_modDetailItem.m_downloadProgressBar ) ) );
		if( ( inModInfoProgress.modID == -1 ) || ( inModInfoProgress.modID != inModInfo.id ) )
		{
			downloadProgressBarController.SetGlobalVisibility( false );
		}
		else
		{
			downloadProgressBarController.SetGlobalVisibility( true );
			downloadProgressBarController.SetProgress( inModInfoProgress.progressRate );
			downloadProgressBarController.SetProgressTextFromProgress( inModInfoProgress.progressState );
		}
		RequestButtonHintUpdateNextFrame();
		m_currentSelectedModID = inModInfo.id;
		m_currentSelectedModName = inModInfo.name;
	}

	protected event OnProcessedModProgressUpdate( inModInfoProgress : ModioModProgressInfo, currentlySelectedMod : Int64, currentlyDisplayedModInfos : array< ModioModInfos > )
	{
		var downloadProgressBarController : ModPanelDownloadProgressBarController;
		downloadProgressBarController = ( ( ModPanelDownloadProgressBarController )( inkCompoundRef.GetController( m_modDetailItem.m_downloadProgressBar ) ) );
		if( ( inModInfoProgress.modID == -1 ) || ( inModInfoProgress.modID != currentlySelectedMod ) )
		{
			downloadProgressBarController.SetGlobalVisibility( false );
		}
		else
		{
			downloadProgressBarController.SetGlobalVisibility( true );
			downloadProgressBarController.SetProgress( inModInfoProgress.progressRate );
			downloadProgressBarController.SetProgressTextFromProgress( inModInfoProgress.progressState );
		}
		m_modPickerController.UpdateProgress( inModInfoProgress, currentlyDisplayedModInfos );
	}

	protected event OnListOfModsToDisplayUpdated( modList : array< ModioModInfos >, modProgressInfo : ModioModProgressInfo )
	{
		m_modPickerController.UpdateGrid( modList, modProgressInfo );
		m_waitingForNewModListState = false;
		UpdateButtonHints();
	}

