	protected event OnMenuUpdate( inNumberOfMods : Int32, inNumberOfEnabledMods : Int32 )
	{
		var textParamsForEnabledMods : inkTextParams;
		var textParamsForSpaceInfo : inkTextParams;
		var maxNumberOfModsYouCanEnable : Int32;
		inkTextRef.SetText( m_numberOfModsText, IntToString( inNumberOfMods ) + " " );
		m_matureContentAndEnableAllModsCheckboxController.UpdateCheckbox();
		if( IsNumberOfEnabledModLimited() )
		{
			inkTextRef.SetVisible( m_modLimitNumberOfModsEnabledText, true );
			maxNumberOfModsYouCanEnable = GetEnableModLimitNumber();
			textParamsForEnabledMods = new inkTextParams;
			textParamsForEnabledMods.AddNumber( "CURMODS", inNumberOfEnabledMods );
			textParamsForEnabledMods.AddNumber( "MAXMODS", maxNumberOfModsYouCanEnable );
			inkTextRef.SetText( m_modLimitNumberOfModsEnabledText, GetLocalizedText( "UI-Modio-MenuContent-NbrModsEnabled" ), textParamsForEnabledMods );
		}
		textParamsForSpaceInfo = new inkTextParams;
		textParamsForSpaceInfo.AddString( "STORAGELEFT", GetRemainingSpaceOnUserDiskText() );
		textParamsForSpaceInfo.AddString( "STORAGETOTAL", GetTotalSpaceOnUserDiskText() );
		inkTextRef.SetVisible( m_spaceInfoTextRef, true );
		inkTextRef.SetText( m_spaceInfoTextRef, GetLocalizedText( "UI-Modio-MenuContent-StorageInfo" ), textParamsForSpaceInfo );
	}

