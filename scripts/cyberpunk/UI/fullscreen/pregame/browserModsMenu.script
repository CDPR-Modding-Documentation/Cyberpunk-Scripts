}

import enum inkModioFilterTags
{
	Appearance,
	Characters,
	Weapons,
	Vehicles,
	Animations,
	Gameplay,
	Graphics,
	Audio,
	Misc,
	MAX,
}

import struct inkModAuthorInfo
{
	import var authorId : Int64;
	import var username : String;
}

import enum inkModioModState
{
	InstallationPending,
	Installed,
	UpdatePending,
	Downloading,
	Extracting,
	UninstallPending,
	Reconciling,
	MAX,
}

import enum inkModioModProgressState
{
	Initializing,
	Downloading,
	Extracting,
	Compressing,
	Uploading,
	CleaningUp,
	MAX,
}

import enum inkModioModSortingOptions : Uint8
{
	Trending,
	Popular,
	HighestRated,
	RecentlyUpdated,
	RecentlyUploaded,
	MAX,
}

import enum inkModioLanguageTagsOptions : Uint32
{
	AllLanguages,
	Arabic,
	Czech,
	German,
	English,
	Spanish,
	LatinAmericaSpanish,
	French,
	Hungarian,
	Italian,
	Japanese,
	Korean,
	Polish,
	BrazilianPortuguese,
	Russian,
	Thai,
	Turkish,
	Ukrainian,
	SimplifiedChinese,
	TraditionalChinese,
	MAX,
}

import enum inkModioMoreOptions : Uint8
{
	More,
	HideAuthor,
	HideMod,
	Report,
	MAX,
}

import struct ModioModInfos
{
	import var name : String;
	import var authorName : String;
	import var authorLinkedAccountName : String;
	import var authorID : Int64;
	import var version : String;
	import var changelog : String;
	import var description : String;
	import var summary : String;
	import var rating : Int64;
	import var size : Uint64;
	import var downloadsTotal : Int64;
	import var dateAdded : Int64;
	import var dateUpdated : Int64;
	import var id : Int64;
	import var bIsUserSubscribedToMod : Bool;
	import var bIsUserLikingMod : Bool;
	import var bIsModEnabledForUser : Bool;
	import var bIsModNewForUser : Bool;
	import var bIsModWaitingEndOfInstallation : Bool;
	import var gallerySize : Int64;
	import var modState : inkModioModState;
	import var localizedTags : array< String >;
}

import struct ModioModProgressInfo
{
	import var modID : Int64;
	import var progressState : inkModioModProgressState;
	import var progressRate : Float;
}

