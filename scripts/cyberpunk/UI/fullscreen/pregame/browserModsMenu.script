}

class LanguageCheckbox extends ContentCheckbox
{
	protected var m_identifier : inkModioLanguageTagsOptions;

	public function InitializeCheckbox( inOwnerMenu : weak< BrowserModsMenuGameController >, inIdentifier : inkModioLanguageTagsOptions )
	{
		m_ownerMenu = inOwnerMenu;
		m_identifier = inIdentifier;
		UpdateCheckbox( false );
		m_ownerMenu.AddToListOfNavigables( this );
	}

	public function UpdateCheckbox( inState : Bool )
	{
		m_bState = inState;
		inkImageRef.SetVisible( m_checkboxImage, m_bState );
	}

	protected override function OnClickContentCheckbox()
	{
		var newState : Bool;
		newState = !( m_bState );
		UpdateCheckbox( newState );
		m_ownerMenu.UpdateCurrentlySelectedLanguageTags( m_identifier );
	}

}

