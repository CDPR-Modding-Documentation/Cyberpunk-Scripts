	}

	private function SwitchToBrowserView()
	{
		inkWidgetRef.Get( m_BrowserMenuTitleText ).BindProperty( 'tintColor', 'MainColors.ActiveBlue' );
		inkWidgetRef.Get( m_CollectionMenuTitleText ).BindProperty( 'tintColor', 'MainColors.ActiveRed' );
		UpdateButtonHints();
	}

	private function SwitchToCollectionView()
	{
		inkWidgetRef.Get( m_BrowserMenuTitleText ).BindProperty( 'tintColor', 'MainColors.ActiveRed' );
		inkWidgetRef.Get( m_CollectionMenuTitleText ).BindProperty( 'tintColor', 'MainColors.ActiveBlue' );
		UpdateButtonHints();
	}

	public function IsGameOnConsole() : Bool
	{
		var platformName : String;
		platformName = GetPlatformShortName();
		if( ( ( ( platformName == "ps5" || platformName == "ps5pro" ) || platformName == "xseriesx" ) || platformName == "xseriess" ) || platformName == "emporium" )
		{
			return true;
		}
		return false;
	}

	public function UpdateButtonHints()
	{
		var EnableOrDisableString : String;
		var EnableOrDisableAllString : String;
		var bIsCurrentlySelectedModInstalled : Bool;
		var bIsCurrentlySelectedModSubscribed : Bool;
		var bShouldActionEnable : Bool;
		m_buttonHintsController.ClearButtonHints();
		if( IsFilterDrawerOpen() )
		{
			m_buttonHintsController.AddButtonHint( 'back', GetLocalizedText( "Common-Access-Close" ) );
			m_buttonHintsController.AddButtonHint( 'focus_search_bar', GetLocalizedText( "UI-Modio-FiltersSorting-Reset" ) );
		}
		else
		{
			m_buttonHintsController.AddButtonHint( 'back', ( ( IsSearchBarFocused() ) ? ( GetLocalizedText( "UI-UserActions-NavigateBack" ) ) : ( GetLocalizedText( "Common-Access-Close" ) ) ) );
			if( !( IsSearchBarFocused() ) )
			{
				m_buttonHintsController.AddButtonHint( 'display_filter_drawer', GetLocalizedText( "UI-Modio-InputHints-Filters" ) );
				if( IsGameOnConsole() )
				{
					m_buttonHintsController.AddButtonHint( 'focus_search_bar', GetLocalizedText( "UI-Modio-InputHints-Search" ) );
				}
				if( !( m_waitingForNewModListState ) )
				{
					m_buttonHintsController.AddButtonHint( 'select', GetLocalizedText( "UI-UserActions-Select" ) );
					bIsCurrentlySelectedModInstalled = GetIsSelectedModInstalled();
					if( bIsCurrentlySelectedModInstalled )
					{
						bShouldActionEnable = !( m_bCurrentlySelectedModIsEnabled );
						EnableOrDisableString = ( ( !( bShouldActionEnable ) ) ? ( GetLocalizedText( "UI-Modio-InputHints-Disable" ) ) : ( GetLocalizedText( "UI-Modio-InputHints-Enable" ) ) );
						m_buttonHintsController.AddButtonHint( 'enable_or_disable_mod', EnableOrDisableString );
						if( !( m_IsInBrowserMenu ) )
						{
							EnableOrDisableAllString = ( ( !( bShouldActionEnable ) ) ? ( GetLocalizedText( "UI-Modio-FiltersSorting-DisableAll" ) ) : ( GetLocalizedText( "UI-Modio-FiltersSorting-EnableAll" ) ) );
							m_buttonHintsController.AddButtonHint( 'enable_or_disable_all_mods', ( ( "[" + GetLocalizedText( "Gameplay-Devices-Interactions-Helpers-Hold" ) ) + "] " ) + EnableOrDisableAllString );
						}
					}
					bIsCurrentlySelectedModSubscribed = GetIsUserSubscribedToSelectedMod();
					if( !( bIsCurrentlySelectedModSubscribed ) )
					{
						m_buttonHintsController.AddButtonHint( 'subscribe_to_mod', GetLocalizedText( "UI-Modio-InputHints-Install" ) );
					}
					else if( bIsCurrentlySelectedModInstalled )
					{
						m_buttonHintsController.AddButtonHint( 'subscribe_to_mod', GetLocalizedText( "UI-Modio-InputHints-Uninstall" ) );
					}
					m_buttonHintsController.AddButtonHint( 'display_hidden_mods', GetLocalizedText( "UI-Modio-MenuContent-ManageHiddenMods" ) );
				}
			}
		}
	}

	protected event OnPageClicked( e : inkPointerEvent )
	{
		var button : weak< inkWidget >;
		var controller : weak< PageSelectorItem >;
		if( e.IsAction( 'click' ) || e.IsAction( 'tap' ) )
		{
			PlaySound( 'Button', 'OnPress' );
			button = ( ( inkWidget )( e.GetCurrentTarget() ) );
			controller = ( ( PageSelectorItem )( button.GetController() ) );
			UpdateCurrentlySelectedPage( controller.m_pageNumber );
		}
	}

	protected event OnPagesLayoutChanged( newNumberOfPages : Int32, currentlySelectedPage : Int32 )
	{
		DisplayCorrectPagesLayout( newNumberOfPages, currentlySelectedPage );
	}

	private function DisplayCorrectPagesLayout( newNumberOfPages : Int32, currentlySelectedPage : Int32 )
	{
		var i : Int32;
		var currentPageSelectorIndex : Int32;
		ShowPage( m_PageSelectorItemWidgetList[ 0 ], 1, currentlySelectedPage );
		currentPageSelectorIndex = 1;
		if( currentlySelectedPage > 4 )
		{
			if( currentlySelectedPage == 5 )
			{
				ShowPage( m_PageSelectorItemWidgetList[ currentPageSelectorIndex ], 2, currentlySelectedPage );
			}
			else
			{
				ShowSeparator( m_PageSelectorItemWidgetList[ currentPageSelectorIndex ] );
			}
			currentPageSelectorIndex += 1;
		}
		for( i = Max( 2, currentlySelectedPage - 2 ); i <= Min( newNumberOfPages - 1, currentlySelectedPage + 2 ); i += 1 )
		{
			ShowPage( m_PageSelectorItemWidgetList[ currentPageSelectorIndex ], i, currentlySelectedPage );
			currentPageSelectorIndex += 1;
		}
		if( currentlySelectedPage < ( newNumberOfPages - 3 ) )
		{
			if( ( i + 1 ) != newNumberOfPages )
			{
				ShowSeparator( m_PageSelectorItemWidgetList[ currentPageSelectorIndex ] );
				currentPageSelectorIndex += 1;
			}
			else
			{
				ShowPage( m_PageSelectorItemWidgetList[ currentPageSelectorIndex ], i, currentlySelectedPage );
				currentPageSelectorIndex += 1;
			}
		}
		if( newNumberOfPages > 1 )
		{
			ShowPage( m_PageSelectorItemWidgetList[ currentPageSelectorIndex ], newNumberOfPages, currentlySelectedPage );
			currentPageSelectorIndex += 1;
		}
		for( currentPageSelectorIndex; currentPageSelectorIndex < 9; currentPageSelectorIndex += 1 )
		{
			HidePage( m_PageSelectorItemWidgetList[ currentPageSelectorIndex ] );
		}
	}

	private function ShowPage( inPageWidget : inkWidget, inPageValue : Int32, inCurrentlySelectedPage : Int32 )
	{
		var inPageSelectorItem : PageSelectorItem;
		inPageSelectorItem = ( ( PageSelectorItem )( inPageWidget.GetController() ) );
		inPageSelectorItem.ShowPageItem( this, inPageValue, inCurrentlySelectedPage );
	}

	private function ShowSeparator( inPageWidget : inkWidget )
	{
		var inPageSelectorItem : PageSelectorItem;
		inPageSelectorItem = ( ( PageSelectorItem )( inPageWidget.GetController() ) );
		inPageSelectorItem.SetAsPageSeparator( this );
	}

	private function HidePage( inPageWidget : inkWidget )
	{
		var inPageSelectorItem : PageSelectorItem;
		inPageSelectorItem = ( ( PageSelectorItem )( inPageWidget.GetController() ) );
		inPageSelectorItem.HidePageItem( this );
	}

	private function SetupReport()
	{
		m_modioReportController = ( ( ModioReportController )( SpawnFromExternal( GetRootWidget(), R"base/gameplay/gui/fullscreen/main_menu/modio/modio_report.inkwidget", 'Root' ).GetController() ) );
		m_modioReportController.GetRootWidget().SetVisible( false );
	}

	public function OnReportClick()
	{
		m_modioReportController.OnOpen();
		m_modioReportController.SetSystemHandler( m_systemHandler );
		m_modioReportController.SetModMenuController( this );
		m_modioReportController.SetModID( m_currentSelectedModID );
		m_modioReportController.SetModName( m_currentSelectedModName );
		DeactivateNavigation();
	}

	protected event OnOnlineStatusChanged( value : GOGRewardsSystemStatus )
	{
		var error : GOGRewardsSystemErrors;
		error = m_onlineSystem.GetError();
		if( error == GOGRewardsSystemErrors.NoInternetConnection )
		{
			if( !( m_isOffline ) )
			{
				m_isOffline = true;
				m_systemHandler.RequestSystemNotificationGenericYesNo( 'UI-Modio-ErrorMessages-PopupTitle', 'UI-Modio-ErrorMessages-ModioOutage', this, 'OnShowNetworkErrorMsgResult', false );
			}
		}
		else if( m_isOffline )
		{
			m_isOffline = false;
		}
	}

	protected event OnShowNetworkErrorMsgResult( value : Bool )
	{
		m_eventDispatcher.SpawnEvent( 'OnMainMenuBack' );
	}

	protected event OnSearchBarPress( evt : inkPointerEvent )
	{
		if( evt.IsAction( 'click' ) )
		{
			OpenIMEDialogIfNeeded();
		}
	}

	public function OpenIMEDialogIfNeeded()
	{
		var platformName : String;
		var voName : CName;
		var voVar : ConfigVarListName;
		platformName = GetPlatformShortName();
		if( ( platformName == "xseriesx" || platformName == "xseriess" ) || platformName == "emporium" )
		{
			if( !( m_bIsOpenIMGDialog ) )
			{
				Modio.OpenIMEDialog( ( ( inkText )( inkTextInputRef.Get( m_searchBarTextInput ) ) ).GetText(), this, 'OnOpenIMEDialogResult' );
				m_bIsOpenIMGDialog = true;
			}
			else
			{
				m_bIsOpenIMGDialog = false;
			}
		}
		else if( platformName == "ps5" || platformName == "ps5pro" )
		{
			Modio.OpenIMEDialog( ( ( inkText )( inkTextInputRef.Get( m_searchBarTextInput ) ) ).GetText(), this, 'OnOpenIMEDialogResult' );
		}
		else if( ( platformName == "mac" || platformName == "windows" ) || platformName == "windowsGDK" )
		{
			voVar = ( ( ConfigVarListName )( m_systemHandler.GetUserSettings().GetVar( '/language', 'OnScreen' ) ) );
			if( voVar )
			{
				voName = voVar.GetValue();
				if( ( ( voName == 'ja' || voName == 'ko' ) || voName == 'zh-cn' ) || voName == 'zh-tw' )
				{
					Modio.OpenIMEDialog( ( ( inkText )( inkTextInputRef.Get( m_searchBarTextInput ) ) ).GetText(), this, 'OnOpenIMEDialogResult', 30 );
				}
			}
		}
	}

	protected event OnOpenIMEDialogResult( str : String, hasResult : Bool )
	{
		var maxChars : Uint32;
		if( hasResult )
		{
			maxChars = ( ( inkTextInput )( inkTextInputRef.Get( m_searchBarTextInput ) ) ).GetMaxChars();
			if( ( maxChars > 0 ) && ( StrLen( str ) > ( ( Int32 )( maxChars ) ) ) )
			{
				( ( inkText )( inkTextInputRef.Get( m_searchBarTextInput ) ) ).SetText( Modio.SubStrByChar( str, 0, ( ( Int32 )( maxChars ) ) ) );
			}
			else if( StrLen( str ) == 0 )
			{
				m_modsearchBarController.Reset();
				( ( inkText )( inkTextInputRef.Get( m_searchBarTextInput ) ) ).SetText( str );
			}
			else
			{
				( ( inkText )( inkTextInputRef.Get( m_searchBarTextInput ) ) ).SetText( str );
			}
		}
		else
		{
			m_modsearchBarController.Reset();
			( ( inkText )( inkTextInputRef.Get( m_searchBarTextInput ) ) ).SetText( "" );
		}
		m_modsearchBarController.DisplayDefaultTextIfEmpty();
	}

	protected event OnSearchBarHoverOut( e : inkPointerEvent )
	{
		RequestSetFocus( NULL );
	}

}

class browserModsMenuModPicker extends inkLogicController
{
	private editable var m_grid : inkUniformGridRef;
	var m_modEntryItemList : array< weak< inkWidget > >;
	private var m_ownerMenu : weak< BrowserModsMenuGameController >;

	public function InitializeGrid( ownerMenu : BrowserModsMenuGameController )
	{
		var i : Int32;
		var currentModPanel : inkWidget;
		var currentModEntry : ModEntryItem;
		m_ownerMenu = ownerMenu;
		for( i = 0; i < 9; i += 1 )
		{
			currentModPanel = SpawnFromLocal( inkUniformGridRef.Get( m_grid ), 'ModEntryItem' );
			currentModEntry = ( ( ModEntryItem )( currentModPanel.GetController() ) );
			currentModEntry.SetID( i );
			currentModEntry.SetOwnerMenu( m_ownerMenu );
			currentModEntry.SetWaitingForModDataState();
			m_modEntryItemList.PushBack( currentModPanel );
			if( i == 2 )
			{
				currentModEntry.OverrideNavigation( inkDiscreteNavigationDirection.Up, m_ownerMenu.GetModDrawerButtonWidget() );
			}
		}
	}

	public function SetGridToWaitingForModState()
	{
		var i : Int32;
		var currentModEntry : ModEntryItem;
		for( i = 0; i < m_modEntryItemList.Size(); i += 1 )
		{
			currentModEntry = ( ( ModEntryItem )( m_modEntryItemList[ i ].GetController() ) );
			currentModEntry.SetWaitingForModDataState();
		}
	}

	public function DestroyGrid( ownerMenu : ModioBrowserMenuGameController )
	{
		var i : Int32;
		var currentModPanel : inkWidget;
		var currentModEntry : ModEntryItem;
		for( i = 0; i < 9; i += 1 )
		{
			currentModPanel = m_modEntryItemList[ i ];
			currentModEntry = ( ( ModEntryItem )( currentModPanel.GetController() ) );
			currentModEntry.UnregisterFromCallback( 'OnRelease', ownerMenu, 'OnModClicked' );
		}
		m_modEntryItemList.Clear();
	}

	public function UpdateGrid( newModList : array< ModioModInfos >, modProgressInfo : ModioModProgressInfo )
	{
		var i : Int32;
		var currentModEntryItem : ModEntryItem;
		for( i = 0; ( i < newModList.Size() ) && ( i < 9 ); i += 1 )
		{
			m_modEntryItemList[ i ].SetVisible( true );
			currentModEntryItem = ( ( ModEntryItem )( m_modEntryItemList[ i ].GetController() ) );
			currentModEntryItem.SetModInfo( newModList[ i ], modProgressInfo, m_ownerMenu.FormatByteSizeToReadableSize( newModList[ i ].size ) );
		}
		for( i; i < 9; i += 1 )
		{
			currentModEntryItem = ( ( ModEntryItem )( m_modEntryItemList[ i ].GetController() ) );
			currentModEntryItem.SetEmptyDataState();
		}
	}

	public function UpdateProgress( modProgressInfo : ModioModProgressInfo, currentlyDisplayedModInfos : array< ModioModInfos > )
	{
		var i : Int32;
		var currentModEntryItem : ModEntryItem;
		for( i = 0; ( i < 9 ) && ( i < m_modEntryItemList.Size() ); i += 1 )
		{
			currentModEntryItem = ( ( ModEntryItem )( m_modEntryItemList[ i ].GetController() ) );
			currentModEntryItem.UpdateProgress( modProgressInfo, currentlyDisplayedModInfos );
		}
	}

	public function SetWarningStateOnGrid()
	{
		var i : Int32;
		var currentModPanel : inkWidget;
		var currentModEntry : ModEntryItem;
		for( i = 0; i < 9; i += 1 )
		{
			currentModPanel = m_modEntryItemList[ i ];
			currentModEntry = ( ( ModEntryItem )( currentModPanel.GetController() ) );
			currentModEntry.SetWarningDataState();
		}
	}

	public function RemoveWarningStateOnGrid()
	{
		var i : Int32;
		var currentModPanel : inkWidget;
		var currentModEntry : ModEntryItem;
		for( i = 0; i < 9; i += 1 )
		{
			currentModPanel = m_modEntryItemList[ i ];
			currentModEntry = ( ( ModEntryItem )( currentModPanel.GetController() ) );
			currentModEntry.RemoveWarningDataState();
		}
	}

}

class ModEntryItem extends AnimatedListItemController
{
	private editable var m_modTitle : inkTextRef;
	private editable var m_modNumberOfDownloadsText : inkTextRef;
	private editable var m_modNumberOfDownloadsIcon : inkImageRef;
	private editable var m_modNumberOfLikesText : inkTextRef;
	private editable var m_modNumberOfLikesIcon : inkImageRef;
	private editable var m_modSizeText : inkTextRef;
	private editable var m_modSizeIcon : inkImageRef;
	private editable var m_entryOutlineImage : inkImageRef;
	private editable var m_hoverHighlightCanvas : inkWidgetRef;
	private editable var m_backgroundColorImage : inkImageRef;
	private editable var m_downloadText : inkTextRef;
	private editable var m_downloadBarFillIcon : inkWidgetRef;
	private editable var m_downloadBarOutlineIcon : inkWidgetRef;
	private editable var m_likedByUserIcon : inkWidgetRef;
	private editable var m_newModWidget : inkWidgetRef;
	private editable var m_modLogoWidget : inkImageRef;
	private editable var m_subscribedToModIcon : inkImageRef;
	private editable var m_logoLoadingWidget : inkWidgetRef;
	private editable var m_logoLoadingSpinner : inkWidgetRef;
	private editable var m_logoLoading_bg : inkImageRef;
	private editable var m_logoErrorWidget : inkImageRef;
	private editable var m_waitingForDataWidget : inkWidgetRef;
	private editable var m_waitingForDataLoadingSpinner : inkWidgetRef;
	private editable var m_emptyDataWidget : inkWidgetRef;
	private editable var m_warningErrorWidget : inkWidgetRef;
	private editable var m_downloadProgressBar : inkCompoundRef;
	private var m_root : weak< inkWidget >;
	private var m_basePreviewSize : Vector2;
	var m_ID : Int32;
	private var m_colorNames : ModsMenuColorsNames;
	var m_isUserSubscribedToMod : Bool;
	var m_isModEntrySelected : Bool;
	private var m_numberOfScreenshotRequests : Int32;
	private var m_isWaitingForData : Bool;
	default m_isWaitingForData = false;
	private var m_isInWarningDataState : Bool;
	default m_isInWarningDataState = false;
	private var m_hasNoData : Bool;
	default m_hasNoData = false;
	private var m_ownerMenu : weak< BrowserModsMenuGameController >;
	private var m_modID : Int64;

	public function SetOwnerMenu( inOwnerMenu : weak< BrowserModsMenuGameController > )
	{
		m_ownerMenu = inOwnerMenu;
		m_ownerMenu.AddToListOfNavigables( this );
	}

	public function SetID( inID : Int32 )
	{
		m_ID = inID;
	}

	public function ResetData()
	{
		m_isUserSubscribedToMod = false;
		m_isModEntrySelected = false;
		m_hasNoData = true;
		m_modID = -1;
	}

	public function SetModInfo( modInfo : ModioModInfos, modProgressInfo : ModioModProgressInfo, formattedModSizeText : String )
	{
		var downloadProgressBarController : ModItemDownloadProgressBarController;
		AdjustCosmeticsForLikesAndDownloads( modInfo );
		inkTextRef.SetText( m_modTitle, modInfo.name );
		inkTextRef.SetText( m_modSizeText, formattedModSizeText );
		m_isUserSubscribedToMod = modInfo.bIsUserSubscribedToMod;
		inkImageRef.SetVisible( m_subscribedToModIcon, modInfo.bIsUserSubscribedToMod && m_ownerMenu.GetIsModInstalled( modInfo.id ) );
		inkWidgetRef.SetVisible( m_likedByUserIcon, modInfo.bIsUserLikingMod );
		inkWidgetRef.SetVisible( m_newModWidget, modInfo.bIsModNewForUser );
		ApplyUnselectedColor();
		RemoveWaitingForModDataState();
		RemoveEmptyDataState();
		if( modInfo.bIsModEnabledForUser )
		{
			inkImageRef.SetTexturePart( m_subscribedToModIcon, 'enabled_rectangle_icon' );
			inkImageRef.Get( m_subscribedToModIcon ).BindProperty( 'tintColor', m_colorNames.activeBlueName );
		}
		else
		{
			inkImageRef.SetTexturePart( m_subscribedToModIcon, 'disabled_rectangle_icon' );
			inkImageRef.Get( m_subscribedToModIcon ).BindProperty( 'tintColor', m_colorNames.activeRedName );
		}
		downloadProgressBarController = ( ( ModItemDownloadProgressBarController )( inkCompoundRef.GetController( m_downloadProgressBar ) ) );
		if( modProgressInfo.modID == modInfo.id )
		{
			downloadProgressBarController.SetGlobalVisibility( true );
			downloadProgressBarController.SetProgress( modProgressInfo.progressRate );
			downloadProgressBarController.SetProgressTextFromProgress( modProgressInfo.progressState );
			inkImageRef.SetVisible( m_subscribedToModIcon, true );
			inkImageRef.SetTexturePart( m_subscribedToModIcon, 'install_rectangle_icon' );
			inkImageRef.Get( m_subscribedToModIcon ).BindProperty( 'tintColor', m_colorNames.yellowName );
		}
		else if( modInfo.modState != inkModioModState.MAX )
		{
			downloadProgressBarController.SetGlobalVisibility( true );
			downloadProgressBarController.SetProgressBarVisibility( false );
			downloadProgressBarController.SetProgressTextFromModState( modInfo.modState );
			inkImageRef.SetVisible( m_subscribedToModIcon, true );
			inkImageRef.SetTexturePart( m_subscribedToModIcon, 'install_rectangle_icon' );
			inkImageRef.Get( m_subscribedToModIcon ).BindProperty( 'tintColor', m_colorNames.yellowName );
		}
		else
		{
			downloadProgressBarController.SetGlobalVisibility( false );
		}
		if( modInfo.bIsModWaitingEndOfInstallation )
		{
			inkImageRef.SetVisible( m_subscribedToModIcon, true );
			inkImageRef.SetTexturePart( m_subscribedToModIcon, 'install_rectangle_icon' );
			inkImageRef.Get( m_subscribedToModIcon ).BindProperty( 'tintColor', m_colorNames.yellowName );
		}
		m_modID = modInfo.id;
	}

	public function AdjustCosmeticsForLikesAndDownloads( inModInfo : ModioModInfos )
	{
		var cosmeticNumberOfLikes : Int64;
		var cosmeticNumberOfDownloads : Int64;
		if( inModInfo.id != 0 )
		{
			cosmeticNumberOfLikes = inModInfo.rating + ( ( inModInfo.bIsUserLikingMod ) ? ( 1 ) : ( 0 ) );
			cosmeticNumberOfDownloads = inModInfo.downloadsTotal + m_ownerMenu.GetLocalNumberOfDownloadsForMod( inModInfo.id );
			inkTextRef.SetText( m_modNumberOfLikesText, ( ( String )( cosmeticNumberOfLikes ) ) );
			inkTextRef.SetText( m_modNumberOfDownloadsText, ( ( String )( cosmeticNumberOfDownloads ) ) );
		}
	}

	public function UpdateProgress( modProgressInfo : ModioModProgressInfo, currentlyDisplayedModInfos : array< ModioModInfos > )
	{
		var downloadProgressBarController : ModItemDownloadProgressBarController;
		var bFound : Bool;
		var i : Int32;
		downloadProgressBarController = ( ( ModItemDownloadProgressBarController )( inkCompoundRef.GetController( m_downloadProgressBar ) ) );
		bFound = false;
		if( ( modProgressInfo.modID == m_modID ) && ( m_modID != -1 ) )
		{
			downloadProgressBarController.SetGlobalVisibility( true );
			downloadProgressBarController.SetProgress( modProgressInfo.progressRate );
			downloadProgressBarController.SetProgressTextFromProgress( modProgressInfo.progressState );
			bFound = true;
		}
		else
		{
			for( i = 0; i < currentlyDisplayedModInfos.Size(); i += 1 )
			{
				if( currentlyDisplayedModInfos[ i ].id == m_modID )
				{
					if( currentlyDisplayedModInfos[ i ].modState != inkModioModState.MAX )
					{
						bFound = true;
						downloadProgressBarController.SetGlobalVisibility( true );
						downloadProgressBarController.SetProgressBarVisibility( false );
						downloadProgressBarController.SetProgressTextFromModState( currentlyDisplayedModInfos[ i ].modState );
						break;
					}
				}
			}
		}
		if( !( bFound ) )
		{
			downloadProgressBarController.SetGlobalVisibility( false );
		}
	}

	protected event OnInitialize()
	{
		m_root = GetRootWidget();
		m_basePreviewSize = inkImageRef.GetSize( m_modLogoWidget );
		m_numberOfScreenshotRequests = 0;
		ResetData();
		ShowLogoLoadingIcon();
		RegisterToCallback( 'OnHoverOver', this, 'OnHoverOver' );
		RegisterToCallback( 'OnHoverOut', this, 'OnHoverOut' );
		RegisterToCallback( 'OnRelease', this, 'OnRelease' );
		ApplyDefaultColor();
		super.OnInitialize();
	}

	protected event OnUninitialize()
	{
		UnregisterFromCallback( 'OnHoverOver', this, 'OnHoverOver' );
		UnregisterFromCallback( 'OnHoverOut', this, 'OnHoverOut' );
		UnregisterFromCallback( 'OnRelease', this, 'OnRelease' );
		super.OnUninitialize();
	}

	protected event OnHoverOver( e : inkPointerEvent )
	{
		var bIsSortingDropdownOpened : Bool;
		var bIsLanguageDropdownOpened : Bool;
		if( m_ownerMenu.ShouldIgnoreInput() )
		{
			return true;
		}
		m_ownerMenu.UpdateCurrentlyHoveredMod( m_ID );
		bIsSortingDropdownOpened = m_ownerMenu.m_sortingDropdownListController.IsOpened();
		bIsLanguageDropdownOpened = m_ownerMenu.m_languageDropdownListController.IsOpened();
		if( !( bIsSortingDropdownOpened ) && !( bIsLanguageDropdownOpened ) )
		{
			inkWidgetRef.SetVisible( m_hoverHighlightCanvas, true );
		}
		m_ownerMenu.RequestButtonHintUpdateNextFrame();
	}

	protected event OnHoverOut( e : inkPointerEvent )
	{
		var bIsSortingDropdownOpened : Bool;
		var bIsLanguageDropdownOpened : Bool;
		if( m_ownerMenu.ShouldIgnoreInput() )
		{
			return true;
		}
		m_ownerMenu.UpdateCurrentlyHoveredMod( -1 );
		bIsSortingDropdownOpened = m_ownerMenu.m_sortingDropdownListController.IsOpened();
		bIsLanguageDropdownOpened = m_ownerMenu.m_languageDropdownListController.IsOpened();
		if( !( bIsSortingDropdownOpened ) && !( bIsLanguageDropdownOpened ) )
		{
			inkWidgetRef.SetVisible( m_hoverHighlightCanvas, false );
		}
		m_ownerMenu.RequestButtonHintUpdateNextFrame();
	}

	protected event OnRelease( e : inkPointerEvent )
	{
		if( e.IsAction( 'click' ) || e.IsAction( 'tap' ) )
		{
		}
	}

	private function ShouldNotListenBackToClick() : Bool
	{
		return ( m_hasNoData || m_isInWarningDataState ) || m_isWaitingForData;
	}

	public function SetWaitingForModDataState()
	{
		var spinLoadingController : LoadingScreenProgressBarController;
		inkWidgetRef.SetVisible( m_waitingForDataWidget, true );
		spinLoadingController = ( ( LoadingScreenProgressBarController )( inkWidgetRef.GetController( m_waitingForDataLoadingSpinner ) ) );
		spinLoadingController.SetSpinnerVisibility( true );
		m_isWaitingForData = true;
		ApplyDefaultColor();
		UnregisterFromCallback( 'OnRelease', m_ownerMenu, 'OnModClicked' );
	}

	public function RemoveWaitingForModDataState()
	{
		var spinLoadingController : LoadingScreenProgressBarController;
		inkWidgetRef.SetVisible( m_waitingForDataWidget, false );
		spinLoadingController = ( ( LoadingScreenProgressBarController )( inkWidgetRef.GetController( m_waitingForDataLoadingSpinner ) ) );
		spinLoadingController.SetSpinnerVisibility( false );
		m_isWaitingForData = false;
	}

	public function SetEmptyDataState()
	{
		RemoveWaitingForModDataState();
		inkWidgetRef.SetVisible( m_emptyDataWidget, true );
		UnregisterFromCallback( 'OnRelease', m_ownerMenu, 'OnModClicked' );
		ResetData();
		ApplyUnselectedColor();
	}

	public function RemoveEmptyDataState()
	{
		inkWidgetRef.SetVisible( m_emptyDataWidget, false );
		m_hasNoData = false;
		if( !( ShouldNotListenBackToClick() ) )
		{
			RegisterToCallback( 'OnRelease', m_ownerMenu, 'OnModClicked' );
		}
	}

	public function SetWarningDataState()
	{
		RemoveWaitingForModDataState();
		inkWidgetRef.SetVisible( m_warningErrorWidget, true );
		UnregisterFromCallback( 'OnRelease', m_ownerMenu, 'OnModClicked' );
		ApplyUnselectedColor();
		m_isInWarningDataState = true;
	}

	public function RemoveWarningDataState()
	{
		inkWidgetRef.SetVisible( m_warningErrorWidget, false );
		m_isInWarningDataState = false;
		if( !( ShouldNotListenBackToClick() ) )
		{
			RegisterToCallback( 'OnRelease', m_ownerMenu, 'OnModClicked' );
		}
	}

	private function ApplyDefaultColor()
	{
		ApplyColorToItem( m_colorNames.activeRedName );
		inkImageRef.Get( m_entryOutlineImage ).BindProperty( 'tintColor', m_colorNames.darkerRedName );
		ApplyColorToBackground( m_colorNames.fullscreenRedDarkBackgroundName );
	}

	private function ApplySubscribedColor()
	{
		ApplyColorToItem( m_colorNames.yellowName );
		inkImageRef.Get( m_entryOutlineImage ).BindProperty( 'tintColor', m_colorNames.mildYellowName );
		ApplyColorToBackground( m_colorNames.panelDarkYellowName );
	}

	public function ApplyUnselectedColor()
	{
		if( m_isUserSubscribedToMod )
		{
			ApplySubscribedColor();
		}
		else
		{
			ApplyDefaultColor();
		}
	}

	public function ApplySelectedColor()
	{
		ApplyColorToItem( m_colorNames.activeBlueName );
		ApplyColorToBackground( m_colorNames.fullscreenPrimaryBackgroundDarkName );
	}

	private function ApplyColorToItem( colorNameToApply : CName )
	{
		inkTextRef.Get( m_modTitle ).BindProperty( 'tintColor', colorNameToApply );
		inkTextRef.Get( m_modNumberOfDownloadsText ).BindProperty( 'tintColor', colorNameToApply );
		inkImageRef.Get( m_modNumberOfDownloadsIcon ).BindProperty( 'tintColor', colorNameToApply );
		inkTextRef.Get( m_modNumberOfLikesText ).BindProperty( 'tintColor', colorNameToApply );
		inkImageRef.Get( m_modNumberOfLikesIcon ).BindProperty( 'tintColor', colorNameToApply );
		inkTextRef.Get( m_modSizeText ).BindProperty( 'tintColor', colorNameToApply );
		inkImageRef.Get( m_modSizeIcon ).BindProperty( 'tintColor', colorNameToApply );
		inkImageRef.Get( m_entryOutlineImage ).BindProperty( 'tintColor', colorNameToApply );
		inkWidgetRef.Get( m_hoverHighlightCanvas ).BindProperty( 'tintColor', colorNameToApply );
		inkTextRef.Get( m_downloadText ).BindProperty( 'tintColor', colorNameToApply );
		inkWidgetRef.Get( m_downloadBarFillIcon ).BindProperty( 'tintColor', colorNameToApply );
		inkWidgetRef.Get( m_downloadBarOutlineIcon ).BindProperty( 'tintColor', colorNameToApply );
	}

	private function ApplyColorToBackground( colorNameToApply : CName )
	{
		inkImageRef.Get( m_backgroundColorImage ).BindProperty( 'tintColor', colorNameToApply );
	}

	public function RemoveNewModIcon()
	{
		inkWidgetRef.SetVisible( m_newModWidget, false );
	}

	public function HandleScreenshotRequest()
	{
		m_numberOfScreenshotRequests = m_numberOfScreenshotRequests + 1;
		ShowLogoLoadingIcon();
	}

	protected event OnScreenshotLoadedByPath( screenshotSize : Vector2, errorCode : Int32 )
	{
		m_numberOfScreenshotRequests = ( ( m_numberOfScreenshotRequests > 0 ) ? ( m_numberOfScreenshotRequests - 1 ) : ( 0 ) );
		if( ( errorCode == 0 ) && ( m_numberOfScreenshotRequests == 0 ) )
		{
			ShowLogoImage();
		}
		else if( errorCode != 0 )
		{
			ShowLogoErrorIcon();
		}
	}

	public function GetLogoWidget() : inkImage
	{
		return ( ( inkImage )( inkImageRef.Get( m_modLogoWidget ) ) );
	}

	public function ShowLogoImage()
	{
		var spinLoadingController : LoadingScreenProgressBarController;
		inkWidgetRef.SetVisible( m_logoLoadingWidget, false );
		inkWidgetRef.SetVisible( m_logoLoadingSpinner, false );
		spinLoadingController = ( ( LoadingScreenProgressBarController )( inkWidgetRef.GetController( m_logoLoadingSpinner ) ) );
		spinLoadingController.SetSpinnerVisibility( false );
		inkImageRef.SetVisible( m_logoLoading_bg, false );
		inkImageRef.SetVisible( m_modLogoWidget, true );
		inkImageRef.SetVisible( m_logoErrorWidget, false );
	}

	public function ShowLogoLoadingIcon()
	{
		var spinLoadingController : LoadingScreenProgressBarController;
		inkWidgetRef.SetVisible( m_logoLoadingWidget, true );
		inkWidgetRef.SetVisible( m_logoLoadingSpinner, true );
		spinLoadingController = ( ( LoadingScreenProgressBarController )( inkWidgetRef.GetController( m_logoLoadingSpinner ) ) );
		spinLoadingController.SetSpinnerVisibility( true );
		inkImageRef.SetVisible( m_logoLoading_bg, true );
		inkImageRef.SetVisible( m_modLogoWidget, false );
		inkImageRef.SetVisible( m_logoErrorWidget, false );
	}

	public function ShowLogoErrorIcon()
	{
		var spinLoadingController : LoadingScreenProgressBarController;
		inkWidgetRef.SetVisible( m_logoLoadingWidget, false );
		inkWidgetRef.SetVisible( m_logoLoadingSpinner, false );
		spinLoadingController = ( ( LoadingScreenProgressBarController )( inkWidgetRef.GetController( m_logoLoadingSpinner ) ) );
		spinLoadingController.SetSpinnerVisibility( true );
		inkImageRef.SetVisible( m_logoLoading_bg, false );
		inkImageRef.SetVisible( m_modLogoWidget, false );
		inkImageRef.SetVisible( m_logoErrorWidget, true );
	}

}

class filterModsMenuModPicker extends inkLogicController
{
	private editable var m_filterIconList : inkHorizontalPanelRef;
	private var m_ownerMenu : weak< BrowserModsMenuGameController >;

	public function DisplayFilters( inOwnerMenu : BrowserModsMenuGameController )
	{
		var i : Int32;
		var currentFilterIcon : inkWidget;
		var currentFilterIconController : FilterIconItem;
		m_ownerMenu = inOwnerMenu;
		for( i = 0; i < ( ( Int32 )( inkModioFilterTags.MAX ) ); i += 1 )
		{
			currentFilterIcon = SpawnFromLocal( inkHorizontalPanelRef.Get( m_filterIconList ), 'FilterIconItem' );
			currentFilterIconController = ( ( FilterIconItem )( currentFilterIcon.GetController() ) );
			currentFilterIconController.SetupFilterItem( ( ( inkModioFilterTags )( i ) ), m_ownerMenu );
			currentFilterIconController.RegisterToCallback( 'OnHoverOver', m_ownerMenu, 'OnFilterHoverOver' );
			currentFilterIconController.RegisterToCallback( 'OnHoverOut', m_ownerMenu, 'OnFilterHoverOut' );
		}
	}

}

class FilterIconItem extends AnimatedListItemController
{
	private editable var m_iconImage : inkImageRef;
	private editable var m_fluffText : inkTextRef;
	private editable var m_frameImage : inkImageRef;
	private editable var m_backgroundImage : inkImageRef;
	private editable var m_tooltipSnapPoint : inkCompoundRef;
	private var m_isSelected : Bool;
	private var m_filterTag : inkModioFilterTags;
	private var m_filterTagName : String;
	private var m_currentTexturePart : CName;
	private var m_colorNames : ModsMenuColorsNames;
	private var m_tooltipWidget : weak< inkWidget >;
	private var m_tooltipController : weak< ModioToolTipController >;
	private var m_ownerMenu : weak< BrowserModsMenuGameController >;

	private function GetTexturePartFromFilterTag( inTexturePart : inkModioFilterTags ) : CName
	{
		var texturePart : CName;
		switch( inTexturePart )
		{
			case inkModioFilterTags.Appearance:
				texturePart = 'Clothes';
			break;
			case inkModioFilterTags.Characters:
				texturePart = 'Person';
			break;
			case inkModioFilterTags.Weapons:
				texturePart = 'Gun';
			break;
			case inkModioFilterTags.Vehicles:
				texturePart = 'Motorbike';
			break;
			case inkModioFilterTags.Animations:
				texturePart = 'Objects';
			break;
			case inkModioFilterTags.Gameplay:
				texturePart = 'Gamepad';
			break;
			case inkModioFilterTags.Graphics:
				texturePart = 'Photo';
			break;
			case inkModioFilterTags.Audio:
				texturePart = 'Sound';
			break;
			case inkModioFilterTags.Misc:
				texturePart = 'all';
			break;
			default:
				texturePart = 'Warning';
			break;
		}
		return texturePart;
	}

	protected event OnInitialize()
	{
		m_isSelected = false;
		SetUnselectedColor();
		RegisterToCallback( 'OnHoverOver', this, 'OnHoverOver' );
		RegisterToCallback( 'OnHoverOut', this, 'OnHoverOut' );
		RegisterToCallback( 'OnRelease', this, 'OnRelease' );
		super.OnInitialize();
	}

	protected event OnUninitialize()
	{
		UnregisterFromCallback( 'OnHoverOver', this, 'OnHoverOver' );
		UnregisterFromCallback( 'OnHoverOut', this, 'OnHoverOut' );
		UnregisterFromCallback( 'OnRelease', this, 'OnRelease' );
		super.OnUninitialize();
	}

	protected event OnHoverOver( e : inkPointerEvent )
	{
		if( !( m_isSelected ) && !( m_ownerMenu.ShouldIgnoreInput() ) )
		{
			inkImageRef.Get( m_frameImage ).BindProperty( 'tintColor', m_colorNames.redName );
		}
	}

	protected event OnHoverOut( e : inkPointerEvent )
	{
		if( m_ownerMenu.ShouldIgnoreInput() )
		{
			return true;
		}
		if( m_isSelected )
		{
			SetSelectedColor();
		}
		else
		{
			SetUnselectedColor();
		}
	}

	protected event OnRelease( e : inkPointerEvent )
	{
		if( e.IsAction( 'click' ) || e.IsAction( 'tap' ) )
		{
			PlaySound( 'Button', 'OnPress' );
			m_isSelected = !( m_isSelected );
			if( !( m_isSelected ) )
			{
				SetUnselectedColor();
			}
			else
			{
				SetSelectedColor();
			}
			m_ownerMenu.UpdateCurrentlySelectedFilters( m_filterTag );
		}
	}

	private function SetSelectedColor()
	{
		inkImageRef.Get( m_iconImage ).BindProperty( 'tintColor', m_colorNames.activeBlueName );
		inkImageRef.Get( m_frameImage ).BindProperty( 'tintColor', m_colorNames.darkBlueName );
		inkTextRef.Get( m_fluffText ).BindProperty( 'tintColor', m_colorNames.darkBlueName );
		inkImageRef.Get( m_backgroundImage ).BindProperty( 'tintColor', m_colorNames.faintBlueName );
	}

	private function SetUnselectedColor()
	{
		inkImageRef.Get( m_iconImage ).BindProperty( 'tintColor', m_colorNames.activeRedName );
		inkImageRef.Get( m_frameImage ).BindProperty( 'tintColor', m_colorNames.mildRedName );
		inkTextRef.Get( m_fluffText ).BindProperty( 'tintColor', m_colorNames.mildRedName );
		inkImageRef.Get( m_backgroundImage ).BindProperty( 'tintColor', m_colorNames.fullscreenRedDarkBackgroundName );
	}

	public function SetupFilterItem( inFilterTag : inkModioFilterTags, inOwnerMenu : BrowserModsMenuGameController )
	{
		m_ownerMenu = inOwnerMenu;
		m_filterTag = inFilterTag;
		m_filterTagName = m_ownerMenu.GetFilterTagNameFromEnum( m_filterTag );
		inkImageRef.SetTexturePart( m_iconImage, GetTexturePartFromFilterTag( inFilterTag ) );
		m_ownerMenu.AddToListOfNavigables( this );
	}

	public function GetFilterName() : String
	{
		return m_filterTagName;
	}

	public function GetLocalizedFilterKey() : String
	{
		var resultString : String;
		switch( m_filterTag )
		{
			case inkModioFilterTags.Appearance:
				resultString = "UI-Modio-FiltersSorting-Appearance";
			break;
			case inkModioFilterTags.Characters:
				resultString = "UI-Modio-FiltersSorting-Characters";
			break;
			case inkModioFilterTags.Weapons:
				resultString = "UI-Modio-FiltersSorting-Weapons";
			break;
			case inkModioFilterTags.Vehicles:
				resultString = "UI-Modio-FiltersSorting-Vehicles";
			break;
			case inkModioFilterTags.Animations:
				resultString = "UI-Modio-FiltersSorting-Animations";
			break;
			case inkModioFilterTags.Gameplay:
				resultString = "UI-Modio-FiltersSorting-Gameplay";
			break;
			case inkModioFilterTags.Graphics:
				resultString = "UI-Modio-FiltersSorting-Graphics";
			break;
			case inkModioFilterTags.Audio:
				resultString = "UI-Modio-FiltersSorting-Audio";
			break;
			case inkModioFilterTags.Misc:
				resultString = "UI-Modio-FiltersSorting-Misc";
			break;
			default:
				resultString = "Error";
			break;
		}
		return resultString;
	}

}

