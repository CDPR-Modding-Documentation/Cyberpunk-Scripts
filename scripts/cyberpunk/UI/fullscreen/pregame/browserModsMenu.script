	protected event OnInitialize()
	{
		var leftCarouselArrowController : weak< CarouselArrowController >;
		var rightCarouselArrowController : weak< CarouselArrowController >;
		var mainCarouselImageController : weak< ModioGalleryPreviewImageController >;
		var animOptions : inkAnimOptions;
		mainCarouselImageController = ( ( ModioGalleryPreviewImageController )( inkWidgetRef.GetController( m_mainCarouselImageController ) ) );
		mainCarouselImageController.Setup( this );
		leftCarouselArrowController = ( ( CarouselArrowController )( inkWidgetRef.GetController( m_leftCarouselArrow ) ) );
		leftCarouselArrowController.InitializeCarouselArrow( true, this );
		rightCarouselArrowController = ( ( CarouselArrowController )( inkWidgetRef.GetController( m_rightCarouselArrow ) ) );
		rightCarouselArrowController.InitializeCarouselArrow( false, this );
		animOptions.playReversed = false;
		animOptions.loopType = inkanimLoopType.Cycle;
		animOptions.loopInfinite = true;
		PlayLibraryAnimation( 'Loading_ModDetails', animOptions );
		SetLoadingDataState();
		m_scrollController = ( ( inkScrollController )( inkWidgetRef.GetController( m_scrollWidgetRef ) ) );
		m_bIsModEnabled = false;
		m_isToggleHovered = false;
		m_numberOfScreenshotRequestsForMainImage = 0;
		m_numberOfScreenshotRequestsForLeftImage = 0;
		m_numberOfScreenshotRequestsForRightImage = 0;
		RegisterToCallback( 'OnRelease', this, 'OnRelease' );
		m_enableDisableToggleNavController = ( ( inkDiscreteNavigationController )( inkWidgetRef.GetController( m_enableDisableToggleWidget ) ) );
		m_enableDisableToggleNavController.OverrideNavigation( inkDiscreteNavigationDirection.Up, inkWidgetRef.Get( m_subscriptionButton ) );
		inkWidgetRef.RegisterToCallback( m_enableDisableToggleWidget, 'OnRelease', this, 'OnEnableDisableToggleClicked' );
		inkWidgetRef.RegisterToCallback( m_enableDisableToggleWidget, 'OnHoverOver', this, 'OnEnableDisableToggleHoverOver' );
		inkWidgetRef.RegisterToCallback( m_enableDisableToggleWidget, 'OnHoverOut', this, 'OnEnableDisableToggleHoverOut' );
	}

	protected event OnUninitialize()
	{
		UnregisterFromCallback( 'OnRelease', this, 'OnRelease' );
		inkWidgetRef.UnregisterFromCallback( m_enableDisableToggleWidget, 'OnRelease', this, 'OnEnableDisableToggleClicked' );
		inkWidgetRef.UnregisterFromCallback( m_enableDisableToggleWidget, 'OnHoverOver', this, 'OnEnableDisableToggleHoverOver' );
		inkWidgetRef.UnregisterFromCallback( m_enableDisableToggleWidget, 'OnHoverOut', this, 'OnEnableDisableToggleHoverOut' );
	}

	protected event OnEnableDisableToggleClicked( evt : inkPointerEvent )
	{
		if( !( m_moreOptionsDropdownListController.IsOpened() ) )
		{
			if( evt.IsAction( 'click' ) || evt.IsAction( 'tap' ) )
			{
				PlaySound( 'Button', 'OnPress' );
				m_ownerMenu.EnableOrDisableCurrentlyFocusedMod();
			}
		}
	}

	protected event OnEnableDisableToggleHoverOver( evt : inkPointerEvent )
	{
		if( !( m_moreOptionsDropdownListController.IsOpened() ) && !( m_ownerMenu.ShouldIgnoreInput() ) )
		{
			inkWidgetRef.Get( m_enableDisableToggleGradient ).BindProperty( 'tintColor', m_colorNames.fullscreenPrimaryBackgroundDarkName );
			inkWidgetRef.Get( m_enableDisableToggleGradient ).BindProperty( 'opacity', 'MiniMapStyle.ExteriorWallOpacity' );
			inkWidgetRef.Get( m_enableDisableToggleUpperLine ).BindProperty( 'tintColor', m_colorNames.mildBlueName );
			inkWidgetRef.Get( m_enableDisableToggleBottomLine ).BindProperty( 'tintColor', m_colorNames.mildBlueName );
			m_ownerMenu.DisplayTooltipOnEnableDisableToggle( m_bIsModEnabled, inkWidgetRef.Get( m_enableDisableToggleWidget ) );
			m_isToggleHovered = true;
		}
	}

	protected event OnEnableDisableToggleHoverOut( evt : inkPointerEvent )
	{
		inkWidgetRef.Get( m_enableDisableToggleGradient ).BindProperty( 'tintColor', m_colorNames.darkRedName );
		inkWidgetRef.Get( m_enableDisableToggleGradient ).BindProperty( 'opacity', 'Briefings.BackgroundOpacity' );
		inkWidgetRef.Get( m_enableDisableToggleUpperLine ).BindProperty( 'tintColor', m_colorNames.darkerRedName );
		inkWidgetRef.Get( m_enableDisableToggleBottomLine ).BindProperty( 'tintColor', m_colorNames.darkerRedName );
		m_ownerMenu.HideTooltips();
		m_isToggleHovered = false;
	}

	public function SetLoadingDataState()
	{
		inkWidgetRef.Get( m_topEmptyPreviewImage ).BindProperty( 'tintColor', m_colorNames.mildRedName );
		inkWidgetRef.Get( m_middleEmptyPreviewImage ).BindProperty( 'tintColor', m_colorNames.mildRedName );
		inkWidgetRef.Get( m_lineEmptyPreviewImage ).BindProperty( 'tintColor', m_colorNames.mildRedName );
		inkWidgetRef.Get( m_bottomEmptyPreviewImage ).BindProperty( 'tintColor', m_colorNames.mildRedName );
		inkWidgetRef.Get( m_buttonEmptyPreviewImage ).BindProperty( 'tintColor', m_colorNames.mildRedName );
		inkWidgetRef.Get( m_infoTitleEmptyPreviewImage ).BindProperty( 'tintColor', m_colorNames.mildRedName );
		inkWidgetRef.Get( m_infoDescEmptyPreviewImage ).BindProperty( 'tintColor', m_colorNames.mildRedName );
		inkWidgetRef.SetOpacity( m_emptyPreviewCanvas, 0.2 );
		inkWidgetRef.SetVisible( m_emptyPreviewCanvas, true );
		inkWidgetRef.SetVisible( m_emptyAnimationWidget, true );
		inkWidgetRef.SetVisible( m_modDetailsContent, false );
	}

	public function RemoveLoadingDataState()
	{
		inkWidgetRef.SetVisible( m_emptyPreviewCanvas, false );
		inkWidgetRef.SetVisible( m_emptyAnimationWidget, false );
		inkWidgetRef.SetVisible( m_modDetailsContent, true );
	}

	public function SetEmptyDataState()
	{
		RemoveLoadingDataState();
		inkWidgetRef.Get( m_topEmptyPreviewImage ).BindProperty( 'tintColor', m_colorNames.mildRedName );
		inkWidgetRef.Get( m_middleEmptyPreviewImage ).BindProperty( 'tintColor', m_colorNames.mildRedName );
		inkWidgetRef.Get( m_lineEmptyPreviewImage ).BindProperty( 'tintColor', m_colorNames.mildRedName );
		inkWidgetRef.Get( m_bottomEmptyPreviewImage ).BindProperty( 'tintColor', m_colorNames.mildRedName );
		inkWidgetRef.Get( m_buttonEmptyPreviewImage ).BindProperty( 'tintColor', m_colorNames.mildRedName );
		inkWidgetRef.Get( m_infoTitleEmptyPreviewImage ).BindProperty( 'tintColor', m_colorNames.mildRedName );
		inkWidgetRef.Get( m_infoDescEmptyPreviewImage ).BindProperty( 'tintColor', m_colorNames.mildRedName );
		inkWidgetRef.SetOpacity( m_emptyPreviewCanvas, 0.2 );
		inkWidgetRef.SetVisible( m_emptyPreviewCanvas, true );
		inkWidgetRef.SetVisible( m_modDetailsContent, false );
	}

	public function DeactivateNavigation()
	{
		m_ownerMenu.DeactivateNavigation();
	}

	private function RemoveEmptyDataState()
	{
		inkWidgetRef.SetVisible( m_emptyPreviewCanvas, false );
		inkWidgetRef.SetVisible( m_modDetailsContent, true );
	}

	public function SetOwnerMenu( inOwnerMenu : weak< BrowserModsMenuGameController > )
	{
		var leftArrowNavController : AnimatedListItemController;
		var rightArrowNavController : AnimatedListItemController;
		var mainCarouselImageController : weak< ModioGalleryPreviewImageController >;
		m_ownerMenu = inOwnerMenu;
		mainCarouselImageController = ( ( ModioGalleryPreviewImageController )( inkWidgetRef.GetController( m_mainCarouselImageController ) ) );
		mainCarouselImageController.SetOwnerMenu( m_ownerMenu );
		leftArrowNavController = ( ( AnimatedListItemController )( inkWidgetRef.GetControllerByType( m_leftCarouselArrow, 'AnimatedListItemController' ) ) );
		rightArrowNavController = ( ( AnimatedListItemController )( inkWidgetRef.GetControllerByType( m_rightCarouselArrow, 'AnimatedListItemController' ) ) );
		m_ownerMenu.AddToListOfNavigables( leftArrowNavController );
		m_ownerMenu.AddToListOfNavigables( rightArrowNavController );
		m_ownerMenu.AddToListOfNavigables( m_enableDisableToggleNavController );
	}

	public function InitializeModDetails( inModInfo : ModioModInfos, inSystemHandler : weak< inkISystemRequestsHandler >, inRemainingSpaceOnDisk : Uint64, inRemainingSpaceOnDiskFormattedText : String )
	{
		var i : Int32;
		var currentTag : weak< TagWidgetItem >;
		var platformName : String;
		var bSupportedPlatform : Bool;
		ResetCarouselState();
		m_systemHandler = inSystemHandler;
		if( inModInfo.id != 0 )
		{
			m_carouselSize = inModInfo.gallerySize;
			for( i = 0; i < m_carouselSize; i += 1 )
			{
				m_carouselImagePaths.PushBack( "" );
			}
			m_bIsModEnabled = inModInfo.bIsModEnabledForUser;
			inkTextRef.SetText( m_modName, inModInfo.name );
			inkTextRef.SetText( m_modAuthorName, inModInfo.authorName );
			platformName = GetPlatformShortName();
			bSupportedPlatform = ( ( platformName == "ps5" || platformName == "ps5pro" ) || platformName == "xseriesx" ) || platformName == "xseriess";
			if( inModInfo.authorLinkedAccountName != "" && bSupportedPlatform )
			{
				inkTextRef.SetVisible( m_modAuthorLinkedAccountName, true );
				inkWidgetRef.SetVisible( m_modPlatformSeparator, true );
				inkTextRef.SetVisible( m_platformText, true );
				inkTextRef.SetText( m_modAuthorLinkedAccountName, inModInfo.authorLinkedAccountName );
				if( platformName == "ps5" || platformName == "ps5pro" )
				{
					inkTextRef.SetText( m_platformText, GetLocalizedText( "UI-Modio-MenuContent-CreatorIDPS5" ) );
				}
				else if( platformName == "xseriesx" || platformName == "xseriess" )
				{
					inkTextRef.SetText( m_platformText, GetLocalizedText( "UI-Modio-MenuContent-CreatorIDXbox" ) );
				}
			}
			else
			{
				inkTextRef.SetVisible( m_modAuthorLinkedAccountName, false );
				inkWidgetRef.SetVisible( m_modPlatformSeparator, false );
				inkTextRef.SetVisible( m_platformText, false );
			}
			inkTextRef.SetText( m_summary, inModInfo.summary );
			inkTextRef.SetText( m_description, inModInfo.description );
			inkTextRef.SetText( m_changelog, inModInfo.changelog );
			inkTextRef.SetText( m_numberOfLikesText, ( ( String )( inModInfo.rating ) ) );
			inkTextRef.SetText( m_modNumberOfDownloadsText, ( ( String )( inModInfo.downloadsTotal ) ) );
			inkTextRef.SetText( m_modSizeText, m_ownerMenu.FormatByteSizeToReadableSize( inModInfo.size ) );
			m_isModTooBigToInstall = inModInfo.size > inRemainingSpaceOnDisk;
			inkImageRef.SetVisible( m_modTooBigIcon, ShouldPreventSubscribing( inModInfo.bIsUserSubscribedToMod ) );
			inkCompoundRef.RemoveAllChildren( m_tagsGridWidgetRef );
			m_tagsItemArray.Clear();
			for( i = 0; i < inModInfo.localizedTags.Size(); i += 1 )
			{
				currentTag = ( ( TagWidgetItem )( SpawnFromLocal( inkCompoundRef.Get( m_tagsGridWidgetRef ), 'TagWidgetItem' ).GetController() ) );
				currentTag.SetTagName( inModInfo.localizedTags[ i ] );
				m_tagsItemArray.PushBack( currentTag );
			}
			m_scrollController.SetScrollPosition( 0.0 );
			UpdateEnableDisableToggleDisplay( m_ownerMenu.GetIsSelectedModInstalled(), inModInfo.bIsModEnabledForUser );
			SetupDropdown();
			ToggleMainCarouselImage( 0 );
			RemoveLoadingDataState();
		}
		else
		{
			SetEmptyDataState();
		}
		m_ownerMenu.RequestModDetailsUpdateNextFrame();
	}

	public function SetScrollbarEnable( bEnable : Bool )
	{
		m_scrollController.SetEnabled( bEnable );
	}

	private function UpdateEnableDisableToggleDisplay( bIsUserSubscribedToMod : Bool, bIsModEnabledForUser : Bool )
	{
		if( m_enableDisableToggleAnimProxy != NULL )
		{
			m_enableDisableToggleAnimProxy.GotoEndAndStop();
			m_enableDisableToggleAnimProxy.UnregisterFromCallback( inkanimEventType.OnFinish, this, 'OnEnableDisableToggleFinished' );
			m_enableDisableToggleAnimProxy = NULL;
		}
		if( bIsUserSubscribedToMod )
		{
			inkWidgetRef.SetVisible( m_enableDisableToggleWidget, true );
			inkTextRef.SetText( m_enableDisableToggleText, GetLocalizedText( ( ( bIsModEnabledForUser ) ? ( "UI-Modio-MenuContent-Enabled" ) : ( "UI-Modio-MenuContent-Disabled" ) ) ) );
			PlayLibraryAnimation( ( ( bIsModEnabledForUser ) ? ( 'Toggle_On' ) : ( 'Toggle_Off' ) ) );
		}
		else
		{
			inkWidgetRef.SetVisible( m_enableDisableToggleWidget, false );
		}
	}

	public function PlayEnableDisableToggleTransitionAnimationIfNeeded( bModIsSubscribed : Bool, bFromDisableToEnable : Bool )
	{
		var animNameToPlay : CName;
		if( !( bModIsSubscribed ) )
		{
			inkWidgetRef.SetVisible( m_enableDisableToggleWidget, false );
			if( m_enableDisableToggleAnimProxy != NULL )
			{
				m_enableDisableToggleAnimProxy.GotoEndAndStop();
				m_enableDisableToggleAnimProxy.UnregisterFromCallback( inkanimEventType.OnFinish, this, 'OnEnableDisableToggleFinished' );
				m_enableDisableToggleAnimProxy = NULL;
			}
			return;
		}
		if( m_bIsModEnabled != bFromDisableToEnable )
		{
			m_bIsModEnabled = bFromDisableToEnable;
			inkWidgetRef.SetVisible( m_enableDisableToggleWidget, true );
			animNameToPlay = ( ( bFromDisableToEnable ) ? ( 'Toggle_OfftoOn' ) : ( 'Toggle_OntoOff' ) );
			inkTextRef.SetText( m_enableDisableToggleText, GetLocalizedText( ( ( bFromDisableToEnable ) ? ( "UI-Modio-MenuContent-Enabled" ) : ( "UI-Modio-MenuContent-Disabled" ) ) ) );
			if( m_enableDisableToggleAnimProxy != NULL )
			{
				m_enableDisableToggleAnimProxy.GotoEndAndStop();
				m_enableDisableToggleAnimProxy.UnregisterFromCallback( inkanimEventType.OnFinish, this, 'OnEnableDisableToggleFinished' );
			}
			m_enableDisableToggleAnimProxy = PlayLibraryAnimation( animNameToPlay );
			m_enableDisableToggleAnimProxy.RegisterToCallback( inkanimEventType.OnFinish, this, 'OnEnableDisableToggleFinished' );
		}
	}

	protected event OnEnableDisableToggleFinished( anim : inkAnimProxy )
	{
		if( m_enableDisableToggleAnimProxy != NULL )
		{
			m_enableDisableToggleAnimProxy.UnregisterFromCallback( inkanimEventType.OnFinish, this, 'OnEnableDisableToggleFinished' );
			m_enableDisableToggleAnimProxy = NULL;
			if( m_isToggleHovered )
			{
				m_ownerMenu.DisplayTooltipOnEnableDisableToggle( m_bIsModEnabled, inkWidgetRef.Get( m_enableDisableToggleWidget ) );
			}
		}
	}

	public function EditPendingActivationOrDeactivationText( bIsModPendingActivationOrDeactivation : Bool, bIsModEnabled : Bool )
	{
		var textToDisplay : String;
		inkTextRef.SetVisible( m_pendingActivationOrDeactivationText, bIsModPendingActivationOrDeactivation );
		textToDisplay = ( ( bIsModEnabled ) ? ( GetLocalizedText( "UI-Modio-ErrorMessages-WarningPendingActive" ) ) : ( GetLocalizedText( "UI-Modio-ErrorMessages-WarningPendingDeactive" ) ) );
		inkTextRef.SetText( m_pendingActivationOrDeactivationText, textToDisplay );
	}

	public function AdjustCosmeticsForLikesAndDownloads( inModInfo : ModioModInfos )
	{
		var cosmeticNumberOfLikes : Int64;
		var cosmeticNumberOfDownloads : Int64;
		if( inModInfo.id != 0 )
		{
			cosmeticNumberOfLikes = inModInfo.rating + ( ( inModInfo.bIsUserLikingMod ) ? ( 1 ) : ( 0 ) );
			cosmeticNumberOfDownloads = inModInfo.downloadsTotal + m_ownerMenu.GetLocalNumberOfDownloadsForMod( inModInfo.id );
			inkTextRef.SetText( m_numberOfLikesText, ( ( String )( cosmeticNumberOfLikes ) ) );
			inkTextRef.SetText( m_modNumberOfDownloadsText, ( ( String )( cosmeticNumberOfDownloads ) ) );
		}
	}

	public function SetTagWidgetCorrectSize()
	{
		var i : Int32;
		for( i = 0; i < m_tagsItemArray.Size(); i += 1 )
		{
			m_tagsItemArray[ i ].SetCorrectSize();
		}
	}

	public function SetCorrectTimestampInfo( inTimeStamp : Int32 )
	{
		inkTextRef.SetText( m_lastUpdatedTimeText, "" );
		inkTextRef.SetDateTimeByTimestamp( m_lastUpdatedTimeText, ( ( Uint64 )( inTimeStamp ) ) );
	}

	public function ShouldPreventSubscribing( bIsUserSubscribedToMod : Bool ) : Bool
	{
		return m_isModTooBigToInstall && !( bIsUserSubscribedToMod );
	}

	public function GetMoreOptionDropdownButtonController() : MoreOptionsButtonController
	{
		return ( ( MoreOptionsButtonController )( inkWidgetRef.GetController( m_moreOptionsDropdownButtonManagerRef ) ) );
	}

	public function GetMoreOptionNaviagableController() : inkDiscreteNavigationController
	{
		return ( ( inkDiscreteNavigationController )( inkWidgetRef.GetControllerByType( m_moreOptionsDropdownButtonManagerRef, 'inkDiscreteNavigationController' ) ) );
	}

	private function SetupDropdown()
	{
		m_moreOptionsDropdownListController = ( ( MoreOptionsDropdownListController )( inkWidgetRef.GetController( m_moreOptionsDropdownListManagerRef ) ) );
		m_moreOptionsDropdownButtonController = ( ( MoreOptionsButtonController )( inkWidgetRef.GetController( m_moreOptionsDropdownButtonManagerRef ) ) );
		UpdateDropdownContext();
		m_moreOptionsDropdownButtonController.SetOwnerWidget( this );
	}

	private function UpdateDropdownContext()
	{
		m_moreOptionsDropdownListController.Setup( this, MoreOptionsDropdownData.GetMoreOptionsDropdownOptions(), m_moreOptionsDropdownButtonController );
		m_moreOptionsDropdownButtonController.SetData( MoreOptionsDropdownData.GetMoreOptionsDropdownOption( m_moreOptionsDropdownListController.GetData(), inkModioMoreOptions.More ) );
	}

	protected event OnMoreOptionsButtonClicked( evt : inkPointerEvent )
	{
		var controller : DropdownListController;
		if( evt.IsAction( 'click' ) || evt.IsAction( 'tap' ) )
		{
			PlaySound( 'Button', 'OnPress' );
			controller = ( ( DropdownListController )( m_moreOptionsDropdownListController.GetController() ) );
			controller.Toggle();
		}
	}

	protected event OnDropdownItemClickedEvent( evt : DropdownItemClickedEvent )
	{
		var moreOptionsIdentifier : inkModioMoreOptions;
		var moreOptionsButtonController : DropdownButtonController;
		var moreOptionsData : DropdownItemData;
		PlaySound( 'Button', 'OnPress' );
		moreOptionsIdentifier = ( ( inkModioMoreOptions )evt.identifier );
		moreOptionsData = MoreOptionsDropdownData.GetMoreOptionsDropdownOption( ( ( DropdownListController )( m_moreOptionsDropdownListController.GetController() ) ).GetData(), moreOptionsIdentifier );
		if( moreOptionsData )
		{
			moreOptionsButtonController = ( ( DropdownButtonController )( m_moreOptionsDropdownListController.GetController() ) );
			moreOptionsButtonController.SetData( moreOptionsData );
			ClickOnMoreOptionsButton( moreOptionsIdentifier );
		}
	}

	private function ClickOnMoreOptionsButton( option : inkModioMoreOptions )
	{
		switch( option )
		{
			case inkModioMoreOptions.HideAuthor:
				AskIfReallyWantToMuteAuthor();
			break;
			case inkModioMoreOptions.HideMod:
				AskIfReallyWantToHideMod();
			break;
			case inkModioMoreOptions.Report:
				m_ownerMenu.OnReportClick();
			break;
		}
	}

	private function AskIfReallyWantToHideMod()
	{
		m_systemHandler.RequestSystemNotificationGenericYesNo( 'UI-Modio-MenuContent-HideMod', 'UI-Modio-ErrorMessages-WarningHiddenMod', this, 'OnHideModConfirmationPopupClosed' );
	}

	protected event OnHideModConfirmationPopupClosed( bAccepted : Bool )
	{
		if( bAccepted )
		{
			m_ownerMenu.HideModButtonClicked();
		}
		if( m_ownerMenu.IsUsingDPad() )
		{
			m_ownerMenu.FocusMoreOptionButton();
		}
		else
		{
			m_ownerMenu.ResetCursor();
		}
		PlaySound( 'Button', 'OnPress' );
	}

	private function AskIfReallyWantToMuteAuthor()
	{
		m_systemHandler.RequestSystemNotificationGenericYesNo( 'UI-Modio-MenuContent-HideAuthor', 'UI-Modio-ErrorMessages-WarningHiddenAuthor', this, 'OnMuteAuthorConfirmationPopupClosed' );
	}

	protected event OnMuteAuthorConfirmationPopupClosed( bAccepted : Bool )
	{
		if( bAccepted )
		{
			m_ownerMenu.MuteAuthorButtonClicked();
		}
		if( m_ownerMenu.IsUsingDPad() )
		{
			m_ownerMenu.FocusMoreOptionButton();
		}
		else
		{
			m_ownerMenu.ResetCursor();
		}
		PlaySound( 'Button', 'OnPress' );
	}

	public function GetMainCarousselImageRef() : inkWidget
	{
		return inkImageRef.Get( m_mainCarouselImage );
	}

	public function ToggleMainCarouselImage( inNumberOfImagesExpected : Int32 )
	{
		var mainCarouselImageController : weak< ModioGalleryPreviewImageController >;
		var bAtLeastOneImage : Bool;
		var bAtLeastTwoImages : Bool;
		bAtLeastOneImage = inNumberOfImagesExpected >= 1;
		bAtLeastTwoImages = inNumberOfImagesExpected >= 2;
		mainCarouselImageController = ( ( ModioGalleryPreviewImageController )( inkWidgetRef.GetController( m_mainCarouselImageController ) ) );
		mainCarouselImageController.SetNavigable( bAtLeastOneImage );
		inkWidgetRef.SetVisible( m_emptyMainCarouselImage, !( bAtLeastOneImage ) );
		inkWidgetRef.SetVisible( m_emptyLeftCarouselImage, !( bAtLeastOneImage ) );
		inkWidgetRef.SetVisible( m_emptyRightCarouselImage, !( bAtLeastOneImage ) );
		inkWidgetRef.SetVisible( m_leftCarouselArrow, bAtLeastTwoImages );
		inkWidgetRef.SetVisible( m_rightCarouselArrow, bAtLeastTwoImages );
		inkImageRef.SetVisible( m_mainCarouselImage, bAtLeastOneImage );
		inkImageRef.SetVisible( m_leftCarouselImage, bAtLeastOneImage );
		inkImageRef.SetVisible( m_rightCarouselImage, bAtLeastOneImage );
		inkTextRef.SetVisible( m_carouselText, bAtLeastOneImage );
		inkTextRef.SetVisible( m_carouselTextShadow, bAtLeastOneImage );
		if( bAtLeastOneImage )
		{
			mainCarouselImageController.OverrideNavigation( inkDiscreteNavigationDirection.Down, m_ownerMenu.GetSubscribeToModButtonRef() );
		}
	}

	private function DisplayAllCarouselLoadingPanels()
	{
		inkWidgetRef.SetVisible( m_mainCarouselLoadingPanel, true );
		GetPrimaryImageWidget().SetVisible( false );
		inkWidgetRef.SetVisible( m_leftCarouselLoadingPanel, true );
		GetLeftImageWidget().SetVisible( false );
		inkWidgetRef.SetVisible( m_rightCarouselLoadingPanel, true );
		GetRightImageWidget().SetVisible( false );
	}

	public function ReceiveNewGalleryIntent( inImageIndex : Int32 )
	{
		if( inImageIndex == m_currentCarouselIndex )
		{
			inkWidgetRef.SetVisible( m_mainCarouselLoadingPanel, true );
			GetPrimaryImageWidget().SetVisible( false );
		}
		else if( inImageIndex == GetPreviousCarouselIndex() )
		{
			inkWidgetRef.SetVisible( m_leftCarouselLoadingPanel, true );
			GetLeftImageWidget().SetVisible( false );
		}
		else if( inImageIndex == GetNextCarouselIndex() )
		{
			inkWidgetRef.SetVisible( m_rightCarouselLoadingPanel, true );
			GetRightImageWidget().SetVisible( false );
		}
	}

	public function ReceiveNewGalleryImage( inImageIndex : Int32, inImagePath : String )
	{
		m_carouselImagePaths[ inImageIndex ] = inImagePath;
		UpdateImages();
	}

	private function UpdateImages()
	{
		ToggleMainCarouselImage( m_carouselImagePaths.Size() );
		DisplayAllCarouselLoadingPanels();
		m_numberOfScreenshotRequestsForMainImage = m_numberOfScreenshotRequestsForMainImage + 1;
		m_numberOfScreenshotRequestsForLeftImage = m_numberOfScreenshotRequestsForLeftImage + 1;
		m_numberOfScreenshotRequestsForRightImage = m_numberOfScreenshotRequestsForRightImage + 1;
		m_systemHandler.RequestGameScreenshotByPath( m_carouselImagePaths[ ( ( Int32 )( m_currentCarouselIndex ) ) ], GetPrimaryImageWidget(), this, 'OnScreenshotLoadedByPathOnCentralIndex' );
		m_systemHandler.RequestGameScreenshotByPath( m_carouselImagePaths[ ( ( Int32 )( GetPreviousCarouselIndex() ) ) ], GetLeftImageWidget(), this, 'OnScreenshotLoadedByPathOnLeftIndex' );
		m_systemHandler.RequestGameScreenshotByPath( m_carouselImagePaths[ ( ( Int32 )( GetNextCarouselIndex() ) ) ], GetRightImageWidget(), this, 'OnScreenshotLoadedByPathOnRightIndex' );
		inkTextRef.SetText( m_carouselText, ( IntToString( ( ( Int32 )( m_currentCarouselIndex ) ) + 1 ) + "/" ) + IntToString( ( ( Int32 )( m_carouselSize ) ) ) );
		inkTextRef.SetText( m_carouselTextShadow, ( IntToString( ( ( Int32 )( m_currentCarouselIndex ) ) + 1 ) + "/" ) + IntToString( ( ( Int32 )( m_carouselSize ) ) ) );
	}

	public function SetDefaultColor()
	{
		SetColor( m_colorNames.redName );
		SetPlatformInfoColor( m_colorNames.mildRedName );
	}

	public function SetSubscribedColor()
	{
		SetColor( m_colorNames.yellowName );
		SetPlatformInfoColor( m_colorNames.mildYellowName );
	}

	public function SetDisabledColor()
	{
		SetColor( m_colorNames.greyName );
		SetPlatformInfoColor( m_colorNames.darkerGreyName );
	}

	private function SetColor( colorName : CName )
	{
		inkTextRef.Get( m_modAuthorName ).BindProperty( 'tintColor', colorName );
		inkTextRef.Get( m_numberOfLikesText ).BindProperty( 'tintColor', colorName );
		inkImageRef.Get( m_numberOfLikesIcon ).BindProperty( 'tintColor', colorName );
		inkTextRef.Get( m_modNumberOfDownloadsText ).BindProperty( 'tintColor', colorName );
		inkImageRef.Get( m_modNumberOfDownloadsIcon ).BindProperty( 'tintColor', colorName );
		inkTextRef.Get( m_modSizeText ).BindProperty( 'tintColor', colorName );
		inkImageRef.Get( m_modSizeIcon ).BindProperty( 'tintColor', colorName );
		inkTextRef.Get( m_lastUpdatedTimeText ).BindProperty( 'tintColor', colorName );
		inkImageRef.Get( m_lastUpdatedTimeIcon ).BindProperty( 'tintColor', colorName );
		inkWidgetRef.Get( m_modPlatformSeparator ).BindProperty( 'tintColor', colorName );
		inkTextRef.Get( m_modAuthorLinkedAccountName ).BindProperty( 'tintColor', colorName );
	}

	private function SetPlatformInfoColor( colorName : CName )
	{
		inkImageRef.Get( m_modioIcon ).BindProperty( 'tintColor', colorName );
		inkTextRef.Get( m_modioText ).BindProperty( 'tintColor', colorName );
		inkTextRef.Get( m_platformText ).BindProperty( 'tintColor', colorName );
	}

	public function ApplyCorrectColor( bIsUserSubscribedToMod : Bool, bIsModDisabled : Bool )
	{
		if( !( bIsUserSubscribedToMod ) )
		{
			SetDefaultColor();
		}
		else if( bIsUserSubscribedToMod && !( bIsModDisabled ) )
		{
			SetSubscribedColor();
		}
		else if( bIsUserSubscribedToMod && bIsModDisabled )
		{
			SetDisabledColor();
		}
	}

	public function GetPrimaryImageWidget() : inkImage
	{
		return ( ( inkImage )( inkImageRef.Get( m_mainCarouselImage ) ) );
	}

	public function GetLeftImageWidget() : inkImage
	{
		return ( ( inkImage )( inkImageRef.Get( m_leftCarouselImage ) ) );
	}

	public function GetRightImageWidget() : inkImage
	{
		return ( ( inkImage )( inkImageRef.Get( m_rightCarouselImage ) ) );
	}

	public function GetCarouselCurrentIndex() : Int64
	{
		return m_currentCarouselIndex;
	}

	public function GetCarouselSize() : Int64
	{
		return m_carouselSize;
	}

	public function GetCarouselImagePaths() : array< String >
	{
		return m_carouselImagePaths;
	}

	public function ResetCarouselState()
	{
		m_currentCarouselIndex = 0;
		m_carouselImagePaths.Clear();
		inkWidgetRef.SetVisible( m_loadingFailedPanelWidget, false );
	}

	private function GetPreviousCarouselIndex() : Int64
	{
		return ( ( ( m_currentCarouselIndex - 1 ) < 0 ) ? ( m_carouselSize - 1 ) : ( m_currentCarouselIndex - 1 ) );
	}

	private function GetNextCarouselIndex() : Int64
	{
		return ( ( ( m_currentCarouselIndex + 1 ) >= m_carouselSize ) ? ( 0 ) : ( ( ( Int32 )m_currentCarouselIndex + 1 ) ) );
	}

	public function DisplayPreviousCarouselImage()
	{
		m_currentCarouselIndex = GetPreviousCarouselIndex();
		UpdateImages();
	}

	public function DisplayNextCarouselImage()
	{
		m_currentCarouselIndex = GetNextCarouselIndex();
		UpdateImages();
	}

	protected event OnScreenshotLoadedByPathOnCentralIndex( screenshotSize : Vector2, errorCode : Int32 )
	{
		m_numberOfScreenshotRequestsForMainImage = ( ( m_numberOfScreenshotRequestsForMainImage > 0 ) ? ( m_numberOfScreenshotRequestsForMainImage - 1 ) : ( 0 ) );
		if( ( errorCode == 0 ) && ( m_numberOfScreenshotRequestsForMainImage == 0 ) )
		{
			inkWidgetRef.SetVisible( m_mainCarouselLoadingPanel, false );
			inkWidgetRef.SetVisible( m_loadingFailedPanelWidget, false );
			if( m_carouselImagePaths.Size() > 0 )
			{
				GetPrimaryImageWidget().SetVisible( true );
			}
			else
			{
				inkWidgetRef.SetVisible( m_emptyMainCarouselImage, true );
			}
		}
		else if( ( errorCode != 0 ) && ( m_numberOfScreenshotRequestsForMainImage == 0 ) )
		{
			inkWidgetRef.SetVisible( m_mainCarouselLoadingPanel, false );
			inkWidgetRef.SetVisible( m_loadingFailedPanelWidget, true );
		}
	}

	protected event OnScreenshotLoadedByPathOnLeftIndex( screenshotSize : Vector2, errorCode : Int32 )
	{
		m_numberOfScreenshotRequestsForLeftImage = ( ( m_numberOfScreenshotRequestsForLeftImage > 0 ) ? ( m_numberOfScreenshotRequestsForLeftImage - 1 ) : ( 0 ) );
		if( ( errorCode == 0 ) && ( m_numberOfScreenshotRequestsForLeftImage == 0 ) )
		{
			inkWidgetRef.SetVisible( m_leftCarouselLoadingPanel, false );
			if( m_carouselImagePaths.Size() > 0 )
			{
				GetLeftImageWidget().SetVisible( true );
			}
			else
			{
				inkWidgetRef.SetVisible( m_emptyLeftCarouselImage, true );
			}
		}
		else if( ( errorCode != 0 ) && ( m_numberOfScreenshotRequestsForLeftImage == 0 ) )
		{
			inkWidgetRef.SetVisible( m_leftCarouselLoadingPanel, false );
			inkWidgetRef.SetVisible( m_emptyLeftCarouselImage, true );
		}
	}

	protected event OnScreenshotLoadedByPathOnRightIndex( screenshotSize : Vector2, errorCode : Int32 )
	{
		m_numberOfScreenshotRequestsForRightImage = ( ( m_numberOfScreenshotRequestsForRightImage > 0 ) ? ( m_numberOfScreenshotRequestsForRightImage - 1 ) : ( 0 ) );
		if( ( errorCode == 0 ) && ( m_numberOfScreenshotRequestsForRightImage == 0 ) )
		{
			inkWidgetRef.SetVisible( m_rightCarouselLoadingPanel, false );
			if( m_carouselImagePaths.Size() > 0 )
			{
				GetRightImageWidget().SetVisible( true );
			}
			else
			{
				inkWidgetRef.SetVisible( m_emptyRightCarouselImage, true );
			}
		}
		else if( ( errorCode != 0 ) && ( m_numberOfScreenshotRequestsForRightImage == 0 ) )
		{
			inkWidgetRef.SetVisible( m_rightCarouselLoadingPanel, false );
			inkWidgetRef.SetVisible( m_emptyRightCarouselImage, true );
		}
	}

}

class CarouselArrowController extends PaginationArrowController
{
	private var m_bIsLeftArrow : Bool;
	private var m_modDetailsItem : weak< ModDetailsItem >;

	protected event OnInitialize()
	{
		super.OnInitialize();
		RegisterToCallback( 'OnRelease', this, 'OnArrowClicked' );
	}

	protected event OnUninitialize()
	{
		super.OnUninitialize();
		UnregisterFromCallback( 'OnRelease', this, 'OnArrowClicked' );
	}

	public function InitializeCarouselArrow( bInIsLeftArrow : Bool, inModDetailsItem : weak< ModDetailsItem > )
	{
		m_bIsLeftArrow = bInIsLeftArrow;
		m_modDetailsItem = inModDetailsItem;
	}

	protected event OnArrowClicked( e : inkPointerEvent )
	{
		if( e.IsAction( 'click' ) || e.IsAction( 'tap' ) )
		{
			PlaySound( 'Button', 'OnPress' );
			if( m_bIsLeftArrow )
			{
				m_modDetailsItem.DisplayPreviousCarouselImage();
			}
			else
			{
				m_modDetailsItem.DisplayNextCarouselImage();
			}
		}
	}

}

class GenericModButtonController extends AnimatedListItemController
{
	protected editable var m_buttonText : inkTextRef;
	protected editable var m_buttonIcon : inkImageRef;
	protected editable var m_buttonCore : inkWidgetRef;
	protected editable var m_buttonBorder : inkWidgetRef;
	protected var m_ownerMenu : weak< BrowserModsMenuGameController >;
	protected var m_isForFunction : Bool;
	private var m_isSelected : Bool;
	private var m_colorNames : ModsMenuColorsNames;
	protected var m_isDisabled : Bool;
	protected var m_isHovered : Bool;

	protected event OnInitialize()
	{
		m_isHovered = false;
		RegisterToCallback( 'OnRelease', this, 'OnRelease' );
		RegisterToCallback( 'OnHoverOver', this, 'OnHoverOver' );
		RegisterToCallback( 'OnHoverOut', this, 'OnHoverOut' );
		super.OnInitialize();
	}

	protected event OnUninitialize()
	{
		UnregisterFromCallback( 'OnRelease', this, 'OnRelease' );
		UnregisterFromCallback( 'OnHoverOver', this, 'OnHoverOver' );
		UnregisterFromCallback( 'OnHoverOut', this, 'OnHoverOut' );
		super.OnUninitialize();
	}

	protected event OnHoverOver( e : inkPointerEvent )
	{
		m_isHovered = true;
		if( m_ownerMenu.ShouldIgnoreInput() )
		{
			return true;
		}
		if( !( m_isDisabled ) )
		{
			ApplyHoveredColor();
		}
	}

	protected event OnHoverOut( e : inkPointerEvent )
	{
		m_isHovered = false;
		if( m_ownerMenu.ShouldIgnoreInput() )
		{
			return true;
		}
		ApplyButtonColor( m_isSelected );
	}

	protected event OnRelease( e : inkPointerEvent )
	{
		if( e.IsAction( 'click' ) || e.IsAction( 'tap' ) )
		{
			PlaySound( 'Button', 'OnPress' );
		}
	}

	public virtual function SetIsDisabled( bInDisabled : Bool ) : Bool
	{
		var bChanged : Bool;
		bChanged = m_isDisabled != bInDisabled;
		m_isDisabled = bInDisabled;
		if( m_isDisabled && bChanged )
		{
			UnregisterFromCallback( 'OnRelease', this, 'OnRelease' );
		}
		else if( !( m_isDisabled ) && bChanged )
		{
			RegisterToCallback( 'OnRelease', this, 'OnRelease' );
		}
		return bChanged;
	}

	private function ApplyHoveredColor()
	{
		inkTextRef.Get( m_buttonText ).BindProperty( 'tintColor', m_colorNames.activeBlueName );
		inkImageRef.Get( m_buttonIcon ).BindProperty( 'tintColor', m_colorNames.activeBlueName );
		inkWidgetRef.Get( m_buttonCore ).BindProperty( 'tintColor', m_colorNames.fullscreenPrimaryBackgroundDarkName );
		inkWidgetRef.Get( m_buttonBorder ).BindProperty( 'tintColor', m_colorNames.mildBlueName );
	}

	private function ApplyButtonColor( bIsFunctionActivated : Bool )
	{
		if( bIsFunctionActivated )
		{
			inkTextRef.Get( m_buttonText ).BindProperty( 'tintColor', m_colorNames.activeRedName );
			inkImageRef.Get( m_buttonIcon ).BindProperty( 'tintColor', m_colorNames.activeRedName );
			inkWidgetRef.Get( m_buttonCore ).BindProperty( 'tintColor', m_colorNames.fullScreenSecondaryBackground3Name );
			inkWidgetRef.Get( m_buttonBorder ).BindProperty( 'tintColor', m_colorNames.activeRedName );
			m_isSelected = true;
		}
		else
		{
			inkTextRef.Get( m_buttonText ).BindProperty( 'tintColor', m_colorNames.activeRedName );
			inkImageRef.Get( m_buttonIcon ).BindProperty( 'tintColor', m_colorNames.activeRedName );
			inkWidgetRef.Get( m_buttonCore ).BindProperty( 'tintColor', m_colorNames.fullscreenRedDarkBackgroundName );
			inkWidgetRef.Get( m_buttonBorder ).BindProperty( 'tintColor', m_colorNames.darkerRedName );
			m_isSelected = false;
		}
		if( m_isDisabled )
		{
			inkTextRef.Get( m_buttonText ).BindProperty( 'tintColor', m_colorNames.panelDarkGreyName );
			inkImageRef.Get( m_buttonIcon ).BindProperty( 'tintColor', m_colorNames.panelDarkGreyName );
			inkWidgetRef.Get( m_buttonCore ).BindProperty( 'tintColor', m_colorNames.panelDarkestGreyName );
			inkWidgetRef.Get( m_buttonBorder ).BindProperty( 'tintColor', m_colorNames.panelDarkerGreyName );
		}
		else if( m_isHovered )
		{
			ApplyHoveredColor();
		}
	}

	public function SetGenericButtonInfo( bIsFunctionActivated : Bool )
	{
		ApplyButtonColor( bIsFunctionActivated );
	}

	public virtual function SetOwnerMenu( inMenu : BrowserModsMenuGameController )
	{
		m_ownerMenu = inMenu;
		m_ownerMenu.AddToListOfNavigables( this );
	}

}

class SubscribeToModButtonController extends GenericModButtonController
{
	private var m_isDeactivatedBecauseInPauseMenu : Bool;

	public override function SetOwnerMenu( inMenu : BrowserModsMenuGameController )
	{
		super.SetOwnerMenu( inMenu );
		m_isDeactivatedBecauseInPauseMenu = !( m_ownerMenu.IsPregame() );
	}

	protected event OnRelease( e : inkPointerEvent )
	{
		if( m_ownerMenu.ShouldIgnoreInput() )
		{
			return true;
		}
		super.OnRelease( e );
		if( e.IsAction( 'click' ) || e.IsAction( 'tap' ) )
		{
			if( !( m_isForFunction ) && m_ownerMenu.CanDisplayUninstallConfirmationPopup() )
			{
				AskIfUserReallyWantToUnsubscribe();
			}
			else
			{
				m_ownerMenu.SubscribeToModButtonClicked( m_isForFunction );
			}
		}
	}

	protected event OnReleaseWhileInPauseMenu( e : inkPointerEvent )
	{
		if( e.IsAction( 'click' ) || e.IsAction( 'tap' ) )
		{
			PlaySound( 'Button', 'OnPress' );
			m_ownerMenu.WarnAboutImpossibleActionInPauseMenu();
		}
	}

	private function AskIfUserReallyWantToUnsubscribe()
	{
		m_ownerMenu.AskIfUserReallyWantToUnsubscribe();
	}

	public function SetIsForSubscribe( bIsForSubscribe : Bool )
	{
		m_isForFunction = bIsForSubscribe;
	}

	public function GetIsForSubscribe() : Bool
	{
		return m_isForFunction;
	}

	public function SetIsDisabledForOutOfSpaceReason( bNotEnoughSpace : Bool )
	{
		var bChangedState : Bool;
		bChangedState = SetIsDisabled( bNotEnoughSpace );
		if( bNotEnoughSpace && bChangedState )
		{
			RegisterToCallback( 'OnHoverOver', m_ownerMenu, 'OnDisabledForOutOfSpaceSubscribeHoverOver' );
			RegisterToCallback( 'OnHoverOut', m_ownerMenu, 'OnDisabledForOutOfSpaceSubscribeHoverOut' );
		}
		else if( !( bNotEnoughSpace ) )
		{
			UnregisterFromCallback( 'OnHoverOver', m_ownerMenu, 'OnDisabledForOutOfSpaceSubscribeHoverOver' );
			UnregisterFromCallback( 'OnHoverOut', m_ownerMenu, 'OnDisabledForOutOfSpaceSubscribeHoverOut' );
		}
	}

	public function SetIsDisabledForPauseMenuReason() : Bool
	{
		var bChangedState : Bool;
		bChangedState = super.SetIsDisabled( true );
		if( bChangedState )
		{
			RegisterToCallback( 'OnRelease', this, 'OnReleaseWhileInPauseMenu' );
		}
		return bChangedState;
	}

	public override function SetIsDisabled( bInDisabled : Bool ) : Bool
	{
		if( m_isDeactivatedBecauseInPauseMenu )
		{
			return SetIsDisabledForPauseMenuReason();
		}
		else
		{
			return super.SetIsDisabled( bInDisabled );
		}
	}

	public function SetButtonInfo( bIsUserSubscribedToMod : Bool )
	{
		var subscribeButtonTextString : CName;
		SetGenericButtonInfo( bIsUserSubscribedToMod );
		SetIsForSubscribe( !( bIsUserSubscribedToMod ) );
		subscribeButtonTextString = ( ( bIsUserSubscribedToMod ) ? ( 'UI-Modio-InputHints-Uninstall' ) : ( 'UI-Modio-MenuContent-Sub' ) );
		inkTextRef.SetText( m_buttonText, GetLocalizedText( NameToString( subscribeButtonTextString ) ) );
	}

}

class LikeButtonController extends GenericModButtonController
{

	protected event OnRelease( e : inkPointerEvent )
	{
		if( m_ownerMenu.ShouldIgnoreInput() )
		{
			return true;
		}
		super.OnRelease( e );
		if( e.IsAction( 'click' ) || e.IsAction( 'tap' ) )
		{
			m_ownerMenu.LikeButtonClicked( m_isForFunction );
		}
	}

	public function SetIsForLike( bIsForLike : Bool )
	{
		m_isForFunction = bIsForLike;
	}

	public function GetIsForLike() : Bool
	{
		return m_isForFunction;
	}

	public function SetButtonInfo( bIsUserLikingMod : Bool )
	{
		var LikeButtonTextString : CName;
		SetGenericButtonInfo( bIsUserLikingMod );
		SetIsForLike( !( bIsUserLikingMod ) );
		LikeButtonTextString = ( ( bIsUserLikingMod ) ? ( 'UI-Modio-MenuContent-Liked' ) : ( 'UI-Modio-MenuContent-Like' ) );
		inkTextRef.SetText( m_buttonText, GetLocalizedText( NameToString( LikeButtonTextString ) ) );
	}

}

class FromAuthorButtonController extends GenericModButtonController
{

	protected event OnRelease( e : inkPointerEvent )
	{
		if( m_ownerMenu.ShouldIgnoreInput() )
		{
			return true;
		}
		super.OnRelease( e );
		if( e.IsAction( 'click' ) || e.IsAction( 'tap' ) )
		{
			m_ownerMenu.AuthorButtonClicked( m_isForFunction );
		}
	}

	public function SetIsForShowFromSameAuthor( bIsToShowFromSameAuthor : Bool )
	{
		m_isForFunction = bIsToShowFromSameAuthor;
	}

	public function GetIsForShowFromSameAuthor() : Bool
	{
		return m_isForFunction;
	}

	public function SetButtonInfo( bIsToShowFromSameAuthor : Bool )
	{
		var AuthorButtonTextString : CName;
		SetGenericButtonInfo( bIsToShowFromSameAuthor );
		SetIsForShowFromSameAuthor( !( bIsToShowFromSameAuthor ) );
		AuthorButtonTextString = 'UI-Modio-MenuContent-Author';
		inkTextRef.SetText( m_buttonText, GetLocalizedText( NameToString( AuthorButtonTextString ) ) );
	}

	public override function SetOwnerMenu( inMenu : BrowserModsMenuGameController )
	{
		super.SetOwnerMenu( inMenu );
		RegisterToCallback( 'OnHoverOver', m_ownerMenu, 'OnAuthorHoveredOver' );
		RegisterToCallback( 'OnHoverOut', m_ownerMenu, 'OnAuthorHoveredOut' );
	}

}

class ModSortingDropdownButtonController extends DropdownButtonController
{
	private editable var m_navigableComponentRef : inkWidgetRef;
	private var m_ownerWidget : weak< ModDetailsItem >;
	private var m_ownerMenu : weak< BrowserModsMenuGameController >;
	private var m_navigableComponentController : weak< AnimatedListItemController >;
	private var m_menuColors : ModsMenuColorsNames;

	protected event OnInitialize()
	{
		RegisterToCallback( 'OnHoverOver', this, 'OnHoverOver' );
		RegisterToCallback( 'OnHoverOut', this, 'OnHoverOut' );
		m_navigableComponentController = ( ( AnimatedListItemController )( inkWidgetRef.GetController( m_navigableComponentRef ) ) );
	}

	protected event OnUninitialize()
	{
		UnregisterFromCallback( 'OnHoverOver', this, 'OnHoverOver' );
		UnregisterFromCallback( 'OnHoverOut', this, 'OnHoverOut' );
	}

	public function SetOwnerMenu( inMenu : BrowserModsMenuGameController )
