}

class ModioGalleryPreviewImageController extends AnimatedListItemController
{
	private var m_modDetailsItem : weak< ModDetailsItem >;
	private var m_ownerMenu : weak< BrowserModsMenuGameController >;

	protected event OnInitialize()
	{
		RegisterToCallback( 'OnRelease', this, 'OnRelease' );
	}

	protected event OnUninitialize()
	{
		UnregisterFromCallback( 'OnRelease', this, 'OnRelease' );
	}

	public function Setup( inModDetailsItem : weak< ModDetailsItem > )
	{
		m_modDetailsItem = inModDetailsItem;
	}

	public function SetOwnerMenu( inOwnerMenu : weak< BrowserModsMenuGameController > )
	{
		m_ownerMenu = inOwnerMenu;
		m_ownerMenu.AddToListOfNavigables( this );
	}

	protected event OnRelease( e : inkPointerEvent )
	{
		var previewEvent : ModioGalleryPreviewPopupEvent;
		if( m_ownerMenu.ShouldIgnoreInput() )
		{
			return false;
		}
		if( e.IsAction( 'click' ) || e.IsAction( 'tap' ) )
		{
			if( m_modDetailsItem.GetCarouselSize() == 0 )
			{
				return 0;
			}
			PlaySound( 'Button', 'OnPress' );
			previewEvent = new ModioGalleryPreviewPopupEvent;
			previewEvent.m_data = new ModioGalleryPreviewData;
			previewEvent.m_data.queueName = 'modio_gallery';
			previewEvent.m_data.notificationName = 'base\gameplay\gui\fullscreen\main_menu\modio\modio_gallery_fullpreview.inkwidget';
			previewEvent.m_data.isBlocking = true;
			previewEvent.m_data.useCursor = true;
			previewEvent.m_data.m_modDetailsItem = m_modDetailsItem;
			previewEvent.m_data.m_ownerMenu = m_ownerMenu;
			QueueBroadcastEvent( previewEvent );
			e.Handle();
		}
	}

}

class ModioGalleryFullPreview extends GalleryFullPreview
{
	private editable var m_leftGalleryArrow : inkWidgetRef;
	private editable var m_rightGalleryArrow : inkWidgetRef;
	private editable var m_galleryText : inkTextRef;
	private editable var m_galleryTextShadow : inkTextRef;
	private editable var m_menuNavigationRef : inkWidgetRef;
	private var m_currentGalleryIndex : Int64;
	private var m_gallerySize : Int64;
	private var m_firstOpening : Bool;
	private var m_menuNavigationController : weak< inkContainerNavigationController >;
	private var m_ownerMenu : weak< BrowserModsMenuGameController >;
	private var m_widget : weak< inkWidget >;

	protected event OnInitialize()
	{
		var leftGalleryArrow : weak< GalleryArrowController >;
		var rightGalleryArrow : weak< GalleryArrowController >;
		var screenshotData : weak< ModioGalleryPreviewData >;
		m_systemHandler = GetSystemRequestsHandler();
		m_widget = GetRootWidget();
		m_data = ( ( ModioGalleryPreviewData )( GetRootWidget().GetUserData( 'ModioGalleryPreviewData' ) ) );
		screenshotData = ( ( ModioGalleryPreviewData )( m_data ) );
		m_ownerMenu = screenshotData.m_ownerMenu;
		if( m_ownerMenu )
		{
			m_ownerMenu.SetIsInGallery( true );
		}
		m_buttonHintsController = ( ( ButtonHints )( SpawnFromExternal( inkWidgetRef.Get( m_buttonHintsManagerRef ), R"base\gameplay\gui\common\buttonhints.inkwidget", 'Root' ).GetController() ) );
		m_buttonHintsController.AddButtonHint( 'back', GetLocalizedText( "Common-Access-Close" ) );
		RegisterToGlobalInputCallback( 'OnPostOnRelease', this, 'OnButtonRelease' );
		m_preloader = ( ( inkCompoundWidget )( SpawnFromExternal( inkWidgetRef.Get( m_container ), R"base\gameplay\gui\common\preloader\preloader.inkwidget", 'Root' ) ) );
		m_preloader.SetAnchor( inkEAnchor.Fill );
		m_preloader.SetAnchorPoint( Vector2( 0.5, 0.5 ) );
		m_preloader.GetWidgetByPathName( 'border' ).SetVisible( false );
		m_preloader.SetVisible( true );
		inkWidgetRef.SetVisible( m_screenshotContainer, false );
		m_currentGalleryIndex = screenshotData.m_modDetailsItem.GetCarouselCurrentIndex();
		m_gallerySize = screenshotData.m_modDetailsItem.GetCarouselSize();
		m_firstOpening = true;
		leftGalleryArrow = ( ( GalleryArrowController )( inkWidgetRef.GetController( m_leftGalleryArrow ) ) );
		leftGalleryArrow.InitializeGalleryArrow( true, this );
		rightGalleryArrow = ( ( GalleryArrowController )( inkWidgetRef.GetController( m_rightGalleryArrow ) ) );
		rightGalleryArrow.InitializeGalleryArrow( false, this );
		m_ownerMenu.AddToListOfNavigables( leftGalleryArrow );
		m_ownerMenu.AddToListOfNavigables( rightGalleryArrow );
		m_menuNavigationController = ( ( inkContainerNavigationController )( inkWidgetRef.GetControllerByType( m_menuNavigationRef, 'inkContainerNavigationController' ) ) );
		m_menuNavigationController.OverrideNavigation( inkDiscreteNavigationDirection.Up, inkWidgetRef.Get( m_leftGalleryArrow ) );
		m_menuNavigationController.OverrideNavigation( inkDiscreteNavigationDirection.Left, inkWidgetRef.Get( m_leftGalleryArrow ) );
		m_menuNavigationController.OverrideNavigation( inkDiscreteNavigationDirection.Down, inkWidgetRef.Get( m_rightGalleryArrow ) );
		m_menuNavigationController.OverrideNavigation( inkDiscreteNavigationDirection.Right, inkWidgetRef.Get( m_rightGalleryArrow ) );
		LoadGalleryImage();
	}

	protected event OnUninitialize()
	{
		if( m_ownerMenu )
		{
			m_ownerMenu.SetIsInGallery( false );
		}
	}

	protected event OnButtonRelease( evt : inkPointerEvent )
	{
		if( evt.IsAction( 'cancel' ) )
		{
			PlaySound( 'Button', 'OnPress' );
			m_data.token.TriggerCallback( NULL );
		}
		else if( evt.IsAction( 'prior_menu' ) )
		{
			PlaySound( 'Button', 'OnPress' );
			DisplayPreviousGalleryImage();
		}
		else if( evt.IsAction( 'next_menu' ) )
		{
			PlaySound( 'Button', 'OnPress' );
			DisplayNextGalleryImage();
		}
	}

	protected function LoadGalleryImage()
	{
		var screenshotData : weak< ModioGalleryPreviewData >;
		var imagePaths : array< String >;
		var path : String;
		screenshotData = ( ( ModioGalleryPreviewData )( m_data ) );
		imagePaths = screenshotData.m_modDetailsItem.GetCarouselImagePaths();
		path = imagePaths[ ( ( Int32 )( m_currentGalleryIndex ) ) ];
		m_systemHandler.RequestGameScreenshotByPath( path, GetPreviewImageWidget(), this, 'OnScreenshotLoaded' );
		inkTextRef.SetText( m_galleryText, ( IntToString( ( ( Int32 )( m_currentGalleryIndex ) ) + 1 ) + "/" ) + IntToString( ( ( Int32 )( m_gallerySize ) ) ) );
		inkTextRef.SetText( m_galleryTextShadow, ( IntToString( ( ( Int32 )( m_currentGalleryIndex ) ) + 1 ) + "/" ) + IntToString( ( ( Int32 )( m_gallerySize ) ) ) );
	}

	private function GetPreviousGalleryIndex() : Int64
	{
		return ( ( ( m_currentGalleryIndex - 1 ) < 0 ) ? ( m_gallerySize - 1 ) : ( m_currentGalleryIndex - 1 ) );
	}

	private function GetNextGalleryIndex() : Int64
	{
		return ( ( ( m_currentGalleryIndex + 1 ) >= m_gallerySize ) ? ( 0 ) : ( ( ( Int32 )m_currentGalleryIndex + 1 ) ) );
	}

	public function DisplayPreviousGalleryImage()
	{
		m_currentGalleryIndex = GetPreviousGalleryIndex();
		LoadGalleryImage();
	}

	public function DisplayNextGalleryImage()
	{
		m_currentGalleryIndex = GetNextGalleryIndex();
		LoadGalleryImage();
	}

	public function OnScreenshotLoaded( screenshotSize : Vector2, errorCode : Int32 )
	{
		GalleryUtils.FillScreenshotInPreview( screenshotSize, inkImageRef.GetSize( m_screenshotPreview ) );
		inkImageRef.SetTintColor( m_screenshotPreview, HDRColor( 0.73000002, 0.73000002, 0.73000002, 1.0 ) );
		m_preloader.SetVisible( false );
		if( m_firstOpening )
		{
			PlayLibraryAnimation( 'intro' );
			m_firstOpening = false;
		}
	}

}

class GalleryArrowController extends AnimatedListItemController
{
	private var m_bIsLeftArrow : Bool;
	private var m_modGalleryPreview : weak< ModioGalleryFullPreview >;

	protected event OnInitialize()
	{
		super.OnInitialize();
		RegisterToCallback( 'OnRelease', this, 'OnArrowClicked' );
	}

	protected event OnUninitialize()
	{
		super.OnUninitialize();
		UnregisterFromCallback( 'OnRelease', this, 'OnArrowClicked' );
	}

	public function InitializeGalleryArrow( bInIsLeftArrow : Bool, inGallery : weak< ModioGalleryFullPreview > )
	{
		m_bIsLeftArrow = bInIsLeftArrow;
		m_modGalleryPreview = inGallery;
	}

	protected event OnArrowClicked( e : inkPointerEvent )
	{
		if( e.IsAction( 'click' ) || e.IsAction( 'tap' ) )
		{
			PlaySound( 'Button', 'OnPress' );
			if( m_bIsLeftArrow )
			{
				m_modGalleryPreview.DisplayPreviousGalleryImage();
			}
			else
			{
				m_modGalleryPreview.DisplayNextGalleryImage();
			}
		}
	}

}

class ModMenuSearchBarController extends inkLogicController
{
	private editable var m_searchBarInput : inkTextInputRef;
	editable var m_searchBarDefaultText : inkTextRef;
	var m_isFocused : Bool;
	private var m_ignoreNextUnfocusCall : Bool;
	private var m_ownerMenu : weak< BrowserModsMenuGameController >;

	protected event OnInitialize()
	{
		m_isFocused = false;
		m_ignoreNextUnfocusCall = false;
		inkTextRef.SetText( m_searchBarDefaultText, GetLocalizedText( "UI-Modio-FiltersSorting-Search" ) );
		RegisterToCallback( 'OnRelease', this, 'OnSearchBarClicked' );
	}

	protected event OnUninitialize()
	{
		UnregisterFromCallback( 'OnRelease', this, 'OnSearchBarClicked' );
	}

	protected event OnSearchBarClicked( evt : inkPointerEvent )
	{
		if( evt.IsAction( 'click' ) || evt.IsAction( 'tap' ) )
		{
			TryFocus( true );
		}
	}

	public function SetOwnerMenu( owner : weak< BrowserModsMenuGameController > )
	{
		m_ownerMenu = owner;
	}

	public function TryFocus( bFocusFromClickEvent : Bool )
	{
		var platformName : String;
		if( !( m_isFocused ) )
		{
			platformName = GetPlatformShortName();
			if( ( ( ( platformName != "ps5" && platformName != "ps5pro" ) && platformName != "xseriesx" ) && platformName != "xseriess" ) && platformName != "emporium" )
			{
				( ( inkTextInput )( inkTextInputRef.Get( m_searchBarInput ) ) ).RequestFocus();
				m_isFocused = true;
				m_ignoreNextUnfocusCall = bFocusFromClickEvent;
			}
			else
			{
				m_ownerMenu.OpenIMEDialogIfNeeded();
			}
			inkTextRef.SetVisible( m_searchBarDefaultText, false );
			m_ownerMenu.UpdateButtonHints();
			PlaySound( 'Button', 'OnPress' );
		}
	}

	public function Reset()
	{
		m_isFocused = false;
		m_ignoreNextUnfocusCall = false;
		inkTextRef.SetText( m_searchBarDefaultText, GetLocalizedText( "UI-Modio-FiltersSorting-Search" ) );
		inkTextRef.SetVisible( m_searchBarDefaultText, true );
	}

	public function LoseFocus()
	{
		var textInput : inkTextInput;
		textInput = ( ( inkTextInput )( inkTextInputRef.Get( m_searchBarInput ) ) );
		if( !( m_ignoreNextUnfocusCall ) && m_isFocused )
		{
			textInput.RequestUnfocus();
			m_isFocused = false;
			DisplayDefaultTextIfEmpty();
			m_ownerMenu.UpdateButtonHints();
			PlaySound( 'Button', 'OnPress' );
		}
		m_ignoreNextUnfocusCall = false;
	}

	public function DisplayDefaultTextIfEmpty()
	{
		var textInput : inkTextInput;
		textInput = ( ( inkTextInput )( inkTextInputRef.Get( m_searchBarInput ) ) );
		if( StrLen( textInput.GetText() ) == 0 )
		{
			inkTextRef.SetText( m_searchBarDefaultText, GetLocalizedText( "UI-Modio-FiltersSorting-Search" ) );
			inkTextRef.SetVisible( m_searchBarDefaultText, true );
		}
	}

	public function UpdateSearchbarOffset()
	{
		var searchBarSize : Vector2;
		var textSize : Vector2;
		var offset : Float;
		searchBarSize = inkTextInputRef.GetSize( m_searchBarInput );
		textSize = inkTextRef.GetDesiredSize( m_searchBarDefaultText );
		offset = searchBarSize.X - textSize.X;
		if( offset < 0.0 )
		{
			( ( inkTextInput )( inkTextInputRef.Get( m_searchBarInput ) ) ).SetOffsetX( offset );
		}
	}

}

class TagWidgetItem extends inkLogicController
{
	private editable var m_selfRef : inkWidgetRef;
	private editable var m_tagText : inkRichTextBoxRef;
	private editable var m_tagVerticalPanelRef : inkWidgetRef;

	public function SetTagName( inTagName : String )
	{
		inkRichTextBoxRef.SetText( m_tagText, "#" + inTagName );
	}

	public function SetCorrectSize()
	{
		var desiredSize : Vector2;
		desiredSize = inkWidgetRef.GetDesiredSize( m_tagVerticalPanelRef );
		if( desiredSize.X != 0.0 )
		{
			inkWidgetRef.SetSize( m_selfRef, desiredSize );
		}
	}

}

class UninstallConfirmationPopupController extends inkGameController
{
	private editable var m_confirmButton : inkWidgetRef;
	private editable var m_cancelButton : inkWidgetRef;
	private editable var m_checkboxButton : inkWidgetRef;
	private editable var m_checkboxFill : inkWidgetRef;
	private editable var m_notificationText : inkTextRef;
	private editable var m_checkboxText : inkTextRef;
	private var m_bDontShowAgain : Bool;
	private var m_modMenuRef : weak< BrowserModsMenuGameController >;
	private var m_data : ModioConfirmUninstallData;
	private var m_widget : weak< inkWidget >;
	private var m_closeAnim : inkAnimProxy;

	protected event OnInitialize()
	{
		PlayLibraryAnimation( 'UninstallPopup_In' );
		inkWidgetRef.RegisterToCallback( m_confirmButton, 'OnRelease', this, 'OnConfirmButtonClicked' );
		inkWidgetRef.RegisterToCallback( m_cancelButton, 'OnRelease', this, 'OnCancelButtonClicked' );
		inkWidgetRef.RegisterToCallback( m_checkboxButton, 'OnRelease', this, 'OnCheckboxClicked' );
		RegisterToGlobalInputCallback( 'OnPostOnRelease', this, 'OnButtonRelease' );
		inkTextRef.SetText( m_notificationText, GetLocalizedText( "UI-Modio-ErrorMessages-WarningUninstall" ) );
		inkTextRef.SetText( m_checkboxText, GetLocalizedText( "UI-Modio-ErrorMessages-HideWarning" ) );
		m_bDontShowAgain = false;
		inkWidgetRef.SetVisible( m_checkboxFill, false );
		m_widget = GetRootWidget();
		m_data = ( ( ModioConfirmUninstallData )( GetRootWidget().GetUserData( 'ModioConfirmUninstallData' ) ) );
		m_modMenuRef = m_data.m_ownerMenu;
		m_modMenuRef.DeactivateNavigation();
		m_modMenuRef.m_bStopListeningToInput = true;
	}

	protected event OnUninitialize()
	{
		inkWidgetRef.UnregisterFromCallback( m_confirmButton, 'OnRelease', this, 'OnConfirmButtonClicked' );
		inkWidgetRef.UnregisterFromCallback( m_cancelButton, 'OnRelease', this, 'OnCancelButtonClicked' );
		inkWidgetRef.UnregisterFromCallback( m_checkboxButton, 'OnRelease', this, 'OnCheckboxClicked' );
		UnregisterFromGlobalInputCallback( 'OnPostOnRelease', this, 'OnButtonRelease' );
		m_modMenuRef.ActivateNavigation();
	}

	protected event OnButtonRelease( evt : inkPointerEvent )
	{
		if( evt.IsAction( 'cancel' ) )
		{
			Hide();
		}
		else if( evt.IsAction( 'mod_notification_confirm' ) )
		{
			ConfirmUninstall();
		}
	}

	public function Hide()
	{
		m_modMenuRef.m_bStopListeningToInput = false;
		m_closeAnim = PlayLibraryAnimation( 'UninstallPopup_Out' );
		m_closeAnim.RegisterToCallback( inkanimEventType.OnFinish, this, 'OnCloseAnimFinished' );
		PlaySound( 'Button', 'OnPress' );
	}

	protected event OnCloseAnimFinished( anim : inkAnimProxy )
	{
		if( m_closeAnim != NULL )
		{
			m_closeAnim.UnregisterFromCallback( inkanimEventType.OnFinish, this, 'OnCloseAnimFinished' );
			m_closeAnim = NULL;
		}
		m_data.token.TriggerCallback( NULL );
	}

	protected function ConfirmUninstall()
	{
		m_modMenuRef.OnUninstallModConfirmationPopupClosed( true, m_bDontShowAgain );
		Hide();
	}

	protected event OnConfirmButtonClicked( evt : inkPointerEvent )
	{
		if( evt.IsAction( 'click' ) || evt.IsAction( 'tap' ) )
		{
			ConfirmUninstall();
		}
	}

	protected event OnCancelButtonClicked( evt : inkPointerEvent )
	{
		if( evt.IsAction( 'click' ) || evt.IsAction( 'tap' ) )
		{
			Hide();
		}
	}

	protected event OnCheckboxClicked( evt : inkPointerEvent )
	{
		if( evt.IsAction( 'click' ) || evt.IsAction( 'tap' ) )
		{
			m_bDontShowAgain = !( m_bDontShowAgain );
			inkWidgetRef.SetVisible( m_checkboxFill, m_bDontShowAgain );
			PlaySound( 'Button', 'OnPress' );
		}
	}

}

class ShowFilterButton extends inkButtonController
{
	private editable var m_textRef : inkWidgetRef;
	private editable var m_backgroundImage : inkWidgetRef;
	private editable var m_outlineImage : inkWidgetRef;
	private editable var m_iconImage : inkWidgetRef;
	private editable var m_hitboxCanvas : inkWidgetRef;
	private var m_ownerMenu : weak< BrowserModsMenuGameController >;
	private var m_colorNames : ModsMenuColorsNames;

	protected event OnInitialize()
	{
		RegisterCallbacks();
	}

	protected event OnUninitialize()
	{
		UnregisterCallbacks();
	}

	public function RegisterCallbacks()
	{
		inkWidgetRef.RegisterToCallback( m_hitboxCanvas, 'OnRelease', this, 'OnButtonRelease' );
		RegisterToCallback( 'OnHoverOver', this, 'OnHoverOver' );
		RegisterToCallback( 'OnHoverOut', this, 'OnHoverOut' );
	}

	public function UnregisterCallbacks()
	{
		inkWidgetRef.UnregisterFromCallback( m_hitboxCanvas, 'OnRelease', this, 'OnButtonRelease' );
		UnregisterFromCallback( 'OnHoverOver', this, 'OnHoverOver' );
		UnregisterFromCallback( 'OnHoverOut', this, 'OnHoverOut' );
	}

	public function SetOwnerMenu( ownerMenu : BrowserModsMenuGameController )
	{
		m_ownerMenu = ownerMenu;
		m_ownerMenu.AddToListOfNavigables( this );
	}

	protected event OnHoverOver( e : inkPointerEvent )
	{
		if( m_ownerMenu.ShouldIgnoreInput() )
		{
			return true;
		}
		if( !( m_ownerMenu.m_sortingDropdownListController.IsOpened() ) )
		{
			SetHoveredColor();
		}
	}

	protected event OnHoverOut( e : inkPointerEvent )
	{
		SetDefaultColor();
	}

	private function SetHoveredColor()
	{
		inkWidgetRef.Get( m_textRef ).BindProperty( 'tintColor', m_colorNames.activeBlueName );
		inkWidgetRef.Get( m_iconImage ).BindProperty( 'tintColor', m_colorNames.activeBlueName );
		inkWidgetRef.Get( m_outlineImage ).BindProperty( 'tintColor', m_colorNames.mildBlueName );
		inkWidgetRef.Get( m_backgroundImage ).BindProperty( 'tintColor', m_colorNames.fullscreenPrimaryBackgroundDarkName );
	}

	public function SetDefaultColor()
	{
		inkWidgetRef.Get( m_iconImage ).BindProperty( 'tintColor', m_colorNames.redName );
		inkWidgetRef.Get( m_textRef ).BindProperty( 'tintColor', m_colorNames.redName );
		inkWidgetRef.Get( m_backgroundImage ).BindProperty( 'tintColor', m_colorNames.fullscreenRedDarkBackgroundName );
		inkWidgetRef.Get( m_outlineImage ).BindProperty( 'tintColor', m_colorNames.darkerRedName );
	}

	protected event OnButtonRelease( e : inkPointerEvent )
	{
		if( m_ownerMenu.ShouldIgnoreInput() || m_ownerMenu.m_sortingDropdownListController.IsOpened() )
		{
			return true;
		}
		if( e.IsAction( 'click' ) || e.IsAction( 'tap' ) )
		{
			m_ownerMenu.ShowFilterDrawer();
			SetDefaultColor();
		}
	}

}

