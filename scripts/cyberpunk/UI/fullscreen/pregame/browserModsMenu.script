class ModSortingDropdownElementController extends DropdownElementController
{
	private editable var m_frameWidget : inkWidgetRef;
	var m_ownerMenu : weak< BrowserModsMenuGameController >;
	private var m_colorNames : ModsMenuColorsNames;

	protected event OnInitialize()
	{
		RegisterToCallback( 'OnHoverOver', this, 'OnHoverOver' );
		RegisterToCallback( 'OnHoverOut', this, 'OnHoverOut' );
	}

	protected event OnUninitialize()
	{
		UnregisterFromCallback( 'OnHoverOver', this, 'OnHoverOver' );
		UnregisterFromCallback( 'OnHoverOut', this, 'OnHoverOut' );
	}

	protected event OnHoverOver( e : inkPointerEvent )
	{
		var bIsLanguageDropdownOpened : Bool;
		if( m_ownerMenu.IsReportPopupOpen() )
		{
			return true;
		}
		PlaySound( 'Button', 'OnHover' );
		inkWidgetRef.Get( m_frameWidget ).BindProperty( 'tintColor', m_colorNames.activeBlueName );
		inkWidgetRef.Get( m_frameWidget ).BindProperty( 'opacity', 'Panel.frameOpacity' );
		bIsLanguageDropdownOpened = m_ownerMenu.m_languageDropdownListController.IsOpened();
		if( !( bIsLanguageDropdownOpened ) )
		{
			super.OnHoverOver( e );
		}
	}

	protected event OnHoverOut( e : inkPointerEvent )
	{
		var bIsLanguageDropdownOpened : Bool;
		if( m_ownerMenu.IsReportPopupOpen() )
		{
			return true;
		}
		inkWidgetRef.Get( m_frameWidget ).BindProperty( 'tintColor', m_colorNames.panelDarkRedName );
		inkWidgetRef.Get( m_frameWidget ).BindProperty( 'opacity', 'SortButton.frameOpacity' );
		bIsLanguageDropdownOpened = m_ownerMenu.m_languageDropdownListController.IsOpened();
		if( !( bIsLanguageDropdownOpened ) )
		{
			super.OnHoverOut( e );
		}
	}

}

class ModSortingDropdownListController extends DropdownListController
{

	protected override function SetupData( const data : ref< array< DropdownItemData > > )
	{
		var i : Int32;
		var item : ModSortingDropdownElementController;
		m_data = data;
		inkCompoundRef.RemoveAllChildren( m_listContainer );
		for( i = 0; i < data.Size(); i += 1 )
		{
			item = ( ( ModSortingDropdownElementController )( SpawnFromLocal( inkCompoundRef.Get( m_listContainer ), 'SortingDropdownElement' ).GetController() ) );
			item.RegisterToCallback( 'OnRelease', this, 'OnDropdownItemClicked' );
			item.m_ownerMenu = ( ( BrowserModsMenuGameController )( m_ownerController ) );
			item.Setup( data[ i ] );
			if( i == 0 )
			{
				item.SetActive( true );
				m_activeElement = item;
			}
		}
	}

}

final abstract class ModSortingDropdownData
{

	public static function GetSortingDropdownOption( const options : ref< array< DropdownItemData > >, identifier : inkModioModSortingOptions ) : DropdownItemData
	{
		var i : Int32;
		for( i = 0; i < options.Size(); i += 1 )
		{
			if( ( ( inkModioModSortingOptions )options[ i ].identifier ) == identifier )
			{
				return options[ i ];
			}
		}
		return NULL;
	}

	private static function GetDropdownItemData( identifier : Variant, labelKey : CName, direction : DropdownItemDirection ) : DropdownItemData
	{
		var itemData : DropdownItemData;
		itemData = new DropdownItemData;
		itemData.identifier = identifier;
		itemData.labelKey = labelKey;
		itemData.direction = direction;
		return itemData;
	}

	public static function GetSortingDropdownOptions() : array< DropdownItemData >
	{
		var result : array< DropdownItemData >;
		result.PushBack( GetDropdownItemData( inkModioModSortingOptions.Trending, 'UI-Modio-FiltersSorting-Trending', DropdownItemDirection.None ) );
		result.PushBack( GetDropdownItemData( inkModioModSortingOptions.Popular, 'UI-Modio-FiltersSorting-Popular', DropdownItemDirection.None ) );
		result.PushBack( GetDropdownItemData( inkModioModSortingOptions.HighestRated, 'UI-Modio-FiltersSorting-HighRate', DropdownItemDirection.None ) );
		result.PushBack( GetDropdownItemData( inkModioModSortingOptions.RecentlyUpdated, 'UI-Modio-FiltersSorting-RecentUpdate', DropdownItemDirection.None ) );
		result.PushBack( GetDropdownItemData( inkModioModSortingOptions.RecentlyUploaded, 'UI-Modio-FiltersSorting-New', DropdownItemDirection.None ) );
		return result;
	}

}

