abstract class ContentCheckbox extends AnimatedListItemController
{
	protected editable var m_checkboxCanvas : inkWidgetRef;
	protected editable var m_checkboxImage : inkImageRef;
	protected editable var m_checkboxText : inkTextRef;
	protected var m_bState : Bool;
	protected var m_ownerMenu : weak< ModioBrowserMenuGameController >;

	protected event OnInitialize()
	{
		RegisterToCallback( 'OnHoverOver', this, 'OnHoverOver' );
		RegisterToCallback( 'OnHoverOut', this, 'OnHoverOut' );
		RegisterToCallback( 'OnRelease', this, 'OnRelease' );
		SetNavigable( true );
	}

	protected event OnHoverOver( e : inkPointerEvent ) {}

	protected event OnHoverOut( e : inkPointerEvent ) {}

	protected event OnRelease( e : inkPointerEvent )
	{
		if( e.IsAction( 'click' ) || e.IsAction( 'tap' ) )
		{
			OnClickContentCheckbox();
		}
	}

	protected virtual function OnClickContentCheckbox()
	{
		m_bState = !( m_bState );
		inkImageRef.SetVisible( m_checkboxImage, m_bState );
	}

}

class MatureContentCheckbox extends ContentCheckbox
{
	protected var m_bIsBrowserMenu : Bool;

	protected event OnInitialize()
	{
		m_bIsBrowserMenu = true;
		super.OnInitialize();
	}

	public function InitializeCheckbox( inOwnerMenu : weak< ModioBrowserMenuGameController > )
	{
		m_ownerMenu = inOwnerMenu;
		m_bState = m_ownerMenu.GetCurrentAllowMatureContentState();
	}

	public function UpdateCheckbox()
	{
		m_bState = m_ownerMenu.GetCurrentAllowMatureContentState();
		inkImageRef.SetVisible( m_checkboxImage, m_bState );
	}

	protected override function OnClickContentCheckbox()
	{
		m_bState = !( m_bState );
		inkImageRef.SetVisible( m_checkboxImage, m_bState );
		m_ownerMenu.UpdateAllowMatureContentState( m_bState );
	}

}

class LanguageCheckbox extends ContentCheckbox
{
	protected var m_identifier : inkModioLanguageTagsOptions;

	public function InitializeCheckbox( inOwnerMenu : weak< ModioBrowserMenuGameController >, inIdentifier : inkModioLanguageTagsOptions )
	{
		m_ownerMenu = inOwnerMenu;
		m_identifier = inIdentifier;
		UpdateCheckbox( false );
	}

	public function UpdateCheckbox( inState : Bool )
	{
		m_bState = inState;
		inkImageRef.SetVisible( m_checkboxImage, m_bState );
	}

	protected override function OnClickContentCheckbox()
	{
		var newState : Bool;
		newState = !( m_bState );
		UpdateCheckbox( newState );
		m_ownerMenu.UpdateCurrentlySelectedLanguageTags( m_identifier );
	}

}

class ModioGalleryPreviewData extends GalleryPreviewData
{
	var m_modDetailsItem : weak< ModDetailsItem >;
}

class ModioGalleryPreviewPopupEvent extends Event
{
	var m_data : ModioGalleryPreviewData;
}

class ModioGalleryPreviewImageController extends AnimatedListItemController
{
	private var m_modDetailsItem : weak< ModDetailsItem >;

	protected event OnInitialize()
	{
		RegisterToCallback( 'OnRelease', this, 'OnRelease' );
	}

	protected event OnUninitialize()
	{
		UnregisterFromCallback( 'OnRelease', this, 'OnRelease' );
	}

	public function Setup( inModDetailsItem : weak< ModDetailsItem > )
	{
		m_modDetailsItem = inModDetailsItem;
	}

	protected event OnRelease( e : inkPointerEvent )
	{
		var previewEvent : ModioGalleryPreviewPopupEvent;
		if( e.IsAction( 'click' ) || e.IsAction( 'tap' ) )
		{
			if( m_modDetailsItem.GetCarouselSize() == 0 )
			{
				return 0;
			}
			PlaySound( 'Button', 'OnPress' );
			previewEvent = new ModioGalleryPreviewPopupEvent;
			previewEvent.m_data = new ModioGalleryPreviewData;
			previewEvent.m_data.queueName = 'modio_gallery';
			previewEvent.m_data.notificationName = 'base\gameplay\gui\fullscreen\main_menu\modio\modio_gallery_fullpreview.inkwidget';
			previewEvent.m_data.isBlocking = true;
			previewEvent.m_data.useCursor = true;
			previewEvent.m_data.m_modDetailsItem = m_modDetailsItem;
			QueueBroadcastEvent( previewEvent );
			e.Handle();
		}
	}

}

class ModioGalleryFullPreview extends GalleryFullPreview
{
	private editable var m_leftGalleryArrow : inkWidgetRef;
	private editable var m_rightGalleryArrow : inkWidgetRef;
	private editable var m_galleryText : inkTextRef;
	private editable var m_galleryTextShadow : inkTextRef;
	private var m_currentGalleryIndex : Int64;
	private var m_gallerySize : Int64;
	private var m_firstOpening : Bool;

	protected event OnInitialize()
	{
		var leftGalleryArrow : weak< GalleryArrowController >;
		var rightGalleryArrow : weak< GalleryArrowController >;
		var screenshotData : weak< ModioGalleryPreviewData >;
		m_systemHandler = GetSystemRequestsHandler();
		m_data = ( ( ModioGalleryPreviewData )( GetRootWidget().GetUserData( 'ModioGalleryPreviewData' ) ) );
		screenshotData = ( ( ModioGalleryPreviewData )( m_data ) );
		m_buttonHintsController = ( ( ButtonHints )( SpawnFromExternal( inkWidgetRef.Get( m_buttonHintsManagerRef ), R"base\gameplay\gui\common\buttonhints.inkwidget", 'Root' ).GetController() ) );
		m_buttonHintsController.AddButtonHint( 'back', GetLocalizedText( "Common-Access-Close" ) );
		RegisterToGlobalInputCallback( 'OnPostOnRelease', this, 'OnGlobalRelease' );
		m_preloader = ( ( inkCompoundWidget )( SpawnFromExternal( inkWidgetRef.Get( m_container ), R"base\gameplay\gui\common\preloader\preloader.inkwidget", 'Root' ) ) );
		m_preloader.SetAnchor( inkEAnchor.Fill );
		m_preloader.SetAnchorPoint( Vector2( 0.5, 0.5 ) );
		m_preloader.GetWidgetByPathName( 'border' ).SetVisible( false );
		m_preloader.SetVisible( true );
		inkWidgetRef.SetVisible( m_screenshotContainer, false );
		m_currentGalleryIndex = screenshotData.m_modDetailsItem.GetCarouselCurrentIndex();
		m_gallerySize = screenshotData.m_modDetailsItem.GetCarouselSize();
		m_firstOpening = true;
		leftGalleryArrow = ( ( GalleryArrowController )( inkWidgetRef.GetController( m_leftGalleryArrow ) ) );
		leftGalleryArrow.InitializeGalleryArrow( true, this );
		rightGalleryArrow = ( ( GalleryArrowController )( inkWidgetRef.GetController( m_rightGalleryArrow ) ) );
		rightGalleryArrow.InitializeGalleryArrow( false, this );
		LoadGalleryImage();
	}

	protected event OnGlobalRelease( evt : inkPointerEvent )
	{
		if( evt.IsAction( 'cancel' ) )
		{
			PlaySound( 'Button', 'OnPress' );
			m_data.token.TriggerCallback( NULL );
		}
	}

	protected function LoadGalleryImage()
	{
		var screenshotData : weak< ModioGalleryPreviewData >;
		var imagePaths : array< String >;
		var path : String;
		screenshotData = ( ( ModioGalleryPreviewData )( m_data ) );
		imagePaths = screenshotData.m_modDetailsItem.GetCarouselImagePaths();
		path = imagePaths[ ( ( Int32 )( m_currentGalleryIndex ) ) ];
		m_systemHandler.RequestGameScreenshotByPath( path, GetPreviewImageWidget(), this, 'OnScreenshotLoaded' );
		inkTextRef.SetText( m_galleryText, ( IntToString( ( ( Int32 )( m_currentGalleryIndex ) ) + 1 ) + "/" ) + IntToString( ( ( Int32 )( m_gallerySize ) ) ) );
		inkTextRef.SetText( m_galleryTextShadow, ( IntToString( ( ( Int32 )( m_currentGalleryIndex ) ) + 1 ) + "/" ) + IntToString( ( ( Int32 )( m_gallerySize ) ) ) );
	}

	private function GetPreviousGalleryIndex() : Int64
	{
		return ( ( ( m_currentGalleryIndex - 1 ) < 0 ) ? ( m_gallerySize - 1 ) : ( m_currentGalleryIndex - 1 ) );
	}

	private function GetNextGalleryIndex() : Int64
	{
		return ( ( ( m_currentGalleryIndex + 1 ) >= m_gallerySize ) ? ( 0 ) : ( ( ( Int32 )m_currentGalleryIndex + 1 ) ) );
	}

	public function DisplayPreviousGalleryImage()
	{
		m_currentGalleryIndex = GetPreviousGalleryIndex();
		LoadGalleryImage();
	}

	public function DisplayNextGalleryImage()
	{
		m_currentGalleryIndex = GetNextGalleryIndex();
		LoadGalleryImage();
	}

	public function OnScreenshotLoaded( screenshotSize : Vector2, errorCode : Int32 )
	{
		var previewSize : Vector2;
		previewSize = GalleryUtils.FillScreenshotInPreview( screenshotSize, inkImageRef.GetSize( m_screenshotPreview ) );
		inkImageRef.SetSize( m_screenshotPreview, previewSize );
		inkWidgetRef.SetSize( m_screenshotContainer, previewSize );
		inkImageRef.SetTintColor( m_screenshotPreview, HDRColor( 0.73000002, 0.73000002, 0.73000002, 1.0 ) );
		m_preloader.SetVisible( false );
		if( m_firstOpening )
		{
			PlayLibraryAnimation( 'intro' );
			m_firstOpening = false;
		}
	}

}

class GalleryArrowController extends AnimatedListItemController
{
	private var m_bIsLeftArrow : Bool;
	private var m_modGalleryPreview : weak< ModioGalleryFullPreview >;

	protected event OnInitialize()
	{
		super.OnInitialize();
		RegisterToCallback( 'OnRelease', this, 'OnArrowClicked' );
	}

	protected event OnUninitialize()
	{
		super.OnUninitialize();
		UnregisterFromCallback( 'OnRelease', this, 'OnArrowClicked' );
	}

	public function InitializeGalleryArrow( bInIsLeftArrow : Bool, inGallery : weak< ModioGalleryFullPreview > )
	{
		m_bIsLeftArrow = bInIsLeftArrow;
		m_modGalleryPreview = inGallery;
	}

	protected event OnArrowClicked( e : inkPointerEvent )
	{
		if( e.IsAction( 'click' ) || e.IsAction( 'tap' ) )
		{
			PlaySound( 'Button', 'OnPress' );
			if( m_bIsLeftArrow )
			{
				m_modGalleryPreview.DisplayPreviousGalleryImage();
			}
			else
			{
				m_modGalleryPreview.DisplayNextGalleryImage();
			}
		}
	}

}

class ModMenuSearchBarController extends inkLogicController
{
	private editable var m_searchBarInput : inkTextInputRef;
	editable var m_searchBarDefaultText : inkTextRef;
	var m_isFocused : Bool;
	private var m_ignoreNextUnfocusCall : Bool;

	protected event OnInitialize()
	{
		m_isFocused = false;
		m_ignoreNextUnfocusCall = false;
		inkTextRef.SetText( m_searchBarDefaultText, GetLocalizedText( "UI-Modio-FiltersSorting-Search" ) );
		RegisterToCallback( 'OnRelease', this, 'OnSearchBarClicked' );
	}

	protected event OnUninitialize()
	{
		UnregisterFromCallback( 'OnRelease', this, 'OnSearchBarClicked' );
	}

	protected event OnSearchBarClicked( evt : inkPointerEvent )
	{
		if( evt.IsAction( 'click' ) || evt.IsAction( 'tap' ) )
		{
			( ( inkTextInput )( inkTextInputRef.Get( m_searchBarInput ) ) ).RequestFocus();
			m_isFocused = true;
			m_ignoreNextUnfocusCall = true;
			inkTextRef.SetVisible( m_searchBarDefaultText, false );
		}
	}

	public function LoseFocus()
	{
		var textInput : inkTextInput;
		textInput = ( ( inkTextInput )( inkTextInputRef.Get( m_searchBarInput ) ) );
		if( !( m_ignoreNextUnfocusCall ) && m_isFocused )
		{
			textInput.RequestUnfocus();
			m_isFocused = false;
			if( StrLen( textInput.GetText() ) == 0 )
			{
				inkTextRef.SetText( m_searchBarDefaultText, GetLocalizedText( "UI-Modio-FiltersSorting-Search" ) );
				inkTextRef.SetVisible( m_searchBarDefaultText, true );
			}
		}
		m_ignoreNextUnfocusCall = false;
	}

	public function UpdateSearchbarOffset()
	{
		var searchBarSize : Vector2;
		var textSize : Vector2;
		var offset : Float;
		searchBarSize = inkTextInputRef.GetSize( m_searchBarInput );
		textSize = inkTextRef.GetDesiredSize( m_searchBarDefaultText );
		offset = searchBarSize.X - textSize.X;
		if( offset < 0.0 )
		{
			( ( inkTextInput )( inkTextInputRef.Get( m_searchBarInput ) ) ).SetOffsetX( offset );
		}
	}

}

class TagWidgetItem extends inkLogicController
{
	private editable var m_selfRef : inkWidgetRef;
	private editable var m_tagText : inkRichTextBoxRef;
	private editable var m_tagVerticalPanelRef : inkWidgetRef;

	public function SetTagName( inTagName : String )
	{
		inkRichTextBoxRef.SetText( m_tagText, "#" + inTagName );
	}

	public function SetCorrectSize()
	{
		var desiredSize : Vector2;
		desiredSize = inkWidgetRef.GetDesiredSize( m_tagVerticalPanelRef );
		if( desiredSize.X != 0.0 )
		{
			inkWidgetRef.SetSize( m_selfRef, desiredSize );
		}
	}

}

