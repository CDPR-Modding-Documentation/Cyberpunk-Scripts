final abstract class ModLanguageDropdownData
{

	public static function GetLanguageDropdownOption( const options : ref< array< DropdownItemData > >, identifier : inkModioLanguageTagsOptions ) : DropdownItemData
	{
		var i : Int32;
		for( i = 0; i < options.Size(); i += 1 )
		{
			if( ( ( inkModioLanguageTagsOptions )options[ i ].identifier ) == identifier )
			{
				return options[ i ];
			}
		}
		return NULL;
	}

	private static function GetDropdownItemData( identifier : Variant, labelKey : CName, direction : DropdownItemDirection ) : DropdownItemData
	{
		var itemData : DropdownItemData;
		itemData = new DropdownItemData;
		itemData.identifier = identifier;
		itemData.labelKey = labelKey;
		itemData.direction = direction;
		return itemData;
	}

	public static function GetLanguageDropdownOptions() : array< DropdownItemData >
	{
		var result : array< DropdownItemData >;
		result.PushBack( GetDropdownItemData( inkModioLanguageTagsOptions.AllLanguages, 'UI-Modio-FiltersSorting-Languages', DropdownItemDirection.None ) );
		result.PushBack( GetDropdownItemData( inkModioLanguageTagsOptions.Arabic, 'UI-Settings-Language-Arabic', DropdownItemDirection.None ) );
		result.PushBack( GetDropdownItemData( inkModioLanguageTagsOptions.Czech, 'UI-Settings-Language-Czech', DropdownItemDirection.None ) );
		result.PushBack( GetDropdownItemData( inkModioLanguageTagsOptions.German, 'UI-Settings-Language-German', DropdownItemDirection.None ) );
		result.PushBack( GetDropdownItemData( inkModioLanguageTagsOptions.English, 'UI-Settings-Language-English', DropdownItemDirection.None ) );
		result.PushBack( GetDropdownItemData( inkModioLanguageTagsOptions.Spanish, 'UI-Settings-Language-Spanish', DropdownItemDirection.None ) );
		result.PushBack( GetDropdownItemData( inkModioLanguageTagsOptions.LatinAmericaSpanish, 'UI-Settings-Language-Mexican', DropdownItemDirection.None ) );
		result.PushBack( GetDropdownItemData( inkModioLanguageTagsOptions.French, 'UI-Settings-Language-French', DropdownItemDirection.None ) );
		result.PushBack( GetDropdownItemData( inkModioLanguageTagsOptions.Hungarian, 'UI-Settings-Language-Hungarian', DropdownItemDirection.None ) );
		result.PushBack( GetDropdownItemData( inkModioLanguageTagsOptions.Italian, 'UI-Settings-Language-Italian', DropdownItemDirection.None ) );
		result.PushBack( GetDropdownItemData( inkModioLanguageTagsOptions.Japanese, 'UI-Settings-Language-Japanese', DropdownItemDirection.None ) );
		result.PushBack( GetDropdownItemData( inkModioLanguageTagsOptions.Korean, 'UI-Settings-Language-Korean', DropdownItemDirection.None ) );
		result.PushBack( GetDropdownItemData( inkModioLanguageTagsOptions.Polish, 'UI-Settings-Language-Polish', DropdownItemDirection.None ) );
		result.PushBack( GetDropdownItemData( inkModioLanguageTagsOptions.BrazilianPortuguese, 'UI-Settings-Language-Portuguese', DropdownItemDirection.None ) );
		result.PushBack( GetDropdownItemData( inkModioLanguageTagsOptions.Russian, 'UI-Settings-Language-Russian', DropdownItemDirection.None ) );
		result.PushBack( GetDropdownItemData( inkModioLanguageTagsOptions.Thai, 'UI-Settings-Language-Thai', DropdownItemDirection.None ) );
		result.PushBack( GetDropdownItemData( inkModioLanguageTagsOptions.Turkish, 'UI-Settings-Language-Turkish', DropdownItemDirection.None ) );
		result.PushBack( GetDropdownItemData( inkModioLanguageTagsOptions.Ukrainian, 'UI-Settings-Language-Ukrainian', DropdownItemDirection.None ) );
		result.PushBack( GetDropdownItemData( inkModioLanguageTagsOptions.SimplifiedChinese, 'UI-Settings-Language-Chinese', DropdownItemDirection.None ) );
		result.PushBack( GetDropdownItemData( inkModioLanguageTagsOptions.TraditionalChinese, 'UI-Settings-Language-Taiwanese', DropdownItemDirection.None ) );
		return result;
	}

}

