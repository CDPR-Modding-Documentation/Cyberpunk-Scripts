		sortingButtonController = ( ( ModSortingDropdownButtonController )( m_sortingDropdownButtonController.GetController() ) );
		sortingListController.Setup( this, ModSortingDropdownData.GetSortingDropdownOptions(), sortingButtonController );
		sortingButtonController.SetData( ModSortingDropdownData.GetSortingDropdownOption( sortingListController.GetData(), inkModioModSortingOptions.Trending ) );
		languageListController = m_languageDropdownListController;
		languageButtonController = ( ( LanguageDropdownButtonController )( m_languageDropdownButtonController.GetController() ) );
		languageListController.Setup( this, ModLanguageDropdownData.GetLanguageDropdownOptions(), languageButtonController );
		languageButtonController.SetData( ModLanguageDropdownData.GetLanguageDropdownOption( languageListController.GetData(), inkModioLanguageTagsOptions.AllLanguages ) );
	}

