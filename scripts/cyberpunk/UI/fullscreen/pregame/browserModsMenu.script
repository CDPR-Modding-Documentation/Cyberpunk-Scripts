class BrowserModsMenuGameController extends ModioBrowserMenuGameController
{
	private editable var m_BrowserMenuTitleText : inkWidgetRef;
	private editable var m_CollectionMenuTitleText : inkWidgetRef;
	private editable var m_buttonHintsManagerRef : inkWidgetRef;
	private editable var m_modPickerRef : inkWidgetRef;
	private editable var m_filterPickerRef : inkWidgetRef;
	private editable var m_modioBrowserHeaderTitle : inkTextRef;
	private editable var m_modioCollectionHeaderTitle : inkTextRef;
	private editable var m_modDetailsPanelSnapshot : inkWidgetRef;
	private editable var m_PageSelectorPanelRef : inkCompoundRef;
	private editable var m_modLimitNumberOfModsEnabledText : inkTextRef;
	private editable var m_leftPageArrowRef : inkWidgetRef;
	private editable var m_rightPageArrowRef : inkWidgetRef;
	private editable var m_searchBarControllerRef : inkWidgetRef;
	private editable var m_searchBarTextInput : inkTextInputRef;
	private editable var m_searchBarArea : inkWidgetRef;
	private editable var m_sortingDropdownButtonManagerRef : inkWidgetRef;
	private editable var m_sortingDropdownListManagerRef : inkWidgetRef;
	private editable var m_languageDropdownButtonManagerRef : inkWidgetRef;
	private editable var m_languageDropdownListManagerRef : inkWidgetRef;
	private editable var m_matureContentCheckboxManagerRef : inkWidgetRef;
	private editable var m_likedContentCheckboxManagerRef : inkWidgetRef;
	private editable var m_playerUserNameText : inkTextRef;
	private editable var m_numberOfModsText : inkTextRef;
	private editable var m_modListChangedCanvas : inkWidgetRef;
	private editable var m_modlistChangedText : inkTextRef;
	private editable var m_modVerificationPopupText : inkTextRef;
	private editable var m_tooltipManagerRef : inkWidgetRef;
	private editable var m_spaceInfoTextRef : inkTextRef;
	private var m_tooltipManager : weak< gameuiTooltipsManager >;
	private var m_menuNavigationController : weak< inkContainerNavigationController >;
	private var m_buttonHintsController : weak< ButtonHints >;
	var m_sortingDropdownListController : weak< ModSortingDropdownListController >;
	private var m_sortingDropdownButtonController : weak< ModSortingDropdownButtonController >;
	var m_languageDropdownCheckboxListController : weak< LanguageDropdownCheckboxListController >;
	var m_languageDropdownListController : weak< LanguageDropdownListController >;
	private var m_languageDropdownButtonController : weak< LanguageDropdownButtonController >;
	private var m_modPickerController : weak< browserModsMenuModPicker >;
	private var m_filterPickerController : weak< filterModsMenuModPicker >;
	private var m_matureContentAndEnableAllModsCheckboxController : weak< MatureContentCheckbox >;
	private var m_likedFilterCheckboxController : weak< LikedFilterCheckbox >;
	private var m_eventDispatcher : weak< inkMenuEventDispatcher >;
	private var m_modDetailItem : weak< ModDetailsItem >;
	private var m_subscribeToModController : weak< SubscribeToModButtonController >;
	private var m_likeController : weak< LikeButtonController >;
	private var m_authorController : weak< FromAuthorButtonController >;
	private var m_moreOptionsController : weak< MoreOptionsButtonController >;
	private var m_modsearchBarController : weak< ModMenuSearchBarController >;
	private var m_downloadProgressBarController : weak< ModPanelDownloadProgressBarController >;
	private var m_PageSelectorItemWidgetList : array< weak< inkWidget > >;
	private var m_IgnoreNextEnableAction : Bool;
	private var m_IsInBrowserMenu : Bool;
	private var m_currentlySelectedModEntry : weak< ModEntryItem >;
	private var m_leftPageArrowController : weak< ModPaginationArrowController >;
	private var m_rightPageArrowController : weak< ModPaginationArrowController >;
	private var m_filterDrawer : weak< ModMenuFilterDrawer >;
	private editable var m_selectedFilterSpawner : inkWidgetRef;
	private var m_selectedFilterSpawnerController : weak< SelectedFilterGroup >;
	private var m_moreFilterTooltipString : String;
	private editable var m_showFiltersButtonRef : inkWidgetRef;
	private var m_showFilterButtonController : weak< ShowFilterButton >;
	private var m_hiddenModsInfoList : array< ModioModInfos >;
	private var m_bIsInGallery : Bool;
	default m_bIsInGallery = false;
	private var m_systemHandler : weak< inkISystemRequestsHandler >;
	private var m_bCurrentlySelectedModIsEnabled : Bool;
	private var m_modioReportController : weak< ModioReportController >;
	private var m_currentSelectedModID : Int64;
	private var m_currentSelectedModName : String;
	private var m_onlineSystem : weak< IOnlineSystem >;
	private var m_isOffline : Bool;
	private var m_bIsOpenIMGDialog : Bool;
	private var m_bIsModHovered : Bool;
	default m_bIsModHovered = false;
	private var m_bIsUserSubscribedToHoveredMod : Bool;
	default m_bIsUserSubscribedToHoveredMod = false;
	var m_bStopListeningToInput : Bool;
	default m_bStopListeningToInput = false;
	private var m_searchBarNavigableComponent : weak< AnimatedListItemController >;
	private var m_listOfNavigableComponents : array< weak< inkDiscreteNavigationController > >;
	private var m_isNavigationActivated : Bool;
	private var m_waitingForNewModListState : Bool;

	protected event OnInitialize()
	{
		var generalFluffWidget : inkWidget;
		super.OnInitialize();
		m_systemHandler = GetSystemRequestsHandler();
		m_tooltipManager = ( ( gameuiTooltipsManager )( inkWidgetRef.GetControllerByType( m_tooltipManagerRef, 'gameuiTooltipsManager' ) ) );
		m_tooltipManager.Setup( ETooltipsStyle.Menus );
		m_menuNavigationController = ( ( inkContainerNavigationController )( inkWidgetRef.GetControllerByType( m_tooltipManagerRef, 'inkContainerNavigationController' ) ) );
		m_menuNavigationController.SetInputDisabled( true );
		m_IgnoreNextEnableAction = false;
		m_IsInBrowserMenu = true;
		m_isNavigationActivated = true;
		m_waitingForNewModListState = true;
		inkTextRef.SetVisible( m_modVerificationPopupText, false );
		inkTextRef.SetText( m_playerUserNameText, "" );
		SetupReport();
		m_buttonHintsController = ( ( ButtonHints )( SpawnFromExternal( inkWidgetRef.Get( m_buttonHintsManagerRef ), R"base\gameplay\gui\common\buttonhints.inkwidget", 'Root' ).GetController() ) );
		m_matureContentAndEnableAllModsCheckboxController = ( ( MatureContentCheckbox )( inkWidgetRef.GetController( m_matureContentCheckboxManagerRef ) ) );
		m_matureContentAndEnableAllModsCheckboxController.InitializeCheckbox( this );
		m_likedFilterCheckboxController = ( ( LikedFilterCheckbox )( inkWidgetRef.GetController( m_likedContentCheckboxManagerRef ) ) );
		m_likedFilterCheckboxController.InitializeCheckbox( this );
		SetMaxEnteredChars( ( ( weak< weak< inkTextInput > > )( inkTextInputRef.Get( m_searchBarTextInput ) ) ) );
		m_searchBarNavigableComponent = ( ( AnimatedListItemController )( inkWidgetRef.GetControllerByType( m_searchBarArea, 'AnimatedListItemController' ) ) );
		AddToListOfNavigables( m_searchBarNavigableComponent );
		m_modsearchBarController = ( ( ModMenuSearchBarController )( inkWidgetRef.GetController( m_searchBarControllerRef ) ) );
		m_modsearchBarController.SetOwnerMenu( this );
		generalFluffWidget = SpawnFromExternal( GetRootWidget(), R"base\gameplay\gui\fullscreen\common\general_fluff.inkwidget", 'Root' );
		if( IsPregame() )
		{
			generalFluffWidget.SetMargin( 0.0, -40.0, 0.0, 0.0 );
		}
		else
		{
			generalFluffWidget.SetMargin( 0.0, -80.0, 0.0, 0.0 );
		}
		SetupDropdown();
		InitializeModGrid();
		CreatePageItems();
		CreateFilters();
		inkTextRef.SetText( m_modioBrowserHeaderTitle, GetLocalizedText( "UI-Modio-MenuContent-Browser" ) );
		inkTextRef.SetText( m_modioCollectionHeaderTitle, GetLocalizedText( "UI-Modio-MenuContent-Collection" ) );
		inkTextRef.SetText( m_modlistChangedText, GetLocalizedText( "UI-Modio-ErrorMessages-WarningApplyChanges" ) );
		CreateModDetailsPanel();
		SwitchToBrowserView();
		RegisterMenuToCallbacks();
		m_onlineSystem = GameInstance.GetOnlineSystem( GetPlayerControlledObject().GetGame() );
	}

	public function IsPregame() : Bool
	{
		return bIsPregame;
	}

	private function RegisterMenuToCallbacks()
	{
		var platformName : String;
		RegisterToGlobalInputCallback( 'OnPostOnRelease', this, 'OnButtonRelease' );
		RegisterToGlobalInputCallback( 'OnPostOnHold', this, 'OnHoldInput' );
		RegisterToCallback( 'OnMenuUpdate', this, 'OnMenuUpdate' );
		RegisterToCallback( 'OnSearchbarUpdate', this, 'OnSearchbarUpdate' );
		RegisterToCallback( 'OnModDetailsUpdate', this, 'OnModDetailsUpdate' );
		RegisterToCallback( 'OnButtonHintsUpdateRequested', this, 'OnButtonHintsUpdateRequested' );
		RegisterToCallback( 'OnNewModSelected', this, 'OnNewModSelected' );
		RegisterToCallback( 'OnProcessedModProgressUpdate', this, 'OnProcessedModProgressUpdate' );
		RegisterToCallback( 'OnListOfModsToDisplayUpdated', this, 'OnListOfModsToDisplayUpdated' );
		RegisterToCallback( 'OnPagesLayoutChanged', this, 'OnPagesLayoutChanged' );
		RegisterToCallback( 'OnSwitchBetweenBrowserAndCollectionMenu', this, 'OnSwitchBetweenBrowserAndCollectionMenu' );
		RegisterToCallback( 'OnRequestLogoForWidget', this, 'OnRequestLogoForWidget' );
		RegisterToCallback( 'OnRequestedGalleryOnServer', this, 'OnRequestedGalleryOnServer' );
		RegisterToCallback( 'OnRequestGalleryForWidget', this, 'OnRequestGalleryForWidget' );
		RegisterToCallback( 'OnUserIdResult', this, 'OnUserIdResult' );
		RegisterToCallback( 'OnLogoDownloadRequested', this, 'OnLogoDownloadRequested' );
		RegisterToCallback( 'OnAllLanguagesCheckboxClicked', this, 'OnAllLanguagesCheckboxClicked' );
		RegisterToCallback( 'OnCheckIfEnabledModsListChanged', this, 'OnCheckIfEnabledModsListChanged' );
		RegisterToCallback( 'OnRateLimitedErrorReceived', this, 'OnRateLimitedErrorReceived' );
		RegisterToCallback( 'OnRateLimitedErrorLifted', this, 'OnRateLimitedErrorLifted' );
		RegisterToCallback( 'OnUpdateModVerificationPopupCount', this, 'OnUpdateModVerificationPopupCount' );
		RegisterToCallback( 'OnModTagsReceived', this, 'OnModTagsReceived' );
		RegisterToCallback( 'OnDelayedSpawnForFilters', this, 'OnDelayedSpawnForFilters' );
		RegisterToCallback( 'OnDelayedSliderAdjustForDrawer', this, 'OnDelayedSliderAdjustForDrawer' );
		RegisterToCallback( 'OnHiddenModListUpdated', this, 'OnHiddenModListUpdated' );
		RegisterToCallback( 'OnAskedForNewModList', this, 'OnAskedForNewModList' );
		m_sortingDropdownButtonController.RegisterToCallback( 'OnRelease', this, 'OnSortingButtonClicked' );
		m_languageDropdownButtonController.RegisterToCallback( 'OnRelease', this, 'OnLanguageButtonClicked' );
		inkTextInputRef.RegisterToCallback( m_searchBarTextInput, 'OnTextChanged', this, 'OnTextChanged' );
		inkWidgetRef.RegisterToCallback( m_BrowserMenuTitleText, 'OnRelease', this, 'OnBrowserMenuTextClicked' );
		inkWidgetRef.RegisterToCallback( m_CollectionMenuTitleText, 'OnRelease', this, 'OnCollectionMenuTextClicked' );
		platformName = GetPlatformShortName();
		if( ( ( ( platformName == "ps5" || platformName == "ps5pro" ) || platformName == "xseriesx" ) || platformName == "xseriess" ) || platformName == "emporium" )
		{
			inkTextInputRef.SetInteractive( m_searchBarTextInput, false );
			inkWidgetRef.SetInteractive( m_searchBarArea, true );
			inkWidgetRef.RegisterToCallback( m_searchBarArea, 'OnPress', this, 'OnSearchBarPress' );
			inkWidgetRef.RegisterToCallback( m_searchBarArea, 'OnHoverOut', this, 'OnSearchBarHoverOut' );
		}
		if( ( platformName == "mac" || platformName == "windows" ) || platformName == "windowsGDK" )
		{
			inkWidgetRef.SetInteractive( m_searchBarArea, true );
			inkWidgetRef.RegisterToCallback( m_searchBarArea, 'OnPress', this, 'OnSearchBarPress' );
		}
	}

	protected event OnRateLimitedErrorReceived()
	{
		m_modPickerController.SetWarningStateOnGrid();
		m_modDetailItem.SetEmptyDataState();
	}

	protected event OnRateLimitedErrorLifted()
	{
		m_modPickerController.RemoveWarningStateOnGrid();
	}

	protected event OnCheckIfEnabledModsListChanged( bEnabledModsListChanged : Bool )
	{
		inkWidgetRef.SetVisible( m_modListChangedCanvas, bEnabledModsListChanged );
	}

	protected event OnBrowserMenuTextClicked( evt : inkPointerEvent )
	{
		if( evt.IsAction( 'click' ) || evt.IsAction( 'tap' ) )
		{
			PlaySound( 'Button', 'OnPress' );
			if( !( m_IsInBrowserMenu ) )
			{
				SwitchBetweenBrowserAndCollectionMenu();
			}
		}
	}

	public function SetIsInGallery( bIsInGallery : Bool )
	{
		m_bIsInGallery = bIsInGallery;
	}

	public function OnHiddenManagerOpened()
	{
		m_bStopListeningToInput = true;
		m_modDetailItem.SetScrollbarEnable( !( m_bStopListeningToInput ) );
	}

	public function OnHiddenManagerClosed()
	{
		m_bStopListeningToInput = false;
		m_modDetailItem.SetScrollbarEnable( !( m_bStopListeningToInput ) );
	}

	public function IsReportPopupOpen() : Bool
	{
		return m_modioReportController && !( m_modioReportController.IsClosed() );
	}

	public function IsFilterDrawerOpen() : Bool
	{
		return m_filterDrawer.IsOpen();
	}

	public function ShouldIgnoreInput() : Bool
	{
		return ( IsReportPopupOpen() || IsFilterDrawerOpen() ) || m_bStopListeningToInput;
	}

	protected event OnCollectionMenuTextClicked( evt : inkPointerEvent )
	{
		if( evt.IsAction( 'click' ) || evt.IsAction( 'tap' ) )
		{
			PlaySound( 'Button', 'OnPress' );
			if( m_IsInBrowserMenu )
			{
				SwitchBetweenBrowserAndCollectionMenu();
			}
		}
	}

	private export function SetPlayerName( playerName : String )
	{
		if( ( !( IsFinal() ) && ( GetPlatformShortName() == "windows" || GetPlatformShortName() == "windowsGDK" ) ) && playerName == "" )
		{
			return;
		}
		inkTextRef.SetText( m_playerUserNameText, playerName );
	}

	private export function PushErrorPopup( title : CName, description : CName, optional errorCode : Uint32 )
	{
		var errorPopupEvt : OpenExpansionErrorPopupEvent;
		errorPopupEvt = new OpenExpansionErrorPopupEvent;
		errorPopupEvt.m_title = title;
		errorPopupEvt.m_description = description;
		errorPopupEvt.m_errorCode = errorCode;
		errorPopupEvt.m_modMenu = this;
		QueueBroadcastEvent( errorPopupEvt );
	}

	public export function WarnAboutImpossibleActionInPauseMenu()
	{
		m_systemHandler.RequestSystemNotificationGeneric( 'UI-Modio-ErrorMessages-PopupTitle', 'UI-Modio-Tooltips-PreventActionInPause' );
	}

	private function InitializeModGrid()
	{
		m_modPickerController = ( ( browserModsMenuModPicker )( inkWidgetRef.GetController( m_modPickerRef ) ) );
		m_modPickerController.InitializeGrid( this );
	}

	private function CreatePageItems()
	{
		var i : Int32;
		var currentlyCreatedWidget : inkWidget;
		var currentPageSelectorItem : weak< PageSelectorItem >;
		for( i = 0; i < 9; i += 1 )
		{
			currentlyCreatedWidget = SpawnFromLocal( inkCompoundRef.Get( m_PageSelectorPanelRef ), 'PageSelectorItem' );
			currentPageSelectorItem = ( ( PageSelectorItem )( currentlyCreatedWidget.GetController() ) );
			currentPageSelectorItem.SetOwnerMenu( this );
			currentPageSelectorItem.HidePageItem( this );
			m_PageSelectorItemWidgetList.PushBack( currentlyCreatedWidget );
		}
		m_leftPageArrowController = ( ( ModPaginationArrowController )( inkWidgetRef.GetController( m_leftPageArrowRef ) ) );
		m_leftPageArrowController.InitializeModPaginationArrow( true, this );
		m_rightPageArrowController = ( ( ModPaginationArrowController )( inkWidgetRef.GetController( m_rightPageArrowRef ) ) );
		m_rightPageArrowController.InitializeModPaginationArrow( false, this );
	}

	private function SetupDropdown()
	{
		m_sortingDropdownListController = ( ( ModSortingDropdownListController )( inkWidgetRef.GetController( m_sortingDropdownListManagerRef ) ) );
		m_sortingDropdownButtonController = ( ( ModSortingDropdownButtonController )( SpawnFromLocal( inkWidgetRef.Get( m_sortingDropdownButtonManagerRef ), 'SortingDropdownButton' ).GetController() ) );
		m_sortingDropdownButtonController.SetOwnerMenu( this );
		m_sortingDropdownListController.SetOwnerMenu( this );
		UpdateDropdownContext();
	}

	public function ActivateNavigation()
	{
		var i : Int32;
		m_menuNavigationController.ActivateNavigationCallback();
		m_isNavigationActivated = true;
		for( i = 0; i < m_listOfNavigableComponents.Size(); i += 1 )
		{
			m_listOfNavigableComponents[ i ].SetNavigable( true );
		}
	}

	public function DeactivateNavigation()
	{
		var i : Int32;
		m_isNavigationActivated = false;
		m_menuNavigationController.DeactivateNavigationCallback();
		for( i = 0; i < m_listOfNavigableComponents.Size(); i += 1 )
		{
			m_listOfNavigableComponents[ i ].SetNavigable( false );
		}
	}

	public function ActivateNavigables()
	{
		var i : Int32;
		for( i = 0; i < m_listOfNavigableComponents.Size(); i += 1 )
		{
			m_listOfNavigableComponents[ i ].SetNavigable( true );
		}
	}

	public function DeactivateNavigables()
	{
		var i : Int32;
		for( i = 0; i < m_listOfNavigableComponents.Size(); i += 1 )
		{
			m_listOfNavigableComponents[ i ].SetNavigable( false );
		}
	}

	public function GetIsNavigationActive() : Bool
	{
		return m_isNavigationActivated;
	}

	public function AddToListOfNavigables( inNavigable : inkDiscreteNavigationController )
	{
		m_listOfNavigableComponents.PushBack( inNavigable );
		inNavigable.SetNavigable( m_isNavigationActivated );
	}

	public function RemoveFromListOfNavigables( inNavigable : inkDiscreteNavigationController )
	{
		m_listOfNavigableComponents.Remove( inNavigable );
	}

	public function AskIfUserReallyWantToUnsubscribe()
	{
		var previewEvent : ModioConfirmUninstallPopupEvent;
		previewEvent = new ModioConfirmUninstallPopupEvent;
		previewEvent.m_data = new ModioConfirmUninstallData;
		previewEvent.m_data.queueName = 'modio_uninstallConfirm';
		previewEvent.m_data.notificationName = 'base\gameplay\gui\fullscreen\main_menu\modio\modio_uninstall_confirmation_popup.inkwidget';
		previewEvent.m_data.isBlocking = true;
		previewEvent.m_data.useCursor = true;
		previewEvent.m_data.m_ownerMenu = this;
		QueueBroadcastEvent( previewEvent );
	}

	public function OnUninstallModConfirmationPopupClosed( bConfirmUninstall : Bool, bDoNotDisplayThePopupAgain : Bool )
	{
		if( bConfirmUninstall )
		{
			SubscribeToModButtonClicked( false );
			if( bDoNotDisplayThePopupAgain )
			{
				StopDisplayUninstallConfirmationPopup();
			}
		}
	}

	private function UpdateDropdownContext()
	{
		var sortingListController : ModSortingDropdownListController;
		var sortingButtonController : ModSortingDropdownButtonController;
		var languageListController : LanguageDropdownListController;
		var languageButtonController : LanguageDropdownButtonController;
