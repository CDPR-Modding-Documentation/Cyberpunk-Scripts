	import var gallerySize : Int64;
	import var localizedTags : array< String >;
}

import struct ModioModProgressInfo
{
	import var modID : Int64;
	import var progressState : inkModioModProgressState;
	import var progressRate : Float;
	import var progressText : String;
}

