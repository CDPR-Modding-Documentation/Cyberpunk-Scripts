class MoreOptionsButtonController extends DropdownButtonController
{
	private editable var m_arrowFill : inkImageRef;
	protected editable var m_buttonText : inkTextRef;
	protected editable var m_buttonIcon : inkImageRef;
	protected editable var m_buttonCore : inkWidgetRef;
	protected editable var m_buttonBorder : inkWidgetRef;
	private var m_ownerWidget : weak< ModDetailsItem >;
	private var m_ownerMenu : weak< BrowserModsMenuGameController >;
	private var m_colorNames : ModsMenuColorsNames;
	private var m_isDisabled : Bool;

	protected event OnInitialize()
	{
		m_isDisabled = false;
		RegisterToCallback( 'OnRelease', this, 'OnRelease' );
		RegisterToCallback( 'OnHoverOver', this, 'OnHoverOver' );
		RegisterToCallback( 'OnHoverOut', this, 'OnHoverOut' );
		SetDefaultColor();
	}

	protected event OnUninitialize()
	{
		UnregisterFromCallback( 'OnRelease', this, 'OnRelease' );
		UnregisterFromCallback( 'OnHoverOver', this, 'OnHoverOver' );
		UnregisterFromCallback( 'OnHoverOut', this, 'OnHoverOut' );
	}

	private function SetDefaultColor()
	{
		inkTextRef.Get( m_buttonText ).BindProperty( 'tintColor', m_colorNames.redName );
		inkImageRef.Get( m_arrow ).BindProperty( 'tintColor', m_colorNames.redName );
		inkWidgetRef.Get( m_buttonCore ).BindProperty( 'tintColor', m_colorNames.fullscreenRedDarkBackgroundName );
		inkWidgetRef.Get( m_buttonBorder ).BindProperty( 'tintColor', m_colorNames.darkerRedName );
	}

	private function SetHoveredColor()
	{
		inkTextRef.Get( m_buttonText ).BindProperty( 'tintColor', m_colorNames.activeBlueName );
		inkImageRef.Get( m_arrow ).BindProperty( 'tintColor', m_colorNames.activeBlueName );
		inkWidgetRef.Get( m_buttonCore ).BindProperty( 'tintColor', m_colorNames.fullscreenPrimaryBackgroundDarkName );
		inkWidgetRef.Get( m_buttonBorder ).BindProperty( 'tintColor', m_colorNames.mildBlueName );
	}

	private function SetDisabledColor()
	{
		inkTextRef.Get( m_buttonText ).BindProperty( 'tintColor', m_colorNames.panelDarkGreyName );
		inkImageRef.Get( m_arrow ).BindProperty( 'tintColor', m_colorNames.panelDarkGreyName );
		inkWidgetRef.Get( m_buttonCore ).BindProperty( 'tintColor', m_colorNames.panelDarkestGreyName );
		inkWidgetRef.Get( m_buttonBorder ).BindProperty( 'tintColor', m_colorNames.panelDarkerGreyName );
	}

	protected event OnHoverOver( e : inkPointerEvent )
	{
		if( m_ownerMenu.ShouldIgnoreInput() )
		{
			return true;
		}
		if( !( m_isDisabled ) )
		{
			SetHoveredColor();
		}
	}

	protected event OnHoverOut( e : inkPointerEvent )
	{
		if( !( m_isDisabled ) )
		{
			SetDefaultColor();
		}
		else
		{
			SetDisabledColor();
		}
	}

	protected event OnRelease( evt : inkPointerEvent )
	{
		if( m_ownerMenu.ShouldIgnoreInput() )
		{
			return true;
		}
		if( evt.IsAction( 'click' ) || evt.IsAction( 'tap' ) )
		{
			PlaySound( 'Button', 'OnPress' );
			m_ownerWidget.m_moreOptionsDropdownListController.Toggle();
		}
	}

	public function SetIsDisabled( bInDisabled : Bool )
	{
		var bChanged : Bool;
		bChanged = m_isDisabled != bInDisabled;
		m_isDisabled = bInDisabled;
		if( m_isDisabled && bChanged )
		{
			SetDisabledColor();
			UnregisterFromCallback( 'OnRelease', this, 'OnRelease' );
		}
		else if( !( m_isDisabled ) && bChanged )
		{
			RegisterToCallback( 'OnRelease', this, 'OnRelease' );
			SetDefaultColor();
		}
	}

	public function SetOwnerMenu( inMenu : BrowserModsMenuGameController )
	{
		m_ownerMenu = inMenu;
	}

	public function SetOwnerWidget( inWidget : weak< ModDetailsItem > )
	{
		m_ownerWidget = inWidget;
	}

}

class ModPanelDownloadProgressBarController extends LoadingScreenProgressBarController
{
	protected editable var spinnerFluff : inkWidgetRef;
	protected editable var textFluff : inkWidgetRef;
	protected editable var progressText : inkTextRef;
	private var m_ownerMenu : weak< BrowserModsMenuGameController >;

	protected event OnInitialize()
	{
		super.OnInitialize();
	}

	protected event OnUninitialize()
	{
		super.OnUninitialize();
	}

	public function SetOwnerMenu( inMenu : BrowserModsMenuGameController )
	{
		m_ownerMenu = inMenu;
	}

	public function SetGlobalVisibility( visible : Bool )
	{
		SetProgressBarVisiblity( visible );
		SetSpinnerVisibility( visible );
		inkWidgetRef.SetVisible( spinnerFluff, visible );
		inkWidgetRef.SetVisible( textFluff, visible );
		inkTextRef.SetVisible( progressText, visible );
	}

	public function SetProgressTextFromProgress( state : inkModioModProgressState )
	{
		switch( state )
		{
			case inkModioModProgressState.Downloading:
				inkTextRef.SetText( progressText, GetLocalizedText( "UI-Modio-MenuContent-Download" ) );
			break;
			case inkModioModProgressState.Extracting:
				inkTextRef.SetText( progressText, GetLocalizedText( "UI-Modio-MenuContent-Extract" ) );
			break;
			case inkModioModProgressState.CleaningUp:
				inkTextRef.SetText( progressText, GetLocalizedText( "UI-Modio-MenuContent-CleanUp" ) );
			break;
			default:
				inkTextRef.SetText( progressText, "" );
			break;
		}
	}

}

class ModItemDownloadProgressBarController extends LoadingScreenProgressBarController
{
	protected editable var backgroundOpacity : inkWidgetRef;
	protected editable var progressText : inkTextRef;
	private var m_ownerMenu : weak< BrowserModsMenuGameController >;

	protected event OnInitialize()
	{
		super.OnInitialize();
	}

	protected event OnUninitialize()
	{
		super.OnUninitialize();
	}

	public function SetOwnerMenu( inMenu : BrowserModsMenuGameController )
	{
		m_ownerMenu = inMenu;
	}

	public function SetGlobalVisibility( visible : Bool )
	{
		SetProgressBarVisiblity( visible );
		inkWidgetRef.SetVisible( backgroundOpacity, visible );
		inkTextRef.SetVisible( progressText, visible );
	}

	public function SetProgressBarVisibility( visible : Bool )
	{
		SetProgressBarVisiblity( visible );
	}

	public function SetProgressTextFromProgress( state : inkModioModProgressState )
	{
		switch( state )
		{
			case inkModioModProgressState.Downloading:
				inkTextRef.SetText( progressText, GetLocalizedTextByKey( 'UI-Modio-MenuContent-Download' ) );
			break;
			case inkModioModProgressState.Extracting:
				inkTextRef.SetText( progressText, GetLocalizedTextByKey( 'UI-Modio-MenuContent-Extract' ) );
			break;
			case inkModioModProgressState.CleaningUp:
				inkTextRef.SetText( progressText, GetLocalizedTextByKey( 'UI-Modio-MenuContent-CleanUp' ) );
			break;
			default:
				inkTextRef.SetText( progressText, "" );
			break;
		}
	}

	public function SetProgressTextFromModState( state : inkModioModState )
	{
		switch( state )
		{
			case inkModioModState.InstallationPending:
				inkTextRef.SetText( progressText, GetLocalizedTextByKey( 'UI-Modio-MenuContent-VerifModPendInstall' ) );
			break;
			case inkModioModState.Installed:
				inkTextRef.SetText( progressText, "" );
			break;
			case inkModioModState.UpdatePending:
				inkTextRef.SetText( progressText, GetLocalizedTextByKey( 'UI-Modio-MenuContent-VerifModPendUpdate' ) );
			break;
			case inkModioModState.Downloading:
				inkTextRef.SetText( progressText, GetLocalizedTextByKey( 'UI-Modio-MenuContent-Download' ) );
			break;
			case inkModioModState.Extracting:
				inkTextRef.SetText( progressText, GetLocalizedTextByKey( 'UI-Modio-MenuContent-Extract' ) );
			break;
			case inkModioModState.UninstallPending:
				inkTextRef.SetText( progressText, GetLocalizedTextByKey( 'UI-Modio-MenuContent-PendUninstall' ) );
			break;
			case inkModioModState.Reconciling:
				inkTextRef.SetText( progressText, GetLocalizedTextByKey( 'UI-Modio-MenuContent-Reconciling' ) );
			break;
			default:
				inkTextRef.SetText( progressText, "" );
			break;
		}
	}

}

class PageSelectorItem extends inkButtonController
{
	editable var m_pageNumberText : inkTextRef;
	private editable var m_underlineIcon : inkWidgetRef;
	var m_pageNumber : Int32;
	private var m_isSeparator : Bool;
	private var m_isSelected : Bool;
	private var m_isRegistered : Bool;
	private var m_ownerMenu : weak< BrowserModsMenuGameController >;

	protected event OnInitialize()
	{
		SetUnselectedColor();
		RegisterToCallback( 'OnHoverOver', this, 'OnHoverOver' );
		RegisterToCallback( 'OnHoverOut', this, 'OnHoverOut' );
		m_isRegistered = false;
	}

	protected event OnUninitialize()
	{
		UnregisterFromCallback( 'OnHoverOver', this, 'OnHoverOver' );
		UnregisterFromCallback( 'OnHoverOut', this, 'OnHoverOut' );
	}

	public function SetOwnerMenu( inMenu : BrowserModsMenuGameController )
	{
		m_ownerMenu = inMenu;
	}

	public function ShowPageItem( ownerMenu : ModioBrowserMenuGameController, pageNumber : Int32, currentlySelectedPageNumber : Int32 )
	{
		SetPageNumber( pageNumber );
		if( !( m_isRegistered ) )
		{
			RegisterToCallback( 'OnRelease', ownerMenu, 'OnPageClicked' );
		}
		GetRootWidget().SetVisible( true );
		GetRootWidget().SetInteractive( true );
		m_ownerMenu.AddToListOfNavigables( this );
		SetNavigable( m_ownerMenu.GetIsNavigationActive() );
		SetIsSelected( currentlySelectedPageNumber == pageNumber );
		m_isRegistered = true;
	}

	protected event OnHoverOver( e : inkPointerEvent )
	{
		PlaySound( 'Button', 'OnHover' );
		if( !( m_isSeparator ) && !( m_ownerMenu.ShouldIgnoreInput() ) )
		{
			inkTextRef.Get( m_pageNumberText ).BindProperty( 'tintColor', 'MainColors.Blue' );
		}
	}

	protected event OnHoverOut( e : inkPointerEvent )
	{
		if( !( m_isSelected ) )
		{
			inkTextRef.Get( m_pageNumberText ).BindProperty( 'tintColor', 'MainColors.Red' );
		}
	}

	public function SetAsPageSeparator( ownerMenu : ModioBrowserMenuGameController )
	{
		SetPageNumber( 0 );
		inkTextRef.SetText( m_pageNumberText, "..." );
		m_isSeparator = true;
		UnregisterFromCallback( 'OnRelease', ownerMenu, 'OnPageClicked' );
		m_isRegistered = false;
		GetRootWidget().SetInteractive( false );
		m_ownerMenu.RemoveFromListOfNavigables( this );
		SetNavigable( false );
		GetRootWidget().SetVisible( true );
		SetUnselectedColor();
	}

	public function HidePageItem( ownerMenu : ModioBrowserMenuGameController )
	{
		SetPageNumber( 0 );
		UnregisterFromCallback( 'OnRelease', ownerMenu, 'OnPageClicked' );
		m_ownerMenu.RemoveFromListOfNavigables( this );
		m_isRegistered = false;
		GetRootWidget().SetVisible( false );
	}

	public function SetPageNumber( pageNumber : Int32 )
	{
		m_pageNumber = pageNumber;
		m_isSeparator = false;
		inkTextRef.SetText( m_pageNumberText, ( ( String )( pageNumber ) ) );
	}

	public function SetIsSelected( bSelected : Bool )
	{
		m_isSelected = bSelected;
		if( bSelected )
		{
			SetSelectedColor();
		}
		else
		{
			SetUnselectedColor();
		}
	}

	private function SetUnselectedColor()
	{
		inkTextRef.Get( m_pageNumberText ).BindProperty( 'tintColor', 'MainColors.Red' );
		inkWidgetRef.Get( m_underlineIcon ).BindProperty( 'tintColor', 'MainColors.Red' );
	}

	private function SetSelectedColor()
	{
		inkTextRef.Get( m_pageNumberText ).BindProperty( 'tintColor', 'MainColors.Blue' );
		inkWidgetRef.Get( m_underlineIcon ).BindProperty( 'tintColor', 'MainColors.Blue' );
	}

}

class ModPaginationArrowController extends PaginationArrowController
{
	private var m_bIsLeftArrow : Bool;
	private var m_ownerMenu : weak< BrowserModsMenuGameController >;

	protected event OnInitialize()
	{
		super.OnInitialize();
		RegisterToCallback( 'OnRelease', this, 'OnArrowClicked' );
	}

	protected event OnUninitialize()
	{
		super.OnUninitialize();
		UnregisterFromCallback( 'OnRelease', this, 'OnArrowClicked' );
	}

	public function InitializeModPaginationArrow( bInIsLeftArrow : Bool, inOwnerMenu : weak< BrowserModsMenuGameController > )
	{
		m_bIsLeftArrow = bInIsLeftArrow;
		m_ownerMenu = inOwnerMenu;
	}

	protected event OnArrowClicked( e : inkPointerEvent )
	{
		if( m_ownerMenu.ShouldIgnoreInput() )
		{
			return true;
		}
		PlaySound( 'Button', 'OnPress' );
		if( e.IsAction( 'click' ) || e.IsAction( 'tap' ) )
		{
			if( m_bIsLeftArrow )
			{
				m_ownerMenu.GoToPreviousPage();
			}
			else
			{
				m_ownerMenu.GoToNextPage();
			}
		}
	}

	protected event OnHoverOver( e : inkPointerEvent )
	{
		if( !( m_ownerMenu.ShouldIgnoreInput() ) )
		{
			super.OnHoverOver( e );
		}
	}

}

