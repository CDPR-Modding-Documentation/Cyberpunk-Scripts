class GenericModButtonController extends AnimatedListItemController
{
	protected editable var m_buttonText : inkTextRef;
	protected editable var m_buttonIcon : inkImageRef;
	protected editable var m_buttonCore : inkWidgetRef;
	protected editable var m_buttonBorder : inkWidgetRef;
	protected var m_ownerMenu : weak< BrowserModsMenuGameController >;
	protected var m_isForFunction : Bool;
	private var m_isSelected : Bool;
	private var m_colorNames : ModsMenuColorsNames;
	protected var m_isDisabled : Bool;
	protected var m_isHovered : Bool;

	protected event OnInitialize()
	{
		m_isHovered = false;
		RegisterToCallback( 'OnRelease', this, 'OnRelease' );
		RegisterToCallback( 'OnHoverOver', this, 'OnHoverOver' );
		RegisterToCallback( 'OnHoverOut', this, 'OnHoverOut' );
		super.OnInitialize();
	}

	protected event OnUninitialize()
	{
		UnregisterFromCallback( 'OnRelease', this, 'OnRelease' );
		UnregisterFromCallback( 'OnHoverOver', this, 'OnHoverOver' );
		UnregisterFromCallback( 'OnHoverOut', this, 'OnHoverOut' );
		super.OnUninitialize();
	}

	protected event OnHoverOver( e : inkPointerEvent )
	{
		m_isHovered = true;
		if( m_ownerMenu.IsReportPopupOpen() )
		{
			return true;
		}
		if( !( m_isDisabled ) )
		{
			ApplyHoveredColor();
		}
	}

	protected event OnHoverOut( e : inkPointerEvent )
	{
		m_isHovered = false;
		if( m_ownerMenu.IsReportPopupOpen() )
		{
			return true;
		}
		if( !( m_isDisabled ) )
		{
			if( m_isSelected )
			{
				inkWidgetRef.Get( m_buttonCore ).BindProperty( 'tintColor', m_colorNames.faintBlueName );
				inkWidgetRef.Get( m_buttonBorder ).BindProperty( 'tintColor', m_colorNames.mildBlueName );
			}
			else
			{
				inkWidgetRef.Get( m_buttonCore ).BindProperty( 'tintColor', m_colorNames.mediumRedName );
				inkWidgetRef.Get( m_buttonBorder ).BindProperty( 'tintColor', m_colorNames.mildRedName );
			}
		}
	}

	protected event OnRelease( e : inkPointerEvent )
	{
		if( e.IsAction( 'click' ) || e.IsAction( 'tap' ) )
		{
			PlaySound( 'Button', 'OnPress' );
		}
	}

	public function SetIsDisabled( bInDisabled : Bool ) : Bool
	{
		var bChanged : Bool;
		bChanged = m_isDisabled != bInDisabled;
		m_isDisabled = bInDisabled;
		if( m_isDisabled && bChanged )
		{
			UnregisterFromCallback( 'OnRelease', this, 'OnRelease' );
		}
		else if( !( m_isDisabled ) && bChanged )
		{
			RegisterToCallback( 'OnRelease', this, 'OnRelease' );
		}
		return bChanged;
	}

	private function ApplyHoveredColor()
	{
		if( m_isSelected )
		{
			inkWidgetRef.Get( m_buttonCore ).BindProperty( 'tintColor', m_colorNames.faintRedName );
			inkWidgetRef.Get( m_buttonBorder ).BindProperty( 'tintColor', m_colorNames.mildRedName );
		}
		else
		{
			inkWidgetRef.Get( m_buttonCore ).BindProperty( 'tintColor', m_colorNames.faintRedName );
			inkWidgetRef.Get( m_buttonBorder ).BindProperty( 'tintColor', m_colorNames.activeRedName );
		}
	}

	private function ApplyButtonColor( bIsFunctionActivated : Bool )
	{
		if( bIsFunctionActivated )
		{
			inkTextRef.Get( m_buttonText ).BindProperty( 'tintColor', m_colorNames.activeBlueName );
			inkImageRef.Get( m_buttonIcon ).BindProperty( 'tintColor', m_colorNames.activeBlueName );
			inkWidgetRef.Get( m_buttonCore ).BindProperty( 'tintColor', m_colorNames.faintBlueName );
			inkWidgetRef.Get( m_buttonBorder ).BindProperty( 'tintColor', m_colorNames.mildBlueName );
			m_isSelected = true;
		}
		else
		{
			inkTextRef.Get( m_buttonText ).BindProperty( 'tintColor', m_colorNames.activeRedName );
			inkImageRef.Get( m_buttonIcon ).BindProperty( 'tintColor', m_colorNames.activeRedName );
			inkWidgetRef.Get( m_buttonCore ).BindProperty( 'tintColor', m_colorNames.mediumRedName );
			inkWidgetRef.Get( m_buttonBorder ).BindProperty( 'tintColor', m_colorNames.mildRedName );
			m_isSelected = false;
		}
		if( m_isDisabled )
		{
			inkTextRef.Get( m_buttonText ).BindProperty( 'tintColor', m_colorNames.greyName );
			inkImageRef.Get( m_buttonIcon ).BindProperty( 'tintColor', m_colorNames.greyName );
			inkWidgetRef.Get( m_buttonCore ).BindProperty( 'tintColor', m_colorNames.darkGreyName );
			inkWidgetRef.Get( m_buttonBorder ).BindProperty( 'tintColor', m_colorNames.panelDarkGreyName );
		}
		else if( m_isHovered )
		{
			ApplyHoveredColor();
		}
	}

	public function SetGenericButtonInfo( bIsFunctionActivated : Bool )
	{
		ApplyButtonColor( bIsFunctionActivated );
	}

	public function SetOwnerMenu( inMenu : BrowserModsMenuGameController )
	{
		m_ownerMenu = inMenu;
	}

}

class SubscribeToModButtonController extends GenericModButtonController
{

	protected event OnRelease( e : inkPointerEvent )
	{
		super.OnRelease( e );
		if( e.IsAction( 'click' ) || e.IsAction( 'tap' ) )
		{
			m_ownerMenu.SubscribeToModButtonClicked( m_isForFunction );
		}
	}

	public function SetIsForSubscribe( bIsForSubscribe : Bool )
	{
		m_isForFunction = bIsForSubscribe;
	}

	public function GetIsForSubscribe() : Bool
	{
		return m_isForFunction;
	}

	public function SetIsDisabledForOutOfSpaceReason( bNotEnoughSpace : Bool )
	{
		var bChangedState : Bool;
		bChangedState = SetIsDisabled( bNotEnoughSpace );
		if( bNotEnoughSpace && bChangedState )
		{
			RegisterToCallback( 'OnHoverOver', m_ownerMenu, 'OnDisabledForOutOfSpaceSubscribeHoverOver' );
			RegisterToCallback( 'OnHoverOut', m_ownerMenu, 'OnDisabledForOutOfSpaceSubscribeHoverOut' );
		}
		else if( !( bNotEnoughSpace ) )
		{
			UnregisterFromCallback( 'OnHoverOver', m_ownerMenu, 'OnDisabledForOutOfSpaceSubscribeHoverOver' );
			UnregisterFromCallback( 'OnHoverOut', m_ownerMenu, 'OnDisabledForOutOfSpaceSubscribeHoverOut' );
		}
	}

	public function SetButtonInfo( bIsUserSubscribedToMod : Bool )
	{
		var subscribeButtonTextString : CName;
		SetGenericButtonInfo( bIsUserSubscribedToMod );
		SetIsForSubscribe( !( bIsUserSubscribedToMod ) );
		subscribeButtonTextString = ( ( bIsUserSubscribedToMod ) ? ( 'UI-Modio-MenuContent-Subed' ) : ( 'UI-Modio-MenuContent-Sub' ) );
		inkTextRef.SetText( m_buttonText, GetLocalizedText( NameToString( subscribeButtonTextString ) ) );
	}

}

