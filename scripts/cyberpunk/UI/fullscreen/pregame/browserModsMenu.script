import enum inkModioFilterTags
{
	Appearance,
	Characters,
	Weapons,
	Vehicles,
	Animations,
	Gameplay,
	Graphics,
	Audio,
	Misc,
	MAX,
}

import enum inkModioModProgressState
{
	Initializing,
	Downloading,
	Extracting,
	Compressing,
	Uploading,
}

import enum inkModioModSortingOptions : Uint8
{
	Trending,
	Popular,
	HighestRated,
	RecentlyUpdated,
	RecentlyUploaded,
	MAX,
}

import enum inkModioLanguageTagsOptions : Uint32
{
	AllLanguages,
	Arabic,
	Czech,
	German,
	English,
	Spanish,
	LatinAmericaSpanish,
	French,
	Hungarian,
	Italian,
	Japanese,
	Korean,
	Polish,
	BrazilianPortuguese,
	Russian,
	Thai,
	Turkish,
	Ukrainian,
	SimplifiedChinese,
	TraditionalChinese,
	MAX,
}

import enum inkModioMoreOptions : Uint8
{
	More,
	HideAuthor,
	HideMod,
	Report,
	MAX,
}

