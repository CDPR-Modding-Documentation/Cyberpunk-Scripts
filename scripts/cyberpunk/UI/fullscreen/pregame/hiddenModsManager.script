class HiddenModManager extends inkGameController
{
	private editable var m_hiddenModsTab : inkWidgetRef;
	private editable var m_hiddenAuthorsTab : inkWidgetRef;
	private editable var m_applyButtonRef : inkWidgetRef;
	private editable var m_applyButtonText : inkWidgetRef;
	private editable var m_closeButtonRef : inkWidgetRef;
	private var m_data : HiddenModManagerPopupData;
	private var m_ownerMenuRef : weak< BrowserModsMenuGameController >;
	private var m_hiddenModsTabController : weak< HiddenManagerTabItem >;
	private var m_hiddenAuthorsTabController : weak< HiddenManagerTabItem >;
	private var m_openAnim : inkAnimProxy;
	private var m_closeAnim : inkAnimProxy;
	private var m_applyButtonController : weak< inkButtonController >;
	private var m_closeButtonController : weak< inkButtonController >;
	private var m_bHasChanges : Bool;
	private var m_currentlyHoveredWidget : weak< inkWidget >;
	private editable var m_mainHiddenModsWidget : inkWidgetRef;
	private editable var m_hiddenModSpawnerRef : inkWidgetRef;
	private var m_hiddenModList : array< weak< HiddenModItem > >;
	private var m_listOfHiddenModsToUnhide : array< ModioModInfos >;
	private editable var m_mainHiddenAuthorsWidget : inkWidgetRef;
	private editable var m_hiddenAuthorSpawnerRef : inkWidgetRef;
	private var m_hiddenAuthorList : array< weak< HiddenAuthorItem > >;
	private var m_listOfHiddenAuthorsToUnhide : array< inkModAuthorInfo >;

	protected event OnInitialize()
	{
		m_currentlyHoveredWidget = NULL;
		m_data = ( ( HiddenModManagerPopupData )( GetRootWidget().GetUserData( 'HiddenModManagerPopupData' ) ) );
		Setup();
		RegisterToGlobalInputCallback( 'OnPostOnRelease', this, 'OnButtonRelease' );
		m_hiddenModsTabController = ( ( HiddenManagerTabItem )( inkWidgetRef.GetController( m_hiddenModsTab ) ) );
		inkWidgetRef.RegisterToCallback( m_hiddenModsTab, 'OnRelease', this, 'OnModsTabButtonClicked' );
		inkWidgetRef.RegisterToCallback( m_hiddenModsTab, 'OnHoverOver', this, 'OnModsTabButtonHoveredOver' );
		inkWidgetRef.RegisterToCallback( m_hiddenModsTab, 'OnHoverOut', this, 'OnModsTabButtonHoveredOut' );
		m_hiddenAuthorsTabController = ( ( HiddenManagerTabItem )( inkWidgetRef.GetController( m_hiddenAuthorsTab ) ) );
		inkWidgetRef.RegisterToCallback( m_hiddenAuthorsTab, 'OnRelease', this, 'OnAuthorTabsButtonClicked' );
		inkWidgetRef.RegisterToCallback( m_hiddenAuthorsTab, 'OnHoverOver', this, 'OnAuthorTabsButtonHoveredOver' );
		inkWidgetRef.RegisterToCallback( m_hiddenAuthorsTab, 'OnHoverOut', this, 'OnAuthorTabsButtonHoveredOut' );
		inkWidgetRef.RegisterToCallback( m_applyButtonRef, 'OnRelease', this, 'OnApplyButtonClicked' );
		inkWidgetRef.RegisterToCallback( m_applyButtonRef, 'OnHoverOver', this, 'OnApplyButtonHoveredOver' );
		inkWidgetRef.RegisterToCallback( m_applyButtonRef, 'OnHoverOut', this, 'OnApplyButtonHoveredOut' );
		inkWidgetRef.RegisterToCallback( m_closeButtonRef, 'OnRelease', this, 'OnCloseButtonClicked' );
		inkWidgetRef.RegisterToCallback( m_closeButtonRef, 'OnHoverOver', this, 'OnCloseButtonHoveredOver' );
		inkWidgetRef.RegisterToCallback( m_closeButtonRef, 'OnHoverOut', this, 'OnCloseButtonHoveredOut' );
		m_applyButtonController = ( ( inkButtonController )( inkWidgetRef.GetController( m_applyButtonRef ) ) );
		m_closeButtonController = ( ( inkButtonController )( inkWidgetRef.GetController( m_closeButtonRef ) ) );
		m_hiddenModsTabController.OverrideNavigation( inkDiscreteNavigationDirection.Up, inkWidgetRef.Get( m_applyButtonRef ) );
		m_hiddenAuthorsTabController.OverrideNavigation( inkDiscreteNavigationDirection.Up, inkWidgetRef.Get( m_applyButtonRef ) );
		m_hiddenModsTabController.OverrideNavigation( inkDiscreteNavigationDirection.Left, inkWidgetRef.Get( m_hiddenAuthorsTab ) );
		m_hiddenAuthorsTabController.OverrideNavigation( inkDiscreteNavigationDirection.Right, inkWidgetRef.Get( m_hiddenModsTab ) );
		m_applyButtonController.OverrideNavigation( inkDiscreteNavigationDirection.Left, inkWidgetRef.Get( m_closeButtonRef ) );
		m_closeButtonController.OverrideNavigation( inkDiscreteNavigationDirection.Right, inkWidgetRef.Get( m_applyButtonRef ) );
		UpdateApplyButtonEnableState();
		DisplayMutedModsTab();
		m_openAnim = PlayLibraryAnimation( 'In' );
		m_openAnim.RegisterToCallback( inkanimEventType.OnFinish, this, 'OnOpenAnimFinished' );
	}

	protected event OnUninitialize()
	{
		inkWidgetRef.UnregisterFromCallback( m_hiddenModsTab, 'OnRelease', this, 'OnModsTabButtonClicked' );
		inkWidgetRef.UnregisterFromCallback( m_hiddenModsTab, 'OnRelease', this, 'OnModsTabButtonHoveredOver' );
		inkWidgetRef.UnregisterFromCallback( m_hiddenModsTab, 'OnRelease', this, 'OnModsTabButtonHoveredOut' );
		inkWidgetRef.UnregisterFromCallback( m_hiddenAuthorsTab, 'OnRelease', this, 'OnAuthorTabsButtonClicked' );
		inkWidgetRef.UnregisterFromCallback( m_hiddenAuthorsTab, 'OnRelease', this, 'OnAuthorTabsButtonHoveredOver' );
		inkWidgetRef.UnregisterFromCallback( m_hiddenAuthorsTab, 'OnRelease', this, 'OnAuthorTabsButtonHoveredOut' );
		inkWidgetRef.UnregisterFromCallback( m_applyButtonRef, 'OnRelease', this, 'OnApplyButtonClicked' );
		inkWidgetRef.UnregisterFromCallback( m_applyButtonRef, 'OnHoverOver', this, 'OnApplyButtonHoveredOver' );
		inkWidgetRef.UnregisterFromCallback( m_applyButtonRef, 'OnHoverOut', this, 'OnApplyButtonHoveredOut' );
		inkWidgetRef.UnregisterFromCallback( m_closeButtonRef, 'OnRelease', this, 'OnCloseButtonClicked' );
		inkWidgetRef.UnregisterFromCallback( m_closeButtonRef, 'OnHoverOver', this, 'OnCloseButtonHoveredOver' );
		inkWidgetRef.UnregisterFromCallback( m_closeButtonRef, 'OnHoverOut', this, 'OnCloseButtonHoveredOut' );
	}

	protected event OnApplyButtonHoveredOver( e : inkPointerEvent )
	{
		OnWidgetHoveredOver( inkWidgetRef.Get( m_applyButtonRef ) );
	}

	protected event OnApplyButtonHoveredOut( e : inkPointerEvent )
	{
		OnWidgetHoveredOut( inkWidgetRef.Get( m_applyButtonRef ) );
	}

	protected event OnCloseButtonHoveredOver( e : inkPointerEvent )
	{
		OnWidgetHoveredOver( inkWidgetRef.Get( m_closeButtonRef ) );
	}

	protected event OnCloseButtonHoveredOut( e : inkPointerEvent )
	{
		OnWidgetHoveredOut( inkWidgetRef.Get( m_closeButtonRef ) );
	}

	protected event OnButtonRelease( evt : inkPointerEvent )
	{
		if( m_closeAnim != NULL )
		{
			return false;
		}
		if( evt.IsAction( 'cancel' ) )
		{
			AskToClose();
		}
		else if( evt.IsAction( 'mod_notification_confirm' ) && m_bHasChanges )
		{
			ApplySelection();
		}
		else if( evt.IsAction( 'prior_menu' ) )
		{
			DisplayMutedModsTab();
		}
		else if( evt.IsAction( 'next_menu' ) )
		{
			DisplayMutedAuthorsTab();
		}
		else if( ( evt.IsAction( 'popup_navigate_up' ) || evt.IsAction( 'popup_navigate_right' ) ) && ( m_currentlyHoveredWidget == NULL ) )
		{
			SetCursorOverWidget( inkWidgetRef.Get( m_closeButtonRef ), 0.1, true );
		}
		else if( ( evt.IsAction( 'popup_navigate_down' ) || evt.IsAction( 'popup_navigate_left' ) ) && ( m_currentlyHoveredWidget == NULL ) )
		{
			SetCursorOverWidget( inkWidgetRef.Get( m_hiddenModsTab ), 0.1, true );
		}
	}

	protected event OnModsTabButtonClicked( e : inkPointerEvent )
	{
		if( e.IsAction( 'click' ) || e.IsAction( 'tap' ) )
		{
			DisplayMutedModsTab();
		}
	}

	protected event OnModsTabButtonHoveredOver( e : inkPointerEvent )
	{
		OnWidgetHoveredOver( inkWidgetRef.Get( m_hiddenModsTab ) );
	}

	protected event OnModsTabButtonHoveredOut( e : inkPointerEvent )
	{
		OnWidgetHoveredOut( inkWidgetRef.Get( m_hiddenModsTab ) );
	}

	protected event OnAuthorTabsButtonClicked( e : inkPointerEvent )
	{
		if( e.IsAction( 'click' ) || e.IsAction( 'tap' ) )
		{
			DisplayMutedAuthorsTab();
		}
	}

	protected event OnAuthorTabsButtonHoveredOver( e : inkPointerEvent )
	{
		OnWidgetHoveredOver( inkWidgetRef.Get( m_hiddenAuthorsTab ) );
	}

	protected event OnAuthorTabsButtonHoveredOut( e : inkPointerEvent )
	{
		OnWidgetHoveredOut( inkWidgetRef.Get( m_hiddenAuthorsTab ) );
	}

	protected event OnApplyButtonClicked( e : inkPointerEvent )
	{
		if( ( e.IsAction( 'click' ) || e.IsAction( 'tap' ) ) && m_bHasChanges )
		{
			ApplySelection();
		}
	}

	protected event OnCloseButtonClicked( e : inkPointerEvent )
	{
		if( e.IsAction( 'click' ) || e.IsAction( 'tap' ) )
		{
			AskToClose();
		}
	}

	public function OnWidgetHoveredOut( inWidget : inkWidget )
	{
		if( m_currentlyHoveredWidget == inWidget )
		{
			m_currentlyHoveredWidget = NULL;
		}
	}

	public function OnWidgetHoveredOver( inWidget : inkWidget )
	{
		m_currentlyHoveredWidget = inWidget;
		PlaySound( 'Button', 'OnHover' );
	}

	private function DisplayMutedModsTab()
	{
		PlaySound( 'Button', 'OnPress' );
		inkWidgetRef.SetVisible( m_mainHiddenModsWidget, true );
		inkWidgetRef.SetVisible( m_mainHiddenAuthorsWidget, false );
		m_hiddenModsTabController.SetSelectedTab( true );
		m_hiddenAuthorsTabController.SetSelectedTab( false );
		m_applyButtonController.OverrideNavigation( inkDiscreteNavigationDirection.Down, ( ( m_hiddenModList.Size() > 0 ) ? ( m_hiddenModList[ 0 ].GetRootWidget() ) : ( inkWidgetRef.Get( m_hiddenAuthorsTab ) ) ) );
		m_closeButtonController.OverrideNavigation( inkDiscreteNavigationDirection.Down, ( ( m_hiddenModList.Size() > 0 ) ? ( m_hiddenModList[ 0 ].GetRootWidget() ) : ( inkWidgetRef.Get( m_hiddenAuthorsTab ) ) ) );
		m_applyButtonController.OverrideNavigation( inkDiscreteNavigationDirection.Up, ( ( m_hiddenModList.Size() > 0 ) ? ( m_hiddenModList[ m_hiddenModList.Size() - 1 ].GetRootWidget() ) : ( inkWidgetRef.Get( m_hiddenAuthorsTab ) ) ) );
		m_closeButtonController.OverrideNavigation( inkDiscreteNavigationDirection.Up, ( ( m_hiddenModList.Size() > 0 ) ? ( m_hiddenModList[ m_hiddenModList.Size() - 1 ].GetRootWidget() ) : ( inkWidgetRef.Get( m_hiddenAuthorsTab ) ) ) );
	}

	private function DisplayMutedAuthorsTab()
	{
		PlaySound( 'Button', 'OnPress' );
		inkWidgetRef.SetVisible( m_mainHiddenModsWidget, false );
		inkWidgetRef.SetVisible( m_mainHiddenAuthorsWidget, true );
		m_hiddenModsTabController.SetSelectedTab( false );
		m_hiddenAuthorsTabController.SetSelectedTab( true );
		m_applyButtonController.OverrideNavigation( inkDiscreteNavigationDirection.Down, ( ( m_hiddenAuthorList.Size() > 0 ) ? ( m_hiddenAuthorList[ 0 ].GetRootWidget() ) : ( inkWidgetRef.Get( m_hiddenModsTab ) ) ) );
		m_closeButtonController.OverrideNavigation( inkDiscreteNavigationDirection.Down, ( ( m_hiddenAuthorList.Size() > 0 ) ? ( m_hiddenAuthorList[ 0 ].GetRootWidget() ) : ( inkWidgetRef.Get( m_hiddenModsTab ) ) ) );
		m_applyButtonController.OverrideNavigation( inkDiscreteNavigationDirection.Up, ( ( m_hiddenAuthorList.Size() > 0 ) ? ( m_hiddenAuthorList[ m_hiddenAuthorList.Size() - 1 ].GetRootWidget() ) : ( inkWidgetRef.Get( m_hiddenModsTab ) ) ) );
		m_closeButtonController.OverrideNavigation( inkDiscreteNavigationDirection.Up, ( ( m_hiddenAuthorList.Size() > 0 ) ? ( m_hiddenAuthorList[ m_hiddenAuthorList.Size() - 1 ].GetRootWidget() ) : ( inkWidgetRef.Get( m_hiddenModsTab ) ) ) );
	}

	private function Setup()
	{
		var i : Int32;
		var currentHiddenModItem : HiddenModItem;
		var currentHiddenAuthorItem : HiddenAuthorItem;
		var currentEmptySlot : EmptySlotItem;
		m_ownerMenuRef = m_data.m_ownerMenu;
		m_ownerMenuRef.OnHiddenManagerOpened();
		for( i = 0; i < m_data.m_listOfHiddenMods.Size(); i += 1 )
		{
			currentHiddenModItem = ( ( HiddenModItem )( SpawnFromLocal( inkWidgetRef.Get( m_hiddenModSpawnerRef ), 'mutedModItem' ).GetController() ) );
			currentHiddenModItem.Setup( this, GetSystemRequestsHandler(), m_data.m_listOfHiddenMods[ i ], m_data.m_listOfModLogoPath[ i ] );
			m_hiddenModList.PushBack( currentHiddenModItem );
		}
		for( i; i < 6; i += 1 )
		{
			currentEmptySlot = ( ( EmptySlotItem )( SpawnFromLocal( inkWidgetRef.Get( m_hiddenModSpawnerRef ), 'EmptySlotItem' ).GetController() ) );
		}
		for( i = 0; i < m_data.m_listOfHiddenAuthors.Size(); i += 1 )
		{
			currentHiddenAuthorItem = ( ( HiddenAuthorItem )( SpawnFromLocal( inkWidgetRef.Get( m_hiddenAuthorSpawnerRef ), 'mutedAuthorItem' ).GetController() ) );
			currentHiddenAuthorItem.Setup( this, m_data.m_listOfHiddenAuthors[ i ] );
			m_hiddenAuthorList.PushBack( currentHiddenAuthorItem );
		}
		for( i; i < 6; i += 1 )
		{
			currentEmptySlot = ( ( EmptySlotItem )( SpawnFromLocal( inkWidgetRef.Get( m_hiddenAuthorSpawnerRef ), 'EmptySlotItem' ).GetController() ) );
			currentEmptySlot.HideImageContainer();
		}
	}

	private function AskToClose()
	{
		var m_systemHandler : inkISystemRequestsHandler;
		m_systemHandler = GetSystemRequestsHandler();
		if( ( m_listOfHiddenAuthorsToUnhide.Size() > 0 ) || ( m_listOfHiddenModsToUnhide.Size() > 0 ) )
		{
			m_systemHandler.RequestSystemNotificationGenericYesNo( 'UI-Modio-ErrorMessages-WarningHiddenTitle', 'UI-Modio-ErrorMessages-WarningHiddenManager', this, 'OnWarnPlayerAboutUnappliedChangesResult', true );
		}
		else
		{
			StartClosing();
		}
	}

	protected event OnWarnPlayerAboutUnappliedChangesResult( bAccepted : Bool )
	{
		if( bAccepted )
		{
			StartClosing();
		}
	}

	private function StartClosing()
	{
		if( m_closeAnim != NULL )
		{
			return;
		}
		PlaySound( 'Button', 'OnPress' );
		m_closeAnim = PlayLibraryAnimation( 'Out' );
		m_closeAnim.RegisterToCallback( inkanimEventType.OnFinish, this, 'OnCloseAnimFinished' );
	}

	protected event OnOpenAnimFinished( anim : inkAnimProxy )
	{
		if( m_openAnim != NULL )
		{
			m_openAnim.UnregisterFromCallback( inkanimEventType.OnFinish, this, 'OnOpenAnimFinished' );
			m_openAnim = NULL;
		}
	}

	protected event OnCloseAnimFinished( anim : inkAnimProxy )
	{
		if( m_closeAnim != NULL )
		{
			m_closeAnim.UnregisterFromCallback( inkanimEventType.OnFinish, this, 'OnCloseAnimFinished' );
			m_closeAnim = NULL;
		}
		m_ownerMenuRef.OnHiddenManagerClosed();
		m_data.token.TriggerCallback( NULL );
	}

	private function ApplySelection()
	{
		if( m_closeAnim != NULL )
		{
			return;
		}
		m_ownerMenuRef.UnhideMods( m_listOfHiddenModsToUnhide );
		m_ownerMenuRef.UnmuteAuthors( m_listOfHiddenAuthorsToUnhide );
		StartClosing();
	}

	public function OnHiddenModItemClicked( hiddenMod : HiddenModItem )
	{
		if( hiddenMod.GetHiddenState() )
		{
			m_listOfHiddenModsToUnhide.Remove( hiddenMod.GetModInfo() );
		}
		else
		{
			m_listOfHiddenModsToUnhide.PushBack( hiddenMod.GetModInfo() );
		}
		m_hiddenModsTabController.SetIsModified( m_listOfHiddenModsToUnhide.Size() > 0 );
		UpdateApplyButtonEnableState();
	}

	public function OnHiddenAuthorItemClicked( hiddenAuthor : HiddenAuthorItem )
	{
		if( hiddenAuthor.GetHiddenState() )
		{
			m_listOfHiddenAuthorsToUnhide.Remove( hiddenAuthor.GetAuthorInfo() );
		}
		else
		{
			m_listOfHiddenAuthorsToUnhide.PushBack( hiddenAuthor.GetAuthorInfo() );
		}
		m_hiddenAuthorsTabController.SetIsModified( m_listOfHiddenAuthorsToUnhide.Size() > 0 );
		UpdateApplyButtonEnableState();
	}

	private function UpdateApplyButtonEnableState()
	{
		m_bHasChanges = ( m_listOfHiddenModsToUnhide.Size() > 0 ) || ( m_listOfHiddenAuthorsToUnhide.Size() > 0 );
		m_applyButtonController.SetEnabled( m_bHasChanges );
		m_applyButtonController.SetSelectable( m_bHasChanges );
		m_applyButtonController.UpdateButtonState( true );
		if( m_bHasChanges )
		{
			inkWidgetRef.Get( m_applyButtonText ).BindProperty( 'tintColor', 'PopupButton.textColor' );
		}
		else
		{
			inkWidgetRef.Get( m_applyButtonText ).BindProperty( 'tintColor', 'MainColors.Grey' );
		}
	}

}

class HiddenModItem extends MutedItemCosmetic
{
	private editable var m_checkboxCanvas : inkWidgetRef;
	private editable var m_modNametext : inkTextRef;
	private editable var m_modAuthorName : inkTextRef;
	private editable var m_logoWidget : inkImageRef;
	private var m_isHiddenState : Bool;
	private var m_modInfo : ModioModInfos;
	private var m_managerRef : weak< HiddenModManager >;

	protected event OnInitialize()
	{
		m_isHiddenState = true;
		inkWidgetRef.SetVisible( m_checkboxFill, true );
		inkWidgetRef.RegisterToCallback( m_checkboxCanvas, 'OnRelease', this, 'OnClicked' );
		inkWidgetRef.RegisterToCallback( m_checkboxCanvas, 'OnHoverOver', this, 'OnHoverOver' );
		inkWidgetRef.RegisterToCallback( m_checkboxCanvas, 'OnHoverOut', this, 'OnHoverOut' );
		SetDefaultColor();
	}

	protected event OnUninitialize()
	{
		inkWidgetRef.UnregisterFromCallback( m_checkboxCanvas, 'OnRelease', this, 'OnClicked' );
		inkWidgetRef.UnregisterFromCallback( m_checkboxCanvas, 'OnHoverOver', this, 'OnHoverOver' );
		inkWidgetRef.UnregisterFromCallback( m_checkboxCanvas, 'OnHoverOut', this, 'OnHoverOut' );
	}

	public function Setup( managerRef : HiddenModManager, systemHandler : inkISystemRequestsHandler, modInfo : ModioModInfos, modLogoPath : String )
	{
		m_managerRef = managerRef;
		inkTextRef.SetText( m_modAuthorName, modInfo.authorName );
		inkTextRef.SetText( m_modNametext, modInfo.name );
		m_modInfo = modInfo;
		systemHandler.RequestGameScreenshotByPath( modLogoPath, ( ( inkImage )( inkImageRef.Get( m_logoWidget ) ) ), this, 'OnScreenshotLoadedByPath' );
	}

	protected event OnScreenshotLoadedByPath( screenshotSize : Vector2, errorCode : Int32 ) {}

	protected event OnClicked( e : inkPointerEvent )
	{
		if( e.IsAction( 'click' ) || e.IsAction( 'tap' ) )
		{
			m_isHiddenState = !( m_isHiddenState );
			SetIsModified( !( m_isHiddenState ) );
			inkWidgetRef.SetVisible( m_checkboxFill, m_isHiddenState );
			m_managerRef.OnHiddenModItemClicked( this );
			PlaySound( 'Button', 'OnPress' );
		}
	}

	protected event OnHoverOver( e : inkPointerEvent )
	{
		SetHoveredColor();
		m_managerRef.OnWidgetHoveredOver( GetRootWidget() );
	}

	protected event OnHoverOut( e : inkPointerEvent )
	{
		SetDefaultColor();
		m_managerRef.OnWidgetHoveredOut( GetRootWidget() );
	}

	public function GetHiddenState() : Bool
	{
		return m_isHiddenState;
	}

	public function GetModInfo() : ModioModInfos
	{
		return m_modInfo;
	}

}

class HiddenAuthorItem extends MutedItemCosmetic
{
	private editable var m_checkboxCanvas : inkWidgetRef;
	private editable var m_authorNameText : inkTextRef;
	private var m_authorInfo : inkModAuthorInfo;
	private var m_managerRef : weak< HiddenModManager >;
	private var m_isHiddenState : Bool;

	protected event OnInitialize()
	{
		m_isHiddenState = true;
		inkWidgetRef.SetVisible( m_checkboxFill, true );
		inkWidgetRef.RegisterToCallback( m_checkboxCanvas, 'OnRelease', this, 'OnClicked' );
		inkWidgetRef.RegisterToCallback( m_checkboxCanvas, 'OnHoverOver', this, 'OnHoverOver' );
		inkWidgetRef.RegisterToCallback( m_checkboxCanvas, 'OnHoverOut', this, 'OnHoverOut' );
	}

	protected event OnUninitialize()
	{
		inkWidgetRef.UnregisterFromCallback( m_checkboxCanvas, 'OnRelease', this, 'OnClicked' );
		inkWidgetRef.UnregisterFromCallback( m_checkboxCanvas, 'OnHoverOver', this, 'OnHoverOver' );
		inkWidgetRef.UnregisterFromCallback( m_checkboxCanvas, 'OnHoverOut', this, 'OnHoverOut' );
	}

	public function Setup( managerRef : HiddenModManager, authorInfo : inkModAuthorInfo )
	{
		m_managerRef = managerRef;
		m_authorInfo = authorInfo;
		inkTextRef.SetText( m_authorNameText, authorInfo.username );
	}

	protected event OnClicked( e : inkPointerEvent )
	{
		if( e.IsAction( 'click' ) || e.IsAction( 'tap' ) )
		{
			m_isHiddenState = !( m_isHiddenState );
			SetIsModified( !( m_isHiddenState ) );
			inkWidgetRef.SetVisible( m_checkboxFill, m_isHiddenState );
			m_managerRef.OnHiddenAuthorItemClicked( this );
			PlaySound( 'Button', 'OnPress' );
		}
	}

	protected event OnHoverOver( e : inkPointerEvent )
	{
		SetHoveredColor();
		m_managerRef.OnWidgetHoveredOver( GetRootWidget() );
	}

	protected event OnHoverOut( e : inkPointerEvent )
	{
		SetDefaultColor();
		m_managerRef.OnWidgetHoveredOut( GetRootWidget() );
	}

	public function GetHiddenState() : Bool
	{
		return m_isHiddenState;
	}

	public function GetAuthorInfo() : inkModAuthorInfo
	{
		return m_authorInfo;
	}

}

class MutedItemCosmetic extends WarnModificationCosmetic
{
	protected editable var m_checkboxFill : inkWidgetRef;
	protected editable var m_isHiddenText : inkTextRef;
	protected editable var m_panelOutline : inkWidgetRef;
	protected editable var m_panelBackground : inkWidgetRef;
	protected var m_colorNames : ModsMenuColorsNames;

	protected function SetHoveredColor()
	{
		inkTextRef.Get( m_isHiddenText ).BindProperty( 'tintColor', m_colorNames.activeBlueName );
		inkWidgetRef.Get( m_checkboxFill ).BindProperty( 'tintColor', m_colorNames.activeBlueName );
		inkWidgetRef.Get( m_panelOutline ).BindProperty( 'tintColor', m_colorNames.activeBlueName );
		inkWidgetRef.Get( m_panelBackground ).BindProperty( 'tintColor', m_colorNames.fullscreenPrimaryBackgroundDarkName );
	}

	protected function SetDefaultColor()
	{
		inkTextRef.Get( m_isHiddenText ).BindProperty( 'tintColor', m_colorNames.activeRedName );
		inkWidgetRef.Get( m_checkboxFill ).BindProperty( 'tintColor', m_colorNames.redName );
		inkWidgetRef.Get( m_panelOutline ).BindProperty( 'tintColor', m_colorNames.faintRedName );
		inkWidgetRef.Get( m_panelBackground ).BindProperty( 'tintColor', m_colorNames.fullscreenRedDarkBackgroundName );
	}

	protected event OnHoverOver( e : inkPointerEvent )
	{
		SetHoveredColor();
		PlaySound( 'Button', 'OnHover' );
	}

	protected event OnHoverOut( e : inkPointerEvent )
	{
		SetDefaultColor();
	}

}

class EmptySlotItem extends inkLogicController
{
	private editable var m_imageContainer : inkWidgetRef;

	public function HideImageContainer()
	{
		inkWidgetRef.SetVisible( m_imageContainer, false );
	}

}

class WarnModificationCosmetic extends inkButtonController
{
	protected editable var m_modifiedFlag : inkWidgetRef;
	protected var m_isModified : Bool;

	public function SetIsModified( bModified : Bool )
	{
		m_isModified = bModified;
		inkWidgetRef.SetVisible( m_modifiedFlag, m_isModified );
	}

}

class HiddenModManagerPopupEvent extends Event
{
	var m_data : HiddenModManagerPopupData;
}

class HiddenModManagerPopupData extends inkGameNotificationData
{
	var m_ownerMenu : weak< BrowserModsMenuGameController >;
	var m_listOfHiddenMods : array< ModioModInfos >;
	var m_listOfModLogoPath : array< String >;
	var m_listOfHiddenAuthors : array< inkModAuthorInfo >;
}

class HiddenManagerTabItem extends WarnModificationCosmetic
{
	private editable var m_selectedStateCanvas : inkWidgetRef;
	private editable var m_tabTextRef : inkTextRef;
	private editable var m_frameRef : inkWidgetRef;
	private var m_isSelected : Bool;
	private var m_colorNames : ModsMenuColorsNames;

	protected event OnInitialize()
	{
		RegisterToCallback( 'OnHoverOver', this, 'OnHoverOver' );
		RegisterToCallback( 'OnHoverOut', this, 'OnHoverOut' );
		RegisterToCallback( 'OnRelease', this, 'OnTabClicked' );
		SetSelectedTab( false );
	}

	protected event OnUninitialize()
	{
		UnregisterFromCallback( 'OnHoverOver', this, 'OnHoverOver' );
		UnregisterFromCallback( 'OnHoverOut', this, 'OnHoverOut' );
	}

	protected event OnHoverOver( evt : inkPointerEvent )
	{
		PlaySound( 'Button', 'OnHover' );
		inkTextRef.Get( m_tabTextRef ).BindProperty( 'tintColor', m_colorNames.activeBlueName );
		inkWidgetRef.Get( m_frameRef ).BindProperty( 'tintColor', m_colorNames.activeBlueName );
	}

	protected event OnHoverOut( evt : inkPointerEvent )
	{
		if( !( m_isSelected ) )
		{
			inkTextRef.Get( m_tabTextRef ).BindProperty( 'tintColor', m_colorNames.activeRedName );
			inkWidgetRef.Get( m_frameRef ).BindProperty( 'tintColor', m_colorNames.mildBlueName );
		}
		else
		{
			inkTextRef.Get( m_tabTextRef ).BindProperty( 'tintColor', m_colorNames.activeBlueName );
			inkWidgetRef.Get( m_frameRef ).BindProperty( 'tintColor', m_colorNames.activeBlueName );
		}
	}

	protected event OnTabClicked( evt : inkPointerEvent )
	{
		if( evt.IsAction( 'click' ) || evt.IsAction( 'tap' ) )
		{
			SetSelectedTab( true );
		}
	}

	public function SetSelectedTab( bSelected : Bool )
	{
		m_isSelected = bSelected;
		if( m_isSelected )
		{
			inkTextRef.Get( m_tabTextRef ).BindProperty( 'tintColor', m_colorNames.activeBlueName );
			inkWidgetRef.SetVisible( m_selectedStateCanvas, true );
			inkWidgetRef.Get( m_frameRef ).BindProperty( 'tintColor', m_colorNames.activeBlueName );
		}
		else
		{
			inkTextRef.Get( m_tabTextRef ).BindProperty( 'tintColor', m_colorNames.activeRedName );
			inkWidgetRef.SetVisible( m_selectedStateCanvas, false );
			inkWidgetRef.Get( m_frameRef ).BindProperty( 'tintColor', m_colorNames.mildBlueName );
		}
	}

}

