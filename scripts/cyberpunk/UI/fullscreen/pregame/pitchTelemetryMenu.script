class PitchTelemetryMenuGameController extends gameuiMenuGameController
{
	private editable var m_telemetrySelectorRef : inkWidgetRef;
	private editable var m_marketing1SelectorRef : inkWidgetRef;
	private editable var m_hyperlinkButtonRef : inkWidgetRef;
	private editable var m_inputHintConsentRef : inkTextRef;
	private var m_telemetrySelectorController : weak< PitchSelectorControllerBool >;
	private var m_marketing1SelectorController : weak< PitchSelectorControllerBool >;
	private var m_eventDispatcher : weak< inkMenuEventDispatcher >;
	private var m_requestHandler : weak< inkISystemRequestsHandler >;
	private var m_uiSystem : UISystem;
	private var m_shouldConsentToAll : Bool;

	protected event OnSetMenuEventDispatcher( d : weak< inkMenuEventDispatcher > )
	{
		m_eventDispatcher = d;
	}

	protected event OnInitialize()
	{
		m_shouldConsentToAll = true;
		if( !( m_uiSystem ) )
		{
			m_uiSystem = GameInstance.GetUISystem( GetPlayerControlledObject().GetGame() );
		}
		m_requestHandler = GetSystemRequestsHandler();
		m_telemetrySelectorController = ( ( PitchSelectorControllerBool )( inkWidgetRef.GetControllerByType( m_telemetrySelectorRef, 'PitchSelectorControllerBool' ) ) );
		m_marketing1SelectorController = ( ( PitchSelectorControllerBool )( inkWidgetRef.GetControllerByType( m_marketing1SelectorRef, 'PitchSelectorControllerBool' ) ) );
		m_telemetrySelectorController.Setup( this );
		m_marketing1SelectorController.Setup( this );
		RegisterToGlobalInputCallback( 'OnPostOnHold', this, 'OnHold' );
		inkWidgetRef.RegisterToCallback( m_hyperlinkButtonRef, 'OnPress', this, 'OnPressHyperlink' );
	}

	protected event OnUninitialize()
	{
		UnregisterFromGlobalInputCallback( 'OnPostOnHold', this, 'OnHold' );
		inkWidgetRef.UnregisterFromCallback( m_hyperlinkButtonRef, 'OnPress', this, 'OnPressHyperlink' );
	}

	protected event OnHold( evt : inkPointerEvent )
	{
		var progress : Float;
		progress = evt.GetHoldProgress();
		if( progress < 1.0 )
		{
			return 0;
		}
		if( evt.IsAction( 'system_notification_confirm_hold' ) )
		{
			evt.Handle();
			if( m_shouldConsentToAll )
			{
				ConsentAll();
			}
			else
			{
				OnTelemetryUpdate();
			}
			LeaveTelemetryMenu();
		}
		if( evt.IsAction( 'close_popup_hold' ) )
		{
			evt.Handle();
			RefuseAll();
			LeaveTelemetryMenu();
		}
	}

	private function LeaveTelemetryMenu()
	{
		if( m_shouldConsentToAll )
		{
			GameInstance.GetTelemetrySystem( GetPlayerControlledObject().GetGame() ).LogTelemetryConsentChanged();
			GameInstance.GetTelemetrySystem( GetPlayerControlledObject().GetGame() ).LogMarketingConsentChanged();
		}
		else
		{
			if( m_telemetrySelectorController.GetValue() )
			{
				GameInstance.GetTelemetrySystem( GetPlayerControlledObject().GetGame() ).LogTelemetryConsentChanged();
			}
			if( m_marketing1SelectorController.GetValue() )
			{
				GameInstance.GetTelemetrySystem( GetPlayerControlledObject().GetGame() ).LogMarketingConsentChanged();
			}
		}
		m_uiSystem.SetAndSaveHasTelemetryScreenBeenDisplayed( true );
		m_eventDispatcher.SpawnEvent( 'OnMainMenu' );
		m_eventDispatcher.SpawnEvent( 'OnRequestPatchNotes' );
		m_requestHandler.RequestTelemetryDataRemoval();
	}

	public function OnTelemetryUpdate()
	{
		var telemetryConsent : Bool;
		var marketingConsent : Bool;
		telemetryConsent = m_telemetrySelectorController.GetValue();
		marketingConsent = m_marketing1SelectorController.GetValue();
		UpdateTelemetry( telemetryConsent, marketingConsent );
		m_shouldConsentToAll = false;
		inkTextRef.SetText( m_inputHintConsentRef, GetLocalizedTextByKey( 'UI-PitchScreen-Telemetry-InputHintConfirm' ) );
	}

	private function RefuseAll()
	{
		UpdateTelemetry( false, false );
	}

	private function ConsentAll()
	{
		UpdateTelemetry( true, true );
	}

	private function UpdateTelemetry( telemetryConsent : Bool, marketingConsent : Bool )
	{
		var settings : UserSettings;
		var configVarTelemetry : ConfigVarBool;
		var configVarMarketing : ConfigVarBool;
		var settingsGroup : ConfigGroup;
		settings = m_requestHandler.GetUserSettings();
		if( settings.HasGroup( '/gameplay/misc' ) )
		{
			settingsGroup = settings.GetGroup( '/gameplay/misc' );
			if( settingsGroup.HasVar( 'EnableTelemetry' ) )
			{
				configVarTelemetry = ( ( ConfigVarBool )( settingsGroup.GetVar( 'EnableTelemetry' ) ) );
				configVarTelemetry.SetValue( telemetryConsent );
			}
			if( settingsGroup.HasVar( 'EnableMarketing' ) )
			{
				configVarMarketing = ( ( ConfigVarBool )( settingsGroup.GetVar( 'EnableMarketing' ) ) );
				configVarMarketing.SetValue( marketingConsent );
			}
		}
	}

	protected event OnPressHyperlink( evt : inkPointerEvent )
	{
		if( !( IsConsolePlatform() ) )
		{
			if( evt.IsAction( 'click' ) || evt.IsAction( 'tap' ) )
			{
				m_requestHandler.OpenPrivacyPolicyUrl();
			}
		}
	}

}

class PitchSelectorControllerBool extends inkLogicController
{
	protected editable var m_yesRef : inkWidgetRef;
	protected editable var m_noRef : inkWidgetRef;
	private var m_localValue : Bool;
	private var m_telemetryController : weak< PitchTelemetryMenuGameController >;

	public function GetValue() : Bool
	{
		return m_localValue;
	}

	public function Setup( telemetryController : weak< PitchTelemetryMenuGameController > )
	{
		m_localValue = false;
		m_telemetryController = telemetryController;
		Refresh();
		if( inkWidgetRef.IsValid( m_yesRef ) )
		{
			inkWidgetRef.RegisterToCallback( m_yesRef, 'OnRelease', this, 'OnYes' );
			inkWidgetRef.RegisterToCallback( m_yesRef, 'OnHoverOver', this, 'OnHoverOverYes' );
			inkWidgetRef.RegisterToCallback( m_yesRef, 'OnHoverOut', this, 'OnHoverOut' );
		}
		if( inkWidgetRef.IsValid( m_noRef ) )
		{
			inkWidgetRef.RegisterToCallback( m_noRef, 'OnRelease', this, 'OnNo' );
			inkWidgetRef.RegisterToCallback( m_noRef, 'OnHoverOver', this, 'OnHoverOverNo' );
			inkWidgetRef.RegisterToCallback( m_noRef, 'OnHoverOut', this, 'OnHoverOut' );
		}
	}

	protected event OnUninitialize()
	{
		if( inkWidgetRef.IsValid( m_yesRef ) )
		{
			inkWidgetRef.UnregisterFromCallback( m_yesRef, 'OnPostOnRelease', this, 'OnYes' );
			inkWidgetRef.UnregisterFromCallback( m_yesRef, 'OnHoverOver', this, 'OnHoverOverYes' );
			inkWidgetRef.UnregisterFromCallback( m_yesRef, 'OnHoverOut', this, 'OnHoverOut' );
		}
		if( inkWidgetRef.IsValid( m_noRef ) )
		{
			inkWidgetRef.UnregisterFromCallback( m_noRef, 'OnPostOnRelease', this, 'OnNo' );
			inkWidgetRef.UnregisterFromCallback( m_noRef, 'OnHoverOver', this, 'OnHoverOverNo' );
			inkWidgetRef.UnregisterFromCallback( m_noRef, 'OnHoverOut', this, 'OnHoverOut' );
		}
	}

	public function Refresh()
	{
		inkWidgetRef.SetState( m_yesRef, ( ( m_localValue ) ? ( 'Default' ) : ( 'Off' ) ) );
		inkWidgetRef.SetState( m_noRef, ( ( !( m_localValue ) ) ? ( 'Default' ) : ( 'Off' ) ) );
	}

	protected event OnYes( e : inkPointerEvent )
	{
		if( e.IsAction( 'click' ) || e.IsAction( 'tap' ) )
		{
			m_localValue = true;
			Refresh();
			PlaySound( 'ButtonValueDown', 'OnPress' );
			m_telemetryController.OnTelemetryUpdate();
		}
	}

	protected event OnNo( e : inkPointerEvent )
	{
		if( e.IsAction( 'click' ) || e.IsAction( 'tap' ) )
		{
			m_localValue = false;
			Refresh();
			PlaySound( 'ButtonValueUp', 'OnPress' );
			m_telemetryController.OnTelemetryUpdate();
		}
	}

	protected event OnHoverOverYes( e : inkPointerEvent )
	{
		inkWidgetRef.SetState( m_yesRef, 'Hover' );
	}

	protected event OnHoverOverNo( e : inkPointerEvent )
	{
		inkWidgetRef.SetState( m_noRef, 'Hover' );
	}

	protected event OnHoverOut( e : inkPointerEvent )
	{
		Refresh();
	}

}

