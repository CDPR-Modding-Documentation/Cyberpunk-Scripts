class PitchEulaGameController extends gameuiMenuGameController
{
	private editable var m_eulaWidget : inkWidgetRef;
	private editable var m_sliderWidget : inkWidgetRef;
	private editable var m_declineButtonText : inkTextRef;
	private editable var m_acceptButtonText : inkTextRef;
	private editable var m_contentTextRef : inkTextRef;
	private editable var m_contentTextLocKey : CName;
	default m_contentTextLocKey = 'UI-EULA-EULAFullText';
	private editable var m_gamerTagContainerRef : inkWidgetRef;
	private editable var m_gamerTagText : inkTextRef;
	private editable var m_declineEulaPopup : inkWidgetRef;
	private editable var m_declineEulaPopupConfirmButtonRef : inkWidgetRef;
	private editable var m_declineEulaQuitGameHintRef : inkWidgetRef;
	private editable var m_eulaHintsContainerRef : inkWidgetRef;
	private var m_uiSystem : UISystem;
	private var m_delaySystem : DelaySystem;
	private var m_requestHandler : weak< inkISystemRequestsHandler >;
	private var m_eventDispatcher : weak< inkMenuEventDispatcher >;
	private var m_eulaIsAccepted : Bool;
	default m_eulaIsAccepted = false;
	private var m_eulaRead : Bool;
	default m_eulaRead = false;
	private var m_eulaReadWhenButtonWasPressed : Bool;
	default m_eulaReadWhenButtonWasPressed = false;
	private var m_declinePopupOpened : Bool;
	default m_declinePopupOpened = false;
	private var m_sliderController : weak< inkSliderController >;
	private var m_declineEulaPopupConfirmButtonController : weak< inkButtonController >;
	private var m_declineEulaPopupProxy : inkAnimProxy;
	private var m_eulaAnimationProxy : inkAnimProxy;

	protected event OnInitialize()
	{
		super.OnInitialize();
		m_requestHandler = GetSystemRequestsHandler();
		if( !( m_uiSystem ) )
		{
			m_uiSystem = GameInstance.GetUISystem( GetPlayerControlledObject().GetGame() );
			m_delaySystem = GameInstance.GetDelaySystem( GetPlayerControlledObject().GetGame() );
		}
		inkTextRef.SetState( m_declineButtonText, 'Disabled' );
		inkTextRef.SetState( m_acceptButtonText, 'Disabled' );
		RegisterToGlobalInputCallback( 'OnPostOnRelease', this, 'OnShortcutRelease' );
		RegisterToGlobalInputCallback( 'OnPostOnPress', this, 'OnShortcutPress' );
		RegisterToGlobalInputCallback( 'OnPostOnHold', this, 'OnHold' );
		m_declineEulaPopupConfirmButtonController = ( ( inkButtonController )( inkWidgetRef.GetControllerByType( m_declineEulaPopupConfirmButtonRef, 'inkButtonController' ) ) );
		InitializeAndShowEula();
		if( ( GetPlatformShortName() == "xseriess" || GetPlatformShortName() == "xseriesx" ) || GetPlatformShortName() == "windowsGDK" )
		{
			RequestPlatformUsername();
		}
	}

	protected override function PlatformUsernameReceived( platformName : String )
	{
		inkWidgetRef.SetVisible( m_gamerTagContainerRef, true );
		inkTextRef.SetText( m_gamerTagText, platformName );
	}

	private function InitializeAndShowEula()
	{
		inkTextRef.SetLocalizedText( m_contentTextRef, m_contentTextLocKey );
		inkWidgetRef.SetVisible( m_eulaWidget, true );
		GetPlayerControlledObject().RegisterInputListener( this, 'system_quit_game' );
		m_sliderController = ( ( inkSliderController )( inkWidgetRef.GetControllerByType( m_sliderWidget, 'inkSliderController' ) ) );
		m_sliderController.RegisterToCallback( 'OnSliderValueChanged', this, 'OnEulaScrollbarValueChanged' );
	}

	protected event OnUninitialize()
	{
		UnregisterFromCallback( 'OnPostOnRelease', this, 'OnShortcutRelease' );
		UnregisterFromCallback( 'OnPostOnPress', this, 'OnShortcutPress' );
		m_sliderController.UnregisterFromCallback( 'OnSliderValueChanged', this, 'OnEulaScrollbarValueChanged' );
	}

	protected event OnSetMenuEventDispatcher( d : weak< inkMenuEventDispatcher > )
	{
		m_eventDispatcher = d;
	}

	protected event OnEulaScrollbarValueChanged( sliderController : weak< inkSliderController >, progress, value : Float )
	{
		if( progress >= 0.95999998 )
		{
			m_eulaRead = true;
			inkTextRef.SetState( m_declineButtonText, 'Normal' );
			inkTextRef.SetState( m_acceptButtonText, 'Normal' );
		}
	}

	protected event OnShortcutRelease( e : inkPointerEvent )
	{
		if( e.IsAction( 'system_notification_confirm' ) )
		{
			if( m_declinePopupOpened )
			{
				CloseDeclineEula();
			}
			else if( m_eulaReadWhenButtonWasPressed )
			{
				AcceptEula();
			}
		}
		if( !( m_declinePopupOpened ) && e.IsAction( 'cancel' ) )
		{
			DeclineEula();
		}
	}

	protected event OnShortcutPress( e : inkPointerEvent )
	{
		if( e.IsAction( 'system_notification_confirm' ) )
		{
			m_eulaReadWhenButtonWasPressed = m_eulaRead;
		}
	}

	protected event OnHold( evt : inkPointerEvent )
	{
		var progress : Float;
		progress = evt.GetHoldProgress();
		if( progress < 1.0 )
		{
			return 0;
		}
		if( !( m_declinePopupOpened ) )
		{
			return 0;
		}
		if( evt.IsAction( 'close_popup_hold' ) && ( ( ( GetPlatformShortName() == "windows" || GetPlatformShortName() == "windowsGDK" ) || GetPlatformShortName() == "linux" ) || GetPlatformShortName() == "mac" ) )
		{
			evt.Handle();
			m_requestHandler.ExitGame();
		}
	}

	private function DeclineEula()
	{
		var quitGameVisible : Bool;
		inkWidgetRef.SetVisible( m_declineEulaPopup, true );
		PlayLibraryAnimation( 'decline_popup_intro' );
		quitGameVisible = ( ( GetPlatformShortName() == "windows" || GetPlatformShortName() == "windowsGDK" ) || GetPlatformShortName() == "linux" ) || GetPlatformShortName() == "mac";
		inkWidgetRef.SetVisible( m_declineEulaQuitGameHintRef, quitGameVisible );
		m_declinePopupOpened = true;
		m_declineEulaPopupConfirmButtonController.RegisterToCallback( 'OnButtonStateChanged', this, 'OnPopupCloseButtonStateChanged' );
		inkWidgetRef.SetVisible( m_eulaHintsContainerRef, false );
	}

	private function CloseDeclineEula()
	{
		var playbackOptions : inkAnimOptions;
		playbackOptions.playReversed = true;
		m_declineEulaPopupProxy = PlayLibraryAnimation( 'decline_popup_intro', playbackOptions );
		m_declineEulaPopupProxy.RegisterToCallback( inkanimEventType.OnFinish, this, 'OnEulaDeclinePopupClosed' );
		m_declineEulaPopupConfirmButtonController.UnregisterFromCallback( 'OnButtonStateChanged', this, 'OnPopupCloseButtonStateChanged' );
	}

	protected event OnEulaDeclinePopupClosed( e : inkAnimProxy )
	{
		inkWidgetRef.SetVisible( m_declineEulaPopup, false );
		inkWidgetRef.SetVisible( m_eulaHintsContainerRef, true );
		m_declinePopupOpened = false;
	}

	private function OnPopupCloseButtonStateChanged( controller : weak< inkButtonController >, oldState : inkEButtonState, newState : inkEButtonState )
	{
		if( newState == inkEButtonState.Press )
		{
			CloseDeclineEula();
		}
	}

	private function AcceptEula()
	{
		if( !( m_declinePopupOpened ) && m_eulaRead )
		{
			inkTextRef.SetState( m_acceptButtonText, EnumValueToName( 'inkEButtonState', ( ( Int64 )( inkEButtonState.Press ) ) ) );
			inkTextRef.SetState( m_declineButtonText, EnumValueToName( 'inkEButtonState', ( ( Int64 )( inkEButtonState.Normal ) ) ) );
			m_uiSystem.SetIsEulaAccepted( true );
			m_eventDispatcher.SpawnEvent( 'OnSwitchToPitchMenu' );
		}
	}

	protected event OnEulaIsAccepted( e : inkAnimProxy )
	{
		if( m_eulaAnimationProxy )
		{
			m_eulaAnimationProxy.UnregisterFromCallback( inkanimEventType.OnFinish, this, 'OnEulaIsAccepted' );
		}
		m_uiSystem.SetIsEulaAccepted( true );
		m_eventDispatcher.SpawnEvent( 'OnSwitchToPitchMenu' );
	}

}

