class PitchSignInPopupEvent extends Event
{
}

class PitchSignInPopupData extends inkGameNotificationData
{
}

class PitchSignInPopupClosedEvent extends Event
{
}

class PitchMenuGameController extends gameuiMenuGameController
{
	private editable var m_defaultInputHintRef : inkWidgetRef;
	private editable var m_alreadyRegisteredInputHintRef : inkWidgetRef;
	private editable var m_guestTitleRef : inkWidgetRef;
	private editable var m_signedInTitleContainerRef : inkWidgetRef;
	private editable var m_usernameRef : inkTextRef;
	private var m_eventDispatcher : weak< inkMenuEventDispatcher >;
	private var m_requestHandler : weak< inkISystemRequestsHandler >;
	private var m_alreadySignedIn : Bool;
	private var m_onlineSystem : weak< IOnlineSystem >;
	private var m_uiSystem : UISystem;
	private var m_signinPopupDisplayed : Bool;
	default m_signinPopupDisplayed = false;

	protected event OnInitialize()
	{
		m_onlineSystem = GameInstance.GetOnlineSystem( GetPlayerControlledObject().GetGame() );
		m_uiSystem = GameInstance.GetUISystem( GetPlayerControlledObject().GetGame() );
		m_requestHandler = GetSystemRequestsHandler();
		m_alreadySignedIn = m_requestHandler.GetIsSignedIn();
		if( m_alreadySignedIn )
		{
			inkWidgetRef.SetVisible( m_defaultInputHintRef, false );
			inkWidgetRef.SetVisible( m_alreadyRegisteredInputHintRef, true );
			inkWidgetRef.SetVisible( m_guestTitleRef, false );
			inkTextRef.SetText( m_usernameRef, m_onlineSystem.GetGalaxyPersonaName() );
		}
		else
		{
			inkWidgetRef.SetVisible( m_defaultInputHintRef, true );
			inkWidgetRef.SetVisible( m_alreadyRegisteredInputHintRef, false );
			inkWidgetRef.SetVisible( m_guestTitleRef, true );
			inkWidgetRef.SetVisible( m_signedInTitleContainerRef, false );
		}
		RegisterToGlobalInputCallback( 'OnPostOnRelease', this, 'OnRelease' );
	}

	protected event OnUninitialize()
	{
		UnregisterFromGlobalInputCallback( 'OnPostOnRelease', this, 'OnRelease' );
	}

	protected event OnRelease( evt : inkPointerEvent )
	{
		if( !( m_alreadySignedIn ) && evt.IsAction( 'system_notification_confirm' ) )
		{
			PlaySound( 'Button', 'OnPress' );
			if( !( m_signinPopupDisplayed ) )
			{
				m_signinPopupDisplayed = true;
				ShowSignInPopup();
			}
			inkWidgetRef.SetVisible( m_defaultInputHintRef, false );
			inkWidgetRef.SetVisible( m_alreadyRegisteredInputHintRef, false );
		}
		if( evt.IsAction( 'back' ) )
		{
			LeavePitchMenu();
		}
	}

	private function ShowSignInPopup()
	{
		var pitchSignInPopupEvent : PitchSignInPopupEvent;
		pitchSignInPopupEvent = new PitchSignInPopupEvent;
		QueueBroadcastEvent( pitchSignInPopupEvent );
	}

	protected event OnRefreshGOGState( evt : RefreshGOGState )
	{
		if( evt.status == GOGRewardsSystemStatus.RegistrationPending )
		{
			inkWidgetRef.SetVisible( m_defaultInputHintRef, true );
			inkWidgetRef.SetVisible( m_alreadyRegisteredInputHintRef, false );
		}
		else if( evt.status == GOGRewardsSystemStatus.Registered )
		{
			inkWidgetRef.SetVisible( m_defaultInputHintRef, false );
			inkWidgetRef.SetVisible( m_alreadyRegisteredInputHintRef, true );
			inkWidgetRef.SetVisible( m_signedInTitleContainerRef, true );
		}
	}

	protected event OnSetMenuEventDispatcher( d : weak< inkMenuEventDispatcher > )
	{
		m_eventDispatcher = d;
	}

	protected event OnPitchSignInPopupClosed( evt : PitchSignInPopupClosedEvent )
	{
		LeavePitchMenu();
	}

	private function LeavePitchMenu()
	{
		m_eventDispatcher.SpawnEvent( 'OnPitchSignInCloseRequest' );
		m_uiSystem.UpdatePitchScreenLastSeenPatch();
		if( !( m_uiSystem.GetHasTelemetryScreenBeenDisplayed() ) )
		{
			m_eventDispatcher.SpawnEvent( 'OnSwitchToTelemetryScreen' );
		}
		else
		{
			m_eventDispatcher.SpawnEvent( 'OnMainMenu' );
		}
	}

}

class PitchSignInController extends BaseGOGProfileController
{
	private editable var m_qrCodeContainerRef : inkWidgetRef;
	private editable var m_hyperlinkRef : inkTextRef;
	private editable var m_hyperlinkButtonRef : inkWidgetRef;
	private var m_data : PitchSignInPopupData;
	private var m_signInQrCodeController : weak< SignInQrCodeController >;
	private var m_signinUrl : String;

	protected event OnInitialize()
	{
		var uiSystem : UISystem;
		var playbackOptions : inkAnimOptions;
		uiSystem = GameInstance.GetUISystem( GetPlayerControlledObject().GetGame() );
		uiSystem.RequestNewVisualState( 'inkPauseMenuState' );
		m_data = ( ( PitchSignInPopupData )( GetRootWidget().GetUserData( 'PitchSignInPopupData' ) ) );
		m_signInQrCodeController = ( ( SignInQrCodeController )( inkWidgetRef.GetController( m_qrCodeContainerRef ) ) );
		RegisterToGlobalInputCallback( 'OnPostOnRelease', this, 'OnRelease' );
		inkWidgetRef.RegisterToCallback( m_hyperlinkButtonRef, 'OnPress', this, 'OnPressHyperlink' );
		playbackOptions.loopInfinite = true;
		playbackOptions.loopType = inkanimLoopType.Cycle;
		PlayLibraryAnimation( 'loop', playbackOptions );
		inkWidgetRef.SetVisible( m_hyperlinkButtonRef, false );
	}

	protected event OnUninitialize()
	{
		UnregisterFromGlobalInputCallback( 'OnPostOnRelease', this, 'OnRelease' );
		inkWidgetRef.UnregisterFromCallback( m_hyperlinkButtonRef, 'OnPress', this, 'OnPressHyperlink' );
		GetSystemRequestsHandler().RequestSaveUserSettings();
	}

	protected event OnRefreshGOGState( evt : RefreshGOGState )
	{
		if( evt.status == GOGRewardsSystemStatus.RegistrationPending )
		{
			m_signinUrl = evt.registerURL;
			inkTextRef.SetText( m_hyperlinkRef, m_signinUrl );
			inkWidgetRef.SetVisible( m_hyperlinkButtonRef, true );
			m_signInQrCodeController.UpdateQrCode( evt.qrCodePNGBlob );
		}
		else if( evt.status == GOGRewardsSystemStatus.Registered || evt.status == GOGRewardsSystemStatus.Error )
		{
			Close();
		}
	}

	protected event OnPressHyperlink( evt : inkPointerEvent )
	{
		if( !( IsConsolePlatform() ) )
		{
			if( evt.IsAction( 'click' ) || evt.IsAction( 'tap' ) )
			{
				evt.Handle();
				if( m_signinUrl != "" )
				{
					OpenProfileUrl( m_signinUrl );
				}
			}
		}
	}

	protected event OnRelease( evt : inkPointerEvent )
	{
		if( !( evt.IsHandled() ) && evt.IsAction( 'cancel' ) )
		{
			if( evt.GetTarget() != inkTextRef.Get( m_hyperlinkRef ) )
			{
				evt.Handle();
				Close();
			}
		}
	}

	public function Close()
	{
		m_data.token.TriggerCallback( m_data );
	}

}

class SettingsTakeoutController extends BaseGOGProfileController
{
	private editable var m_qrCodeContainerRef : inkWidgetRef;
	private editable var m_hyperlinkRef : inkTextRef;
	private editable var m_hyperlinkButtonRef : inkWidgetRef;
	private var m_data : TelemetryTakeoutPopupData;
	private var m_signInQrCodeController : weak< SignInQrCodeController >;
	private var m_takeoutUrl : String;

	protected event OnInitialize()
	{
		var uiSystem : UISystem;
		var playbackOptions : inkAnimOptions;
		uiSystem = GameInstance.GetUISystem( GetPlayerControlledObject().GetGame() );
		uiSystem.RequestNewVisualState( 'inkPauseMenuState' );
		m_data = ( ( TelemetryTakeoutPopupData )( GetRootWidget().GetUserData( 'TelemetryTakeoutPopupData' ) ) );
		m_signInQrCodeController = ( ( SignInQrCodeController )( inkWidgetRef.GetController( m_qrCodeContainerRef ) ) );
		RegisterToGlobalInputCallback( 'OnPostOnRelease', this, 'OnRelease' );
		inkWidgetRef.SetVisible( m_hyperlinkButtonRef, true );
		inkWidgetRef.RegisterToCallback( m_hyperlinkButtonRef, 'OnPress', this, 'OnPressHyperlink' );
		RequestTakeoutTelemetryURL();
		playbackOptions.loopInfinite = true;
		playbackOptions.loopType = inkanimLoopType.Cycle;
		PlayLibraryAnimation( 'loop', playbackOptions );
	}

	protected event OnUninitialize()
	{
		UnregisterFromGlobalInputCallback( 'OnPostOnRelease', this, 'OnRelease' );
		inkWidgetRef.UnregisterFromCallback( m_hyperlinkButtonRef, 'OnPress', this, 'OnPressHyperlink' );
	}

	protected event OnTakeoutTelemetryURLGenerated( evt : TakeoutTelemetryURLGenerated )
	{
		m_takeoutUrl = evt.takeoutURL;
		m_signInQrCodeController.UpdateQrCode( evt.qrCodePNGBlob );
	}

	protected event OnPressHyperlink( evt : inkPointerEvent )
	{
		if( !( IsConsolePlatform() ) )
		{
			if( evt.IsAction( 'click' ) )
			{
				evt.Handle();
				OpenProfileUrl( m_takeoutUrl );
			}
		}
	}

	protected event OnRelease( evt : inkPointerEvent )
	{
		if( !( evt.IsHandled() ) && evt.IsAction( 'close_popup' ) )
		{
			if( evt.GetTarget() != inkTextRef.Get( m_hyperlinkRef ) )
			{
				evt.Handle();
				Close();
			}
		}
	}

	private function Close()
	{
		m_data.token.TriggerCallback( m_data );
	}

}

