class MenuScenario_FastTravel extends MenuScenario_BaseMenu
{

	protected event OnEnterScenario( prevScenario : CName, userData : IScriptable )
	{
		SwitchMenu( 'world_map' );
	}

	protected event OnBack()
	{
		GotoIdleState();
	}

	protected event OnHotkeySwitchToJournal_FastTravel()
	{
		SwitchMenu( 'quest_log' );
	}

	protected event OnHotkeySwitchToMap_FastTravel()
	{
		SwitchMenu( 'world_map' );
	}

}

