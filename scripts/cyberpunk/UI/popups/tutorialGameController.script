import class TutorialPopupGameController extends inkGameController
{
	editable var m_actionHint : inkWidgetRef;
	editable var m_popupPanel : inkWidgetRef;
	editable var m_popupFullscreenPanel : inkWidgetRef;
	editable var m_fullscreenButtonContainerWidgetPath : CName;
	editable var m_popupBlockingPanel : inkWidgetRef;
	editable var m_popupFullscreenRightPanel : inkWidgetRef;
	private var m_data : weak< TutorialPopupData >;
	private var m_prevData : TutorialPopupData;
	private var m_inputBlocked : Bool;
	private var m_gamePaused : Bool;
	private var m_isShownBbId : CallbackHandle;
	private var m_isHoldAction : Bool;
	private var m_isJoyconDetachPatternTutorial : Bool;
	private var m_animIntroPopup : CName;
	default m_animIntroPopup = 'into_popup';
	private var m_animIntroPopupModal : CName;
	default m_animIntroPopupModal = 'into_popup_modal';
	private var m_animIntroFullscreenLeft : CName;
	default m_animIntroFullscreenLeft = 'into_fullscreen_left';
	private var m_animIntroFullscreenRight : CName;
	default m_animIntroFullscreenRight = 'into_fullscreen_right';
	private var m_animOutroPopup : CName;
	default m_animOutroPopup = 'outro_popup';
	private var m_animOutroPopupModal : CName;
	default m_animOutroPopupModal = 'outro_popup_modal';
	private var m_animOutroFullscreenLeft : CName;
	default m_animOutroFullscreenLeft = 'outro_fullscreen_left';
	private var m_animOutroFullscreenRight : CName;
	default m_animOutroFullscreenRight = 'outro_fullscreen_right';
	private var m_animIntro : CName;
	private var m_animOutro : CName;
	private var m_targetPopup : inkWidgetRef;
	private var m_animationProxy : inkAnimProxy;
	private var m_targetPosition : PopupPosition;
	private var m_onInputDeviceChangedCallbackID : CallbackHandle;
	private var m_joyconDualStyleChangedListener : CallbackHandle;
	private var m_uiContextIsActive : Bool;

	private import function RequestVisualState();
	private import function RestorePreviousVisualState();
	private import function AdaptToScreenComposition();

	protected event OnInitialize()
	{
		RequestVisualState();
		m_data = ( ( TutorialPopupData )( GetRootWidget().GetUserData( 'TutorialPopupData' ) ) );
		m_data.gyroTutorialProgress = 0;
		m_targetPosition = m_data.position;
		if( m_data.closeAtInput )
		{
			BlockInput( true );
		}
		if( m_data.pauseGame )
		{
			PauseGame( true );
			PlaySound( 'GameMenu', 'OnOpen' );
		}
		if( !( GetBlackboardSystem().Get( GetAllBlackboardDefs().InputSchemes ).GetBool( GetAllBlackboardDefs().InputSchemes.IsJoyconDualStyle ) ) && GetBlackboardSystem().Get( GetAllBlackboardDefs().UIGameData ).GetBool( GetAllBlackboardDefs().UIGameData.DetachTutorialPopup_IsShown ) )
		{
			ShowDetachTutorialPopup();
		}
		else
		{
			SetupView();
		}
	}

	protected event OnUninitialize()
	{
		RestorePreviousVisualState();
		if( m_inputBlocked )
		{
			BlockInput( false );
		}
		if( m_gamePaused )
		{
			PauseGame( false );
		}
	}

	protected event OnPlayerAttach( playerPuppet : GameObject )
	{
		m_onInputDeviceChangedCallbackID = GetBlackboardSystem().Get( GetAllBlackboardDefs().InputSchemes ).RegisterListenerUint( GetAllBlackboardDefs().InputSchemes.Device, this, 'OnInputDeviceChanged' );
		if( ( ( PlayerPuppet )( playerPuppet ) ).IsInGyroTutorial() )
		{
			m_joyconDualStyleChangedListener = GetBlackboardSystem().Get( GetAllBlackboardDefs().InputSchemes ).RegisterListenerBool( GetAllBlackboardDefs().InputSchemes.IsJoyconDualStyle, this, 'OnJoyconDualStyleChanged' );
		}
		if( m_inputBlocked )
		{
			playerPuppet.RegisterInputListener( this, 'UI_Apply' );
			playerPuppet.RegisterInputListener( this, 'UI_Cancel' );
			playerPuppet.RegisterInputListener( this, 'ChoiceApply' );
		}
		RegisterGyroInputListeners( playerPuppet );
		if( ( m_data.gyroTutorialProgress > 0 ) && ( m_data.gyroTutorialProgress <= m_data.gyroTutorialProgressMax ) )
		{
			UpdateTutorialUiText();
		}
	}

	protected event OnPlayerDetach( playerPuppet : GameObject )
	{
		if( m_onInputDeviceChangedCallbackID )
		{
			GetBlackboardSystem().Get( GetAllBlackboardDefs().InputSchemes ).UnregisterListenerUint( GetAllBlackboardDefs().InputSchemes.Device, m_onInputDeviceChangedCallbackID );
		}
		if( m_joyconDualStyleChangedListener )
		{
			GetBlackboardSystem().Get( GetAllBlackboardDefs().InputSchemes ).UnregisterListenerBool( GetAllBlackboardDefs().InputSchemes.IsJoyconDualStyle, m_joyconDualStyleChangedListener );
		}
		if( m_inputBlocked )
		{
			GetPlayerControlledObject().UnregisterInputListener( this );
		}
		if( m_uiContextIsActive )
		{
			ChangeUIContext( false );
		}
	}

	protected event OnInputDeviceChanged( value : Uint32 )
	{
		var popupController : TutorialPopupDisplayController;
		var inputDevice : InputDevice;
		var inputScheme : InputScheme;
		inputDevice = ( ( InputDevice )( ( ( Uint8 )( value ) ) ) );
		inputScheme = ( ( InputScheme )( ( ( Uint8 )( GetBlackboardSystem().Get( GetAllBlackboardDefs().InputSchemes ).GetUint( GetAllBlackboardDefs().InputSchemes.Scheme ) ) ) ) );
		if( inkWidgetRef.IsValid( m_targetPopup ) )
		{
			popupController = ( ( TutorialPopupDisplayController )( inkWidgetRef.GetController( m_targetPopup ) ) );
			popupController.Refresh( inputDevice, inputScheme );
		}
	}

	public function CloseTutorial()
	{
		var bb : IBlackboard;
		if( m_animationProxy != NULL )
		{
			m_animationProxy.UnregisterFromAllCallbacks( inkanimEventType.OnFinish );
			m_animationProxy.Stop();
			m_animationProxy = NULL;
		}
		m_animationProxy = PlayLibraryAnimationOnAutoSelectedTargets( m_animOutro, inkWidgetRef.Get( m_targetPopup ) );
		m_animationProxy.RegisterToCallback( inkanimEventType.OnFinish, this, 'OnOutro' );
		PlaySound( 'GameMenu', 'OnClose' );
		bb = GetBlackboardSystem().Get( GetAllBlackboardDefs().UIGameData );
		if( bb.GetBool( GetAllBlackboardDefs().UIGameData.DetachTutorialPopup_IsShown ) )
		{
			bb.SetBool( GetAllBlackboardDefs().UIGameData.DetachTutorialPopup_IsShown, false );
		}
	}

	protected event OnRelease( e : inkPointerEvent )
	{
		var menuEvent : inkMenuInstance_SpawnEvent;
		if( ( !( m_isJoyconDetachPatternTutorial ) && !( m_isHoldAction ) ) && e.IsAction( 'close_tutorial' ) )
		{
			CloseTutorial();
		}
		else if( m_isJoyconDetachPatternTutorial && e.IsAction( 'OpenPauseMenu_Tutorial' ) )
		{
			menuEvent = new inkMenuInstance_SpawnEvent;
			menuEvent.Init( 'OnOpenPauseMenu' );
			GameInstance.GetUISystem( GetPlayerControlledObject().GetGame() ).QueueEvent( menuEvent );
		}
	}

	protected event OnHold( e : inkPointerEvent )
	{
		var progress : Float;
		progress = e.GetHoldProgress();
		if( ( ( !( m_isJoyconDetachPatternTutorial ) && m_isHoldAction ) && ( progress >= 1.0 ) ) && e.IsAction( 'close_tutorial' ) )
		{
			CloseTutorial();
		}
	}

	protected event OnAction( action : ListenerAction, consumer : ListenerActionConsumer )
	{
		var actionName : String;
		var actionPatternTutorialName : String;
		actionName = NameToString( ListenerAction.GetName( action ) );
		actionPatternTutorialName = NameToString( ListenerAction.GetPatternTutorialName( action ) );
		if( actionName != "" )
		{
			if( m_data.gyroTutorialProgress < 0 )
			{
				m_data.gyroTutorialProgress = 0;
			}
			else if( m_data.gyroTutorialProgress <= m_data.gyroTutorialProgressMax )
			{
				SetGyroTutorialFact( actionName, actionPatternTutorialName );
				UpdateTutorialUiText();
			}
			else
			{
				PauseGame( false );
			}
		}
	}

	public function ChangeUIContext( value : Bool )
	{
		var psmEvent : PSMPostponedParameterBool;
		m_uiContextIsActive = value;
		if( value )
		{
			psmEvent = new PSMPostponedParameterBool;
			psmEvent.id = 'OnUIContextActive';
		}
		else
		{
			psmEvent = new PSMPostponedParameterBool;
			psmEvent.id = 'OnUIContextInactive';
		}
		psmEvent.value = true;
		GetPlayerControlledObject().QueueEvent( psmEvent );
	}

	public function SetupTutorialPopupView()
	{
		BlockInput( m_data.closeAtInput );
		PauseGame( m_data.pauseGame );
		ContinueButtonSetState( !( m_isJoyconDetachPatternTutorial ), m_data.gyroTutorialProgress > 0 );
		SetupView();
		ChangeUIContext( m_data.pauseGame );
		GetBlackboardSystem().Get( GetAllBlackboardDefs().UIGameData ).SetBool( GetAllBlackboardDefs().UIGameData.DetachTutorialPopup_IsShown, m_isJoyconDetachPatternTutorial );
	}

	public function ShowDetachTutorialPopup()
	{
		m_prevData = new TutorialPopupData;
		CopyPopupData( m_data, m_prevData );
		CopyPopupData( new DetachTutorialPopupData, m_data );
		m_isJoyconDetachPatternTutorial = true;
		SetupTutorialPopupView();
	}

	public function CopyPopupData( from : TutorialPopupData, to : TutorialPopupData )
	{
		to.title = from.title;
		to.message = from.message;
		to.videoType = from.videoType;
		to.video = from.video;
		to.pauseGame = from.pauseGame;
		to.isModal = from.isModal;
		to.closeAtInput = from.closeAtInput;
		to.position = from.position;
		to.gyroTutorialProgress = from.gyroTutorialProgress;
	}

	protected event OnJoyconDualStyleChanged( value : Bool )
	{
		if( m_isJoyconDetachPatternTutorial && value )
		{
			if( m_prevData != NULL )
			{
				CopyPopupData( m_prevData, m_data );
				m_prevData = NULL;
				m_isJoyconDetachPatternTutorial = false;
				SetupTutorialPopupView();
			}
			else
			{
				CloseTutorial();
			}
		}
		else if( !( value ) )
		{
			ShowDetachTutorialPopup();
		}
	}

	protected event OnGyroTutorialUIEvent( evt : GyroTutorialUIEvent )
	{
		var actionName : String;
		var actionPatternTutorialName : String;
		actionName = NameToString( evt.actionName );
		actionPatternTutorialName = NameToString( evt.actionPatternTutorialName );
		SetGyroTutorialFact( actionName, actionPatternTutorialName );
		if( ( m_data.gyroTutorialProgress > 0 ) && ( m_data.gyroTutorialProgress <= m_data.gyroTutorialProgressMax ) )
		{
			UpdateTutorialUiText();
		}
	}

	private function ContinueButtonSetState( isEnabled : Bool, isHoldAction : Bool )
	{
		var widget : weak< inkWidget >;
		var widgetPath : CName;
		var inputDisplayController : inkInputDisplayController;
		widgetPath = m_fullscreenButtonContainerWidgetPath + '/inputDisplayController';
		widget = GetWidget( widgetPath );
		if( widget )
		{
			inputDisplayController = ( ( inkInputDisplayController )( widget.GetController() ) );
			if( inputDisplayController )
			{
				m_isHoldAction = isHoldAction;
				inputDisplayController.SetInputAction( 'close_tutorial' );
				inputDisplayController.SetHoldIndicatorType( ( ( isEnabled && isHoldAction ) ? ( inkInputHintHoldIndicationType.Hold ) : ( inkInputHintHoldIndicationType.Press ) ) );
			}
		}
		widgetPath = m_fullscreenButtonContainerWidgetPath + '/inputDisplayController/container/inputRoot/inputIcon';
		widget = GetWidget( widgetPath );
		if( widget )
		{
			widget.BindProperty( 'tintColor', ( ( isEnabled ) ? ( 'MainColors.Blue' ) : ( 'MainColors.Grey' ) ) );
		}
		widgetPath = m_fullscreenButtonContainerWidgetPath + '/inputDisplayController/container/inputRoot/inputText';
		widget = GetWidget( widgetPath );
		if( widget )
		{
			widget.BindProperty( 'tintColor', ( ( isEnabled ) ? ( 'MainColors.Blue' ) : ( 'MainColors.Grey' ) ) );
		}
		widgetPath = m_fullscreenButtonContainerWidgetPath + '/action';
		widget = GetWidget( widgetPath );
		if( widget )
		{
			widget.BindProperty( 'tintColor', ( ( isEnabled ) ? ( 'MainColors.Red' ) : ( 'MainColors.Grey' ) ) );
		}
	}

	private function RegisterGyroInputListeners( owner : GameObject )
	{
		var questSystem : QuestsSystem;
		questSystem = GameInstance.GetQuestsSystem( owner.GetGame() );
		m_data.hasGyroTutorialCounter = questSystem.GetFact( 'gyro_tutorial_show_counter' ) == 1;
		if( ( questSystem.GetFact( 'gyro_light_attack_tutorial' ) > 0 ) && ( questSystem.GetFact( 'gyro_light_attack_tutorial_seen' ) == 0 ) )
		{
			owner.RegisterInputListener( this, ( ( m_inputBlocked ) ? ( 'MeleeAttack_Tutorial' ) : ( 'MeleeAttack' ) ) );
			m_data.gyroTutorialProgress = questSystem.GetFact( 'gyro_light_attack_tutorial' );
		}
		else if( ( questSystem.GetFact( 'gyro_strong_attack_tutorial' ) > 0 ) && ( questSystem.GetFact( 'gyro_strong_attack_tutorial_seen' ) == 0 ) )
		{
			owner.RegisterInputListener( this, ( ( m_inputBlocked ) ? ( 'MeleeAttack_Tutorial' ) : ( 'MeleeAttack' ) ) );
			m_data.gyroTutorialProgress = questSystem.GetFact( 'gyro_strong_attack_tutorial' );
		}
		else if( ( questSystem.GetFact( 'gyro_charged_attack_tutorial' ) > 0 ) && ( questSystem.GetFact( 'gyro_charged_attack_tutorial_seen' ) == 0 ) )
		{
			owner.RegisterInputListener( this, ( ( m_inputBlocked ) ? ( 'MeleeAttack_Tutorial' ) : ( 'MeleeAttack' ) ) );
			m_data.gyroTutorialProgress = questSystem.GetFact( 'gyro_charged_attack_tutorial' );
		}
		else if( ( questSystem.GetFact( 'gyro_reload_tutorial' ) > 0 ) && ( questSystem.GetFact( 'gyro_reload_tutorial_seen' ) == 0 ) )
		{
			owner.RegisterInputListener( this, ( ( m_inputBlocked ) ? ( 'Reload_Tutorial' ) : ( 'Reload' ) ) );
			m_data.gyroTutorialProgress = questSystem.GetFact( 'gyro_reload_tutorial' );
		}
		else if( ( questSystem.GetFact( 'gyro_dodge_tutorial' ) > 0 ) && ( questSystem.GetFact( 'gyro_dodge_tutorial_seen' ) == 0 ) )
		{
			owner.RegisterInputListener( this, ( ( m_inputBlocked ) ? ( 'Dodge_Tutorial' ) : ( 'Dodge' ) ) );
			m_data.gyroTutorialProgress = questSystem.GetFact( 'gyro_dodge_tutorial' );
		}
		else if( ( questSystem.GetFact( 'gyro_dodge_left_tutorial' ) > 0 ) && ( questSystem.GetFact( 'gyro_dodge_left_tutorial_seen' ) == 0 ) )
		{
			owner.RegisterInputListener( this, ( ( m_inputBlocked ) ? ( 'Dodge_Tutorial' ) : ( 'Dodge' ) ) );
			m_data.gyroTutorialProgress = questSystem.GetFact( 'gyro_dodge_left_tutorial' );
		}
		else if( ( questSystem.GetFact( 'gyro_dodge_right_tutorial' ) > 0 ) && ( questSystem.GetFact( 'gyro_dodge_right_tutorial_seen' ) == 0 ) )
		{
			owner.RegisterInputListener( this, ( ( m_inputBlocked ) ? ( 'Dodge_Tutorial' ) : ( 'Dodge' ) ) );
			m_data.gyroTutorialProgress = questSystem.GetFact( 'gyro_dodge_right_tutorial' );
		}
		else if( ( questSystem.GetFact( 'gyro_inhaler_tutorial' ) > 0 ) && ( questSystem.GetFact( 'gyro_inhaler_tutorial_seen' ) == 0 ) )
		{
			owner.RegisterInputListener( this, ( ( m_inputBlocked ) ? ( 'UseConsumable_Tutorial' ) : ( 'UseConsumable' ) ) );
			m_data.gyroTutorialProgress = questSystem.GetFact( 'gyro_inhaler_tutorial' );
		}
		else if( ( questSystem.GetFact( 'gyro_detach_tutorial' ) > 0 ) && ( questSystem.GetFact( 'gyro_detach_tutorial_seen' ) == 0 ) )
		{
			m_isJoyconDetachPatternTutorial = !( GetBlackboardSystem().Get( GetAllBlackboardDefs().InputSchemes ).GetBool( GetAllBlackboardDefs().InputSchemes.IsJoyconDualStyle ) );
			m_data.gyroTutorialProgress = questSystem.GetFact( 'gyro_detach_tutorial' );
		}
		else if( ( questSystem.GetFact( 'gyro_settings_tutorial' ) > 0 ) && ( questSystem.GetFact( 'gyro_settings_tutorial_seen' ) == 0 ) )
		{
			m_data.gyroTutorialProgress = questSystem.GetFact( 'gyro_settings_tutorial' );
		}
		else if( ( questSystem.GetFact( 'gyro_sensor_reset_tutorial' ) > 0 ) && ( questSystem.GetFact( 'gyro_sensor_reset_tutorial_seen' ) == 0 ) )
		{
			m_data.gyroTutorialProgress = questSystem.GetFact( 'gyro_sensor_reset_tutorial' );
		}
		if( ( m_data.gyroTutorialProgress > 0 ) || m_data.title == "LocKey#97281" )
		{
			ContinueButtonSetState( !( m_isJoyconDetachPatternTutorial ), true );
		}
	}

	public function SetGyroTutorialFact( actionName : String, actionPatternTutorialName : String )
	{
		var questSystem : QuestsSystem;
		questSystem = GameInstance.GetQuestsSystem( GetPlayerControlledObject().GetGame() );
		if( ( questSystem.GetFact( 'gyro_tutorial_show_counter' ) == 0 ) && ( ( m_data.gyroTutorialProgress + 1 ) > m_data.gyroTutorialProgressMax ) )
		{
			m_data.gyroTutorialProgress = m_data.gyroTutorialProgressMax - 1;
		}
		if( StrContains( actionName, "MeleeAttack" ) )
		{
			if( ( StrContains( actionPatternTutorialName, "MeleeAttack_Normal" ) && ( questSystem.GetFact( 'gyro_light_attack_tutorial' ) > 0 ) ) && ( questSystem.GetFact( 'gyro_light_attack_tutorial_seen' ) == 0 ) )
			{
				questSystem.SetFact( 'gyro_light_attack_tutorial', m_data.gyroTutorialProgress + 1 );
				m_data.gyroTutorialProgress = questSystem.GetFact( 'gyro_light_attack_tutorial' );
			}
			else if( ( StrContains( actionPatternTutorialName, "MeleeAttack_Heavy" ) && ( questSystem.GetFact( 'gyro_strong_attack_tutorial' ) > 0 ) ) && ( questSystem.GetFact( 'gyro_strong_attack_tutorial_seen' ) == 0 ) )
			{
				questSystem.SetFact( 'gyro_strong_attack_tutorial', m_data.gyroTutorialProgress + 1 );
				m_data.gyroTutorialProgress = questSystem.GetFact( 'gyro_strong_attack_tutorial' );
			}
			else if( ( StrContains( actionPatternTutorialName, "MeleeAttack_Charge" ) && ( questSystem.GetFact( 'gyro_charged_attack_tutorial' ) > 0 ) ) && ( questSystem.GetFact( 'gyro_charged_attack_tutorial_seen' ) == 0 ) )
			{
				questSystem.SetFact( 'gyro_charged_attack_tutorial', m_data.gyroTutorialProgress + 1 );
				m_data.gyroTutorialProgress = questSystem.GetFact( 'gyro_charged_attack_tutorial' );
			}
		}
		else if( ( actionName == "Reload_Tutorial" && ( questSystem.GetFact( 'gyro_reload_tutorial' ) > 0 ) ) && ( questSystem.GetFact( 'gyro_reload_tutorial_seen' ) == 0 ) )
		{
			questSystem.SetFact( 'gyro_reload_tutorial', m_data.gyroTutorialProgress + 1 );
			m_data.gyroTutorialProgress = questSystem.GetFact( 'gyro_reload_tutorial' );
		}
		else if( ( ( actionName == "Dodge_Tutorial" || StrContains( actionPatternTutorialName, "Dodge" ) ) && ( questSystem.GetFact( 'gyro_dodge_tutorial' ) > 0 ) ) && ( questSystem.GetFact( 'gyro_dodge_tutorial_seen' ) == 0 ) )
		{
			questSystem.SetFact( 'gyro_dodge_tutorial', m_data.gyroTutorialProgress + 1 );
			m_data.gyroTutorialProgress = questSystem.GetFact( 'gyro_dodge_tutorial' );
		}
		else if( ( ( actionName == "Dodge_Tutorial" || StrContains( actionPatternTutorialName, "Dodge" ) ) && ( questSystem.GetFact( 'gyro_dodge_left_tutorial' ) > 0 ) ) && ( questSystem.GetFact( 'gyro_dodge_left_tutorial_seen' ) == 0 ) )
		{
			questSystem.SetFact( 'gyro_dodge_left_tutorial', m_data.gyroTutorialProgress + 1 );
			m_data.gyroTutorialProgress = questSystem.GetFact( 'gyro_dodge_left_tutorial' );
		}
		else if( ( ( actionName == "Dodge_Tutorial" || StrContains( actionPatternTutorialName, "Dodge" ) ) && ( questSystem.GetFact( 'gyro_dodge_right_tutorial' ) > 0 ) ) && ( questSystem.GetFact( 'gyro_dodge_right_tutorial_seen' ) == 0 ) )
		{
			questSystem.SetFact( 'gyro_dodge_right_tutorial', m_data.gyroTutorialProgress + 1 );
			m_data.gyroTutorialProgress = questSystem.GetFact( 'gyro_dodge_right_tutorial' );
		}
		else if( ( actionName == "UseConsumable_Tutorial" && ( questSystem.GetFact( 'gyro_inhaler_tutorial' ) > 0 ) ) && ( questSystem.GetFact( 'gyro_inhaler_tutorial_seen' ) == 0 ) )
		{
			questSystem.SetFact( 'gyro_inhaler_tutorial', m_data.gyroTutorialProgress + 1 );
			m_data.gyroTutorialProgress = questSystem.GetFact( 'gyro_inhaler_tutorial' );
		}
	}

	public function UpdateTutorialUiText()
	{
		var displayController : TutorialPopupDisplayController;
		var inputBB : IBlackboard;
		var inputDevice : InputDevice;
		var inputScheme : InputScheme;
		inputBB = GetBlackboardSystem().Get( GetAllBlackboardDefs().InputSchemes );
		inputDevice = ( ( InputDevice )( ( ( Uint8 )( inputBB.GetUint( GetAllBlackboardDefs().InputSchemes.Device ) ) ) ) );
		inputScheme = ( ( InputScheme )( ( ( Uint8 )( inputBB.GetUint( GetAllBlackboardDefs().InputSchemes.Scheme ) ) ) ) );
		displayController = ( ( TutorialPopupDisplayController )( inkWidgetRef.GetController( m_targetPopup ) ) );
		displayController.SetData( m_data, inputDevice, inputScheme );
	}

	private function BlockInput( value : Bool )
	{
		if( m_inputBlocked != value )
		{
			m_inputBlocked = value;
			if( m_inputBlocked )
			{
				RegisterToGlobalInputCallback( 'OnPostOnRelease', this, 'OnRelease' );
				RegisterToGlobalInputCallback( 'OnPostOnHold', this, 'OnHold' );
			}
			else
			{
				UnregisterFromGlobalInputCallback( 'OnPostOnRelease', this, 'OnRelease' );
				UnregisterFromGlobalInputCallback( 'OnPostOnHold', this, 'OnHold' );
			}
		}
	}

	private function PauseGame( value : Bool )
	{
		if( m_gamePaused != value )
		{
			m_gamePaused = value;
			if( value )
			{
				GameInstance.GetTimeSystem( GetPlayerControlledObject().GetGame() ).SetTimeDilation( 'UI_TutorialPopup', 0.0 );
				GameInstance.GetAudioSystem( GetPlayerControlledObject().GetGame() ).Play( 'global_tutorial_open' );
			}
			else
			{
				GameInstance.GetTimeSystem( GetPlayerControlledObject().GetGame() ).UnsetTimeDilation( 'UI_TutorialPopup' );
				GameInstance.GetAudioSystem( GetPlayerControlledObject().GetGame() ).Play( 'ui_menu_tutorial_close' );
				GameInstance.GetAudioSystem( GetPlayerControlledObject().GetGame() ).Play( 'global_tutorial_close' );
			}
		}
	}

	private function SetupView()
	{
		var targetMargin : inkMargin;
		var isMouserActive : Bool;
		GetRootWidget().SetVisible( true );
		inkWidgetRef.SetVisible( m_popupPanel, false );
		inkWidgetRef.SetVisible( m_popupFullscreenPanel, false );
		inkWidgetRef.SetVisible( m_popupBlockingPanel, false );
		inkWidgetRef.SetVisible( m_popupFullscreenRightPanel, false );
		if( m_data.title == "LocKey#19637" && m_data.message == "LocKey#19639" )
		{
			isMouserActive = GetBlackboardSystem().Get( GetAllBlackboardDefs().InputSchemes ).GetBool( GetAllBlackboardDefs().InputSchemes.IsMouserActive );
			if( isMouserActive )
			{
				return;
			}
		}
		if( m_animationProxy != NULL )
		{
			m_animationProxy.UnregisterFromAllCallbacks( inkanimEventType.OnFinish );
			m_animationProxy.Stop();
			m_animationProxy = NULL;
		}
		if( m_data.isModal )
		{
			if( m_data.position == PopupPosition.UpperRight || m_data.position == PopupPosition.LowerRight )
			{
				m_targetPopup = m_popupFullscreenRightPanel;
				m_animIntro = m_animIntroFullscreenRight;
				m_animOutro = m_animOutroFullscreenRight;
			}
			else
			{
				m_targetPopup = m_popupFullscreenPanel;
				m_animIntro = m_animIntroFullscreenLeft;
				m_animOutro = m_animOutroFullscreenLeft;
			}
			inkWidgetRef.SetVisible( m_targetPopup, true );
			targetMargin = inkWidgetRef.GetMargin( m_targetPopup );
			targetMargin.left += m_data.margin.left;
			targetMargin.top += m_data.margin.top;
			targetMargin.right += m_data.margin.right;
			targetMargin.bottom += m_data.margin.bottom;
			inkWidgetRef.SetMargin( m_targetPopup, targetMargin );
		}
		else
		{
			if( m_data.closeAtInput )
			{
				m_targetPopup = m_popupBlockingPanel;
				m_animIntro = m_animIntroPopupModal;
				m_animOutro = m_animOutroPopupModal;
			}
			else
			{
				m_targetPopup = m_popupPanel;
				m_animIntro = m_animIntroPopup;
				m_animOutro = m_animOutroPopup;
			}
			inkWidgetRef.SetVisible( m_targetPopup, true );
			targetMargin = inkWidgetRef.GetMargin( m_targetPopup );
			targetMargin.left += m_data.margin.left;
			targetMargin.top += m_data.margin.top;
			targetMargin.right += m_data.margin.right;
			targetMargin.bottom += m_data.margin.bottom;
			inkWidgetRef.SetMargin( m_targetPopup, targetMargin );
			m_targetPosition = m_data.position;
			switch( m_targetPosition )
			{
				case PopupPosition.UpperRight:
					inkWidgetRef.SetAnchorPoint( m_targetPopup, 1.0, 0.0 );
				inkWidgetRef.SetAnchor( m_targetPopup, inkEAnchor.TopRight );
				break;
				case PopupPosition.UpperLeft:
					inkWidgetRef.SetAnchorPoint( m_targetPopup, 0.0, 0.0 );
				inkWidgetRef.SetAnchor( m_targetPopup, inkEAnchor.TopLeft );
				break;
				case PopupPosition.LowerLeft:
					inkWidgetRef.SetAnchorPoint( m_targetPopup, 0.0, 1.0 );
				inkWidgetRef.SetAnchor( m_targetPopup, inkEAnchor.BottomLeft );
				AdaptToDpadHints();
				break;
				case PopupPosition.LowerRight:
					inkWidgetRef.SetAnchorPoint( m_targetPopup, 1.0, 1.0 );
				inkWidgetRef.SetAnchor( m_targetPopup, inkEAnchor.BottomRight );
				break;
				case PopupPosition.Undefined:
				case PopupPosition.Center:
					inkWidgetRef.SetAnchorPoint( m_targetPopup, 0.5, 0.5 );
				inkWidgetRef.SetAnchor( m_targetPopup, inkEAnchor.Centered );
				break;
			}
		}
		UpdateTutorialUiText();
		AdaptToScreenComposition();
		m_animationProxy = PlayLibraryAnimationOnAutoSelectedTargets( m_animIntro, inkWidgetRef.Get( m_targetPopup ) );
		m_animationProxy.RegisterToCallback( inkanimEventType.OnFinish, this, 'OnIntro' );
	}

	private export function AdaptToBlackBars( offset : Float )
	{
		var popupTranslation : Vector2;
		popupTranslation = inkWidgetRef.GetTranslation( m_targetPopup );
		switch( m_targetPosition )
		{
			case PopupPosition.UpperLeft:
			case PopupPosition.LowerLeft:
				popupTranslation.X += offset;
			inkWidgetRef.SetTranslation( m_targetPopup, popupTranslation );
			break;
			case PopupPosition.LowerRight:
			case PopupPosition.UpperRight:
				popupTranslation.X -= offset;
			inkWidgetRef.SetTranslation( m_targetPopup, popupTranslation );
			break;
			case PopupPosition.Undefined:
			case PopupPosition.Center:
				return;
		}
	}

	private export function AdaptToHudSafezones( safezones : Vector2 )
	{
		var targetMargin : inkMargin;
		targetMargin = inkWidgetRef.GetMargin( m_targetPopup );
		targetMargin.left += m_data.margin.left;
		targetMargin.top += m_data.margin.top;
		targetMargin.right += m_data.margin.right;
		targetMargin.bottom += m_data.margin.bottom;
		switch( m_targetPosition )
		{
			case PopupPosition.UpperLeft:
				targetMargin.left += safezones.X;
			targetMargin.top += safezones.Y;
			break;
			case PopupPosition.LowerLeft:
				targetMargin.left += safezones.X;
			targetMargin.bottom += safezones.Y;
			break;
			case PopupPosition.LowerRight:
				targetMargin.right += safezones.X;
			targetMargin.bottom += safezones.Y;
			break;
			case PopupPosition.UpperRight:
				targetMargin.right += safezones.X;
			targetMargin.top += safezones.Y;
			break;
			default:
				break;
		}
		inkWidgetRef.SetMargin( m_targetPopup, targetMargin );
	}

	private function AdaptToDpadHints()
	{
		var isBiggerHudEnabled : Bool;
		var targetMargin : inkMargin;
		isBiggerHudEnabled = GameInstance.GetUISystem( GetPlayerControlledObject().GetGame() ).GetHudScalingOverride() > 1.0;
		targetMargin = inkWidgetRef.GetMargin( m_targetPopup );
		if( targetMargin.bottom > 0.0 )
		{
			targetMargin.bottom += ( ( isBiggerHudEnabled ) ? ( 300.0 ) : ( 200.0 ) );
			inkWidgetRef.SetMargin( m_targetPopup, targetMargin );
		}
	}

	protected event OnIntro( anim : inkAnimProxy )
	{
		if( m_gamePaused )
		{
			GameInstance.GetAudioSystem( GetPlayerControlledObject().GetGame() ).Play( 'ui_menu_tutorial_open' );
		}
	}

	protected event OnOutro( anim : inkAnimProxy )
	{
		m_data.token.TriggerCallback( m_data );
	}

}

class GyroTutorialUIEvent extends Event
{
	var actionName : CName;
	var actionPatternTutorialName : CName;
}

