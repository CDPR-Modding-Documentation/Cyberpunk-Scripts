class TutorialPopupData extends inkGameNotificationData
{
	var closeAtInput : Bool;
	var pauseGame : Bool;
	var isModal : Bool;
	var position : PopupPosition;
	var margin : inkMargin;
	var imageId : TweakDBID;
	var title : String;
	var message : String;
	var messageOverrideDataList : array< JournalEntryOverrideData >;
	var videoType : VideoType;
	var video : ResRef;
	var gyroTutorialProgress : Int32;
	var hasGyroTutorialCounter : Bool;
	var gyroTutorialProgressMax : Int32;
	default gyroTutorialProgressMax = 3;
	var gyroCounterStr : String;
	default gyroCounterStr = "{gyro_tutorial_progress0}";
	var gyroCounterParamStr : String;
	default gyroCounterParamStr = "gyro_tutorial_progress0";
}

class DetachTutorialPopupData extends TutorialPopupData
{
	default title = "LocKey#96663";
	default message = "LocKey#96664";
	default videoType = VideoType.Tutorial_1360x768;
	default video = R"base\movies\tutorials\1360x768\detach.bk2";
	default pauseGame = true;
	default isModal = true;
	default closeAtInput = true;
	default position = PopupPosition.LowerLeft;
}

