class EmporiumPatternTutorialPanelGameController extends inkGameController
{
	[ category = "Main" ]
	private editable var m_closeButtonRef : inkWidgetRef;
	[ category = "Main" ]
	private editable var m_descriptionRef : inkRichTextBoxRef;
	[ category = "Main" ]
	private editable var m_videoWidgetRef : inkVideoRef;
	[ category = "Main" ]
	private editable var m_introAnimationName : CName;
	default m_introAnimationName = 'intro';
	[ category = "Tabs" ]
	private editable var m_tabButtonRef : inkWidgetRef[ 7 ];
	[ category = "Tabs" ]
	private editable var m_tabButtonLabelRef : inkTextRef[ 7 ];
	[ category = "Tabs" ]
	private editable var m_tabButtonBkgRef : inkWidgetRef[ 7 ];
	[ category = "Data" ]
	private editable var m_contentData : VideoCarouselData[ 7 ];
	private var m_data : EmporiumPopupData;
	private var m_videoWidget : weak< inkVideo >;
	private var m_activeTab : Int32;
	default m_activeTab = -1;
	private var m_animProxy : inkAnimProxy;

	protected event OnInitialize()
	{
		var playerControlledObject : GameObject;
		m_data = ( ( EmporiumPopupData )( GetRootWidget().GetUserData( 'EmporiumPopupData' ) ) );
		m_videoWidget = ( ( inkVideo )( inkVideoRef.Get( m_videoWidgetRef ) ) );
		inkTextRef.SetLocalizedText( m_tabButtonLabelRef[ 0 ], m_contentData[ 0 ].videoTitleKey );
		inkTextRef.SetLocalizedText( m_tabButtonLabelRef[ 1 ], m_contentData[ 1 ].videoTitleKey );
		inkTextRef.SetLocalizedText( m_tabButtonLabelRef[ 2 ], m_contentData[ 2 ].videoTitleKey );
		inkTextRef.SetLocalizedText( m_tabButtonLabelRef[ 3 ], m_contentData[ 3 ].videoTitleKey );
		inkTextRef.SetLocalizedText( m_tabButtonLabelRef[ 4 ], m_contentData[ 4 ].videoTitleKey );
		inkTextRef.SetLocalizedText( m_tabButtonLabelRef[ 5 ], m_contentData[ 5 ].videoTitleKey );
		inkTextRef.SetLocalizedText( m_tabButtonLabelRef[ 6 ], m_contentData[ 6 ].videoTitleKey );
		SetActiveContetnt( 0 );
		playerControlledObject = GetPlayerControlledObject();
		playerControlledObject.RegisterInputListener( this, 'UI_MoveDown' );
		playerControlledObject.RegisterInputListener( this, 'UI_MoveUp' );
		inkWidgetRef.RegisterToCallback( m_closeButtonRef, 'OnPress', this, 'OnPressClose' );
		inkWidgetRef.RegisterToCallback( m_tabButtonRef[ 0 ], 'OnPress', this, 'OnPressTab0' );
		inkWidgetRef.RegisterToCallback( m_tabButtonRef[ 1 ], 'OnPress', this, 'OnPressTab1' );
		inkWidgetRef.RegisterToCallback( m_tabButtonRef[ 2 ], 'OnPress', this, 'OnPressTab2' );
		inkWidgetRef.RegisterToCallback( m_tabButtonRef[ 3 ], 'OnPress', this, 'OnPressTab3' );
		inkWidgetRef.RegisterToCallback( m_tabButtonRef[ 4 ], 'OnPress', this, 'OnPressTab4' );
		inkWidgetRef.RegisterToCallback( m_tabButtonRef[ 5 ], 'OnPress', this, 'OnPressTab5' );
		inkWidgetRef.RegisterToCallback( m_tabButtonRef[ 6 ], 'OnPress', this, 'OnPressTab6' );
		inkWidgetRef.RegisterToCallback( m_tabButtonRef[ 0 ], 'OnHoverOver', this, 'OnHoverOverTab0' );
		inkWidgetRef.RegisterToCallback( m_tabButtonRef[ 0 ], 'OnHoverOut', this, 'OnHoverOutTab0' );
		inkWidgetRef.RegisterToCallback( m_tabButtonRef[ 1 ], 'OnHoverOver', this, 'OnHoverOverTab1' );
		inkWidgetRef.RegisterToCallback( m_tabButtonRef[ 1 ], 'OnHoverOut', this, 'OnHoverOutTab1' );
		inkWidgetRef.RegisterToCallback( m_tabButtonRef[ 2 ], 'OnHoverOver', this, 'OnHoverOverTab2' );
		inkWidgetRef.RegisterToCallback( m_tabButtonRef[ 2 ], 'OnHoverOut', this, 'OnHoverOutTab2' );
		inkWidgetRef.RegisterToCallback( m_tabButtonRef[ 3 ], 'OnHoverOver', this, 'OnHoverOverTab3' );
		inkWidgetRef.RegisterToCallback( m_tabButtonRef[ 3 ], 'OnHoverOut', this, 'OnHoverOutTab03' );
		inkWidgetRef.RegisterToCallback( m_tabButtonRef[ 4 ], 'OnHoverOver', this, 'OnHoverOverTab4' );
		inkWidgetRef.RegisterToCallback( m_tabButtonRef[ 4 ], 'OnHoverOut', this, 'OnHoverOutTab04' );
		inkWidgetRef.RegisterToCallback( m_tabButtonRef[ 5 ], 'OnHoverOver', this, 'OnHoverOverTab5' );
		inkWidgetRef.RegisterToCallback( m_tabButtonRef[ 5 ], 'OnHoverOut', this, 'OnHoverOutTab05' );
		inkWidgetRef.RegisterToCallback( m_tabButtonRef[ 6 ], 'OnHoverOver', this, 'OnHoverOverTab6' );
		inkWidgetRef.RegisterToCallback( m_tabButtonRef[ 6 ], 'OnHoverOut', this, 'OnHoverOutTab06' );
		m_animProxy = PlayLibraryAnimation( m_introAnimationName );
	}

	protected event OnUninitialize()
	{
		if( GetPlayerControlledObject() )
		{
			GetPlayerControlledObject().UnregisterInputListener( this );
		}
		inkWidgetRef.UnregisterFromCallback( m_closeButtonRef, 'OnPress', this, 'OnPressClose' );
		inkWidgetRef.UnregisterFromCallback( m_tabButtonRef[ 0 ], 'OnPress', this, 'OnPressTab0' );
		inkWidgetRef.UnregisterFromCallback( m_tabButtonRef[ 1 ], 'OnPress', this, 'OnPressTab1' );
		inkWidgetRef.UnregisterFromCallback( m_tabButtonRef[ 2 ], 'OnPress', this, 'OnPressTab2' );
		inkWidgetRef.UnregisterFromCallback( m_tabButtonRef[ 3 ], 'OnPress', this, 'OnPressTab3' );
		inkWidgetRef.UnregisterFromCallback( m_tabButtonRef[ 4 ], 'OnPress', this, 'OnPressTab4' );
		inkWidgetRef.UnregisterFromCallback( m_tabButtonRef[ 5 ], 'OnPress', this, 'OnPressTab5' );
		inkWidgetRef.UnregisterFromCallback( m_tabButtonRef[ 6 ], 'OnPress', this, 'OnPressTab6' );
		inkWidgetRef.UnregisterFromCallback( m_tabButtonRef[ 0 ], 'OnHoverOver', this, 'OnHoverOverTab0' );
		inkWidgetRef.UnregisterFromCallback( m_tabButtonRef[ 0 ], 'OnHoverOut', this, 'OnHoverOutTab0' );
		inkWidgetRef.UnregisterFromCallback( m_tabButtonRef[ 1 ], 'OnHoverOver', this, 'OnHoverOverTab1' );
		inkWidgetRef.UnregisterFromCallback( m_tabButtonRef[ 1 ], 'OnHoverOut', this, 'OnHoverOutTab1' );
		inkWidgetRef.UnregisterFromCallback( m_tabButtonRef[ 2 ], 'OnHoverOver', this, 'OnHoverOverTab2' );
		inkWidgetRef.UnregisterFromCallback( m_tabButtonRef[ 2 ], 'OnHoverOut', this, 'OnHoverOutTab2' );
		inkWidgetRef.UnregisterFromCallback( m_tabButtonRef[ 3 ], 'OnHoverOver', this, 'OnHoverOverTab3' );
		inkWidgetRef.UnregisterFromCallback( m_tabButtonRef[ 3 ], 'OnHoverOut', this, 'OnHoverOutTab03' );
		inkWidgetRef.UnregisterFromCallback( m_tabButtonRef[ 4 ], 'OnHoverOver', this, 'OnHoverOverTab4' );
		inkWidgetRef.UnregisterFromCallback( m_tabButtonRef[ 4 ], 'OnHoverOut', this, 'OnHoverOutTab04' );
		inkWidgetRef.UnregisterFromCallback( m_tabButtonRef[ 5 ], 'OnHoverOver', this, 'OnHoverOverTab5' );
		inkWidgetRef.UnregisterFromCallback( m_tabButtonRef[ 5 ], 'OnHoverOut', this, 'OnHoverOutTab05' );
		inkWidgetRef.UnregisterFromCallback( m_tabButtonRef[ 6 ], 'OnHoverOver', this, 'OnHoverOverTab6' );
		inkWidgetRef.UnregisterFromCallback( m_tabButtonRef[ 6 ], 'OnHoverOut', this, 'OnHoverOutTab06' );
	}

	public function SetActiveContetnt( tabId : Int32 )
	{
		if( m_activeTab == tabId )
		{
			return;
		}
		inkRichTextBoxRef.SetLocalizedText( m_descriptionRef, m_contentData[ tabId ].videoDescriptionKey );
		m_videoWidget.SetVideoPath( m_contentData[ tabId ].videoResPath );
		m_videoWidget.Play();
		inkWidgetRef.SetState( m_tabButtonRef[ m_activeTab ], 'Default' );
		inkWidgetRef.SetState( m_tabButtonRef[ tabId ], 'Selected' );
		m_activeTab = tabId;
	}

	protected event OnAction( action : ListenerAction, consumer : ListenerActionConsumer )
	{
		var aName : CName;
		var aType : gameinputActionType;
		aName = ListenerAction.GetName( action );
		aType = ListenerAction.GetType( action );
		if( aType == gameinputActionType.BUTTON_RELEASED )
		{
			if( aName == 'UI_MoveDown' )
			{
				NextTab();
			}
			else if( aName == 'UI_MoveUp' )
			{
				PreviousTab();
			}
		}
	}

	public function NextTab()
	{
		if( 1 != GameInstance.GetQuestsSystem( GetPlayerControlledObject().GetGame() ).GetFact( 'radial_wheel_tab_open' ) )
		{
			return;
		}
		PlaySound( 'Button', 'OnPress' );
		if( m_activeTab < 6 )
		{
			SetActiveContetnt( m_activeTab + ( ( Int32 )( 1 ) ) );
		}
		else
		{
			SetActiveContetnt( 0 );
		}
	}

	public function PreviousTab()
	{
		if( 1 != GameInstance.GetQuestsSystem( GetPlayerControlledObject().GetGame() ).GetFact( 'radial_wheel_tab_open' ) )
		{
			return;
		}
		PlaySound( 'Button', 'OnPress' );
		if( m_activeTab > 0 )
		{
			SetActiveContetnt( m_activeTab - ( ( Int32 )( 1 ) ) );
		}
		else
		{
			SetActiveContetnt( 6 );
		}
	}

	protected event OnPressClose( evt : inkPointerEvent )
	{
		if( evt.IsAction( 'click' ) || evt.IsAction( 'tap' ) )
		{
			Close();
		}
	}

	private function Close()
	{
		var playbackOptions : inkAnimOptions;
		PlaySound( 'Button', 'OnPress' );
		playbackOptions.playReversed = true;
		m_animProxy = PlayLibraryAnimation( m_introAnimationName, playbackOptions );
		m_animProxy.RegisterToCallback( inkanimEventType.OnFinish, this, 'OnOutroAnimationFinished' );
	}

	protected event OnOutroAnimationFinished( proxy : inkAnimProxy )
	{
		m_animProxy.UnregisterFromCallback( inkanimEventType.OnFinish, this, 'OnOutroAnimationFinished' );
		m_data.token.TriggerCallback( m_data );
	}

	protected event OnPressTab0( evt : inkPointerEvent )
	{
		if( evt.IsAction( 'click' ) || evt.IsAction( 'tap' ) )
		{
			PlaySound( 'Button', 'OnPress' );
			SetActiveContetnt( 0 );
		}
	}

	protected event OnPressTab1( evt : inkPointerEvent )
	{
		if( evt.IsAction( 'click' ) || evt.IsAction( 'tap' ) )
		{
			PlaySound( 'Button', 'OnPress' );
			SetActiveContetnt( 1 );
		}
	}

	protected event OnPressTab2( evt : inkPointerEvent )
	{
		if( evt.IsAction( 'click' ) || evt.IsAction( 'tap' ) )
		{
			PlaySound( 'Button', 'OnPress' );
			SetActiveContetnt( 2 );
		}
	}

	protected event OnPressTab3( evt : inkPointerEvent )
	{
		if( evt.IsAction( 'click' ) || evt.IsAction( 'tap' ) )
		{
			PlaySound( 'Button', 'OnPress' );
			SetActiveContetnt( 3 );
		}
	}

	protected event OnPressTab4( evt : inkPointerEvent )
	{
		if( evt.IsAction( 'click' ) || evt.IsAction( 'tap' ) )
		{
			PlaySound( 'Button', 'OnPress' );
			SetActiveContetnt( 4 );
		}
	}

	protected event OnPressTab5( evt : inkPointerEvent )
	{
		if( evt.IsAction( 'click' ) || evt.IsAction( 'tap' ) )
		{
			PlaySound( 'Button', 'OnPress' );
			SetActiveContetnt( 5 );
		}
	}

	protected event OnPressTab6( evt : inkPointerEvent )
	{
		if( evt.IsAction( 'click' ) || evt.IsAction( 'tap' ) )
		{
			PlaySound( 'Button', 'OnPress' );
			SetActiveContetnt( 6 );
		}
	}

	protected event OnHoverOverTab0( evt : inkPointerEvent )
	{
		inkWidgetRef.SetState( m_tabButtonBkgRef[ 0 ], 'Hover' );
	}

	protected event OnHoverOutTab0( evt : inkPointerEvent )
	{
		inkWidgetRef.SetState( m_tabButtonBkgRef[ 0 ], 'Default' );
	}

	protected event OnHoverOverTab1( evt : inkPointerEvent )
	{
		inkWidgetRef.SetState( m_tabButtonBkgRef[ 1 ], 'Hover' );
	}

	protected event OnHoverOutTab1( evt : inkPointerEvent )
	{
		inkWidgetRef.SetState( m_tabButtonBkgRef[ 1 ], 'Default' );
	}

	protected event OnHoverOverTab2( evt : inkPointerEvent )
	{
		inkWidgetRef.SetState( m_tabButtonBkgRef[ 2 ], 'Hover' );
	}

	protected event OnHoverOutTab2( evt : inkPointerEvent )
	{
		inkWidgetRef.SetState( m_tabButtonBkgRef[ 2 ], 'Default' );
	}

	protected event OnHoverOverTab3( evt : inkPointerEvent )
	{
		inkWidgetRef.SetState( m_tabButtonBkgRef[ 3 ], 'Hover' );
	}

	protected event OnHoverOutTab03( evt : inkPointerEvent )
	{
		inkWidgetRef.SetState( m_tabButtonBkgRef[ 3 ], 'Default' );
	}

	protected event OnHoverOverTab4( evt : inkPointerEvent )
	{
		inkWidgetRef.SetState( m_tabButtonBkgRef[ 4 ], 'Hover' );
	}

	protected event OnHoverOutTab04( evt : inkPointerEvent )
	{
		inkWidgetRef.SetState( m_tabButtonBkgRef[ 4 ], 'Default' );
	}

	protected event OnHoverOverTab5( evt : inkPointerEvent )
	{
		inkWidgetRef.SetState( m_tabButtonBkgRef[ 5 ], 'Hover' );
	}

	protected event OnHoverOutTab05( evt : inkPointerEvent )
	{
		inkWidgetRef.SetState( m_tabButtonBkgRef[ 5 ], 'Default' );
	}

	protected event OnHoverOverTab6( evt : inkPointerEvent )
	{
		inkWidgetRef.SetState( m_tabButtonBkgRef[ 6 ], 'Hover' );
	}

	protected event OnHoverOutTab06( evt : inkPointerEvent )
	{
		inkWidgetRef.SetState( m_tabButtonBkgRef[ 6 ], 'Default' );
	}

}

