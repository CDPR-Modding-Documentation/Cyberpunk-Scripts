class InventoryWeaponDisplayController extends InventoryItemDisplayController
{
	protected editable var m_weaponSpecyficModsRoot : inkCompoundRef;
	protected editable var m_silencerIcon : inkWidgetRef;
	protected editable var m_scopeIcon : inkWidgetRef;
	protected editable var m_ammoIcon : inkImageRef;
	protected editable var m_inactiveDualWieldIcon : inkWidgetRef;
	protected editable var m_primaryWeaponOnlyEquippedIcon : inkWidgetRef;
	protected editable var m_dualWieldPrimaryWeaponIcon : inkWidgetRef;
	protected editable var m_dualWieldSecondaryWeaponIcon : inkWidgetRef;
	protected editable var m_switchToPrimaryArrow : inkWidgetRef;
	protected editable var m_switchToSecondaryArrow : inkWidgetRef;
	protected var m_switchToPrimaryArrowController : weak< inkButtonController >;
	protected var m_switchToSecondaryArrowController : weak< inkButtonController >;
	protected var m_toggleToPrimary : Bool;
	protected var m_toggleToSecondary : Bool;
	protected var m_showArrows : Bool;
	protected var m_canCycleWeapons : Bool;
	protected var m_isHoveringArrow : Bool;

	protected event OnInitialize()
	{
		super.OnInitialize();
		if( inkWidgetRef.IsValid( m_switchToPrimaryArrow ) )
		{
			inkWidgetRef.RegisterToCallback( m_switchToPrimaryArrow, 'OnRelease', this, 'OnToggleToPrimary' );
			inkWidgetRef.RegisterToCallback( m_switchToPrimaryArrow, 'OnHoverOver', this, 'OnHoverOver' );
			inkWidgetRef.RegisterToCallback( m_switchToPrimaryArrow, 'OnHoverOut', this, 'OnHoverOut' );
			m_switchToPrimaryArrowController = ( ( inkButtonController )( inkWidgetRef.GetController( m_switchToPrimaryArrow ) ) );
		}
		if( inkWidgetRef.IsValid( m_switchToSecondaryArrow ) )
		{
			inkWidgetRef.RegisterToCallback( m_switchToSecondaryArrow, 'OnRelease', this, 'OnToggleToSecondary' );
			inkWidgetRef.RegisterToCallback( m_switchToSecondaryArrow, 'OnHoverOver', this, 'OnHoverOver' );
			inkWidgetRef.RegisterToCallback( m_switchToSecondaryArrow, 'OnHoverOut', this, 'OnHoverOut' );
			m_switchToSecondaryArrowController = ( ( inkButtonController )( inkWidgetRef.GetController( m_switchToSecondaryArrow ) ) );
		}
		SetShowArrows( true );
	}

	protected event OnUninitialize()
	{
		super.OnUninitialize();
		if( inkWidgetRef.IsValid( m_switchToPrimaryArrow ) )
		{
			inkWidgetRef.UnregisterFromCallback( m_switchToPrimaryArrow, 'OnRelease', this, 'OnToggleToPrimary' );
			inkWidgetRef.UnregisterFromCallback( m_switchToPrimaryArrow, 'OnHoverOver', this, 'OnHoverOver' );
			inkWidgetRef.UnregisterFromCallback( m_switchToPrimaryArrow, 'OnHoverOut', this, 'OnHoverOut' );
		}
		if( inkWidgetRef.IsValid( m_switchToSecondaryArrow ) )
		{
			inkWidgetRef.UnregisterFromCallback( m_switchToSecondaryArrow, 'OnRelease', this, 'OnToggleToSecondary' );
			inkWidgetRef.UnregisterFromCallback( m_switchToSecondaryArrow, 'OnHoverOver', this, 'OnHoverOver' );
			inkWidgetRef.UnregisterFromCallback( m_switchToSecondaryArrow, 'OnHoverOut', this, 'OnHoverOut' );
		}
	}

	public override function OnCreate()
	{
		SetShowArrows( false );
		RefreshUI();
	}

	protected override function NewRefreshUI( itemData : UIInventoryItem )
	{
		super.NewRefreshUI( itemData );
		NewUpdateWeaponParts( itemData );
		UpdateAmmoIcon( itemData.GetItemData() );
		NewUpdateDualWield( itemData );
	}

	protected function UpdateAmmoIcon( itemData : weak< gameItemData > )
	{
		var type : gamedataItemType;
		var icon : CName;
		if( itemData )
		{
			type = itemData.GetItemType();
			icon = UIItemsHelper.GetAmmoIconByType( type );
			inkImageRef.SetTexturePart( m_ammoIcon, icon );
		}
	}

	protected virtual function NewUpdateWeaponParts( itemData : UIInventoryItem )
	{
		var hasScopeSlot, hasSilencerSlot, hasScopeInstalled, hasSilencerInstalled : Bool;
		if( itemData )
		{
			hasScopeSlot = itemData.HasScopeSlot();
			hasSilencerSlot = itemData.HasSilencerSlot();
			hasScopeInstalled = itemData.HasScopeInstalled();
			hasSilencerInstalled = itemData.HasSilencerInstalled();
		}
		inkWidgetRef.SetVisible( m_scopeIcon, hasScopeSlot );
		inkWidgetRef.SetState( m_scopeIcon, ( ( hasScopeInstalled ) ? ( 'Default' ) : ( 'Empty' ) ) );
		inkWidgetRef.SetVisible( m_silencerIcon, hasSilencerSlot );
		inkWidgetRef.SetState( m_silencerIcon, ( ( hasSilencerInstalled ) ? ( 'Default' ) : ( 'Empty' ) ) );
	}

	protected override function RefreshUI()
	{
		super.RefreshUI();
		UpdateWeaponParts();
		UpdateAmmoIcon( InventoryItemData.GetGameItemData( m_itemData ) );
		UpdateDualWield( InventoryItemData.GetGameItemData( m_itemData ) );
	}

	protected virtual function UpdateWeaponParts()
	{
		var i, attachmentsSize : Int32;
		var itemData : InventoryItemData;
		var hasSilencerSlot, hasScopeSlot : Bool;
		var attachment, scopeAttachment, silencerAttachment : InventoryItemAttachments;
		itemData = GetItemData();
		attachmentsSize = itemData.Attachments.Size();
		for( i = 0; i < attachmentsSize; i += 1 )
		{
			attachment = itemData.Attachments[ i ];
			if( attachment.SlotID == T"AttachmentSlots.Scope" )
			{
				scopeAttachment = attachment;
				hasScopeSlot = true;
			}
			else if( attachment.SlotID == T"AttachmentSlots.PowerModule" )
			{
				silencerAttachment = attachment;
				hasSilencerSlot = true;
			}
		}
		inkWidgetRef.SetVisible( m_scopeIcon, hasScopeSlot );
		inkWidgetRef.SetState( m_scopeIcon, ( ( scopeAttachment.ItemData.Empty ) ? ( 'Empty' ) : ( 'Default' ) ) );
		inkWidgetRef.SetVisible( m_silencerIcon, hasSilencerSlot );
		inkWidgetRef.SetState( m_silencerIcon, ( ( silencerAttachment.ItemData.Empty ) ? ( 'Empty' ) : ( 'Default' ) ) );
	}

	protected function NewUpdateDualWield( itemData : UIInventoryItem )
	{
		var weaponType : WeaponType;
		weaponType = UIInventoryItemsManager.GetItemTypeWeapon( itemData.GetItemType() );
		if( weaponType != WeaponType.Invalid )
		{
			itemData.FetchWeaponImmediate( weaponType );
		}
		DoUpdateDualWield( itemData != NULL, itemData.IsLeftWeapon(), itemData.HasPairedWeapon(), itemData.CanDualWield(), itemData.IsEquipped() );
	}

	protected function UpdateDualWield( itemData : weak< gameItemData > )
	{
		DoUpdateDualWield( !( InventoryItemData.IsEmpty( GetItemData() ) ), IsLeftWeapon(), HasPairedWeapon(), InventoryItemData.CanDualWield( GetItemData() ), InventoryItemData.IsEquipped( GetItemData() ) );
	}

	protected function DoUpdateDualWield( itemDataExists : Bool, isLeftWeapon : Bool, hasPairedWeapon : Bool, canDualWield : Bool, isEquipped : Bool )
	{
		var displayContextData : ItemDisplayContext;
		if( ( itemDataExists && !( canDualWield ) ) || !( m_inventoryDataManager.HasPlayerDualWield() ) )
		{
			SetArrowsVisibility( false, false );
			SetDualWieldIconsVisiblity( false, false, false, false );
			return;
		}
		inkWidgetRef.SetState( m_inactiveDualWieldIcon, 'Empty' );
		displayContextData = GetDisplayContext();
		if( m_showArrows && displayContextData == ItemDisplayContext.GearPanel )
		{
			SetArrowsVisibility( isLeftWeapon || GetCanCycleWeapons(), ( !( isLeftWeapon ) || GetCanCycleWeapons() ) && itemDataExists );
		}
		else
		{
			SetArrowsVisibility( false, false );
		}
		if( itemDataExists )
		{
			SetDualWieldIconsVisiblity( !( hasPairedWeapon ) && isEquipped, ( hasPairedWeapon && isEquipped ) && !( isLeftWeapon ), ( hasPairedWeapon && isEquipped ) && isLeftWeapon, !( isEquipped ) );
		}
		else
		{
			SetDualWieldIconsVisiblity( false, false, false, canDualWield );
		}
	}

	protected override function UpdateIcon()
	{
		var emptyIcon : CName;
		super.UpdateIcon();
		if( IsLeftWeapon() )
		{
			emptyIcon = 'UIIcon.ItemShadow_DualWield';
			InkImageUtils.RequestSetImage( this, m_itemEmptyImage, emptyIcon );
		}
	}

	public override function GetSlotName() : String
	{
		if( IsStringValid( m_slotName ) )
		{
			return m_slotName;
		}
		if( IsLeftWeapon() )
		{
			return GetLocalizedText( "Gameplay-Weapons-DualWield-SecondaryWeapon" );
		}
		return UIItemsHelper.GetSlotName( GetSlotID(), GetItemType(), GetEquipmentArea() );
	}

	public function SetShowArrows( value : Bool )
	{
		m_showArrows = value;
	}

	public function SetArrowsVisibility( showRight : Bool, showLeft : Bool )
	{
		inkWidgetRef.SetVisible( m_switchToPrimaryArrow, showRight );
		m_switchToPrimaryArrowController.SetNavigable( showRight );
		inkWidgetRef.SetVisible( m_switchToSecondaryArrow, showLeft );
		m_switchToSecondaryArrowController.SetNavigable( showLeft );
	}

	public function SetDualWieldIconsVisiblity( showPrimaryOnlyEquipped : Bool, showDualWieldPrimaryWeapon : Bool, showDualWieldSecondaryWeapon : Bool, showInactive : Bool )
	{
		inkWidgetRef.SetVisible( m_primaryWeaponOnlyEquippedIcon, showPrimaryOnlyEquipped );
		inkWidgetRef.SetVisible( m_dualWieldPrimaryWeaponIcon, showDualWieldPrimaryWeapon );
		inkWidgetRef.SetVisible( m_dualWieldSecondaryWeaponIcon, showDualWieldSecondaryWeapon );
		inkWidgetRef.SetVisible( m_inactiveDualWieldIcon, showInactive );
	}

	public function IsLeftWeapon() : Bool
	{
		var slotIndex : Int32;
		slotIndex = GetSlotIndex();
		return ( slotIndex >= ( ( Int32 )( WeaponSlot.LeftSlot_1 ) ) ) && ( slotIndex <= ( ( Int32 )( WeaponSlot.LeftSlot_3 ) ) );
	}

	public function HasPairedWeapon() : Bool
	{
		var pairedWeapon : InventoryItemData;
		var dualWieldSlot : Int32;
		dualWieldSlot = 0;
		dualWieldSlot = EquipmentSystemPlayerData.GetOppositeWeaponSlotIndex( InventoryItemData.GetSlotIndex( m_itemData ) );
		pairedWeapon = m_inventoryDataManager.GetWeaponEquippedInSlot( dualWieldSlot );
		return !( pairedWeapon.Empty );
	}

	public function GetToggleToPrimary() : Bool
	{
		return m_toggleToPrimary;
	}

	public function GetToggleToSecondary() : Bool
	{
		return m_toggleToSecondary;
	}

	public function IsHoveringArrow() : Bool
	{
		return m_isHoveringArrow;
	}

	public function ResetToggle()
	{
		QueueEvent( new DelayedResetDualWieldItemToggled );
	}

	protected event OnToggleToPrimary( e : inkPointerEvent )
	{
		if( e.IsAction( 'click' ) || e.IsAction( 'tap' ) )
		{
			m_toggleToPrimary = true;
		}
	}

	protected event OnToggleToSecondary( e : inkPointerEvent )
	{
		if( e.IsAction( 'click' ) || e.IsAction( 'tap' ) )
		{
			m_toggleToSecondary = true;
		}
	}

	protected event OnHoverOver( e : inkPointerEvent )
	{
		m_isHoveringArrow = true;
	}

	protected event OnHoverOut( e : inkPointerEvent )
	{
		m_isHoveringArrow = false;
	}

	protected event OnDelayedResetDualWieldItemToggled( evt : DelayedResetDualWieldItemToggled )
	{
		m_toggleToPrimary = false;
		m_toggleToSecondary = false;
	}

	public function GetCanCycleWeapons() : Bool
	{
		return m_canCycleWeapons;
	}

	public function SetCanCycleWeapons( value : Bool )
	{
		m_canCycleWeapons = value;
	}

	public function PlayCycleAnimation( isNext : Bool )
	{
		if( isNext )
		{
			PlayLibraryAnimation( 'Weapon_Cycle_Next' );
		}
		else
		{
			PlayLibraryAnimation( 'Weapon_Cycle_Previous' );
		}
	}

	public function PlaySwapWeaponsAnimation()
	{
		PlayLibraryAnimation( 'Weapon_Swap' );
	}

}

class DelayedResetDualWieldItemToggled extends Event
{
}

