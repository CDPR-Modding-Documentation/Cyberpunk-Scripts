import class InputTarget extends CallbackSystemTarget
{
	public import static function Key( key : EInputKey, optional threshold : Float ) : InputTarget;
	public import static function Axis( key : EInputKey, optional threshold : Float ) : InputTarget;
}

import class ResourceTarget extends CallbackSystemTarget
{
	public import static function Path( resourcePath : ResRef ) : ResourceTarget;
	public import static function Type( resourceType : CName ) : ResourceTarget;
}

