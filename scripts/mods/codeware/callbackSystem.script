importonly class ScriptableService extends IScriptable
{
}

class ScriptableEnv extends ScriptableService
{

	public static function Get( name : CName ) : ScriptableService
	{
		var inName : CName;
		var service : ScriptableService;
		inName = name;
		service = GameInstance.GetScriptableServiceContainer().GetService( inName );
		return service;
	}

}

import class ScriptableServiceContainer extends IGameSystem
{
	public import function GetService( name : CName ) : ScriptableService;
}

import abstract class CallbackSystemTarget extends IScriptable
{
}

import class CallbackSystemEvent extends IScriptable
{
	import var eventName : CName;
}

import enum gameCallbackRunMode
{
	Default,
	Once,
	OncePerTarget,
}

import enum gameCallbackLifetime
{
	Session,
	Forever,
}

import final class CallbackSystemHandler extends IScriptable
{
	public import function AddTarget( target : CallbackSystemTarget ) : CallbackSystemHandler;
	public import function RemoveTarget( target : CallbackSystemTarget ) : CallbackSystemHandler;
	public import function SetRunMode( runMode : gameCallbackRunMode ) : CallbackSystemHandler;
	public import function SetLifetime( lifetime : gameCallbackLifetime ) : CallbackSystemHandler;
	public import function IsRegistered() : Bool;
	public import function Unregister();
}

import class CallbackSystem extends IGameSystem
{
	public import function RegisterCallback( eventName : CName, target : IScriptable, functionName : CName, optional sticky : Bool ) : CallbackSystemHandler;
	public import function UnregisterCallback( eventName : CName, target : IScriptable, optional functionName : CName );
	public import function RegisterStaticCallback( eventName : CName, target : IScriptable, functionName : CName, optional sticky : Bool ) : CallbackSystemHandler;
	public import function UnregisterStaticCallback( eventName : CName, contextName : CName, optional functionName : CName );
	public import function RegisterEvent( eventName : CName, optional eventType : CName );
	public import function DispatchEvent( eventObject : CallbackSystemEvent );
	public import function DispatchEventAs( eventName : CName, eventObject : CallbackSystemEvent );
}

importonly abstract class ISerializable
{
}

import abstract class CResource extends ISerializable
{
	import var cookingPlatform : ECookingPlatform;
}

import class ResourceEvent extends CallbackSystemEvent
{
	import var resource : CResource;

	public import function GetResource() : CResource;
	public import function GetPath() : ResRef;
}

import class GameSessionEvent extends CallbackSystemEvent
{
	public import function IsRestored() : Bool;
	public import function IsPreGame() : Bool;
}

